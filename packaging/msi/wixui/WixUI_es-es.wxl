    <String Id="VerifyReadyDlgRepair" Overridable="yes">Re&amp;parar</String>
    <String Id="VerifyReadyDlgRepairText" Overridable="yes">Hacé clic en Reparar para reparar la instalación de [ProductName]. Hacé clic en Atrás para revisar o cambiar la configuración de la instalación. Hacé clic en Cancelar para salir del asistente.</String>
