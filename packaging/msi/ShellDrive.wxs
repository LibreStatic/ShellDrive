<?xml version="1.0" encoding="UTF-8"?>
<!--
  ShellDrive per-machine MSI (docs/design/04 §8). One source for every flavour: packaging/msi/build-msi.cmake passes
  the flavour through the defines below (candle -d...), and the generated includes come from the build tree:
    Registry.wxi  tools/sd-msigen registry (packaging/registration.txt)
    Guids.wxi     component and product GUIDs of this flavour family (sd-msigen guid)
  Localized text: the loc.* ids come from the generated ShellDrive.<culture>.wxl files and from WixUI.

  Defines: SD_VERSION, SD_FLAVOUR, SD_PRODUCT_CODE, SD_PACKAGE_CODE, SD_UPGRADE_CODE, SD_INSTALLER_VERSION,
  SD_PF_DIR (ProgramFilesFolder or ProgramFiles64Folder), SD_WIN64 (yes/no), SD_BIN_DIR, SD_ICON,
  SD_LAUNCH (none or win10), SD_WITH_SERVICE (0 or 1, 0 until the service exists: M5, D6), SD_LICENSE_RTF (the
  LICENSE of the repository converted to RTF by build-msi.cmake, shown by the license page).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include Guids.wxi?>
  <Product Id="$(var.SD_PRODUCT_CODE)" Name="ShellDrive" Language="1033" Version="$(var.SD_VERSION)"
           Manufacturer="LibreStatic" UpgradeCode="$(var.SD_UPGRADE_CODE)">
    <Package Id="$(var.SD_PACKAGE_CODE)" InstallerVersion="$(var.SD_INSTALLER_VERSION)" Compressed="yes"
             InstallScope="perMachine" InstallPrivileges="elevated"
             Description="ShellDrive $(var.SD_FLAVOUR)" Comments="LibreStatic ShellDrive, per-machine package" />

    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="no" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ShellDriveIcon" SourceFile="$(var.SD_ICON)" />
    <!-- The host binary as a Binary table entry: the programdata-secure hook runs before InstallFiles (TM-R34), when the
         installed copy does not exist yet (CA_ProgramDataSecure, BinaryKey). -->
    <Binary Id="BIN_ShellDriveHost" SourceFile="$(var.SD_BIN_DIR)\shelldrive-host.exe" />
    <Property Id="ARPPRODUCTICON" Value="ShellDriveIcon" />
    <!-- ARPNOMODIFY=0: Add/Remove Programs offers "Change", which runs the feature tree and the options page of the
         ShellDriveUI dialog set below (04 §6.7). Explicit so that the Property table shows it. -->
    <Property Id="ARPNOMODIFY" Value="0" />

    <!-- Public properties for silent configuration (04 §8.4). Empty means "not given": DOKANY and ENABLELINKEDCONNECTIONS
         are not declared here, so a value on the command line wins, otherwise the choice remembered in the registry
         (HKLM Installer key, 04 §8.7), otherwise the default (DOKANY on, ENABLELINKEDCONNECTIONS off). -->
    <Property Id="AUTOSTART" Value="1" />
    <Property Id="REMOVEDATA" Value="0" />
    <Property Id="REMOVESECRETS" Value="1" />
    <Property Id="UPDATECHANNEL" Value="stable" />
    <Property Id="WEBDAV_TUNING" Value="1" />
    <!-- UPDATEURL and DEFAULTPROFILES have no default: they are set on the command line (04 §8.4). -->
    <!-- UPDATECHECK defaults to 0 for a silent install (UILevel 2 is /qn) and to 1 otherwise. -->
    <SetProperty Id="SD_UpdateCheckSilent" Value="0" Sequence="both" Before="CostInitialize"><![CDATA[UILevel = 2 AND UPDATECHECK = ""]]></SetProperty>
    <SetProperty Id="SD_UpdateCheckDefault" Value="1" Sequence="both" After="CostInitialize"><![CDATA[UPDATECHECK = ""]]></SetProperty>

    <!-- Read by the launch condition (OS) and by the ENABLELINKEDCONNECTIONS condition (04 §8.2, §8.4). -->
    <Property Id="SD_OSMAJOR">
      <RegistrySearch Id="SD_OSMAJOR_RS" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentMajorVersionNumber" Type="raw" Win64="$(var.SD_WIN64)" />
    </Property>
    <Property Id="SD_ELC_EXISTS">
      <RegistrySearch Id="SD_ELC_EXISTS_RS" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
                      Name="EnableLinkedConnections" Type="raw" Win64="$(var.SD_WIN64)" />
    </Property>
    <!-- Remembered choices (04 §8.7). The Installer key is owned by this package and always installed (C_Installer), so
         every run reads it back: repair, silent maintenance and uninstall see the same choices as the last install. -->
    <Property Id="SD_REG_DOKANY">
      <RegistrySearch Id="SD_REG_DOKANY_RS" Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="DOKANY"
                      Type="raw" Win64="$(var.SD_WIN64)" />
    </Property>
    <Property Id="SD_REG_ELC">
      <RegistrySearch Id="SD_REG_ELC_RS" Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="ENABLELINKEDCONNECTIONS"
                      Type="raw" Win64="$(var.SD_WIN64)" />
    </Property>
    <!-- ELC_OWNED = 1 when this package wrote the EnableLinkedConnections value (it did not exist before). -->
    <Property Id="SD_REG_ELC_OWNED">
      <RegistrySearch Id="SD_REG_ELC_OWNED_RS" Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="ELC_OWNED"
                      Type="raw" Win64="$(var.SD_WIN64)" />
    </Property>

    <!-- Checkbox state of the options page (SD_UI_*, "1" = checked) and the effective state written to the registry
         and settings.ini (SD_*_STATE, SD_ELC_WRITE = 1 when the value is written and owned by this package). The
         defaults below apply until the init rows run (InstallUISequence, and InstallExecuteSequence for a silent run). -->
    <Property Id="SD_UI_DOKANY" Value="1" />
    <Property Id="SD_UI_ELC" Value="0" />
    <Property Id="SD_DOKANY_STATE" Value="1" />
    <Property Id="SD_ELC_STATE" Value="0" />
    <Property Id="SD_ELC_WRITE" Value="0" />
    <!-- Init, once per run (SD_UI_INIT is set by the last init row): command line first, then the remembered choice. -->
    <SetProperty Id="SD_UI_DOKANY" Value="0" Sequence="both" After="AppSearch"><![CDATA[SD_UI_INIT = "" AND (DOKANY = "0" OR (DOKANY = "" AND SD_REG_DOKANY = "0"))]]></SetProperty>
    <SetProperty Id="SD_UI_ELC" Value="1" Sequence="both" After="SetSD_UI_DOKANY"><![CDATA[SD_UI_INIT = "" AND (ENABLELINKEDCONNECTIONS = "1" OR (ENABLELINKEDCONNECTIONS = "" AND SD_REG_ELC = "1"))]]></SetProperty>
    <SetProperty Id="SD_UI_INIT" Value="1" Sequence="both" After="SetSD_UI_ELC"><![CDATA[1]]></SetProperty>
    <!-- Effective state, before the components are costed. The chain keeps the order of the three rows. -->
    <SetProperty Id="SD_DOKANY_STATE" Value="0" Sequence="both" After="SetSD_UI_INIT"><![CDATA[SD_UI_DOKANY <> "1"]]></SetProperty>
    <SetProperty Id="SD_ELC_STATE" Value="1" Sequence="both" After="SetSD_DOKANY_STATE"><![CDATA[SD_UI_ELC = "1"]]></SetProperty>
    <!-- The value is written when it is wanted and either does not exist yet (this package creates it) or is ours already.
         A value that exists and was set by someone else is never written, changed or removed (ELC ownership, 04 §8.7). -->
    <SetProperty Id="SD_ELC_WRITE" Value="1" Sequence="both" After="SetSD_ELC_STATE"><![CDATA[SD_ELC_STATE = "1" AND VersionNT >= 600 AND (SD_ELC_EXISTS = "" OR SD_REG_ELC_OWNED = "1")]]></SetProperty>

    <?if $(var.SD_LAUNCH) = "win10" ?>
    <!-- Windows 10 or later: CurrentMajorVersionNumber exists only there (04 §8.2). -->
    <Condition Message="!(loc.OsRequired)"><![CDATA[Installed OR (SD_OSMAJOR <> "" AND SD_OSMAJOR >= 10)]]></Condition>
    <?endif?>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.SD_PF_DIR)">
        <Directory Id="SD_VENDOR_PF" Name="LibreStatic">
          <Directory Id="INSTALLDIR" Name="ShellDrive">

            <Component Id="C_Core_Cli" Guid="$(var.G_C_Core_Cli)" Win64="$(var.SD_WIN64)">
              <File Id="F_shelldrive" Name="shelldrive.exe" Source="$(var.SD_BIN_DIR)\shelldrive.exe" KeyPath="yes" />
            </Component>

            <Component Id="C_Core_Host" Guid="$(var.G_C_Core_Host)" Win64="$(var.SD_WIN64)">
              <File Id="F_shelldrive_host" Name="shelldrive-host.exe" Source="$(var.SD_BIN_DIR)\shelldrive-host.exe" KeyPath="yes" />
              <?if $(var.SD_WITH_SERVICE) = "1" ?>
              <!-- The service binary is this file (M5). The feature split for SERVICE=0 comes with it (04 §8.3). -->
              <ServiceInstall Id="SD_ServiceInstall" Name="ShellDriveSvc" DisplayName="ShellDrive" Description="ShellDrive background service"
                              Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="service" />
              <ServiceControl Id="SD_ServiceControl" Name="ShellDriveSvc" Stop="both" Remove="uninstall" Wait="yes" />
              <?endif?>
            </Component>

            <Component Id="C_Core_Ui" Guid="$(var.G_C_Core_Ui)" Win64="$(var.SD_WIN64)">
              <File Id="F_shelldrive_ui" Name="shelldrive-ui.exe" Source="$(var.SD_BIN_DIR)\shelldrive-ui.exe" KeyPath="yes" />
            </Component>

            <Component Id="C_ShellExt" Guid="$(var.G_C_ShellExt)" Win64="$(var.SD_WIN64)">
              <File Id="F_shelldrive_shellext" Name="shelldrive-shellext.dll" Source="$(var.SD_BIN_DIR)\shelldrive-shellext.dll" KeyPath="yes" />
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="SD_STARTMENU" Name="ShellDrive">
          <Component Id="C_StartMenu" Guid="$(var.G_C_StartMenu)" Win64="$(var.SD_WIN64)">
            <CreateFolder />
            <Shortcut Id="SD_SHORTCUT_UI" Name="ShellDrive" Description="ShellDrive" Target="[INSTALLDIR]shelldrive-ui.exe"
                      WorkingDirectory="INSTALLDIR" Icon="ShellDriveIcon" IconIndex="0" Advertise="no" />
            <RemoveFolder Id="SD_STARTMENU_RM" On="uninstall" />
          </Component>
        </Directory>
      </Directory>

      <!-- Machine settings and data (04 §6.7, §8.3). Written by the MSI only; removed on uninstall as stated there. -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="SD_CAD_VENDOR" Name="LibreStatic">
          <Directory Id="SD_CAD_PRODUCT" Name="ShellDrive">
            <Directory Id="SD_CAD_PROFILES" Name="profiles" />
            <Directory Id="SD_CAD_STATE" Name="state" />
            <Directory Id="SD_CAD_SERVICE" Name="service">
              <Directory Id="SD_CAD_SECRETS" Name="secrets" />
              <Directory Id="SD_CAD_KEYS" Name="keys" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <!-- settings.ini (03 §3.4): the [update] and [backend] keys that the public properties write. -->
    <Component Id="C_Ini_Update" Guid="$(var.G_C_Ini_Update)" Directory="SD_CAD_PRODUCT" Win64="$(var.SD_WIN64)">
      <CreateFolder />
      <IniFile Id="SD_INI_UPDATE_ENABLED" Action="addLine" Directory="SD_CAD_PRODUCT" Name="settings.ini"
               Section="update" Key="enabled" Value="[UPDATECHECK]" />
      <IniFile Id="SD_INI_UPDATE_CHANNEL" Action="addLine" Directory="SD_CAD_PRODUCT" Name="settings.ini"
               Section="update" Key="channel" Value="[UPDATECHANNEL]" />
    </Component>
    <Component Id="C_Ini_UpdateUrl" Guid="$(var.G_C_Ini_UpdateUrl)" Directory="SD_CAD_PRODUCT" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[UPDATEURL <> ""]]></Condition>
      <CreateFolder />
      <IniFile Id="SD_INI_UPDATE_URL" Action="addLine" Directory="SD_CAD_PRODUCT" Name="settings.ini"
               Section="update" Key="manifest_url" Value="[UPDATEURL]" />
    </Component>
    <Component Id="C_Ini_Backend" Guid="$(var.G_C_Ini_Backend)" Directory="SD_CAD_PRODUCT" Win64="$(var.SD_WIN64)">
      <!-- The effective choice (SD_DOKANY_STATE, from the command line, the remembered choice or the options page). -->
      <Condition><![CDATA[SD_DOKANY_STATE = "0"]]></Condition>
      <CreateFolder />
      <IniFile Id="SD_INI_BACKEND_DOKANY" Action="addLine" Directory="SD_CAD_PRODUCT" Name="settings.ini"
               Section="backend" Key="dokany" Value="no" />
    </Component>

    <!-- DEFAULTPROFILES (C9, 04 §8.4): a folder of .ini profiles copied into the profiles folder by the native MoveFile table
         (copy mode, *.ini, no custom action). The table row is below the components; this component carries it while the
         property is set. The copy runs with MoveFiles, after the ProgramData check (CA_ProgramDataSecure, before InstallFiles). -->
    <Component Id="C_DefaultProfiles" Guid="$(var.G_C_DefaultProfiles)" Directory="SD_CAD_PROFILES" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[DEFAULTPROFILES <> "" AND NOT REMOVE~="ALL"]]></Condition>
      <CreateFolder />
    </Component>

    <!-- ENABLELINKEDCONNECTIONS (D24, 04 §8.7): installed only when this package owns the value, that is when it creates it
         (none existed) or already owns it (ELC_OWNED). The component is installed, so its value is removed on uninstall,
         exactly when this package created it. A value set by someone else is never taken over. -->
    <Component Id="C_LinkedConn" Guid="$(var.G_C_LinkedConn)" Directory="TARGETDIR" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[SD_ELC_WRITE = "1"]]></Condition>
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
                     Name="EnableLinkedConnections" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The choices of this package (04 §8.7): read back by the RegistrySearch rows on every run. Always installed (Core). -->
    <Component Id="C_Installer" Guid="$(var.G_C_Installer)" Directory="TARGETDIR" Win64="$(var.SD_WIN64)">
      <RegistryValue Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="DOKANY" Type="string"
                     Value="[SD_DOKANY_STATE]" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="ENABLELINKEDCONNECTIONS" Type="string"
                     Value="[SD_ELC_STATE]" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\LibreStatic\ShellDrive\Installer" Name="ELC_OWNED" Type="string"
                     Value="[SD_ELC_WRITE]" />
    </Component>

    <!-- Uninstall-only removal (04 §6.7). Each component's condition is true only while the product is removed. -->
    <Component Id="C_Rm_Secrets" Guid="$(var.G_C_Rm_Secrets)" Directory="SD_CAD_SECRETS" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[(REMOVESECRETS = "1" OR REMOVEDATA = "1") AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFile Id="SD_RMF_SECRETS" Name="*" On="uninstall" />
      <RemoveFolder Id="SD_RMD_SECRETS" On="uninstall" />
    </Component>
    <Component Id="C_Rm_Keys" Guid="$(var.G_C_Rm_Keys)" Directory="SD_CAD_KEYS" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[(REMOVESECRETS = "1" OR REMOVEDATA = "1") AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFile Id="SD_RMF_KEYS" Name="*" On="uninstall" />
      <RemoveFolder Id="SD_RMD_KEYS" On="uninstall" />
    </Component>
    <Component Id="C_Rm_Data" Guid="$(var.G_C_Rm_Data)" Directory="SD_CAD_PRODUCT" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[REMOVEDATA = "1" AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFile Id="SD_RMF_DATA" Name="*" On="uninstall" />
      <RemoveFolder Id="SD_RMD_DATA" On="uninstall" />
    </Component>
    <Component Id="C_Rm_DataProfiles" Guid="$(var.G_C_Rm_DataProfiles)" Directory="SD_CAD_PROFILES" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[REMOVEDATA = "1" AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFile Id="SD_RMF_PROFILES" Name="*" On="uninstall" />
      <RemoveFolder Id="SD_RMD_PROFILES" On="uninstall" />
    </Component>
    <Component Id="C_Rm_DataState" Guid="$(var.G_C_Rm_DataState)" Directory="SD_CAD_STATE" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[REMOVEDATA = "1" AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFile Id="SD_RMF_STATE" Name="*" On="uninstall" />
      <RemoveFolder Id="SD_RMD_STATE" On="uninstall" />
    </Component>
    <Component Id="C_Rm_DataService" Guid="$(var.G_C_Rm_DataService)" Directory="SD_CAD_SERVICE" Win64="$(var.SD_WIN64)">
      <Condition><![CDATA[REMOVEDATA = "1" AND REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Condition>
      <CreateFolder />
      <RemoveFolder Id="SD_RMD_SERVICE" On="uninstall" />
    </Component>

    <!-- Feature tree (04 §8.3). Core is always installed; the others are on by default. -->
    <Feature Id="ShellDrive" Title="ShellDrive" Level="1" Display="expand">
      <Feature Id="Core" Title="!(loc.FeatureCoreTitle)" Description="!(loc.FeatureCoreDesc)" Level="1" Absent="disallow" AllowAdvertise="no">
        <ComponentRef Id="C_Core_Cli" />
        <ComponentRef Id="C_Core_Host" />
        <ComponentRef Id="C_Core_Ui" />
        <ComponentRef Id="C_Ini_Update" />
        <ComponentRef Id="C_Ini_UpdateUrl" />
        <ComponentRef Id="C_Ini_Backend" />
        <ComponentRef Id="C_DefaultProfiles" />
        <ComponentRef Id="C_LinkedConn" />
        <ComponentRef Id="C_Installer" />
        <ComponentRef Id="C_Rm_Secrets" />
        <ComponentRef Id="C_Rm_Keys" />
        <ComponentRef Id="C_Rm_Data" />
        <ComponentRef Id="C_Rm_DataProfiles" />
        <ComponentRef Id="C_Rm_DataState" />
        <ComponentRef Id="C_Rm_DataService" />
        <ComponentGroupRef Id="SD_RegCore" />
      </Feature>
      <Feature Id="ShellExt" Title="!(loc.FeatureShellextTitle)" Description="!(loc.FeatureShellextDesc)" Level="1" AllowAdvertise="no">
        <ComponentRef Id="C_ShellExt" />
        <!-- CLSIDs, handlers (Drive, Directory, *, This PC) and Approved entries of the shell extension (03 §8.5). -->
        <ComponentGroupRef Id="SD_RegShellExt" />
      </Feature>
      <Feature Id="StartMenu" Title="!(loc.FeatureStartmenuTitle)" Description="!(loc.FeatureStartmenuDesc)" Level="1" AllowAdvertise="no">
        <ComponentRef Id="C_StartMenu" />
      </Feature>
      <Feature Id="Autostart" Title="!(loc.FeatureAutostartTitle)" Description="!(loc.FeatureAutostartDesc)" Level="1" AllowAdvertise="no">
        <Condition Level="0"><![CDATA[AUTOSTART = "0"]]></Condition>
        <ComponentGroupRef Id="SD_RegAutostart" />
      </Feature>
    </Feature>

    <!-- Deferred custom actions of our own binary (04 §8.3, TM-R35). The conditions are the table of 04 §8.3.
         FileKey runs the installed copy, so each action is scheduled after InstallFiles. The exception is
         CA_ProgramDataSecure: it runs from the Binary table (BinaryKey) before InstallFiles, so the ProgramData check
         (TM-R34) comes before any file or profile is written there. Impersonate="no" only where the table says so. -->
    <CustomAction Id="CA_ProgramDataSecure" BinaryKey="BIN_ShellDriveHost" ExeCommand="--installer-hook programdata-secure --apply"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CA_WebDavTune_Apply" FileKey="F_shelldrive_host" ExeCommand="--installer-hook webdav-tune --apply"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CA_WebDavTune_Revert" FileKey="F_shelldrive_host" ExeCommand="--installer-hook webdav-tune --revert"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="CA_SignalShutdown" FileKey="F_shelldrive_host" ExeCommand="--installer-hook signal-shutdown --apply"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="CA_UserCleanup" FileKey="F_shelldrive_host" ExeCommand="--installer-hook user-cleanup --apply"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CA_SignalShutdown" Before="RemoveExistingProducts"><![CDATA[NOT REINSTALL AND (REMOVE~="ALL" OR WIX_UPGRADE_DETECTED)]]></Custom>
      <Custom Action="CA_ProgramDataSecure" Before="MoveFiles"><![CDATA[NOT REMOVE~="ALL"]]></Custom>
      <MoveFiles />
      <Custom Action="CA_WebDavTune_Apply" After="InstallFiles"><![CDATA[WEBDAV_TUNING = "1" AND NOT REMOVE~="ALL"]]></Custom>
      <Custom Action="CA_WebDavTune_Revert" Before="RemoveFiles"><![CDATA[REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
      <Custom Action="CA_UserCleanup" Before="RemoveFiles"><![CDATA[REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
    </InstallExecuteSequence>

    <!-- DEFAULTPROFILES (C9, 04 §8.4). WiX 3.14 has no element for the MoveFile table, so the table is authored as a custom
         table with the standard name and columns (MSI 3.1 MoveFile: FileKey, Component_, SourceName, DestName, SourceFolder,
         DestFolder, Options; Options 0 = copy). It must sit in the Product element, not in a fragment: a fragment drops it.
         SourceFolder is the property: the folder of .ini profiles given on the command line (empty = nothing to copy). -->
    <CustomTable Id="MoveFile">
      <Column Id="FileKey" Type="string" Width="72" PrimaryKey="yes" Category="Identifier" />
      <Column Id="Component_" Type="string" Width="72" Category="Identifier" KeyTable="Component" KeyColumn="1" />
      <Column Id="SourceName" Type="string" Width="255" Nullable="yes" Category="Text" />
      <Column Id="DestName" Type="string" Width="255" Nullable="yes" Category="Text" />
      <Column Id="SourceFolder" Type="string" Width="72" Nullable="yes" Category="Identifier" />
      <Column Id="DestFolder" Type="string" Width="72" Category="Identifier" KeyTable="Directory" KeyColumn="1" />
      <Column Id="Options" Type="int" Width="2" />
      <Row>
        <Data Column="FileKey">SD_MF_DEFAULTPROFILES</Data>
        <Data Column="Component_">C_DefaultProfiles</Data>
        <Data Column="SourceName">*.ini</Data>
        <Data Column="SourceFolder">DEFAULTPROFILES</Data>
        <Data Column="DestFolder">SD_CAD_PROFILES</Data>
        <Data Column="Options">0</Data>
      </Row>
    </CustomTable>

    <!-- Dialog set (04 §6.7, 04 §8.4): the WixUI_FeatureTree flow with an options page after the feature tree. The dialogs
         are the stock WixUI_Common ones (ids and loc.* strings of packaging/msi/wixui/dialog-set.txt); the flow is ours.
         Install: Welcome, License (the repository LICENSE), Customize (features), Options (DOKANY, ENABLELINKEDCONNECTIONS),
         Verify, Progress, Exit. Maintenance (Add/Remove Programs "Change", msiexec /i): MaintenanceWelcome, MaintenanceType
         (Change, Repair, Remove); Change goes through Customize and Options, Repair and Remove go to Verify. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SD_LICENSE_RTF)" />
    <UI Id="ShellDriveUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="FeatureTree" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="!(loc.OptionsWindowTitle)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}!(loc.OptionsTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.OptionsDescription)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="DokanyCheckBox" Type="CheckBox" X="20" Y="62" Width="330" Height="18" CheckBoxValue="1" Property="SD_UI_DOKANY"
                 Text="!(loc.OptionsDokanyCheckbox)" />
        <Control Id="DokanyHint" Type="Text" X="38" Y="82" Width="312" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.OptionsDokanyHint)" />
        <Control Id="LinkedConnectionsCheckBox" Type="CheckBox" X="20" Y="130" Width="330" Height="18" CheckBoxValue="1"
                 Property="SD_UI_ELC" Text="!(loc.OptionsLinkedCheckbox)" />
        <Control Id="LinkedConnectionsHint" Type="Text" X="38" Y="150" Width="312" Height="48" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.OptionsLinkedHint)" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg">LicenseAccepted = "1"</Publish>

      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1">Installed</Publish>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="2">NOT Installed</Publish>
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="OptionsDlg">1</Publish>

      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg">1</Publish>
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="1">NOT Installed OR WixUI_InstallMode = "Change"</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3">Installed AND PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>

      <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="CustomizeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>

  <?include Registry.wxi?>
</Wix>
