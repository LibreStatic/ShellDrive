# ShellDrive CLI strings, German (informal imperative).
msgid ""
msgstr ""
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "cli.version"
msgid "ShellDrive {version}"
msgstr "ShellDrive {version}"

msgctxt "cli.usage"
msgid "Usage: shelldrive <command> [options]"
msgstr "Verwendung: shelldrive <Befehl> [Optionen]"

msgctxt "cli.unknown_command"
msgid "Unknown command: {command}. Run \"shelldrive --help\" for help."
msgstr "Unbekannter Befehl: {command}. Führe \"shelldrive --help\" aus, um die Hilfe anzuzeigen."

msgctxt "cli.mounted_count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} Laufwerk eingebunden."
msgstr[1] "{count} Laufwerke eingebunden."

msgctxt "cli.help.commands"
msgid "Commands:"
msgstr "Befehle:"

msgctxt "cli.help.options"
msgid "Options:"
msgstr "Optionen:"

msgctxt "cli.help.global_options"
msgid "Global options:"
msgstr "Globale Optionen:"

msgctxt "cli.help.mount"
msgid "Mount a profile or a server as a drive."
msgstr "Bindet ein Profil oder einen Server als Laufwerk ein."

msgctxt "cli.help.unmount"
msgid "Unmount a drive, or every drive with --all."
msgstr "Trennt ein Laufwerk oder mit --all alle Laufwerke."

msgctxt "cli.help.list"
msgid "List the drives mounted in this session."
msgstr "Zeigt die in dieser Sitzung eingebundenen Laufwerke an."

msgctxt "cli.help.agent_stop"
msgid "Stop the ShellDrive agent of this session and unmount its drives."
msgstr "Beendet den ShellDrive-Agenten dieser Sitzung und trennt seine Laufwerke."

msgctxt "cli.help.version"
msgid "Show the version."
msgstr "Zeigt die Version an."

msgctxt "cli.help.help"
msgid "Show help for a command."
msgstr "Zeigt die Hilfe zu einem Befehl an."

msgctxt "cli.help.more"
msgid "Run \"shelldrive help <command>\" to see the options of a command."
msgstr "Führe \"shelldrive help <Befehl>\" aus, um die Optionen eines Befehls zu sehen."

msgctxt "cli.help.opt_host"
msgid "Server to connect to, with an optional user name and port."
msgstr "Server, mit dem die Verbindung hergestellt wird, mit optionalem Benutzernamen und Port."

msgctxt "cli.help.opt_letter"
msgid "Drive letter to use, for example Z:. By default the first free letter from Z: down."
msgstr "Zu verwendender Laufwerksbuchstabe, zum Beispiel Z:. Standard: der erste freie Buchstabe ab Z: abwärts."

msgctxt "cli.help.opt_identity"
msgid "Private key file to sign in with."
msgstr "Private Schlüsseldatei für die Anmeldung."

msgctxt "cli.help.opt_remote_path"
msgid "Folder on the server to show in the drive. By default your home folder."
msgstr "Ordner auf dem Server, der im Laufwerk angezeigt wird. Standard: dein Basisordner."

msgctxt "cli.help.opt_read_only"
msgid "Mount the drive read-only."
msgstr "Bindet das Laufwerk schreibgeschützt ein."

msgctxt "cli.help.opt_prompt"
msgid "How to ask for passwords and confirmations: auto, console or none."
msgstr "Wie nach Passwörtern und Bestätigungen gefragt wird: auto, console oder none."

msgctxt "cli.help.opt_stdin"
msgid "Read the answers to questions from standard input, one per line."
msgstr "Liest die Antworten auf Fragen von der Standardeingabe, eine pro Zeile."

msgctxt "cli.help.opt_no_wait"
msgid "Return as soon as the mount has started."
msgstr "Kehrt zurück, sobald das Einbinden begonnen hat."

msgctxt "cli.help.opt_all"
msgid "Unmount every drive of this session."
msgstr "Trennt alle Laufwerke dieser Sitzung."

msgctxt "cli.help.opt_json"
msgid "Print the result as JSON."
msgstr "Gibt das Ergebnis als JSON aus."

msgctxt "cli.help.opt_quiet"
msgid "Print only errors."
msgstr "Gibt nur Fehler aus."

msgctxt "cli.help.opt_lang"
msgid "Language of the messages: en, es, fr, pt, it or de."
msgstr "Sprache der Meldungen: en, es, fr, pt, it oder de."

msgctxt "cli.err.unknown_option"
msgid "Unknown option: {option}."
msgstr "Unbekannte Option: {option}."

msgctxt "cli.err.missing_value"
msgid "The option {option} needs a value."
msgstr "Die Option {option} braucht einen Wert."

msgctxt "cli.err.missing_argument"
msgid "The command \"{command}\" needs more arguments."
msgstr "Für den Befehl \"{command}\" fehlen Argumente."

msgctxt "cli.err.extra_argument"
msgid "Unexpected argument: {argument}."
msgstr "Unerwartetes Argument: {argument}."

msgctxt "cli.err.bad_value"
msgid "Invalid value for {option}: {value}."
msgstr "Ungültiger Wert für {option}: {value}."

msgctxt "cli.err.conflict"
msgid "{option} cannot be used together with {other}."
msgstr "{option} kann nicht zusammen mit {other} verwendet werden."

msgctxt "cli.err.host_spec"
msgid "Invalid server: {value}. Use [user@]host[:port]."
msgstr "Ungültiger Server: {value}. Verwende [benutzer@]host[:port]."

msgctxt "cli.err.see_help"
msgid "Run \"shelldrive help {command}\" for help."
msgstr "Führe \"shelldrive help {command}\" aus, um die Hilfe anzuzeigen."

msgctxt "cli.mount.connecting"
msgid "Connecting to {host}..."
msgstr "Verbindung mit {host} wird hergestellt..."

msgctxt "cli.mount.done"
msgid "Mounted {name} on {target}."
msgstr "{name} ist als {target} eingebunden."

msgctxt "cli.mount.started"
msgid "Mounting {name} on {target}."
msgstr "{name} wird als {target} eingebunden."

msgctxt "cli.unmount.done"
msgid "Unmounted {target}."
msgstr "{target} wurde getrennt."

msgctxt "cli.list.empty"
msgid "No drives are mounted."
msgstr "Es sind keine Laufwerke eingebunden."

msgctxt "cli.list.col_drive"
msgid "Drive"
msgstr "Laufwerk"

msgctxt "cli.list.col_state"
msgid "State"
msgstr "Status"

msgctxt "cli.list.col_server"
msgid "Server"
msgstr "Server"

msgctxt "cli.list.col_profile"
msgid "Profile"
msgstr "Profil"

msgctxt "cli.state.connecting"
msgid "connecting"
msgstr "verbinden"

msgctxt "cli.state.authenticating"
msgid "signing in"
msgstr "anmelden"

msgctxt "cli.state.mounted"
msgid "mounted"
msgstr "eingebunden"

msgctxt "cli.state.offline"
msgid "offline"
msgstr "offline"

msgctxt "cli.state.auth_required"
msgid "sign-in required"
msgstr "Anmeldung nötig"

msgctxt "cli.state.failed"
msgid "failed"
msgstr "fehlgeschlagen"

msgctxt "cli.state.unmounting"
msgid "unmounting"
msgstr "wird getrennt"

msgctxt "cli.state.unmounted"
msgid "unmounted"
msgstr "getrennt"

msgctxt "cli.agent.stopped"
msgid "The ShellDrive agent stopped."
msgstr "Der ShellDrive-Agent wurde beendet."

msgctxt "cli.agent.not_running"
msgid "The ShellDrive agent is not running."
msgstr "Der ShellDrive-Agent läuft nicht."

msgctxt "cli.hk.unknown"
msgid "The authenticity of host '{host}' (port {port}) can't be established."
msgstr "Die Echtheit des Hosts '{host}' (Port {port}) kann nicht festgestellt werden."

msgctxt "cli.hk.fingerprint"
msgid "{type} key fingerprint: {fingerprint}"
msgstr "Fingerabdruck des {type}-Schlüssels: {fingerprint}"

msgctxt "cli.hk.check_hint"
msgid "Compare the fingerprint with the one the server's administrator gave you."
msgstr "Vergleiche den Fingerabdruck mit dem, den du vom Administrator des Servers bekommen hast."

msgctxt "cli.hostkey_default_no"
msgid "Trust this key? [y]es, [o]nce, [N]o: "
msgstr "Diesem Schlüssel vertrauen? [j]a, [e]inmal, [N]ein: "

msgctxt "cli.hk.letter_yes"
msgid "y"
msgstr "j"

msgctxt "cli.hk.letter_once"
msgid "o"
msgstr "e"

msgctxt "cli.hk.word_yes"
msgid "yes"
msgstr "ja"

msgctxt "cli.hk.word_once"
msgid "once"
msgstr "einmal"

msgctxt "prompt.hostkey_just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Du hast gerade die Identität dieses Servers akzeptiert. ShellDrive hat dein gespeichertes Passwort nicht automatisch gesendet."

msgctxt "cli.prompt.password"
msgid "Password for {user}@{host}: "
msgstr "Passwort für {user}@{host}: "

msgctxt "cli.prompt.passphrase"
msgid "Passphrase for the key {key}: "
msgstr "Passphrase für den Schlüssel {key}: "

msgctxt "cli.prompt.retry"
msgid "The server did not accept the answer. Try again."
msgstr "Der Server hat die Antwort nicht akzeptiert. Versuche es noch einmal."

msgctxt "cli.prompt.server_says"
msgid "The server {host} asks:"
msgstr "Der Server {host} fragt:"

msgctxt "cli.hk.mismatch_stored"
msgid "Stored key: {type} {fingerprint} ({file}, line {line})"
msgstr "Gespeicherter Schlüssel: {type} {fingerprint} ({file}, Zeile {line})"

msgctxt "cli.hk.mismatch_offered"
msgid "Key offered now: {type} {fingerprint}"
msgstr "Jetzt angebotener Schlüssel: {type} {fingerprint}"

msgctxt "cli.hk.mismatch_hint"
msgid "If the server's key really changed, remove the old key from that file and connect again."
msgstr "Wenn sich der Schlüssel des Servers wirklich geändert hat, entferne den alten Schlüssel aus dieser Datei und verbinde dich erneut."

msgctxt "cli.error.auth_failed"
msgid "Signing in to {host} failed. Check the user name, the password or the key."
msgstr "Die Anmeldung bei {host} ist fehlgeschlagen. Prüfe den Benutzernamen, das Passwort oder den Schlüssel."

msgctxt "cli.error.prompt_required"
msgid "{host} needs a password or another answer, but ShellDrive was not allowed to ask. Run the command in a console or use --stdin."
msgstr "{host} braucht ein Passwort oder eine andere Antwort, aber ShellDrive durfte nicht nachfragen. Führe den Befehl in einer Konsole aus oder verwende --stdin."

msgctxt "cli.error.host_key_unknown"
msgid "The identity of {host} is not known yet, and ShellDrive was not allowed to ask you to confirm it. Run the command in a console to check the key."
msgstr "Die Identität von {host} ist noch nicht bekannt, und ShellDrive durfte dich nicht bitten, sie zu bestätigen. Führe den Befehl in einer Konsole aus, um den Schlüssel zu prüfen."

msgctxt "cli.error.host_key_rejected"
msgid "You did not trust the key of {host}. ShellDrive did not connect."
msgstr "Du hast dem Schlüssel von {host} nicht vertraut. ShellDrive hat keine Verbindung hergestellt."

msgctxt "cli.error.host_key_mismatch"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "Die Identität von {host} hat sich geändert. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.host_key_type_unavailable"
msgid "{host} did not offer the type of key ShellDrive knows for it. ShellDrive stopped the connection."
msgstr "{host} hat nicht den Schlüsseltyp angeboten, den ShellDrive für diesen Server kennt. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.host_key_revoked"
msgid "The key of {host} has been revoked. ShellDrive stopped the connection."
msgstr "Der Schlüssel von {host} wurde widerrufen. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.dns_failed"
msgid "The server name {host} could not be found."
msgstr "Der Servername {host} wurde nicht gefunden."

msgctxt "cli.error.conn_refused"
msgid "{host} refused the connection."
msgstr "{host} hat die Verbindung abgelehnt."

msgctxt "cli.error.net_unreachable"
msgid "{host} cannot be reached from this network."
msgstr "{host} ist aus diesem Netzwerk nicht erreichbar."

msgctxt "cli.error.connect_failed"
msgid "The connection to {host} failed."
msgstr "Die Verbindung mit {host} ist fehlgeschlagen."

msgctxt "cli.error.kex_failed"
msgid "ShellDrive and {host} could not agree on a secure connection."
msgstr "ShellDrive und {host} konnten sich nicht auf eine sichere Verbindung einigen."

msgctxt "cli.error.legacy_refused"
msgid "{host} only offers outdated encryption, which is turned off."
msgstr "{host} bietet nur veraltete Verschlüsselung an, die ausgeschaltet ist."

msgctxt "cli.error.bad_passphrase"
msgid "The passphrase of the key is wrong."
msgstr "Die Passphrase des Schlüssels ist falsch."

msgctxt "cli.error.key_format"
msgid "The key file could not be read."
msgstr "Die Schlüsseldatei konnte nicht gelesen werden."

msgctxt "cli.error.timeout"
msgid "The operation took too long and was stopped."
msgstr "Der Vorgang hat zu lange gedauert und wurde abgebrochen."

msgctxt "cli.error.cancelled"
msgid "Cancelled."
msgstr "Abgebrochen."

msgctxt "cli.error.agent_unavailable"
msgid "The ShellDrive agent is not running and could not be started."
msgstr "Der ShellDrive-Agent läuft nicht und konnte nicht gestartet werden."

msgctxt "cli.error.agent_untrusted"
msgid "Another program is using the name of the ShellDrive agent. ShellDrive did not connect to it."
msgstr "Ein anderes Programm verwendet den Namen des ShellDrive-Agenten. ShellDrive hat sich nicht damit verbunden."

msgctxt "cli.error.access_denied"
msgid "Access denied."
msgstr "Zugriff verweigert."

msgctxt "cli.error.proto_unsupported"
msgid "This shelldrive version does not match the running ShellDrive agent. Run \"shelldrive agent stop\" and try again."
msgstr "Diese shelldrive-Version passt nicht zum laufenden ShellDrive-Agenten. Führe \"shelldrive agent stop\" aus und versuche es erneut."

msgctxt "cli.error.profile_not_found"
msgid "There is no profile named {name}."
msgstr "Es gibt kein Profil mit dem Namen {name}."

msgctxt "cli.error.mount_not_found"
msgid "No ShellDrive drive matches {name}."
msgstr "Kein ShellDrive-Laufwerk passt zu {name}."

msgctxt "cli.error.target_in_use"
msgid "The drive letter {target} is already in use."
msgstr "Der Laufwerksbuchstabe {target} wird bereits verwendet."

msgctxt "cli.error.invalid_target"
msgid "Invalid drive letter: {value}. Use a letter from D: to Z:."
msgstr "Ungültiger Laufwerksbuchstabe: {value}. Verwende einen Buchstaben von D: bis Z:."

msgctxt "cli.error.already_mounted"
msgid "This profile is already mounted."
msgstr "Dieses Profil ist bereits eingebunden."

msgctxt "cli.error.backend_unavailable"
msgid "Dokany is not installed, so ShellDrive cannot create the drive. Install Dokany 2.1 or later."
msgstr "Dokany ist nicht installiert, daher kann ShellDrive das Laufwerk nicht erstellen. Installiere Dokany 2.1 oder neuer."

msgctxt "cli.error.generic"
msgid "The operation failed ({code})."
msgstr "Der Vorgang ist fehlgeschlagen ({code})."

msgctxt "cli.help.opt_backend"
msgid "Drive backend: auto (Dokany when it is installed, otherwise WebDAV), dokany or webdav."
msgstr "Laufwerks-Backend: auto (Dokany, wenn installiert, sonst WebDAV), dokany oder webdav."

msgctxt "cli.error.webclient_disabled"
msgid "The WebClient service is disabled, so ShellDrive cannot create a WebDAV drive. An administrator can enable it with: sc config WebClient start= demand"
msgstr "Der Dienst WebClient ist deaktiviert, daher kann ShellDrive kein WebDAV-Laufwerk erstellen. Ein Administrator kann ihn so aktivieren: sc config WebClient start= demand"

msgctxt "cli.error.webdav_unavailable"
msgid "The Windows WebDAV client (WebClient service) is not installed or could not be started. An administrator can start it with: sc start WebClient. On Windows Server, add the WebDAV Redirector feature first."
msgstr "Der Windows-WebDAV-Client (Dienst WebClient) ist nicht installiert oder konnte nicht gestartet werden. Ein Administrator kann ihn so starten: sc start WebClient. Unter Windows Server füge zuerst das Feature WebDAV Redirector hinzu."

msgctxt "cli.state.reconnecting"
msgid "reconnecting"
msgstr "verbindet neu"

msgctxt "cli.list.write_failed"
msgid "On {target}, {count} file could not be saved on the server (last: {path})."
msgid_plural "On {target}, {count} files could not be saved on the server (last: {path})."
msgstr[0] "Auf {target} konnte {count} Datei nicht auf dem Server gespeichert werden (zuletzt: {path})."
msgstr[1] "Auf {target} konnten {count} Dateien nicht auf dem Server gespeichert werden (zuletzt: {path})."

#. ---- M2: status, profile import, hostkey commands, mount options and the new prompts ----

#. Summary of the status command.
msgctxt "cli.help.status"
msgid "Show the detailed state of the mounted drives."
msgstr "Zeigt den detaillierten Zustand der eingebundenen Laufwerke an."

#. Summary of "profile import".
msgctxt "cli.help.profile_import"
msgid "Import profiles from PuTTY sessions or an OpenSSH ssh_config file."
msgstr "Importiert Profile aus PuTTY-Sitzungen oder einer OpenSSH-ssh_config-Datei."

#. Summary of the hostkey command.
msgctxt "cli.help.hostkey"
msgid "Show, import or remove stored host keys, and apply announced key updates."
msgstr "Zeigt gespeicherte Host-Schlüssel an, importiert oder entfernt sie und wendet angekündigte Schlüsselaktualisierungen an."

#. Help for --jump HOST. The value syntax is literal.
msgctxt "cli.help.opt_jump"
msgid "A server to connect through before the target, as [user@]host[:port]. Repeat the option for several hops."
msgstr "Ein Server, über den vor dem Ziel verbunden wird, als [benutzer@]host[:port]. Wiederhole die Option für mehrere Sprünge."

#. Help for --proxy SPEC. The value syntax and the scheme names are literal.
msgctxt "cli.help.opt_proxy"
msgid "Proxy for the first leg: http://[user@]host[:port] or socks5://[user@]host[:port]."
msgstr "Proxy für den ersten Abschnitt: http://[benutzer@]host[:port] oder socks5://[benutzer@]host[:port]."

#. Help for --connections N. States the pool rule (D18): extra connections only with non-interactive auth.
msgctxt "cli.help.opt_connections"
msgid "How many connections to the server to use at once, from 1 to 4. More than one is only reached when signing in needs no typed answer."
msgstr "Wie viele Verbindungen zum Server gleichzeitig verwendet werden, von 1 bis 4. Mehr als eine wird nur erreicht, wenn die Anmeldung keine getippte Antwort braucht."

#. Help for hostkey remove --type T.
msgctxt "cli.help.opt_type"
msgid "Remove only the stored key of this type, for example ssh-ed25519."
msgstr "Entfernt nur den gespeicherten Schlüssel dieses Typs, zum Beispiel ssh-ed25519."

#. Help for hostkey import --from. putty and openssh are literal values.
msgctxt "cli.help.opt_from"
msgid "Where to copy host keys from: putty (the registry) or openssh (a known_hosts file)."
msgstr "Woher die Host-Schlüssel kopiert werden: putty (die Registrierung) oder openssh (eine known_hosts-Datei)."

#. Help for hostkey accept-announced --add-only.
msgctxt "cli.help.opt_add_only"
msgid "Add the new keys, but keep the keys the server no longer offers."
msgstr "Fügt die neuen Schlüssel hinzu, behält aber die Schlüssel, die der Server nicht mehr anbietet."

#. Help for hostkey list --announced.
msgctxt "cli.help.opt_announced"
msgid "Show the host key updates that servers announced and that wait for review."
msgstr "Zeigt die Host-Schlüssel-Aktualisierungen an, die Server angekündigt haben und die auf eine Prüfung warten."

#. Help for --dry-run.
msgctxt "cli.help.opt_dry_run"
msgid "Show what would be imported without writing anything."
msgstr "Zeigt an, was importiert würde, ohne etwas zu schreiben."

#. Detail line of shelldrive status; {state} is a connection state word such as ready.
msgctxt "cli.status.conn"
msgid "Connection: {state}"
msgstr "Verbindung: {state}"

#. Detail line of shelldrive status.
msgctxt "cli.status.pool"
msgid "Connections in use: {count} of {wanted}."
msgstr "Verbindungen in Gebrauch: {count} von {wanted}."

#. Detail line of shelldrive status: automatic reconnects after losses.
msgctxt "cli.status.reconnects"
msgid "Reconnected {count} times."
msgstr "Erneut verbunden: {count} mal."

#. Detail line of shelldrive status; {reason} is an English error identifier.
msgctxt "cli.status.reason"
msgid "The connection was lost ({reason})."
msgstr "Die Verbindung ging verloren ({reason})."

#. profile import summary with --dry-run.
#, plural-arg=count
msgctxt "cli.pi.found"
msgid "{count} profile found. Nothing was written (--dry-run)."
msgid_plural "{count} profiles found. Nothing was written (--dry-run)."
msgstr[0] "{count} Profil gefunden. Es wurde nichts geschrieben (--dry-run)."
msgstr[1] "{count} Profile gefunden. Es wurde nichts geschrieben (--dry-run)."

#. profile import summary.
#, plural-arg=count
msgctxt "cli.pi.imported"
msgid "{count} profile imported."
msgid_plural "{count} profiles imported."
msgstr[0] "{count} Profil importiert."
msgstr[1] "{count} Profile importiert."

#. profile import of a source with no usable entries.
msgctxt "cli.pi.empty"
msgid "Nothing to import."
msgstr "Nichts zu importieren."

#. Note column of the profile import table.
msgctxt "cli.pi.note_duplicate"
msgid "a profile for this server already exists"
msgstr "für diesen Server existiert bereits ein Profil"

#. Note column of the profile import table (D37).
msgctxt "cli.pi.note_only_this_key"
msgid "the imported key would be the only one offered"
msgstr "der importierte Schlüssel wäre der einzige angebotene"

#. Note column of the profile import table.
msgctxt "cli.pi.note_proxy_skipped"
msgid "its proxy type is not supported"
msgstr "der Proxy-Typ wird nicht unterstützt"

#. Note column of the profile import table.
msgctxt "cli.pi.note_name_changed"
msgid "renamed because the name was taken"
msgstr "umbenannt, weil der Name bereits vergeben war"

#. profile import: an ssh_config keyword that has no ShellDrive equivalent (3.7). {item} is the keyword.
msgctxt "cli.pi.skip_keyword"
msgid "{source}: the {item} lines are not imported."
msgstr "{source}: die {item}-Zeilen werden nicht importiert."

#. profile import: same, for global lines (no Host section).
msgctxt "cli.pi.skip_keyword_global"
msgid "The {item} lines are not imported."
msgstr "Die {item}-Zeilen werden nicht importiert."

#. profile import: a PuTTY session of another protocol. {item} is the protocol.
msgctxt "cli.pi.skip_not_ssh"
msgid "{source}: the session is not SSH ({item})."
msgstr "{source}: die Sitzung ist kein SSH ({item})."

#. profile import: a PuTTY proxy type without an equivalent (D20). {item} is the method.
msgctxt "cli.pi.skip_proxy"
msgid "{source}: the proxy type ({item}) is not supported."
msgstr "{source}: der Proxy-Typ ({item}) wird nicht unterstützt."

#. profile import: an unusable entry.
msgctxt "cli.pi.skip_invalid"
msgid "{source}: unusable entry ({item})."
msgstr "{source}: unbrauchbarer Eintrag ({item})."

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_store"
msgid "Store"
msgstr "Speicher"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_type"
msgid "Type"
msgstr "Typ"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_fp"
msgid "Fingerprint"
msgstr "Fingerabdruck"

#. hostkey list of a host with no stored key.
msgctxt "cli.hk.list_empty"
msgid "No host key is stored for {host}."
msgstr "Für {host} ist kein Host-Schlüssel gespeichert."

#. hostkey list stopped early because there are very many keys.
msgctxt "cli.hk.list_truncated"
msgid "The list was cut short; refine the host name to see the rest."
msgstr "Die Liste wurde gekürzt; grenze den Hostnamen weiter ein, um den Rest zu sehen."

#. hostkey remove.
msgctxt "cli.hk.removed"
msgid "Removed the stored keys of {host}."
msgstr "Die gespeicherten Schlüssel von {host} wurden entfernt."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.imported"
msgid "{count} host key imported."
msgid_plural "{count} host keys imported."
msgstr[0] "{count} Host-Schlüssel importiert."
msgstr[1] "{count} Host-Schlüssel importiert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_kept"
msgid "{count} key was already stored."
msgid_plural "{count} keys were already stored."
msgstr[0] "{count} Schlüssel war bereits gespeichert."
msgstr[1] "{count} Schlüssel waren bereits gespeichert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_conflicts"
msgid "{count} key conflicts with a stored key and was not imported."
msgid_plural "{count} keys conflict with stored keys and were not imported."
msgstr[0] "{count} Schlüssel steht im Konflikt mit einem gespeicherten Schlüssel und wurde nicht importiert."
msgstr[1] "{count} Schlüssel stehen im Konflikt mit gespeicherten Schlüsseln und wurden nicht importiert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_invalid"
msgid "{count} line could not be read."
msgid_plural "{count} lines could not be read."
msgstr[0] "{count} Zeile konnte nicht gelesen werden."
msgstr[1] "{count} Zeilen konnten nicht gelesen werden."

#. hostkey import of a source without keys.
msgctxt "cli.hk.import_empty"
msgid "The source has no host keys."
msgstr "Die Quelle enthält keine Host-Schlüssel."

#. hostkey list --announced with nothing pending.
msgctxt "cli.hk.announced_none"
msgid "There are no host key updates to review."
msgstr "Es gibt keine Host-Schlüssel-Aktualisierungen zu prüfen."

#. hostkey list --announced, one pending update. {id} is the id for accept-announced.
msgctxt "cli.hk.announced_item"
msgid "{id}: {host} offered new host keys."
msgstr "{id}: {host} hat neue Host-Schlüssel angeboten."

#. One key a server added to its announcement (5.6).
msgctxt "cli.hk.announced_add"
msgid "New key: {type} {fingerprint}"
msgstr "Neuer Schlüssel: {type} {fingerprint}"

#. One key a server no longer offers (5.6).
msgctxt "cli.hk.announced_remove"
msgid "No longer offered: {type} {fingerprint}"
msgstr "Nicht mehr angeboten: {type} {fingerprint}"

#. hostkey accept-announced.
msgctxt "cli.hk.announced_applied"
msgid "Updated the host keys of {host}: {added} added, {removed} removed."
msgstr "Die Host-Schlüssel von {host} wurden aktualisiert (hinzugefügt: {added}; entfernt: {removed})."

#. Introduction of the password-change questions (2.5, PASSWD_CHANGEREQ).
msgctxt "cli.prompt.password_change"
msgid "The server {host} asks to change the password."
msgstr "Der Server {host} bittet darum, das Passwort zu ändern."

#. Proxy password prompt; input is hidden.
msgctxt "cli.prompt.proxy_password"
msgid "Password for the proxy {user}@{proxy_host}:{proxy_port}: "
msgstr "Passwort für den Proxy {user}@{proxy_host}:{proxy_port}: "

#. The legacy-algorithms question (2.5, C21); {algorithms} is a comma list of algorithm names.
msgctxt "cli.prompt.legacy_ack"
msgid "The server {host} uses outdated encryption ({algorithms})."
msgstr "Der Server {host} verwendet veraltete Verschlüsselung ({algorithms})."

#. The legacy-algorithms question; the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.legacy_ack_question"
msgid "Continue anyway? [y]es, [N]o: "
msgstr "Trotzdem fortfahren? [j]a, [N]ein: "

#. Shown for hop i >= 1 of a jump chain (TM-R03). {host} is the previous hop.
msgctxt "cli.prompt.via"
msgid "Reached through jump host {host}."
msgstr "Verbindung über den Jump-Host {host} hergestellt."

#. Shown for every prompt of a jump chain. {host} is the hop's server.
msgctxt "cli.prompt.hop"
msgid "Jump host {hop} of {hops}: {host}"
msgstr "Jump-Host {hop} von {hops}: {host}"

#. Save question after a password, passphrase or proxy password (4.2); the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.save"
msgid "Save the answer for the next connection? [y]es, [N]o: "
msgstr "Antwort für die nächste Verbindung speichern? [j]a, [N]ein: "

#. Credential Manager comment for a saved secret (4.2). {name} is the profile name.
msgctxt "cli.save.comment"
msgid "Saved by ShellDrive for {name}"
msgstr "Von ShellDrive für {name} gespeichert"

msgctxt "cli.error.host_key_not_found"
msgid "No host key of {host} is stored in your ShellDrive store."
msgstr "Es ist kein Schlüssel von {host} in deinem ShellDrive-Speicher gespeichert."

msgctxt "cli.error.announcement_not_found"
msgid "There is no pending host key update with this id."
msgstr "Es gibt keine ausstehende Host-Schlüssel-Aktualisierung mit dieser Kennung."

msgctxt "cli.error.session_not_found"
msgid "There is no PuTTY session named {name}."
msgstr "Es gibt keine PuTTY-Sitzung mit dem Namen {name}."

msgctxt "cli.error.putty_not_found"
msgid "PuTTY is not installed, or it has no saved sessions."
msgstr "PuTTY ist nicht installiert oder hat keine gespeicherten Sitzungen."

msgctxt "cli.error.file_not_found"
msgid "The file {name} could not be read."
msgstr "Die Datei {name} konnte nicht gelesen werden."

#. M3: refresh, cache clear, profile test, status --stats and the new mount option.
#. Exit code 3: the drive has no file system to refresh.
msgctxt "cli.error.not_mounted"
msgid "The drive is not mounted, so there is nothing to refresh."
msgstr "Das Laufwerk ist nicht verbunden, es gibt also nichts zu aktualisieren."

#. Exit code 8: write-behind data is queued and the cache clear was refused.
msgctxt "cli.error.write_behind_pending"
msgid "Changes are still waiting to be written to the server, so the cache was not cleared. Run the command again with --force to clear the rest; the waiting changes are kept."
msgstr "Es warten noch Änderungen darauf, auf den Server geschrieben zu werden, daher wurde der Cache nicht geleert. Führe den Befehl mit --force erneut aus, um den Rest zu leeren; die wartenden Änderungen bleiben erhalten."

#. Printed by shelldrive refresh. {path} is the drive and the folder, such as W: or W:\docs.
msgctxt "cli.refresh.done"
msgid "Refreshed the cache of {path}."
msgstr "Der Cache von {path} wurde aktualisiert."

#. Printed by shelldrive cache clear. {count} is the number of drives whose cache was cleared.
#, plural-arg=count
msgctxt "cli.cache.cleared"
msgid "Cleared the cache of {count} drive."
msgid_plural "Cleared the cache of {count} drives."
msgstr[0] "Der Cache von {count} Laufwerk wurde geleert."
msgstr[1] "Der Cache von {count} Laufwerken wurde geleert."

#. Printed by status --stats for a drive without a connection.
msgctxt "cli.stats.none"
msgid "No statistics: the drive has no connection."
msgstr "Keine Statistik: Das Laufwerk hat keine Verbindung."

#. Heading of one drive in status --stats. {target} is the drive, {name} the profile.
msgctxt "cli.stats.header"
msgid "{target} {name}"
msgstr "{target} {name}"

#. status --stats: the session line. Round trip in milliseconds; generation counts the reconnects.
msgctxt "cli.stats.session"
msgid "Connection: round trip {srtt} ms, {inflight} requests in flight, {queued} queued, session generation {generation}."
msgstr "Verbindung: Umlaufzeit {srtt} ms, {inflight} Anfragen in Bearbeitung, {queued} in der Warteschlange, Sitzungsgeneration {generation}."

#. status --stats: bytes received and sent by the current connection.
msgctxt "cli.stats.transfer"
msgid "Transferred {rx} bytes in and {tx} bytes out."
msgstr "Übertragen: {rx} Byte empfangen und {tx} Byte gesendet."

#. status --stats: the cache counters of the drive (memory and disk tiers).
msgctxt "cli.stats.cache"
msgid "Cache: {hits} hits, {misses} misses, {failed} failed writes, {queued} bytes waiting for write-behind."
msgstr "Cache: {hits} Treffer, {misses} Fehlzugriffe, {failed} fehlgeschlagene Schreibvorgänge, {queued} Byte warten auf verzögertes Schreiben."

#. profile test: the result line. {path} is the resolved remote folder.
msgctxt "cli.test.ok"
msgid "{name} works: connected to {host} as {user}, and the remote path is {path}."
msgstr "{name} funktioniert: Verbindung zu {host} als {user} hergestellt, der Remote-Pfad ist {path}."

#. profile test: the host key that was verified.
msgctxt "cli.test.hostkey"
msgid "Host key: {fingerprint}."
msgstr "Host-Schlüssel: {fingerprint}."

#. profile test: the negotiated algorithms (key exchange, host key, cipher and MAC of the client-to-server direction).
msgctxt "cli.test.algorithms"
msgid "Algorithms: key exchange {kex}, host key {hostkey}, cipher {cipher}, MAC {mac}."
msgstr "Algorithmen: Schlüsselaustausch {kex}, Host-Schlüssel {hostkey}, Verschlüsselung {cipher}, MAC {mac}."

#. profile test: an outdated algorithm was negotiated on some hop.
msgctxt "cli.test.legacy"
msgid "The server negotiated an outdated algorithm. security.legacy_algorithms decides what happens next."
msgstr "Der Server hat einen veralteten Algorithmus ausgehandelt. security.legacy_algorithms legt fest, was danach geschieht."

#. Help of the mount option --open.
msgctxt "cli.help.opt_open"
msgid "Open the drive in Explorer once it is mounted."
msgstr "Öffne das Laufwerk im Explorer, sobald es verbunden ist."

#. Help of the status option --stats.
msgctxt "cli.help.opt_stats"
msgid "Also show the connection and cache counters of each drive."
msgstr "Zeige zusätzlich die Zähler für Verbindung und Cache jedes Laufwerks."

#. Help of the cache clear option --force.
msgctxt "cli.help.opt_force"
msgid "Clear the cache even while changes are waiting to be written. The waiting changes are kept."
msgstr "Leere den Cache auch, während Änderungen auf das Schreiben warten. Die wartenden Änderungen bleiben erhalten."

#. Summary of the refresh command.
msgctxt "cli.help.refresh"
msgid "Drop the cached attributes and listings of a folder, or of the whole drive."
msgstr "Verwirf die zwischengespeicherten Attribute und Listen eines Ordners oder des ganzen Laufwerks."

#. Summary of the cache command.
msgctxt "cli.help.cache"
msgid "Clear the cache of a profile, a drive or every mounted drive."
msgstr "Leere den Cache eines Profils, eines Laufwerks oder aller verbundenen Laufwerke."

#. Summary of profile test.
msgctxt "cli.help.profile_test"
msgid "Connect and sign in, then resolve the remote path, without mounting anything."
msgstr "Verbinde dich und melde dich an, löse dann den Remote-Pfad auf, ohne etwas einzubinden."

msgctxt "cli.help.service"
msgid "Global drives (shared by every session) and the ShellDrive service: list, mount, unmount, status, install, uninstall, start, stop and repair-data. Changing them needs an elevated console."
msgstr "Globale Laufwerke (für alle Sitzungen gemeinsam) und der ShellDrive-Dienst: list, mount, unmount, status, install, uninstall, start, stop und repair-data. Zum Ändern ist eine erhöhte Konsole nötig."

msgctxt "cli.service.need_admin"
msgid "Changing global drives needs an elevated console. Run it as administrator."
msgstr "Zum Ändern globaler Laufwerke ist eine erhöhte Konsole nötig. Starte das Programm als Administrator."

msgctxt "cli.service.unavailable"
msgid "The ShellDrive service is not running or not installed."
msgstr "Der ShellDrive-Dienst läuft nicht oder ist nicht installiert."

msgctxt "cli.service.none"
msgid "No global drives are mounted."
msgstr "Es sind keine globalen Laufwerke eingebunden."

msgctxt "cli.service.list_item"
msgid "{target}  {label}  {state}"
msgstr "{target}  {label}  {state}"

msgctxt "cli.service.connecting"
msgid "Connecting {target}..."
msgstr "Verbindung zu {target} wird hergestellt..."

msgctxt "cli.service.mounted"
msgid "{target} is mounted."
msgstr "{target} ist eingebunden."

msgctxt "cli.service.unmounting"
msgid "Unmounting {name}..."
msgstr "{name} wird ausgehängt..."

msgctxt "cli.service.state.connecting"
msgid "connecting"
msgstr "verbindet"

msgctxt "cli.service.state.mounted"
msgid "mounted"
msgstr "eingebunden"

msgctxt "cli.service.state.failed"
msgid "failed"
msgstr "fehlgeschlagen"

msgctxt "cli.service.state.offline"
msgid "offline"
msgstr "offline"

msgctxt "cli.service.state.unmounting"
msgid "unmounting"
msgstr "wird ausgehängt"

#. Printed by "shelldrive service install" after the service is registered (exit 0).
msgctxt "cli.service.installed"
msgid "ShellDrive service installed."
msgstr "Der ShellDrive-Dienst wurde installiert."

#. Printed by "shelldrive service uninstall" after the service and its Event Log source are removed (exit 0).
msgctxt "cli.service.uninstalled"
msgid "ShellDrive service removed."
msgstr "Der ShellDrive-Dienst wurde entfernt."

#. Printed by "shelldrive service start" when the service is running (exit 0).
msgctxt "cli.service.started"
msgid "ShellDrive service started."
msgstr "Der ShellDrive-Dienst wurde gestartet."

#. Printed by "shelldrive service stop" when the service has stopped (exit 0).
msgctxt "cli.service.stopped"
msgid "ShellDrive service stopped."
msgstr "Der ShellDrive-Dienst wurde beendet."

#. Printed by "shelldrive service install" when the service already exists (exit 1).
msgctxt "cli.service.already_installed"
msgid "The ShellDrive service is already installed."
msgstr "Der ShellDrive-Dienst ist bereits installiert."

#. Printed by "shelldrive service uninstall, start or stop" when the service does not exist (exit 1).
msgctxt "cli.service.not_installed"
msgid "The ShellDrive service is not installed."
msgstr "Der ShellDrive-Dienst ist nicht installiert."

#. Printed by "shelldrive service start" when the service is already running (exit 1).
msgctxt "cli.service.already_running"
msgid "The ShellDrive service is already running."
msgstr "Der ShellDrive-Dienst läuft bereits."

#. Printed by "shelldrive service stop" when the service is not running (exit 1).
msgctxt "cli.service.not_running"
msgid "The ShellDrive service is not running."
msgstr "Der ShellDrive-Dienst läuft nicht."

#. Printed when the Windows Service Control Manager refuses a service verb (exit 1). {code} is the Win32 error number.
msgctxt "cli.service.scm_failed"
msgid "The Windows service manager refused the request (error {code})."
msgstr "Der Dienststeuerungs-Manager von Windows hat die Anfrage abgelehnt (Fehler {code})."

#. Description of ShellDriveSvc shown in the Services console; set at install time in the language of the installing console.
msgctxt "cli.service.description"
msgid "Mounts ShellDrive drives shared by every user of this computer. Stays idle while no global drive is configured."
msgstr "Bindet die ShellDrive-Laufwerke ein, die alle Benutzer dieses Computers gemeinsam nutzen. Er bleibt inaktiv, solange kein globales Laufwerk eingerichtet ist."

msgctxt "cli.service.status.not_installed"
msgid "The ShellDrive service is not installed."
msgstr "Der ShellDrive-Dienst ist nicht installiert."

msgctxt "cli.service.status.state_line"
msgid "Service state: {state}."
msgstr "Dienststatus: {state}."

msgctxt "cli.service.status.start_line"
msgid "Start type: {type}."
msgstr "Starttyp: {type}."

msgctxt "cli.service.status.program_line"
msgid "Program: {path}"
msgstr "Programm: {path}"

msgctxt "cli.service.status.program_ok"
msgid "The program path is quoted and points at this install."
msgstr "Der Programmpfad steht in Anführungszeichen und zeigt auf diese Installation."

msgctxt "cli.service.status.program_unquoted"
msgid "The program path is not quoted. Remove the service and install it again."
msgstr "Der Programmpfad hat keine Anführungszeichen. Entferne den Dienst und installiere ihn erneut."

msgctxt "cli.service.status.program_other"
msgid "The program path points at another install. Remove the service and install it again from this one."
msgstr "Der Programmpfad zeigt auf eine andere Installation. Entferne den Dienst und installiere ihn von dieser aus erneut."

msgctxt "cli.service.status.program_unknown"
msgid "The program path cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "Der Programmpfad kann nicht geprüft werden: shelldrive-host.exe liegt nicht neben diesem Programm."

msgctxt "cli.service.status.source_ok"
msgid "The Event Log source is registered for this install."
msgstr "Die Ereignisprotokollquelle ist für diese Installation registriert."

msgctxt "cli.service.status.source_missing"
msgid "The Event Log source is not registered."
msgstr "Die Ereignisprotokollquelle ist nicht registriert."

msgctxt "cli.service.status.source_other"
msgid "The Event Log source is registered for another program."
msgstr "Die Ereignisprotokollquelle ist für ein anderes Programm registriert."

msgctxt "cli.service.status.source_unknown"
msgid "The Event Log source cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "Die Ereignisprotokollquelle kann nicht geprüft werden: shelldrive-host.exe liegt nicht neben diesem Programm."

msgctxt "cli.service.status.pipe_down"
msgid "The service is running but does not answer on its pipe."
msgstr "Der Dienst läuft, antwortet aber nicht über seine Pipe."

msgctxt "cli.service.status.healthy"
msgid "The machine data folder is in order."
msgstr "Der Maschinen-Datenordner ist in Ordnung."

msgctxt "cli.service.status.idle"
msgid "The machine data folder is refused, so the service stays idle. Run \"shelldrive service repair-data\" as administrator."
msgstr "Der Maschinen-Datenordner wurde abgelehnt, daher bleibt der Dienst inaktiv. Führe \"shelldrive service repair-data\" als Administrator aus."

msgctxt "cli.service.status.prompts"
msgid "{count} administrator prompt waiting."
msgid_plural "{count} administrator prompts waiting."
msgstr[0] "{count} Administratorabfrage wartet."
msgstr[1] "{count} Administratorabfragen warten."

msgctxt "cli.service.svc_state.running"
msgid "running"
msgstr "läuft"

msgctxt "cli.service.svc_state.stopped"
msgid "stopped"
msgstr "beendet"

msgctxt "cli.service.svc_state.starting"
msgid "starting"
msgstr "startet"

msgctxt "cli.service.svc_state.stopping"
msgid "stopping"
msgstr "wird beendet"

msgctxt "cli.service.svc_state.paused"
msgid "paused"
msgstr "angehalten"

msgctxt "cli.service.svc_state.unknown"
msgid "unknown"
msgstr "unbekannt"

msgctxt "cli.service.start_type.automatic"
msgid "automatic"
msgstr "automatisch"

msgctxt "cli.service.start_type.manual"
msgid "manual"
msgstr "manuell"

msgctxt "cli.service.start_type.disabled"
msgid "disabled"
msgstr "deaktiviert"

msgctxt "cli.service.start_type.unknown"
msgid "unknown"
msgstr "unbekannt"

msgctxt "cli.service.repair.ok"
msgid "The machine data folder is in order. Its permissions were set again."
msgstr "Der Maschinen-Datenordner ist in Ordnung. Seine Berechtigungen wurden erneut gesetzt."

msgctxt "cli.service.repair.moved"
msgid "An untrusted machine data folder was moved to {path}. A new one was created. Nothing from the old folder is imported, so stored secrets and keys must be entered again."
msgstr "Der nicht vertrauenswürdige Maschinen-Datenordner wurde nach {path} verschoben. Ein neuer wurde angelegt. Aus dem alten Ordner wird nichts übernommen, daher musst du gespeicherte Geheimnisse und Schlüssel erneut eingeben."

msgctxt "cli.service.repair.refused"
msgid "{path} is a link or a junction, so nothing was changed. Remove it yourself, then run this command again."
msgstr "{path} ist ein Link oder eine Verbindung (Junction), daher wurde nichts geändert. Entferne ihn selbst und führe diesen Befehl dann erneut aus."

msgctxt "cli.service.repair.failed"
msgid "The machine data folder could not be repaired (error {code})."
msgstr "Der Maschinen-Datenordner konnte nicht repariert werden (Fehler {code})."

#. TM-R19 (03 7.5): asked before token-only WebDAV is used for one enable. Shown in the console.
msgctxt "cli.prompt.webdav_token_only"
msgid "Windows could not sign in to ShellDrive's local file server. Continue with a less protected connection? Other programs that learn the drive's address can then read your files."
msgstr "Windows konnte sich nicht am lokalen Dateiserver von ShellDrive anmelden. Mit einer weniger geschützten Verbindung fortfahren? Andere Programme, die die Adresse des Laufwerks kennen, können dann deine Dateien lesen."

#. Question for the token-only consent; the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.webdav_token_only_question"
msgid "Continue with a less protected connection? [y]es, [N]o: "
msgstr "Mit einer weniger geschützten Verbindung fortfahren? [j]a, [N]ein: "

#. Help for hostkey add --from-server. The value is host[:port].
msgctxt "cli.help.opt_from_server"
msgid "The server to take host keys from, as host[:port]. Its keys are checked against the stored ones first."
msgstr "Der Server, von dem die Host-Schlüssel geholt werden, als Host[:Port]. Seine Schlüssel werden zuerst mit den gespeicherten verglichen."

#. Help for hostkey add --expect. SHA256: is literal.
msgctxt "cli.help.opt_expect"
msgid "Accept the key only when its SHA-256 fingerprint is this value, for example SHA256:abc... Meant for scripts: a mismatch fails."
msgstr "Akzeptiert den Schlüssel nur, wenn sein SHA-256-Fingerabdruck dieser Wert ist, zum Beispiel SHA256:abc... Für Skripte gedacht: Bei Abweichung schlägt der Befehl fehl."

#. Help for --machine on hostkey add and accept-announced.
msgctxt "cli.help.opt_machine"
msgid "Work on the machine host keys (the service's store). Needs an elevated console."
msgstr "Arbeitet mit den Host-Schlüsseln des Rechners (dem Speicher des Dienstes). Erfordert eine erhöhte Konsole."

#. Printed when --machine is used from a console that is not elevated (exit 9).
msgctxt "cli.hk.need_admin"
msgid "Changing the machine host keys needs an elevated console. Run it as administrator."
msgstr "Das Ändern der Host-Schlüssel des Rechners erfordert eine erhöhte Konsole. Starte das Programm als Administrator."

#. Printed by hostkey add and accept-announced --machine until the service connect path exists (exit 1).
msgctxt "cli.hk.not_built"
msgid "Adding host keys from a server is not part of this build yet."
msgstr "Das Hinzufügen von Host-Schlüsseln von einem Server ist in dieser Version noch nicht enthalten."

#. Summary of the diag bench command (and of the bench alias), in --help. Literal syntax stays as it is.
msgctxt "cli.help.bench"
msgid "Measure a mounted drive: sequential transfers, small files and the latency of opening a file. The run uses a new folder on the drive and removes it afterwards."
msgstr "Miss ein eingebundenes Laufwerk: sequenzielle Übertragungen, kleine Dateien und die Latenz beim Öffnen einer Datei. Der Test legt auf dem Laufwerk einen neuen Ordner an und entfernt ihn danach."

#. Help for diag bench --scenario. The names are literal.
msgctxt "cli.help.opt_scenario"
msgid "Run one scenario: all (the default), seq-write, seq-write-64k, seq-read, small-files or open."
msgstr "Führt ein Szenario aus: all (Standard), seq-write, seq-write-64k, seq-read, small-files oder open."

#. Help for diag bench --size. MiB is a unit name.
msgctxt "cli.help.opt_size"
msgid "Size of each sequential transfer in MiB, from 1 to 4096. The default is 256; the targets of 02 section 11 use 1024."
msgstr "Größe jeder sequenziellen Übertragung in MiB, von 1 bis 4096. Standard ist 256; die Ziele aus 02 Abschnitt 11 nutzen 1024."

#. Help for diag bench --write-mode. through and behind are literal values.
msgctxt "cli.help.opt_write_mode"
msgid "The write mode to state in the report: through (the default) or behind. It is declared, not set: the mount keeps the setting of its profile."
msgstr "Der Schreibmodus, der im Bericht angegeben wird: through (Standard) oder behind. Er wird angegeben, nicht gesetzt: das Laufwerk behält die Einstellung seines Profils."

#. Printed by diag bench when the drive is read-only (exit 1). {target} is the drive letter, such as X:.
msgctxt "cli.bench.read_only"
msgid "{target} is read-only, so the benchmark did not run."
msgstr "{target} ist schreibgeschützt, daher wurde der Test nicht ausgeführt."

#. First line of the benchmark report. {size} is in MiB.
msgctxt "cli.bench.header"
msgid "Benchmark of {target}: {size} MiB per sequential transfer."
msgstr "Test von {target}: {size} MiB pro sequenzieller Übertragung."

#. Pool size line of the benchmark report, shown when an agent reports the mount.
#, plural-arg=count
msgctxt "cli.bench.pool"
msgid "{count} connection in the pool."
msgid_plural "{count} connections in the pool."
msgstr[0] "{count} Verbindung im Pool."
msgstr[1] "{count} Verbindungen im Pool."

#. Write mode line of the benchmark report. {mode} is through or behind, as given with --write-mode.
msgctxt "cli.bench.write_mode"
msgid "Write mode {mode}, as given with --write-mode. The agent does not report the mount's own setting."
msgstr "Schreibmodus {mode}, wie mit --write-mode angegeben. Der Agent meldet die eigene Einstellung des Laufwerks nicht."

#. Sequential write result. {block} is the block size (1 MiB or 64 KiB); {mbps} and {seconds} are numbers.
msgctxt "cli.bench.seq_write"
msgid "Sequential write, {block} blocks: {mbps} MB/s in {seconds} s."
msgstr "Sequenzielles Schreiben, Blöcke von {block}: {mbps} MB/s in {seconds} s."

#. Sequential read result. {block} is the block size; {mbps} and {seconds} are numbers.
msgctxt "cli.bench.seq_read"
msgid "Sequential read, {block} blocks: {mbps} MB/s in {seconds} s."
msgstr "Sequenzielles Lesen, Blöcke von {block}: {mbps} MB/s in {seconds} s."

#. Small-file result. {count} is the number of 4 KiB files; {seconds} is the total time and {ms} the time per file.
#, plural-arg=count
msgctxt "cli.bench.small_files"
msgid "{count} file of 4 KiB: {seconds} s in total, {ms} ms per file."
msgid_plural "{count} files of 4 KiB: {seconds} s in total, {ms} ms per file."
msgstr[0] "{count} Datei mit 4 KiB: {seconds} s insgesamt, {ms} ms pro Datei."
msgstr[1] "{count} Dateien mit 4 KiB: {seconds} s insgesamt, {ms} ms pro Datei."

#. Open-latency result. The four timings are medians and 95th percentiles in milliseconds; {samples} is the sample count.
msgctxt "cli.bench.open"
msgid "Open of an existing file: attributes median {attr_median} ms, p95 {attr_p95} ms. Open and read of 4 KiB: median {read_median} ms, p95 {read_p95} ms ({samples} samples)."
msgstr "Öffnen einer vorhandenen Datei: Attribute Median {attr_median} ms, p95 {attr_p95} ms. Öffnen und Lesen von 4 KiB: Median {read_median} ms, p95 {read_p95} ms ({samples} Messungen)."

#. Printed after the benchmark results: reads may come from the memory cache, which the run does not clear.
msgctxt "cli.bench.cache_note"
msgid "Reads can come from the memory cache, which the run does not clear. Compare runs made in the same cache state."
msgstr "Lesevorgänge können aus dem Speicher-Cache stammen, den der Test nicht leert. Vergleiche Läufe mit demselben Cache-Zustand."

#. Printed after a benchmark run whose temporary folder was removed.
msgctxt "cli.bench.cleaned"
msgid "Temporary folder removed."
msgstr "Temporärer Ordner entfernt."

#. Printed (exit 1) when the temporary folder could not be removed. {path} is the folder; {code} the Win32 error number.
msgctxt "cli.bench.cleanup_failed"
msgid "The temporary folder {path} could not be removed (error {code}). Delete it by hand."
msgstr "Der temporäre Ordner {path} konnte nicht entfernt werden (Fehler {code}). Lösche ihn von Hand."

#. Printed (exit 1) when a benchmark step failed. {code} is the Win32 error number.
msgctxt "cli.bench.failed"
msgid "The benchmark stopped (error {code})."
msgstr "Der Test wurde abgebrochen (Fehler {code})."

#. Printed by hostkey add when the server offers no host key that is not stored yet. {host} is the host as typed.
msgctxt "cli.hk.add_none"
msgid "{host} has no other host keys to add."
msgstr "{host} hat keine weiteren Host-Schlüssel zum Hinzufügen."

#. Printed by hostkey add before the question about the keys the server offers besides the stored ones.
#, plural-arg=count
msgctxt "cli.hk.add_offer"
msgid "{host} also has {count} other host key. Add it?"
msgid_plural "{host} also has {count} other host keys. Add them?"
msgstr[0] "{host} hat außerdem {count} weiteren Host-Schlüssel. Füge ihn hinzu?"
msgstr[1] "{host} hat außerdem {count} weitere Host-Schlüssel. Füge sie hinzu?"

#. Question for the key of a first contact (no stored key; 5.2). The letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.hk.add_first_question"
msgid "Add this key? [y]es, [N]o: "
msgstr "Diesen Schlüssel hinzufügen? [j]a, [N]ein: "

#. Choices after cli.hk.add_offer. The letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.hk.add_choices"
msgid "[y]es, [N]o: "
msgstr "[j]a, [N]ein: "

#. Heading of "shelldrive diag" output. {version} is the product version.
msgctxt "cli.diag.header"
msgid "ShellDrive diagnostics, version {version}"
msgstr "ShellDrive-Diagnose, Version {version}"

#. One check row: {status} is the status word, {label} the check name, {value} what was found.
msgctxt "cli.diag.row"
msgid "{status} {label}: {value}"
msgstr "{status} {label}: {value}"

#. Status word of a check that is fine.
msgctxt "cli.diag.status_ok"
msgid "[OK]"
msgstr "[OK]"

#. Status word of a check that needs attention but is not a failure.
msgctxt "cli.diag.status_warn"
msgid "[Warning]"
msgstr "[Warnung]"

#. Status word of a check that failed.
msgctxt "cli.diag.status_problem"
msgid "[Problem]"
msgstr "[Problem]"

msgctxt "cli.diag.label_os"
msgid "Windows"
msgstr "Windows"

msgctxt "cli.diag.label_agent"
msgid "Agent"
msgstr "Agent"

msgctxt "cli.diag.label_service"
msgid "Service"
msgstr "Dienst"

msgctxt "cli.diag.label_webclient"
msgid "WebClient"
msgstr "WebClient"

msgctxt "cli.diag.label_webdav"
msgid "WebDAV limits"
msgstr "WebDAV-Grenzen"

msgctxt "cli.diag.label_dokany"
msgid "Dokany"
msgstr "Dokany"

msgctxt "cli.diag.label_linked"
msgid "Linked connections"
msgstr "Verknüpfte Verbindungen"

msgctxt "cli.diag.label_elevation"
msgid "Elevation"
msgstr "Erhöhung"

msgctxt "cli.diag.label_domain"
msgid "Domain"
msgstr "Domäne"

msgctxt "cli.diag.label_drives"
msgid "Drive letters"
msgstr "Laufwerkbuchstaben"

msgctxt "cli.diag.label_settings"
msgid "Settings"
msgstr "Einstellungen"

msgctxt "cli.diag.label_privacy"
msgid "Log privacy"
msgstr "Protokollschutz"

msgctxt "cli.diag.label_clock"
msgid "Clock"
msgstr "Uhr"

#. Value of the Windows check. {version} is the build version, {flavour} the build flavour.
msgctxt "cli.diag.v_os"
msgid "{version}, {flavour} build"
msgstr "{version}, Build {flavour}"

msgctxt "cli.diag.v_agent_running"
msgid "running"
msgstr "läuft"

msgctxt "cli.diag.v_agent_stopped"
msgid "not running (it starts when you mount a drive)"
msgstr "läuft nicht (startet beim Verbinden eines Laufwerks)"

msgctxt "cli.diag.v_service_missing"
msgid "not installed"
msgstr "nicht installiert"

msgctxt "cli.diag.v_service_running"
msgid "installed, running"
msgstr "installiert, läuft"

msgctxt "cli.diag.v_service_stopped"
msgid "installed, not running"
msgstr "installiert, läuft nicht"

#. WebClient running on a domain-joined computer: a warning (03 §10.5).
msgctxt "cli.diag.v_webclient_domain"
msgid "running on a domain-joined computer. If every connection uses Dokany, consider disabling it."
msgstr "läuft auf einem Computer in einer Domäne. Wenn alle Verbindungen Dokany nutzen, schalte ihn am besten ab."

msgctxt "cli.diag.v_webclient_running"
msgid "running"
msgstr "läuft"

msgctxt "cli.diag.v_webclient_stopped"
msgid "stopped"
msgstr "beendet"

msgctxt "cli.diag.v_webclient_disabled"
msgid "disabled"
msgstr "deaktiviert"

msgctxt "cli.diag.v_webclient_missing"
msgid "not installed"
msgstr "nicht installiert"

msgctxt "cli.diag.v_unknown"
msgid "unknown"
msgstr "unbekannt"

#. WebDAV limits as set: {size} and {attributes} are byte counts or "not set".
msgctxt "cli.diag.v_webdav"
msgid "file size limit {size}, file attribute limit {attributes}"
msgstr "Dateigrößenlimit {size}, Attributlimit {attributes}"

#. WebDAV limits at the Windows defaults (warning): large files cannot be opened until the installer hook webdav-tune runs.
msgctxt "cli.diag.v_webdav_default"
msgid "file size limit {size}, file attribute limit {attributes}. Large files cannot be opened with these limits."
msgstr "Dateigrößenlimit {size}, Attributlimit {attributes}. Große Dateien lassen sich mit diesen Grenzen nicht öffnen."

msgctxt "cli.diag.v_not_set"
msgid "not set"
msgstr "nicht gesetzt"

msgctxt "cli.diag.v_present"
msgid "installed"
msgstr "installiert"

msgctxt "cli.diag.v_absent"
msgid "not installed"
msgstr "nicht installiert"

msgctxt "cli.diag.v_linked_on"
msgid "enabled"
msgstr "aktiviert"

msgctxt "cli.diag.v_linked_off"
msgid "not set"
msgstr "nicht gesetzt"

#. Warning when EnableLinkedConnections is not set for an administrator account.
msgctxt "cli.diag.v_linked_off_admin"
msgid "not set, so programs run as administrator cannot see the drives"
msgstr "nicht gesetzt, daher sehen Programme mit Administratorrechten die Laufwerke nicht"

msgctxt "cli.diag.v_elev_yes"
msgid "elevated"
msgstr "erhöht"

msgctxt "cli.diag.v_elev_split"
msgid "not elevated (administrator account with a filtered token)"
msgstr "nicht erhöht (Administratorkonto mit gefiltertem Token)"

msgctxt "cli.diag.v_elev_no"
msgid "not elevated"
msgstr "nicht erhöht"

msgctxt "cli.diag.v_domain_yes"
msgid "joined to a domain"
msgstr "in einer Domäne"

msgctxt "cli.diag.v_domain_no"
msgid "not joined to a domain"
msgstr "nicht in einer Domäne"

#. Free drive letters from D: on. {count} is the number of free letters.
#, plural-arg=count
msgctxt "cli.diag.v_drives"
msgid "{count} free drive letter"
msgid_plural "{count} free drive letters"
msgstr[0] "{count} freier Laufwerkbuchstabe"
msgstr[1] "{count} freie Laufwerkbuchstaben"

msgctxt "cli.diag.v_settings_ok"
msgid "readable"
msgstr "lesbar"

msgctxt "cli.diag.v_settings_bad"
msgid "cannot be read"
msgstr "nicht lesbar"

msgctxt "cli.diag.v_privacy_strict"
msgid "strict: host and user names and remote paths are hashed"
msgstr "streng: Computer- und Benutzernamen sowie Remotepfade werden gehasht"

msgctxt "cli.diag.v_privacy_standard"
msgid "standard: host and user names are logged"
msgstr "Standard: Computer- und Benutzernamen werden protokolliert"

#. Clock row. {time} is the local time, {offset} the UTC offset, {state} the state of Windows Time.
msgctxt "cli.diag.v_clock"
msgid "{time} (UTC{offset}), Windows Time {state}"
msgstr "{time} (UTC{offset}), Windows-Zeit {state}"

msgctxt "cli.diag.v_w32_running"
msgid "running"
msgstr "läuft"

msgctxt "cli.diag.v_w32_stopped"
msgid "not running"
msgstr "läuft nicht"

msgctxt "cli.diag.summary_ok"
msgid "No problems found."
msgstr "Keine Probleme gefunden."

#, plural-arg=count
msgctxt "cli.diag.summary_problem"
msgid "{count} problem found."
msgid_plural "{count} problems found."
msgstr[0] "{count} Problem gefunden."
msgstr[1] "{count} Probleme gefunden."

#. A fix failed. {code} is the Windows error number.
msgctxt "cli.diag.fix_failed"
msgid "The change failed (error {code})."
msgstr "Die Änderung ist fehlgeschlagen (Fehler {code})."

#. The fix is refused by the AllowedBackends policy (exit 15).
msgctxt "cli.diag.fix_policy"
msgid "The AllowedBackends policy excludes WebDAV, so WebClient is not changed."
msgstr "Die Richtlinie AllowedBackends schließt WebDAV aus, daher wird WebClient nicht geändert."

#. A fix needs an administrator (exit 9).
msgctxt "cli.diag.elevation_required"
msgid "This needs an administrator. Open a console as administrator and run the command again."
msgstr "Dafür brauchst du Administratorrechte. Öffne eine Konsole als Administrator und führe den Befehl erneut aus."

#. The letter and the word that answer yes. The letter in brackets of the questions below must match.
msgctxt "cli.diag.letter_yes"
msgid "y"
msgstr "j"

msgctxt "cli.diag.word_yes"
msgid "yes"
msgstr "ja"

#. Question before the WebClient fix. The letters in brackets must match cli.diag.letter_yes; the default (capital) is no.
msgctxt "cli.diag.fix_confirm_webclient"
msgid "Set WebClient to start on demand and start it now? [y]es, [N]o: "
msgstr "WebClient auf Start bei Bedarf stellen und jetzt starten? [j]a, [N]ein:"

#. Question before the linked-connections fix. The letters in brackets must match cli.diag.letter_yes; the default (capital) is no.
msgctxt "cli.diag.fix_confirm_linked"
msgid "Let programs run as administrator see the drives (EnableLinkedConnections)? [y]es, [N]o: "
msgstr "Programmen mit Administratorrechten den Zugriff auf die Laufwerke erlauben (EnableLinkedConnections)? [j]a, [N]ein:"

msgctxt "cli.diag.fix_webclient_done"
msgid "WebClient starts on demand and is running."
msgstr "WebClient startet bei Bedarf und läuft."

msgctxt "cli.diag.fix_webclient_unchanged"
msgid "WebClient already runs on demand. Nothing was changed."
msgstr "WebClient startet bereits bei Bedarf. Nichts wurde geändert."

#. Note before the WebClient fix on a domain-joined computer.
msgctxt "cli.diag.fix_domain_note"
msgid "This computer is joined to a domain. If every connection uses Dokany, WebClient is not needed."
msgstr "Dieser Computer ist in einer Domäne. Wenn alle Verbindungen Dokany nutzen, wird WebClient nicht gebraucht."

msgctxt "cli.diag.fix_linked_done"
msgid "EnableLinkedConnections is set. Restart Windows for it to take effect."
msgstr "EnableLinkedConnections ist gesetzt. Starte Windows neu, damit es wirkt."

msgctxt "cli.diag.fix_linked_unchanged"
msgid "EnableLinkedConnections is already set. Nothing was changed."
msgstr "EnableLinkedConnections ist bereits gesetzt. Nichts wurde geändert."

#. Printed before a bundle that keeps host names, user names and remote paths.
msgctxt "cli.diag.bundle_no_anon"
msgid "Host names, user names and remote paths are NOT anonymized (--no-anonymize)."
msgstr "Computer-, Benutzernamen und Remotepfade werden NICHT anonymisiert (--no-anonymize)."

msgctxt "cli.diag.bundle_dumps_note"
msgid "Crash dumps are included. They can contain file names and file content."
msgstr "Absturz-Speicherabbilder sind enthalten. Diese können Dateinamen und Dateiinhalte enthalten."

#. {path} is the file name that already exists. The file is not replaced.
msgctxt "cli.diag.bundle_exists"
msgid "{path} already exists. Choose another name; the existing file was not replaced."
msgstr "{path} existiert bereits. Wähle einen anderen Namen; die vorhandene Datei wurde nicht ersetzt."

#. {code} is the Windows error number.
msgctxt "cli.diag.bundle_failed"
msgid "The bundle could not be written (error {code})."
msgstr "Das Paket konnte nicht geschrieben werden (Fehler {code})."

#. Printed after a bundle is written. {path} is the file, {count} the number of files in it.
#, plural-arg=count
msgctxt "cli.diag.bundle_written"
msgid "Diagnostic bundle written: {path} ({count} file). Nothing was sent; attach the file yourself when you report a problem."
msgid_plural "Diagnostic bundle written: {path} ({count} files). Nothing was sent; attach the file yourself when you report a problem."
msgstr[0] "Diagnosepaket geschrieben: {path} ({count} Datei). Nichts wurde gesendet; hänge die Datei selbst an, wenn du ein Problem meldest."
msgstr[1] "Diagnosepaket geschrieben: {path} ({count} Dateien). Nichts wurde gesendet; hänge die Datei selbst an, wenn du ein Problem meldest."

#. Help: the diag command in the general list.
msgctxt "cli.help.diag"
msgid "Check this computer, write a support bundle or apply one of the two fixes."
msgstr "Prüft diesen Computer, schreibt ein Supportpaket oder wendet eine der beiden Korrekturen an."

msgctxt "cli.help.diag_check"
msgid "Run the checks of this computer (the default)."
msgstr "Führt die Prüfungen dieses Computers aus (Standard)."

msgctxt "cli.help.diag_bundle"
msgid "Write a ZIP file with the checks, logs and settings. Anonymized by default."
msgstr "Schreibt eine ZIP-Datei mit Prüfungen, Protokollen und Einstellungen. Standardmäßig anonymisiert."

msgctxt "cli.help.diag_fix"
msgid "Apply one fix after a question. Needs an administrator."
msgstr "Wendet nach einer Rückfrage eine Korrektur an. Benötigt Administratorrechte."

msgctxt "cli.help.admin_webclient"
msgid "The same as diag --fix webclient: WebClient starts on demand and runs now."
msgstr "Wie diag --fix webclient: WebClient startet bei Bedarf und läuft jetzt."

msgctxt "cli.help.opt_bundle"
msgid "The new ZIP file. Without FILE the name is shelldrive-diag-<date>-<time>.zip in the current folder."
msgstr "Die neue ZIP-Datei. Ohne FILE lautet der Name shelldrive-diag-<Datum>-<Uhrzeit>.zip im aktuellen Ordner."

msgctxt "cli.help.opt_no_anonymize"
msgid "Keep host names, user names and remote paths in the bundle."
msgstr "Behält Computer-, Benutzernamen und Remotepfade im Paket."

msgctxt "cli.help.opt_include_dumps"
msgid "Include the crash dumps. They can contain file content."
msgstr "Nimmt die Absturz-Speicherabbilder auf. Diese können Dateiinhalte enthalten."

msgctxt "cli.help.opt_fix"
msgid "webclient: start on demand and run now. linked-connections: administrator programs see the drives after a restart."
msgstr "webclient: Start bei Bedarf und sofortiger Start. linked-connections: Programme mit Administratorrechten sehen die Laufwerke nach einem Neustart."

msgctxt "cli.help.opt_yes"
msgid "Do not ask before a fix."
msgstr "Fragt vor einer Korrektur nicht nach."

