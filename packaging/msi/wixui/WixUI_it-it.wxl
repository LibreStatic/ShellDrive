    <String Id="MaintenanceTypeDlgRemoveDisabledText" Overridable="yes">Impossibile rimuovere [ProductName].</String>
    <String Id="MaintenanceTypeDlgRemoveText" Overridable="yes">Consente di rimuovere [ProductName] dal computer.</String>
    <String Id="MaintenanceTypeDlgRepairButton" Overridable="yes">Ri&amp;para</String>
