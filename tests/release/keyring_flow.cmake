# Compiled-in keyring (docs/design/04 §9.3): `sd-release keyring` end to end with TEST keys. Run by ctest as
#   cmake -DSD_RELEASE=<sd-release.exe> -DSD_UPDSIGN=<sd-updsign.exe> -DWORK=<scratch dir> -P keyring_flow.cmake
#
# Every key here is a TEST key generated by sd-updsign keygen in the scratch dir; nothing touches installer/keys/
# and nothing uses or stores a release key. The keyset body goes through write_lf.ps1 because file(WRITE) is text
# mode on Windows (CRLF) and the keyset verifier takes the exact bytes and refuses CR. Exit codes checked: 0 ok,
# 2 malformed roots.txt or keyset, 3 a keyset that does not verify. Any failed step stops with FATAL_ERROR.

if(NOT SD_RELEASE OR NOT SD_UPDSIGN OR NOT WORK)
  message(FATAL_ERROR "SD_RELEASE, SD_UPDSIGN and WORK are required")
endif()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# rel(<expected exit code> <output variable> <sd-release arguments...>) — as in release_flow.cmake
function(rel expect out_var)
  execute_process(COMMAND "${SD_RELEASE}" ${ARGN}
                  WORKING_DIRECTORY "${WORK}"
                  RESULT_VARIABLE rc
                  OUTPUT_VARIABLE out
                  ERROR_VARIABLE err)
  if(NOT rc EQUAL expect)
    message(FATAL_ERROR "sd-release ${ARGN}: exit ${rc}, expected ${expect}\n${out}${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# upd(<expected exit code> <output variable> <sd-updsign arguments...>)
function(upd expect out_var)
  execute_process(COMMAND "${SD_UPDSIGN}" ${ARGN}
                  WORKING_DIRECTORY "${WORK}"
                  RESULT_VARIABLE rc
                  OUTPUT_VARIABLE out
                  ERROR_VARIABLE err)
  if(NOT rc EQUAL expect)
    message(FATAL_ERROR "sd-updsign ${ARGN}: exit ${rc}, expected ${expect}\n${out}${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

function(expect_contains text needle)
  string(FIND "${text}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "expected '${needle}' in:\n${text}")
  endif()
endfunction()

# The public key (hex) and key ID of a seed file, from the `sd-release pubkey` output line.
function(pub_of seed_file out_pub out_kid)
  rel(0 out pubkey --seed "${seed_file}")
  string(REGEX REPLACE "^pub ([0-9a-f]+) kid ([0-9a-f]+).*" "\\1" pub "${out}")
  string(REGEX REPLACE "^pub ([0-9a-f]+) kid ([0-9a-f]+).*" "\\2" kid "${out}")
  string(LENGTH "${pub}" pn)
  string(LENGTH "${kid}" kn)
  if(NOT pn EQUAL 64 OR NOT kn EQUAL 16)
    message(FATAL_ERROR "pubkey output: ${out}")
  endif()
  set(${out_pub} "${pub}" PARENT_SCOPE)
  set(${out_kid} "${kid}" PARENT_SCOPE)
endfunction()

# The public key (base64) and key ID of a seed file, from the `sd-updsign keygen` output (and the keygen .pub file).
function(key_of seed_file out_b64 out_kid)
  upd(0 out keygen --seed "${seed_file}" --pub "${seed_file}.pub")
  string(REPLACE "\n" ";" lines "${out}")
  list(GET lines 0 l0)
  list(GET lines 1 l1)
  string(REPLACE "pubkey " "" b64 "${l0}")
  string(REPLACE "key-id " "" kid "${l1}")
  string(LENGTH "${b64}" bn)
  string(LENGTH "${kid}" kn)
  if(NOT bn EQUAL 44 OR NOT kn EQUAL 16)
    message(FATAL_ERROR "keygen output: ${out}")
  endif()
  set(${out_b64} "${b64}" PARENT_SCOPE)
  set(${out_kid} "${kid}" PARENT_SCOPE)
endfunction()

# hex_bytes(<64 hex digits> <out variable>): the bytes as "0x.., 0x.., ..." as they appear in the generated include.
function(hex_bytes hex out_var)
  string(REGEX REPLACE "(..)" "0x\\1, " t "${hex}")
  string(REGEX REPLACE ", $" "" t "${t}")
  set(${out_var} "${t}" PARENT_SCOPE)
endfunction()

# write_lf(<in> <out>): OUT is IN with CRLF pairs read as LF (see write_lf.ps1).
function(write_lf src dst)
  execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
                  -File "${CMAKE_CURRENT_LIST_DIR}/write_lf.ps1" -In "${src}" -Out "${dst}"
                  RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "write_lf.ps1 ${src}: exit ${rc}")
  endif()
endfunction()

# ---- TEST keys: two roots and one beta release key ----
key_of("${WORK}/root-a.seed" B64_A KID_A)
key_of("${WORK}/root-b.seed" B64_B KID_B)
key_of("${WORK}/beta.seed" B64_BETA KID_BETA)
pub_of("${WORK}/beta.seed" PUB_BETA KID_BETA_FROM_PUB)
if(NOT KID_BETA STREQUAL KID_BETA_FROM_PUB)
  message(FATAL_ERROR "the tools disagree on the beta key ID: ${KID_BETA} vs ${KID_BETA_FROM_PUB}")
endif()

# roots.txt: comments and blank lines, then exactly two root lines (CRLF pairs are accepted here, unlike the keyset).
file(WRITE "${WORK}/roots.txt"
"# test roots for the keyring test
root ${KID_A} ${B64_A}

root ${KID_B} ${B64_B}
")

# ---- a signed keyset with one beta release key ----
set(BODY "shelldrive-keyset 1
product com.librestatic.shelldrive
version 1
issued 2026-10-31T00:00:00Z
key ${KID_BETA} beta ${B64_BETA} 2026-01-01 2027-01-01
")
file(WRITE "${WORK}/body-crlf.txt" "${BODY}")
write_lf("${WORK}/body-crlf.txt" "${WORK}/keyset-body.txt")
upd(0 updsign_out sign-keyset --in keyset-body.txt --root root-a.seed --out keyset.txt)

# ---- success: the include files hold the roots, the key bytes and the inclusive dates ----
rel(0 out keyring --roots roots.txt --keyset keyset.txt --out-setup setup_keyring.inc --out-trust update_trust.inc)
expect_contains("${out}" "keyring roots 2 keys 1")
file(READ "${WORK}/setup_keyring.inc" setup_inc)
file(READ "${WORK}/update_trust.inc" trust_inc)
# 2026-01-01 00:00:00Z = 1767225600, 2027-01-01 23:59:59Z = 1798847999 (sd_upd_date_parse, end of day inclusive).
hex_bytes("${PUB_BETA}" pub_beta_bytes)
expect_contains("${setup_inc}" "{ { ${pub_beta_bytes} }, \"beta\", 1767225600, 1798847999, 0 },")
expect_contains("${trust_inc}" "static const sd_upd_root k_roots[] = {")
expect_contains("${trust_inc}" "static const uint8_t k_keyset[] = {")
expect_contains("${trust_inc}" "static const sd_upd_trust k_trust = { k_roots, (uint32_t)(sizeof(k_roots) / sizeof(k_roots[0])), k_keyset,")
hex_bytes("${KID_A}" kid_a_bytes)
hex_bytes("${KID_B}" kid_b_bytes)
expect_contains("${trust_inc}" "${kid_a_bytes}")
expect_contains("${trust_inc}" "${kid_b_bytes}")
# the exact bytes of keyset.txt: the inc embeds them from "shelldrive-keyset 1" on (first bytes of the ASCII magic).
expect_contains("${trust_inc}" "0x73, 0x68, 0x65, 0x6c, 0x6c, 0x64, 0x72, 0x69, 0x76, 0x65, 0x2d, 0x6b, 0x65, 0x79, 0x73, 0x65")

# ---- deterministic output (04 §12.2) ----
rel(0 out keyring --roots roots.txt --keyset keyset.txt --out-setup setup2.inc --out-trust trust2.inc)
file(READ "${WORK}/setup2.inc" setup_inc2)
file(READ "${WORK}/trust2.inc" trust_inc2)
if(NOT setup_inc STREQUAL setup_inc2 OR NOT trust_inc STREQUAL trust_inc2)
  message(FATAL_ERROR "sd-release keyring output is not deterministic")
endif()

# ---- a keyset signed by a root outside roots.txt: refused (3), nothing written ----
upd(0 stranger_out keygen --seed "${WORK}/stranger.seed" --pub "${WORK}/stranger.pub")
upd(0 updsign_out sign-keyset --in keyset-body.txt --root stranger.seed --out keyset-stranger.txt)
rel(3 out keyring --roots roots.txt --keyset keyset-stranger.txt --out-setup refused.inc --out-trust refused2.inc)
if(EXISTS "${WORK}/refused.inc" OR EXISTS "${WORK}/refused2.inc")
  message(FATAL_ERROR "keyring wrote output for a keyset that does not verify")
endif()

# ---- a tampered keyset (bytes changed behind the signature): refused (3) ----
file(READ "${WORK}/keyset.txt" keyset_text)
string(REPLACE "version 1" "version 2" tampered "${keyset_text}")
file(WRITE "${WORK}/tampered-crlf.txt" "${tampered}")
write_lf("${WORK}/tampered-crlf.txt" "${WORK}/keyset-tampered.txt")
rel(3 out keyring --roots roots.txt --keyset keyset-tampered.txt --out-setup refused.inc --out-trust refused2.inc)

# ---- malformed roots.txt: refused (2) ----
file(WRITE "${WORK}/roots-one.txt" "root ${KID_A} ${B64_A}\n")
rel(2 out keyring --roots roots-one.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
file(WRITE "${WORK}/roots-three.txt"
"root ${KID_A} ${B64_A}
root ${KID_B} ${B64_B}
root ${KID_BETA} ${B64_BETA}
")
rel(2 out keyring --roots roots-three.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
file(WRITE "${WORK}/roots-junk.txt"
"root ${KID_A} ${B64_A}
root ${KID_B} ${B64_B}
not a root line
")
rel(2 out keyring --roots roots-junk.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
string(TOUPPER "${KID_A}" KID_A_UPPER)
file(WRITE "${WORK}/roots-upper.txt"
"root ${KID_A_UPPER} ${B64_A}
root ${KID_B} ${B64_B}
")
rel(2 out keyring --roots roots-upper.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
file(WRITE "${WORK}/roots-wrongid.txt"
"root 1234567890abcdef ${B64_A}
root ${KID_B} ${B64_B}
")
rel(2 out keyring --roots roots-wrongid.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
rel(2 out keyring --roots roots-missing.txt --keyset keyset.txt --out-setup refused.inc --out-trust refused2.inc)
rel(1 out keyring --roots roots.txt --keyset keyset.txt --out-setup refused.inc)

# ---- a revoked key gets revoked = 1 ----
set(BODY_R "shelldrive-keyset 1
product com.librestatic.shelldrive
version 2
issued 2026-10-31T00:00:00Z
key ${KID_BETA} beta ${B64_BETA} 2026-01-01 2027-01-01
revoke ${KID_BETA} tm-r37.test
")
file(WRITE "${WORK}/body-revoked-crlf.txt" "${BODY_R}")
write_lf("${WORK}/body-revoked-crlf.txt" "${WORK}/keyset-body-revoked.txt")
upd(0 updsign_out sign-keyset --in keyset-body-revoked.txt --root root-a.seed --out keyset-revoked.txt)
rel(0 out keyring --roots roots.txt --keyset keyset-revoked.txt --out-setup setup-revoked.inc --out-trust trust-revoked.inc)
file(READ "${WORK}/setup-revoked.inc" setup_revoked)
expect_contains("${setup_revoked}" "{ { ${pub_beta_bytes} }, \"beta\", 1767225600, 1798847999, 1 },")

message(STATUS "keyring flow: all checks passed")
