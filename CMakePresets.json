{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "x64-modern",
      "displayName": "x64 modern (v143, Windows 10+, CFG + CET)",
      "inherits": "base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-modern",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "x64-xp",
      "displayName": "x64 XP (v141_xp, SDK 7.1A, subsystem 5.02)",
      "inherits": "base",
      "toolset": {
        "value": "v141_xp",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-xp"
      }
    },
    {
      "name": "x86-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "v141_xp",
        "strategy": "set"
      }
    },
    {
      "name": "x86-ia32",
      "displayName": "x86 IA32 (v141_xp, SDK 7.1A, /arch:IA32, no SSE; XP SP3)",
      "inherits": "x86-base",
      "cacheVariables": {
        "SD_FLAVOUR": "x86-ia32",
        "SD_X86_ARCH": "IA32"
      }
    },
    {
      "name": "x86-sse2",
      "displayName": "x86 SSE2 (v141_xp, SDK 7.1A, /arch:SSE2; XP SP3)",
      "inherits": "x86-base",
      "cacheVariables": {
        "SD_FLAVOUR": "x86-sse2",
        "SD_X86_ARCH": "SSE2"
      }
    },
    {
      "name": "x64-analysis",
      "displayName": "x64 analysis (v143, /analyze; -DSD_ENABLE_ASAN=ON for ASan)",
      "inherits": "base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-analysis",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "SD_ENABLE_ANALYZE": "ON",
        "SD_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "x86-fuzz",
      "displayName": "x86 fuzz (v143 Win32, libFuzzer + ASan, DLL CRT; tests/fuzz, never shipped)",
      "inherits": "x86-base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x86-ia32",
        "SD_X86_ARCH": "IA32",
        "SD_FUZZ": "ON",
        "SD_ENABLE_ASAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
