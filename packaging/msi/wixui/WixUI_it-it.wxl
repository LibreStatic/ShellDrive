    <String Id="FilesInUseBannerBitmap" Overridable="yes">WixUI_Bmp_Banner</String>
    <String Id="FilesInUseDescription" Overridable="yes">Alcuni file che richiedono l'aggiornamento sono attualmente in uso.</String>
    <String Id="FilesInUseExit" Overridable="yes">E&amp;sci</String>
    <String Id="FilesInUseText" Overridable="yes">Le applicazioni seguenti stanno utilizzando file che devono essere aggiornati da questa installazione. Chiudi le applicazioni, quindi fai clic su &amp;Riprova per continuare l'installazione. Per uscire dall'installazione, fai clic su Esci.</String>
    <String Id="FilesInUseTitle" Overridable="yes">{\WixUI_Font_Title}File in uso</String>
    <String Id="FilesInUse_Title" Overridable="yes">Installazione di [ProductName]</String>
