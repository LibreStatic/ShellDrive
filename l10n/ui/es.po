# ShellDrive UI strings, es (03 §9.1). msgctxt is the stable symbolic id; msgid is the English source.
msgid ""
msgstr ""
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n == 1 ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

#. Tray icon tooltip when no drive is mounted.
#. sdl10n:maxlen=128
msgctxt "ui.tray.tip_none"
msgid "ShellDrive: no drives mounted"
msgstr "ShellDrive: ninguna unidad montada"

#. Tray icon tooltip with the number of mounted drives.
#. sdl10n:maxlen=128
#, plural-arg=count
msgctxt "ui.tray.tip_count"
msgid "ShellDrive: {count} drive mounted."
msgid_plural "ShellDrive: {count} drives mounted."
msgstr[0] "ShellDrive: {count} unidad montada."
msgstr[1] "ShellDrive: {count} de unidades montadas."
msgstr[2] "ShellDrive: {count} unidades montadas."

#. Tray menu: opens the main window.
msgctxt "ui.tray.open"
msgid "Open ShellDrive"
msgstr "Abrir ShellDrive"

#. Tray menu: quits the tray application. Mounts and the agent keep running.
msgctxt "ui.tray.exit"
msgid "Exit"
msgstr "Salir"

#. Tray menu: disabled item shown when no drive is mounted.
msgctxt "ui.tray.no_drives"
msgid "No drives mounted"
msgstr "Ninguna unidad montada"

#. Tray menu item for one mounted drive. {drive} is a letter such as E:, {profile} is the profile name.
msgctxt "ui.tray.unmount"
msgid "Unmount {drive} ({profile})"
msgstr "Desmontar {drive} ({profile})"

#. Main window list column: profile name.
msgctxt "ui.main.col_name"
msgid "Name"
msgstr "Nombre"

#. Main window list column: drive letter.
msgctxt "ui.main.col_drive"
msgid "Drive"
msgstr "Unidad"

#. Main window list column: connection state.
msgctxt "ui.main.col_state"
msgid "State"
msgstr "Estado"

#. Main window list column: storage backend (product names Dokany or WebDAV).
msgctxt "ui.main.col_backend"
msgid "Backend"
msgstr "Backend"

#. Main window list column: server host name.
msgctxt "ui.main.col_server"
msgid "Server"
msgstr "Servidor"

#. Main window button that mounts the selected connection.
msgctxt "ui.main.mount"
msgid "Mount"
msgstr "Montar"

#. Main window button that unmounts the selected drive.
msgctxt "ui.main.unmount"
msgid "Unmount"
msgstr "Desmontar"

#. Main window button that asks the agent for the mount list again.
msgctxt "ui.main.refresh"
msgid "Refresh"
msgstr "Actualizar"

#. Status bar summary of the mounts.
#, plural-arg=count
msgctxt "ui.status.count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} unidad montada."
msgstr[1] "{count} de unidades montadas."
msgstr[2] "{count} unidades montadas."

#. Status bar when the agent is not running.
msgctxt "ui.status.agent_down"
msgid "ShellDrive is not running."
msgstr "ShellDrive no está en ejecución."

#. Mount state in the list: the agent is opening the connection.
msgctxt "ui.state.connecting"
msgid "Connecting"
msgstr "Conectando"

#. Mount state in the list: signing in to the server.
msgctxt "ui.state.authenticating"
msgid "Signing in"
msgstr "Iniciando sesión"

#. Mount state in the list: the drive is mounted and usable.
msgctxt "ui.state.mounted"
msgid "Connected"
msgstr "Conectada"

#. Mount state in the list: the connection is lost and ShellDrive retries.
msgctxt "ui.state.offline"
msgid "Offline"
msgstr "Sin conexión"

#. Mount state in the list: the user has to sign in again.
msgctxt "ui.state.auth_required"
msgid "Sign-in required"
msgstr "Se requiere inicio de sesión"

#. Mount state in the list: the mount failed.
msgctxt "ui.state.failed"
msgid "Failed"
msgstr "Falló"

#. Mount state in the list: the drive is being unmounted.
msgctxt "ui.state.unmounting"
msgid "Disconnecting"
msgstr "Desmontando"

#. Mount state in the list: the drive is no longer mounted.
msgctxt "ui.state.unmounted"
msgid "Not mounted"
msgstr "Desmontada"

#. Balloon title for warnings from the agent.
#. sdl10n:maxlen=64
msgctxt "ui.warn.title"
msgid "ShellDrive warning"
msgstr "Advertencia de ShellDrive"

#. Balloon text: the connection uses outdated algorithms. {drive} is a drive letter such as E:.
#. sdl10n:maxlen=256
msgctxt "ui.warn.legacy"
msgid "Drive {drive} uses outdated security. Open ShellDrive for details."
msgstr "La unidad {drive} usa seguridad desactualizada. Abrí ShellDrive para ver los detalles."

#. Balloon text: the connection is open to a known attack until the server is updated.
#. sdl10n:maxlen=256
msgctxt "ui.warn.terrapin"
msgid "Drive {drive} is open to a known attack until the server is updated."
msgstr "La unidad {drive} es vulnerable a un ataque conocido hasta que el servidor se actualice."

#. Balloon text: changes could not be written to the server.
#. sdl10n:maxlen=256
msgctxt "ui.warn.write_failed"
msgid "Changes to drive {drive} could not be saved."
msgstr "No se pudieron guardar los cambios de la unidad {drive}."

#. Balloon text for any other warning.
#. sdl10n:maxlen=256
msgctxt "ui.warn.generic"
msgid "Drive {drive} needs your attention. Open ShellDrive for details."
msgstr "La unidad {drive} necesita atención. Abrí ShellDrive para ver los detalles."

#. Message box when the agent refuses to unmount a drive.
msgctxt "ui.error.unmount"
msgid "Could not unmount drive {drive}."
msgstr "No se pudo desmontar la unidad {drive}."

#. Prompt dialog title for a server whose host key is not known yet (first connection).
msgctxt "ui.prompt.title_hostkey"
msgid "Unknown server"
msgstr "Servidor desconocido"

#. Prompt dialog title when a known server presents a different host key. ShellDrive never offers to accept it.
msgctxt "ui.prompt.title_changed"
msgid "Server identity changed"
msgstr "La identidad del servidor cambió"

#. Prompt dialog title for a password. {host} is the server name.
msgctxt "ui.prompt.title_password"
msgid "Sign in to {host}"
msgstr "Ingresá a {host}"

#. Prompt dialog title for a key passphrase. {profile} is the profile name.
msgctxt "ui.prompt.title_passphrase"
msgid "Passphrase for {profile}"
msgstr "Frase de contraseña de {profile}"

#. Prompt dialog title for keyboard-interactive questions. {host} is the server name.
msgctxt "ui.prompt.title_kbdint"
msgid "Verification from {host}"
msgstr "Verificación de {host}"

#. Prompt dialog title when the server requires a password change. {host} is the server name.
msgctxt "ui.prompt.title_change"
msgid "Change your password on {host}"
msgstr "Cambiá tu contraseña en {host}"

#. Prompt dialog title for outdated security algorithms. {host} is the server name.
msgctxt "ui.prompt.title_legacy"
msgid "Outdated security on {host}"
msgstr "Seguridad desactualizada en {host}"

#. Prompt dialog title for a proxy password. {profile} is the profile name.
msgctxt "ui.prompt.title_proxy"
msgid "Proxy password for {profile}"
msgstr "Contraseña del proxy de {profile}"

#. Prompt dialog: first line for a host key or keyboard prompt. {host} and {port} are the server and its port.
msgctxt "ui.prompt.hostkey_intro"
msgid "The authenticity of host {host} (port {port}) can't be established."
msgstr "No se puede verificar la identidad del host {host} (puerto {port})."

#. Prompt dialog: a jump host chain. {hop} is this hop (from 1) and {hops} the total number of hops.
msgctxt "ui.prompt.hop_info"
msgid "Jump host {hop} of {hops}."
msgstr "Host de salto {hop} de {hops}."

#. Prompt dialog: names the jump host the connection went through. {via} is that host name.
msgctxt "ui.prompt.reach_via"
msgid "Reached through jump host {via}."
msgstr "Se llegó a través del host de salto {via}."

#. Prompt dialog: the profile line, outside the server text. {profile} is the profile name.
msgctxt "ui.prompt.profile_line"
msgid "Profile: {profile}"
msgstr "Perfil: {profile}"

#. Prompt dialog: the server and user line of a sign-in prompt. {host} and {user} are the server and the account.
msgctxt "ui.prompt.target_line"
msgid "Server: {host}, user: {user}"
msgstr "Servidor: {host}, usuario: {user}"

#. Prompt dialog: key type of a new host key. {type} is the algorithm name, such as ED25519.
msgctxt "ui.prompt.key_type"
msgid "Key type: {type}"
msgstr "Tipo de clave: {type}"

#. Prompt dialog: label of the read-only fingerprint field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.fingerprint"
msgid "&Fingerprint (SHA-256):"
msgstr "&Huella (SHA-256):"

#. Prompt dialog: asks the user to check a new host key with the administrator.
msgctxt "ui.prompt.hostkey_check"
msgid "Ask the server's administrator to confirm this fingerprint before you trust it."
msgstr "Pedile al administrador del servidor que confirme esta huella antes de confiar en ella."

#. Prompt dialog: explains the two trust buttons. Use the same words as the button captions.
msgctxt "ui.prompt.hostkey_choice"
msgid "Trust and connect saves this server's key for next time. Connect once uses it only for this connection."
msgstr "Confiar y conectar guarda la clave de este servidor para la próxima vez. Conectar una vez la usa solo en esta conexión."

#. Prompt dialog: screen reader hint, because no button is the default for a trust decision.
msgctxt "ui.prompt.choose_button"
msgid "Choose a button to continue."
msgstr "Elegí un botón para continuar."

#. Prompt dialog button: trusts the new host key, saves it and connects.
msgctxt "ui.prompt.btn.trust"
msgid "&Trust and connect"
msgstr "Con&fiar y conectar"

#. Prompt dialog button: connects once with a new host key, without saving it.
msgctxt "ui.prompt.btn.once"
msgid "Connect &once"
msgstr "Conectar &una vez"

#. Prompt dialog button: closes the dialog without answering the request (rejects it).
msgctxt "ui.prompt.btn.cancel"
msgid "&Cancel"
msgstr "&Cancelar"

#. Prompt dialog button for the host key change notice: closes it.
msgctxt "ui.prompt.btn.close"
msgid "Clos&e"
msgstr "Ce&rrar"

#. Prompt dialog button: sends the password or passphrase and connects.
msgctxt "ui.prompt.btn.connect"
msgid "Co&nnect"
msgstr "Con&ectar"

#. Prompt dialog button: sends the keyboard-interactive answers.
msgctxt "ui.prompt.btn.verify"
msgid "&Verify"
msgstr "&Verificar"

#. Prompt dialog button: sends the old and new passwords.
msgctxt "ui.prompt.btn.change"
msgid "Chan&ge password"
msgstr "Cambiar contra&seña"

#. Prompt dialog button: continues with the outdated algorithms, once.
msgctxt "ui.prompt.btn.anyway"
msgid "Continue &anyway"
msgstr "Continuar &igual"

#. Prompt dialog: a host key change notice. {host} is the server name.
msgctxt "ui.prompt.changed_intro"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "La identidad de {host} cambió. ShellDrive cortó la conexión."

#. Prompt dialog: warning under the host key change notice.
msgctxt "ui.prompt.changed_warning"
msgid "This can mean someone is intercepting the connection. Ask the server's administrator before you change anything."
msgstr "Puede significar que alguien intercepta la conexión. Consultá con el administrador del servidor antes de cambiar algo."

#. Prompt dialog: the key ShellDrive has stored. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_stored"
msgid "Stored key: {fingerprint}"
msgstr "Clave guardada: {fingerprint}"

#. Prompt dialog: the key the server offers now. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_offered"
msgid "Offered key: {fingerprint}"
msgstr "Clave ofrecida: {fingerprint}"

#. Prompt dialog: the server sent its own text (name, instruction) above the answer fields.
msgctxt "ui.prompt.server_caption"
msgid "From the server (ShellDrive does not check this text):"
msgstr "Del servidor (ShellDrive no verifica este texto):"

#. Prompt dialog: appended to a password prompt after a host key was accepted in this connection.
msgctxt "ui.prompt.just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Acabás de aceptar la identidad de este servidor. ShellDrive no envió tu contraseña guardada automáticamente."

#. Prompt dialog: the password is asked again because the connection was lost.
msgctxt "ui.prompt.reconnect"
msgid "The connection was lost. Enter your password to reconnect."
msgstr "Se perdió la conexión. Ingresá tu contraseña para volver a conectarte."

#. Prompt dialog: label of the password field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.password"
msgid "&Password:"
msgstr "&Contraseña:"

#. Prompt dialog: label of the key passphrase field.
msgctxt "ui.prompt.field.passphrase"
msgid "Passph&rase:"
msgstr "Frase de contra&seña:"

#. Prompt dialog: label of the proxy password field.
msgctxt "ui.prompt.field.proxy"
msgid "Pro&xy password:"
msgstr "Contraseña del pro&xy:"

#. Prompt dialog: label of the current password in a password change.
msgctxt "ui.prompt.field.current"
msgid "C&urrent password:"
msgstr "Contraseña &actual:"

#. Prompt dialog: label of the new password in a password change.
msgctxt "ui.prompt.field.new"
msgid "Ne&w password:"
msgstr "&Nueva contraseña:"

#. Prompt dialog: label of the repeated new password in a password change.
msgctxt "ui.prompt.field.retype"
msgid "Re&type new password:"
msgstr "&Repetí la nueva contraseña:"

#. Prompt dialog: check box that keeps the secret on this computer, shown only when it can be saved.
msgctxt "ui.prompt.check.save"
msgid "&Save on this computer"
msgstr "&Guardar en esta computadora"

#. Prompt dialog: shows the fingerprint of the key that unlocks a key file. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.key_fingerprint"
msgid "Key fingerprint: {fingerprint}"
msgstr "Huella de la clave: {fingerprint}"

#. Prompt dialog: the server asks a password change. {user} is the account name.
msgctxt "ui.prompt.change_intro"
msgid "The server asks you to choose a new password for {user}."
msgstr "El servidor te pide que elijas una contraseña nueva para {user}."

#. Prompt dialog: the new passwords differ.
msgctxt "ui.prompt.mismatch"
msgid "The new passwords do not match."
msgstr "Las contraseñas nuevas no coinciden."

#. Prompt dialog: a field is empty.
msgctxt "ui.prompt.empty"
msgid "Fill in every field."
msgstr "Completá todos los campos."

#. Prompt dialog: the answer could not be queued for the agent; the dialog stays open.
msgctxt "ui.prompt.send_failed"
msgid "ShellDrive could not send your answer. Try again."
msgstr "ShellDrive no pudo enviar tu respuesta. Volvé a intentarlo."

#. Prompt dialog: label above one keyboard-interactive answer field. {n} is this field and {total} the count.
msgctxt "ui.prompt.kbd_answer"
msgid "Answer {n} of {total}:"
msgstr "Respuesta {n} de {total}:"

#. Prompt dialog: the server asks questions. {host} is the server name and {port} its port.
msgctxt "ui.prompt.kbdint_intro"
msgid "The server {host} (port {port}) asks you to answer these questions."
msgstr "El servidor {host} (puerto {port}) te pide que respondas estas preguntas."

#. Prompt dialog: a proxy needs a password. {proxy_host} and {proxy_port} are the proxy, {host} the server.
msgctxt "ui.prompt.proxy_intro"
msgid "The proxy {proxy_host}:{proxy_port} needs a password to reach {host}."
msgstr "El proxy {proxy_host}:{proxy_port} necesita una contraseña para llegar a {host}."

#. Prompt dialog: the proxy user name. {user} is the user name.
msgctxt "ui.prompt.proxy_user"
msgid "Proxy user: {user}"
msgstr "Usuario del proxy: {user}"

#. Prompt dialog: outdated algorithms. {host} is the server, {algorithms} a list such as hmac-sha1, 3des-cbc.
msgctxt "ui.prompt.legacy_intro"
msgid "{host} uses outdated security algorithms: {algorithms}."
msgstr "{host} usa algoritmos de seguridad desactualizados: {algorithms}."

#. Prompt dialog: explains the outdated algorithms warning.
msgctxt "ui.prompt.legacy_text"
msgid "The connection works, but these algorithms are easier to attack. Continue only if you trust this server."
msgstr "La conexión funciona, pero estos algoritmos son más fáciles de atacar. Continuá solo si confiás en este servidor."

#. Prompt dialog: remaining time, shown as text only. {count} is the number of minutes, at least 1.
#, plural-arg=count
msgctxt "ui.prompt.deadline"
msgid "Time left to answer: about {count} minute."
msgid_plural "Time left to answer: about {count} minutes."
msgstr[0] "Tiempo para responder: unos {count} minuto."
msgstr[1] "Tiempo para responder: unos {count} minutos."
msgstr[2] "Tiempo para responder: unos {count} minutos."

#. Tray balloon when a prompt expired without an answer. {profile} is the profile name.
msgctxt "ui.prompt.timeout"
msgid "A sign-in for {profile} timed out. Open ShellDrive to try again."
msgstr "Se agotó el tiempo de ingreso a {profile}. Abrí ShellDrive para intentarlo de nuevo."

#. Property sheet tab: general connection settings.
msgctxt "ui.tab.general"
msgid "General"
msgstr "General"

#. Property sheet tab: how to sign in.
msgctxt "ui.tab.auth"
msgid "Authentication"
msgstr "Autenticación"

#. Property sheet tab: jump hosts, proxy and connection count.
msgctxt "ui.tab.conn"
msgid "Connection"
msgstr "Conexión"

#. Property sheet tab: the drive that is shown.
msgctxt "ui.tab.mount"
msgid "Mount"
msgstr "Montaje"

#. Property sheet tab: algorithms and host keys.
msgctxt "ui.tab.security"
msgid "Security"
msgstr "Seguridad"

#. Caption of the editor opened by New.
msgctxt "ui.editor.caption_new"
msgid "New connection"
msgstr "Nueva conexión"

#. Caption of the editor opened by Edit.
msgctxt "ui.editor.caption_edit"
msgid "Edit connection"
msgstr "Editar conexión"

#. Caption of the quick mount dialog (no saved profile).
msgctxt "ui.editor.caption_adhoc"
msgid "Quick mount"
msgstr "Montaje rápido"

#. General page: one line of help above the fields.
msgctxt "ui.general.intro"
msgid "Where the server is and which folder to show. Leave the user name empty to use your Windows user name."
msgstr "Dónde está el servidor y qué carpeta mostrar. Dejá vacío el usuario para usar el de Windows."

#. General page: the name of the saved connection.
msgctxt "ui.general.name"
msgid "Name"
msgstr "Nombre"

#. General page: server name or address.
msgctxt "ui.general.host"
msgid "Server address"
msgstr "Dirección del servidor"

#. General page: SSH port number.
msgctxt "ui.general.port"
msgid "Port"
msgstr "Puerto"

#. General page: user name on the server.
msgctxt "ui.general.user"
msgid "User name"
msgstr "Nombre de usuario"

#. General page: folder on the server that the drive shows.
msgctxt "ui.general.remote_path"
msgid "Remote folder (empty = the login folder)"
msgstr "Carpeta remota (vacío = carpeta de inicio)"

#. Authentication page: key file sign-in check box.
msgctxt "ui.auth.method_publickey"
msgid "Use a &key file"
msgstr "Usar un &archivo de clave"

#. Authentication page: keyboard-interactive check box.
msgctxt "ui.auth.method_kbdint"
msgid "Use &questions from the server (keyboard-interactive)"
msgstr "Usar preguntas del servidor (&keyboard-interactive)"

#. Authentication page: password sign-in check box.
msgctxt "ui.auth.method_password"
msgid "Use a &password"
msgstr "Usar una &contraseña"

#. Authentication page: label of the key file path.
msgctxt "ui.auth.identity"
msgid "Key file"
msgstr "Archivo de clave"

#. Authentication page: button that opens a file picker for the key file.
msgctxt "ui.auth.browse"
msgid "&Browse…"
msgstr "&Examinar…"

#. Authentication page: label of the certificate file.
msgctxt "ui.auth.certificate"
msgid "Certificate file (optional)"
msgstr "Archivo de certificado (opcional)"

#. Authentication page: label of the key agent list.
msgctxt "ui.auth.agent"
msgid "Key agent"
msgstr "Agente de claves"

#. Authentication page: label of the identities-only list.
msgctxt "ui.auth.identities_only"
msgid "Offer only the selected keys (recommended)"
msgstr "Ofrecer solo las claves seleccionadas (recomendado)"

#. Authentication page: keep the password on this computer.
msgctxt "ui.auth.save_password"
msgid "&Save the password on this computer"
msgstr "&Guardar la contraseña en este equipo"

#. Authentication page: remember the password for reconnects.
msgctxt "ui.auth.cache_secrets"
msgid "Re&member the password for reconnects"
msgstr "Recordar la contraseña para reconec&tar"

#. Connection page: one line of help above the fields.
msgctxt "ui.conn.intro"
msgid "How to reach the server: a jump host, a proxy and the number of connections."
msgstr "Cómo llegar al servidor: un host de salto, un proxy y la cantidad de conexiones."

#. Connection page: jump host list (profile names or host names).
msgctxt "ui.conn.jump"
msgid "Jump hosts (profile names or host names, separated by commas)"
msgstr "Hosts de salto (nombres de perfil o de host, separados por comas)"

#. Connection page: proxy type list.
msgctxt "ui.conn.proxy_kind"
msgid "Proxy"
msgstr "Proxy"

#. Connection page: proxy server name or address.
msgctxt "ui.conn.proxy_host"
msgid "Proxy server"
msgstr "Servidor proxy"

#. Connection page: proxy port number.
msgctxt "ui.conn.proxy_port"
msgid "Proxy port"
msgstr "Puerto del proxy"

#. Connection page: proxy user name; its password is asked when needed.
msgctxt "ui.conn.proxy_user"
msgid "Proxy user name (the password is asked when needed)"
msgstr "Usuario del proxy (la contraseña se pide cuando hace falta)"

#. Connection page: proxy authentication list.
msgctxt "ui.conn.proxy_auth"
msgid "Proxy authentication"
msgstr "Autenticación del proxy"

#. Connection page: number of parallel connections list.
msgctxt "ui.conn.connections"
msgid "Parallel connections (1 to 4; use 1 with two-step sign-in)"
msgstr "Conexiones en paralelo (1 a 4; usá 1 con ingreso en dos pasos)"

#. Connection page: keepalive interval in milliseconds.
msgctxt "ui.conn.keepalive"
msgid "Keepalive interval in milliseconds (0 = default)"
msgstr "Intervalo de keepalive en milisegundos (0 = predeterminado)"

#. Connection page: connect timeout in milliseconds.
msgctxt "ui.conn.connect_timeout"
msgid "Connect timeout in milliseconds (0 = default)"
msgstr "Tiempo límite de conexión en milisegundos (0 = predeterminado)"

#. Mount page: drive letter list; auto lets Windows choose.
msgctxt "ui.mount.target"
msgid "Drive letter"
msgstr "Letra de unidad"

#. Mount page: storage backend list.
msgctxt "ui.mount.backend"
msgid "Backend"
msgstr "Backend"

#. Mount page: read-only check box (mount group letters must be unique).
msgctxt "ui.mount.read_only"
msgid "&Read only"
msgstr "Solo &lectura"

#. Mount page: write mode list.
msgctxt "ui.mount.write_mode"
msgid "Writes"
msgstr "Escrituras"

#. Mount page: symbolic link handling list.
msgctxt "ui.mount.symlinks"
msgid "Symbolic links"
msgstr "Enlaces simbólicos"

#. Mount page: label of the drive in Explorer.
msgctxt "ui.mount.label"
msgid "Drive label"
msgstr "Etiqueta de unidad"

#. Mount page: how long to wait for the server when offline, in milliseconds.
msgctxt "ui.mount.offline_wait"
msgid "Wait for the server when offline, in milliseconds (0 = default)"
msgstr "Esperar al servidor si está sin conexión, en milisegundos (0 = predeterminado)"

#. Mount page: adds a Network locations entry in This PC (mount group letters must be unique).
msgctxt "ui.mount.network_location"
msgid "&Show in This PC under Network locations"
msgstr "&Mostrar en Este equipo, en Ubicaciones de red"

#. Mount page: size of the disk cache in megabytes.
msgctxt "ui.mount.disk_cache"
msgid "Disk cache size in MB (0 = off)"
msgstr "Tamaño de la caché en disco en MB (0 = desactivada)"

#. Drive letter list: first entry, Windows chooses the letter.
msgctxt "ui.target.auto"
msgid "Choose automatically"
msgstr "Elegir automáticamente"

#. Backend list: Windows chooses the backend.
msgctxt "ui.backend.auto"
msgid "Automatic"
msgstr "Automático"

#. Backend list: the Dokany driver (a product name).
msgctxt "ui.backend.dokany"
msgid "Dokany"
msgstr "Dokany"

#. Backend list: WebDAV (a protocol name).
msgctxt "ui.backend.webdav"
msgid "WebDAV"
msgstr "WebDAV"

#. Writes list: wait for the server on every write (default).
msgctxt "ui.write.through"
msgid "Wait for the server to confirm each write (safer)"
msgstr "Esperar la confirmación del servidor en cada escritura (más seguro)"

#. Writes list: acknowledge writes before the server confirms them.
msgctxt "ui.write.behind"
msgid "Write in the background (faster; recent changes can be lost if the connection drops)"
msgstr "Escribir en segundo plano (más rápido; si se corta la conexión, se pueden perder cambios recientes)"

#. Symbolic links list: links must stay inside the remote folder (default).
msgctxt "ui.symlinks.inside"
msgid "Stay inside the remote folder"
msgstr "Quedarse dentro de la carpeta remota"

#. Symbolic links list: follow links.
msgctxt "ui.symlinks.follow"
msgid "Follow"
msgstr "Seguir"

#. Symbolic links list: hide links.
msgctxt "ui.symlinks.hide"
msgid "Hide"
msgstr "Ocultar"

#. Security page: explains the outdated algorithms setting (03 7.6 warning).
msgctxt "ui.security.legacy_text"
