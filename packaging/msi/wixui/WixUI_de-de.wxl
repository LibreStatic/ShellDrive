<?xml version="1.0" encoding="utf-8"?>
<!-- German overrides of the WixUI_Minimal strings: informal du (AGENTS.md). Replaces the WiX stock de-de, which uses Sie. -->
<!-- Every id of packaging/msi/wixui/dialog-set.txt. Values that WiX's stock file already has in the project register are copied from it. -->
<WixLocalization Culture="de-de" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="CancelDlgIcon" Overridable="yes">WixUI_Ico_Info</String>
    <String Id="CancelDlgIconTooltip" Overridable="yes">Informationssymbol</String>
