# ShellDrive installer strings, English source of truth (03 §9.1, 04 §8.6). Used by the setup
# program (apps/shelldrive-setup). msgstr stays empty in en.po; the msgctxt is the stable symbolic id.
msgid ""
msgstr ""
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Title of the setup window and of its message boxes.
msgctxt "installer.window.title"
msgid "ShellDrive Setup"
msgstr ""

#. Progress line while setup starts.
msgctxt "installer.progress.prepare"
msgid "Preparing setup..."
msgstr ""

#. Progress line while the installed version is read.
msgctxt "installer.progress.check"
msgid "Checking the installed version..."
msgstr ""

#. Progress line while running ShellDrive programs are asked to close.
msgctxt "installer.progress.stop"
msgid "Closing running ShellDrive programs..."
msgstr ""

#. Progress line while the setup package is unpacked to a temporary folder.
msgctxt "installer.progress.extract"
msgid "Unpacking the files..."
msgstr ""

#. Progress line while files are copied. {folder} is the install folder.
msgctxt "installer.progress.copy"
msgid "Copying files to {folder}..."
msgstr ""

#. Progress line while the account registration is written.
msgctxt "installer.progress.register"
msgid "Registering ShellDrive for this account..."
msgstr ""

#. Progress line while the Start menu shortcut is created.
msgctxt "installer.progress.shortcut"
msgid "Creating the Start menu shortcut..."
msgstr ""

#. Progress line while uninstalling. {folder} is the install folder.
msgctxt "installer.progress.uninstall"
msgid "Removing ShellDrive from {folder}..."
msgstr ""

#. Progress line while the portable copy is unpacked. {folder} is the chosen folder.
msgctxt "installer.progress.portable"
msgid "Unpacking the portable copy to {folder}..."
msgstr ""

#. Final line after an install. {version} is the product version, {folder} the install folder.
msgctxt "installer.done.install"
msgid "ShellDrive {version} is installed in {folder}."
msgstr ""

#. Final line after an uninstall. Settings and profiles are kept by default.
msgctxt "installer.done.uninstall"
msgid "ShellDrive has been removed. Your settings and profiles were kept."
msgstr ""

#. Final line after a portable extraction. {folder} is the chosen folder.
msgctxt "installer.done.portable"
msgid "The portable copy is ready in {folder}."
msgstr ""

#. Summary line after an install. {count} is the number of files copied.
#, plural-arg=count
msgctxt "installer.summary.files"
msgid "{count} file copied."
msgid_plural "{count} files copied."
msgstr[0] ""
msgstr[1] ""

#. Shown after an error, with the path of the setup log. {path} is the log file.
msgctxt "installer.log.saved"
msgid "Details were written to {path}."
msgstr ""

#. Shown for a portable copy on a drive without file permissions.
msgctxt "installer.warn.volume"
msgid "This drive may not keep file permissions, so anyone with it can change the files."
msgstr ""

#. Error for an unknown or malformed command-line option. {option} is the option as typed.
msgctxt "installer.error.args"
msgid "Unknown or invalid option: {option}. Run setup with /help for the options."
msgstr ""

#. Error for /permachine in builds without the MSI engine.
msgctxt "installer.error.machine_unsupported"
msgid "Installing for all users is not available in this version. Run setup without /permachine."
msgstr ""

#. Error when the processor has no SSE2 and the SSE2 build was asked for. {flavour} is the build name.
msgctxt "installer.error.flavour_sse2"
msgid "This processor does not support SSE2, so the {flavour} build cannot run here."
msgstr ""

#. Error when the Windows version is older than the build needs. {flavour} is the build name.
msgctxt "installer.error.flavour_os"
msgid "The {flavour} build needs a newer version of Windows."
msgstr ""

#. Error for a processor type the setup program does not know.
msgctxt "installer.error.flavour_cpu"
msgid "This processor is not supported by this setup program."
msgstr ""

#. Error for 32-bit Windows on ARM, which needs its own setup program.
msgctxt "installer.error.flavour_arm32"
msgid "Windows on ARM (32-bit) needs the ARM32 setup program."
msgstr ""

#. Error when the build does not match the Windows bitness or processor. {flavour} is the build name.
msgctxt "installer.error.flavour_bitness"
msgid "The {flavour} build cannot run on this version of Windows or this processor."
msgstr ""

#. Error when the setup program has no files for the chosen build. {flavour} is the build name.
msgctxt "installer.error.payload_missing"
msgid "This setup program does not include the files for {flavour}."
msgstr ""

#. Error when the embedded package does not match its recorded checksum.
msgctxt "installer.error.payload_damaged"
msgid "The setup program is damaged. Download it again."
msgstr ""

#. Error for a file name inside the package that could escape the install folder. {name} is that name.
msgctxt "installer.error.payload_unsafe"
msgid "The setup package contains an unsafe file name: {name}."
msgstr ""

#. Error when the package or one of its files is larger than the allowed size.
msgctxt "installer.error.payload_too_big"
msgid "The setup package is larger than the allowed size."
msgstr ""

#. Error when the package cannot be unpacked. {code} is the Windows error code.
msgctxt "installer.error.payload_extract"
msgid "The setup files could not be unpacked (error {code})."
msgstr ""

#. Error when a newer version is installed and /update was not given. {version} is that version.
msgctxt "installer.error.newer_installed"
msgid "A newer ShellDrive ({version}) is already installed. Use /update to replace it."
msgstr ""

#. Error when ShellDrive is still running after it was asked to close, and /force was not given.
msgctxt "installer.error.running"
msgid "ShellDrive is still running. Close it and try again, or use /force."
msgstr ""

#. Error when a file cannot be replaced. {file} is the file name.
msgctxt "installer.error.file_locked"
msgid "Could not replace {file}. Close the programs that use it and try again."
msgstr ""

#. Error when a folder cannot be written. {path} is the folder.
msgctxt "installer.error.write"
msgid "Setup could not write to {path}."
msgstr ""

#. Error when a per-machine installation already exists and a per-user one was requested.
msgctxt "installer.error.machine_exists"
msgid "ShellDrive is installed for all users. Remove that copy first."
msgstr ""

#. Error for /uninstall when no ShellDrive is registered for this account.
msgctxt "installer.error.not_installed"
msgid "ShellDrive is not installed for this account."
msgstr ""

#. Error for a portable folder that already has files. {folder} is the folder.
msgctxt "installer.error.portable_not_empty"
msgid "The folder {folder} is not empty. Choose an empty folder."
msgstr ""

#. Generic error with the Windows error code. {code} is the number.
msgctxt "installer.error.generic"
msgid "Setup failed with error {code}."
msgstr ""

#. Output of /help. Option names and separators are literal syntax.
msgctxt "installer.help"
msgid "Usage: ShellDrive-setup.exe [/quiet | /passive] [/peruser | /portable=<folder>] [/uninstall] [/update] [/force] [/autostart=0|1] [/flavour=<name>] [/log=<file>] [/lang=<code>]"
msgstr ""

#. Wizard button: go to the previous page.
msgctxt "installer.button.back"
msgid "Back"
msgstr ""

#. Wizard button: go to the next page.
msgctxt "installer.button.next"
msgid "Next"
msgstr ""

#. Wizard button: start the installation.
msgctxt "installer.button.install"
msgid "Install"
msgstr ""

#. Wizard button: start the removal.
msgctxt "installer.button.uninstall"
msgid "Uninstall"
msgstr ""

#. Wizard button: close the setup after it completed.
msgctxt "installer.button.finish"
msgid "Finish"
msgstr ""

#. Wizard button: stop without changing anything.
msgctxt "installer.button.cancel"
msgid "Cancel"
msgstr ""

#. Wizard button: choose a folder with a dialog. The dots are part of the label.
msgctxt "installer.button.browse"
msgid "Browse..."
msgstr ""

#. Title of the first page.
msgctxt "installer.welcome.title"
msgid "Welcome to ShellDrive Setup"
msgstr ""

#. Text of the first page.
msgctxt "installer.welcome.text"
msgid "This wizard installs ShellDrive on this computer. Click Next to continue."
msgstr ""

#. Title of the license page.
msgctxt "installer.license.title"
msgid "License"
msgstr ""

#. Line above the license text. The license itself is in English.
msgctxt "installer.license.intro"
msgid "ShellDrive is free software released under the MIT License. The license text below is in English, the language of the license."
msgstr ""

#. The MIT License text. Legal text: it is not translated, in any locale.
msgctxt "installer.license.text"
msgid "MIT License\n\nCopyright (c) LibreStatic\n\nPermission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the \"Software\"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE."
msgstr ""

#. Title of the install mode page.
msgctxt "installer.mode.title"
msgid "Install mode"
msgstr ""

#. Text of the install mode page.
msgctxt "installer.mode.text"
msgid "Choose where ShellDrive is installed."
msgstr ""

#. Radio button: install for the current account only.
msgctxt "installer.mode.user"
msgid "Install for me only (no administrator rights needed)"
msgstr ""

#. Radio button: install for every user of the computer. Disabled in this version.
msgctxt "installer.mode.machine"
msgid "Install for all users (requires administrator)"
msgstr ""

#. Radio button: copy ShellDrive to a folder of the user's choice, with no registration.
msgctxt "installer.mode.portable"
msgid "Portable (copy to a folder you choose)"
msgstr ""

#. Shown under the all-users choice, which this version does not offer yet.
msgctxt "installer.mode.machine_reason"
msgid "Not available yet: installing for all users needs the MSI package, which this version does not include."
msgstr ""

#. Title of the destination page (portable copies).
msgctxt "installer.dest.title"
msgid "Destination folder"
msgstr ""

#. Text of the destination page. The folder must be new or empty.
msgctxt "installer.dest.text"
msgid "ShellDrive is copied to this folder. Choose a new or empty folder."
msgstr ""

#. Title of the Dokany page. Dokany is a product name and is not translated.
msgctxt "installer.dokany.title"
msgid "Dokany driver"
msgstr ""

#. Explains the Dokany driver on the per-machine page.
msgctxt "installer.dokany.text"
msgid "Dokany is a file system driver from the Dokany project. It is a signed third-party kernel driver. It is installed for the whole computer, stays available to every user, and ShellDrive does not remove it when ShellDrive is uninstalled."
msgstr ""

#. Checkbox on the Dokany page. Checked by default when the driver can be installed.
msgctxt "installer.dokany.option"
msgid "Install the Dokany file system driver (recommended)"
msgstr ""

#. Shown on the Dokany page when this Windows version cannot take the driver.
msgctxt "installer.dokany.unavailable"
msgid "This version of Windows cannot use the Dokany driver. ShellDrive uses WebDAV."
msgstr ""

#. Shown on the Dokany page under the checkbox, when it is unchecked.
msgctxt "installer.dokany.skip_note"
msgid "Without Dokany, ShellDrive uses only the WebDAV backend."
msgstr ""

#. Title of the last page after an installation.
msgctxt "installer.finish.title"
msgid "Setup is complete"
msgstr ""

#. Checkbox on the last page: start ShellDrive when setup closes.
msgctxt "installer.finish.launch"
msgid "Launch ShellDrive"
msgstr ""

#. Shown when ShellDrive could not be started from the last page.
msgctxt "installer.launch.failed"
msgid "ShellDrive could not be started. Open it from the Start menu."
msgstr ""

#. Title of the removal confirmation page.
msgctxt "installer.uninstall.title"
msgid "Remove ShellDrive"
msgstr ""

#. Text of the removal confirmation page. {folder} is the install folder.
msgctxt "installer.uninstall.text"
msgid "ShellDrive will be removed from {folder}. Your settings and profiles are kept."
msgstr ""

#. Question on the removal confirmation page.
msgctxt "installer.uninstall.question"
msgid "Do you want to remove ShellDrive from this computer?"
msgstr ""

# MSI strings (04 §8.6): WiX localization ids, one msi.<Id> entry each (tools/sd-msigen wxl).
#. WiX string FeatureCoreTitle of the MSI.
msgctxt "msi.feature.core.title"
msgid "Program files"
msgstr ""

#. WiX string FeatureCoreDesc of the MSI.
msgctxt "msi.feature.core.desc"
msgid "The command line, the background agent and the window. Always installed."
msgstr ""

#. WiX string FeatureShellExtTitle of the MSI.
msgctxt "msi.feature.shellext.title"
msgid "File Explorer menu"
msgstr ""

#. WiX string FeatureShellExtDesc of the MSI.
msgctxt "msi.feature.shellext.desc"
msgid "Adds ShellDrive commands to the right-click menu of drives and folders."
msgstr ""

#. WiX string FeatureServiceTitle of the MSI.
msgctxt "msi.feature.service.title"
msgid "Background service"
msgstr ""

#. WiX string FeatureServiceDesc of the MSI.
msgctxt "msi.feature.service.desc"
msgid "Keeps the global drives of the machine running before any user signs in."
msgstr ""

#. WiX string FeatureStartMenuTitle of the MSI.
msgctxt "msi.feature.startmenu.title"
msgid "Start menu shortcut"
msgstr ""

#. WiX string FeatureStartMenuDesc of the MSI.
msgctxt "msi.feature.startmenu.desc"
msgid "Adds ShellDrive to the Start menu."
msgstr ""

#. WiX string FeatureAutostartTitle of the MSI.
msgctxt "msi.feature.autostart.title"
msgid "Start at sign-in"
msgstr ""

#. WiX string FeatureAutostartDesc of the MSI.
msgctxt "msi.feature.autostart.desc"
msgid "Starts the ShellDrive agent when each user signs in."
msgstr ""

#. WiX string DowngradeError of the MSI (MajorUpgrade).
msgctxt "msi.downgrade.error"
msgid "A newer version of ShellDrive is already installed."
msgstr ""

#. WiX string OsRequired of the MSI (launch condition).
msgctxt "msi.os.required"
msgid "This package of ShellDrive needs Windows 10 or later. Use the package for your version of Windows."
msgstr ""
