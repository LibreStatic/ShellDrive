# ShellDrive UI strings, it (03 §9.1). msgctxt is the stable symbolic id; msgid is the English source.
msgid ""
msgstr ""
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n == 1 ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

#. Tray icon tooltip when no drive is mounted.
#. sdl10n:maxlen=128
msgctxt "ui.tray.tip_none"
msgid "ShellDrive: no drives mounted"
msgstr "ShellDrive: nessuna unità montata"

#. Tray icon tooltip with the number of mounted drives.
#. sdl10n:maxlen=128
#, plural-arg=count
msgctxt "ui.tray.tip_count"
msgid "ShellDrive: {count} drive mounted."
msgid_plural "ShellDrive: {count} drives mounted."
msgstr[0] "ShellDrive: {count} unità montata."
msgstr[1] "ShellDrive: {count} di unità montate."
msgstr[2] "ShellDrive: {count} unità montate."

#. Tray menu: opens the main window.
msgctxt "ui.tray.open"
msgid "Open ShellDrive"
msgstr "Apri ShellDrive"

#. Tray menu: quits the tray application. Mounts and the agent keep running.
msgctxt "ui.tray.exit"
msgid "Exit"
msgstr "Esci"

#. Tray menu: disabled item shown when no drive is mounted.
msgctxt "ui.tray.no_drives"
msgid "No drives mounted"
msgstr "Nessuna unità montata"

#. Tray menu item for one mounted drive. {drive} is a letter such as E:, {profile} is the profile name.
msgctxt "ui.tray.unmount"
msgid "Unmount {drive} ({profile})"
msgstr "Smonta {drive} ({profile})"

#. Main window list column: profile name.
msgctxt "ui.main.col_name"
msgid "Name"
msgstr "Nome"

#. Main window list column: drive letter.
msgctxt "ui.main.col_drive"
msgid "Drive"
msgstr "Unità"

#. Main window list column: connection state.
msgctxt "ui.main.col_state"
msgid "State"
msgstr "Stato"

#. Main window list column: storage backend (product names Dokany or WebDAV).
msgctxt "ui.main.col_backend"
msgid "Backend"
msgstr "Backend"

#. Main window list column: server host name.
msgctxt "ui.main.col_server"
msgid "Server"
msgstr "Server"

#. Main window button that mounts the selected connection.
msgctxt "ui.main.mount"
msgid "Mount"
msgstr "Monta"

#. Main window button that unmounts the selected drive.
msgctxt "ui.main.unmount"
msgid "Unmount"
msgstr "Smonta"

#. Main window button that asks the agent for the mount list again.
msgctxt "ui.main.refresh"
msgid "Refresh"
msgstr "Aggiorna"

#. Status bar summary of the mounts.
#, plural-arg=count
msgctxt "ui.status.count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} unità montata."
msgstr[1] "{count} di unità montate."
msgstr[2] "{count} unità montate."

#. Status bar when the agent is not running.
msgctxt "ui.status.agent_down"
msgid "ShellDrive is not running."
msgstr "ShellDrive non è in esecuzione."

#. Mount state in the list: the agent is opening the connection.
msgctxt "ui.state.connecting"
msgid "Connecting"
msgstr "Connessione"

#. Mount state in the list: signing in to the server.
msgctxt "ui.state.authenticating"
msgid "Signing in"
msgstr "Autenticazione"

#. Mount state in the list: the drive is mounted and usable.
msgctxt "ui.state.mounted"
msgid "Connected"
msgstr "Connesso"

#. Mount state in the list: the connection is lost and ShellDrive retries.
msgctxt "ui.state.offline"
msgid "Offline"
msgstr "Offline"

#. Mount state in the list: the user has to sign in again.
msgctxt "ui.state.auth_required"
msgid "Sign-in required"
msgstr "Accesso richiesto"

#. Mount state in the list: the mount failed.
msgctxt "ui.state.failed"
msgid "Failed"
msgstr "Non riuscito"

#. Mount state in the list: the drive is being unmounted.
msgctxt "ui.state.unmounting"
msgid "Disconnecting"
msgstr "Smontaggio"

#. Mount state in the list: the drive is no longer mounted.
msgctxt "ui.state.unmounted"
msgid "Not mounted"
msgstr "Smontato"

#. Balloon title for warnings from the agent.
#. sdl10n:maxlen=64
msgctxt "ui.warn.title"
msgid "ShellDrive warning"
msgstr "Avviso di ShellDrive"

#. Balloon text: the connection uses outdated algorithms. {drive} is a drive letter such as E:.
#. sdl10n:maxlen=256
msgctxt "ui.warn.legacy"
msgid "Drive {drive} uses outdated security. Open ShellDrive for details."
msgstr "L'unità {drive} usa una sicurezza obsoleta. Apri ShellDrive per i dettagli."

#. Balloon text: the connection is open to a known attack until the server is updated.
#. sdl10n:maxlen=256
msgctxt "ui.warn.terrapin"
msgid "Drive {drive} is open to a known attack until the server is updated."
msgstr "L'unità {drive} è esposta a un attacco noto finché il server non viene aggiornato."

#. Balloon text: changes could not be written to the server.
#. sdl10n:maxlen=256
msgctxt "ui.warn.write_failed"
msgid "Changes to drive {drive} could not be saved."
msgstr "Impossibile salvare le modifiche all'unità {drive}."

#. Balloon text for any other warning.
#. sdl10n:maxlen=256
msgctxt "ui.warn.generic"
msgid "Drive {drive} needs your attention. Open ShellDrive for details."
msgstr "L'unità {drive} richiede attenzione. Apri ShellDrive per i dettagli."

#. Message box when the agent refuses to unmount a drive.
msgctxt "ui.error.unmount"
msgid "Could not unmount drive {drive}."
msgstr "Impossibile smontare l'unità {drive}."

#. Prompt dialog title for a server whose host key is not known yet (first connection).
msgctxt "ui.prompt.title_hostkey"
msgid "Unknown server"
msgstr "Server sconosciuto"

#. Prompt dialog title when a known server presents a different host key. ShellDrive never offers to accept it.
msgctxt "ui.prompt.title_changed"
msgid "Server identity changed"
msgstr "L'identità del server è cambiata"

#. Prompt dialog title for a password. {host} is the server name.
msgctxt "ui.prompt.title_password"
msgid "Sign in to {host}"
msgstr "Accedi a {host}"

#. Prompt dialog title for a key passphrase. {profile} is the profile name.
msgctxt "ui.prompt.title_passphrase"
msgid "Passphrase for {profile}"
msgstr "Passphrase di {profile}"

#. Prompt dialog title for keyboard-interactive questions. {host} is the server name.
msgctxt "ui.prompt.title_kbdint"
msgid "Verification from {host}"
msgstr "Verifica da {host}"

#. Prompt dialog title when the server requires a password change. {host} is the server name.
msgctxt "ui.prompt.title_change"
msgid "Change your password on {host}"
msgstr "Cambia la password su {host}"

#. Prompt dialog title for outdated security algorithms. {host} is the server name.
msgctxt "ui.prompt.title_legacy"
msgid "Outdated security on {host}"
msgstr "Sicurezza obsoleta su {host}"

#. Prompt dialog title for a proxy password. {profile} is the profile name.
msgctxt "ui.prompt.title_proxy"
msgid "Proxy password for {profile}"
msgstr "Password del proxy di {profile}"

#. Prompt dialog: first line for a host key or keyboard prompt. {host} and {port} are the server and its port.
msgctxt "ui.prompt.hostkey_intro"
msgid "The authenticity of host {host} (port {port}) can't be established."
msgstr "Impossibile verificare l'autenticità dell'host {host} (porta {port})."

#. Prompt dialog: a jump host chain. {hop} is this hop (from 1) and {hops} the total number of hops.
msgctxt "ui.prompt.hop_info"
msgid "Jump host {hop} of {hops}."
msgstr "Host di salto {hop} di {hops}."

#. Prompt dialog: names the jump host the connection went through. {via} is that host name.
msgctxt "ui.prompt.reach_via"
msgid "Reached through jump host {via}."
msgstr "Raggiunto tramite l'host di salto {via}."

#. Prompt dialog: the profile line, outside the server text. {profile} is the profile name.
msgctxt "ui.prompt.profile_line"
msgid "Profile: {profile}"
msgstr "Profilo: {profile}"

#. Prompt dialog: the server and user line of a sign-in prompt. {host} and {user} are the server and the account.
msgctxt "ui.prompt.target_line"
msgid "Server: {host}, user: {user}"
msgstr "Server: {host}, utente: {user}"

#. Prompt dialog: key type of a new host key. {type} is the algorithm name, such as ED25519.
msgctxt "ui.prompt.key_type"
msgid "Key type: {type}"
msgstr "Tipo di chiave: {type}"

#. Prompt dialog: label of the read-only fingerprint field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.fingerprint"
msgid "&Fingerprint (SHA-256):"
msgstr "&Impronta (SHA-256):"

#. Prompt dialog: asks the user to check a new host key with the administrator.
msgctxt "ui.prompt.hostkey_check"
msgid "Ask the server's administrator to confirm this fingerprint before you trust it."
msgstr "Chiedi all'amministratore del server di confermare questa impronta prima di fidarti."

#. Prompt dialog: explains the two trust buttons. Use the same words as the button captions.
msgctxt "ui.prompt.hostkey_choice"
msgid "Trust and connect saves this server's key for next time. Connect once uses it only for this connection."
msgstr "Fidati e connetti salva la chiave di questo server per le prossime volte. Connetti una volta la usa solo per questa connessione."

#. Prompt dialog: screen reader hint, because no button is the default for a trust decision.
msgctxt "ui.prompt.choose_button"
msgid "Choose a button to continue."
msgstr "Scegli un pulsante per continuare."

#. Prompt dialog button: trusts the new host key, saves it and connects.
msgctxt "ui.prompt.btn.trust"
msgid "&Trust and connect"
msgstr "&Fidati e connetti"

#. Prompt dialog button: connects once with a new host key, without saving it.
msgctxt "ui.prompt.btn.once"
msgid "Connect &once"
msgstr "Connetti &una volta"

#. Prompt dialog button: closes the dialog without answering the request (rejects it).
msgctxt "ui.prompt.btn.cancel"
msgid "&Cancel"
msgstr "&Annulla"

#. Prompt dialog button for the host key change notice: closes it.
msgctxt "ui.prompt.btn.close"
msgid "Clos&e"
msgstr "Ch&iudi"

#. Prompt dialog button: sends the password or passphrase and connects.
msgctxt "ui.prompt.btn.connect"
msgid "Co&nnect"
msgstr "Con&netti"

#. Prompt dialog button: sends the keyboard-interactive answers.
msgctxt "ui.prompt.btn.verify"
msgid "&Verify"
msgstr "&Verifica"

#. Prompt dialog button: sends the old and new passwords.
msgctxt "ui.prompt.btn.change"
msgid "Chan&ge password"
msgstr "Cambia &password"

#. Prompt dialog button: continues with the outdated algorithms, once.
msgctxt "ui.prompt.btn.anyway"
msgid "Continue &anyway"
msgstr "Continua &comunque"

#. Prompt dialog: a host key change notice. {host} is the server name.
msgctxt "ui.prompt.changed_intro"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "L'identità di {host} è cambiata. ShellDrive ha interrotto la connessione."

#. Prompt dialog: warning under the host key change notice.
msgctxt "ui.prompt.changed_warning"
msgid "This can mean someone is intercepting the connection. Ask the server's administrator before you change anything."
msgstr "Potrebbe significare che qualcuno sta intercettando la connessione. Chiedi all'amministratore del server prima di cambiare qualcosa."

#. Prompt dialog: the key ShellDrive has stored. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_stored"
msgid "Stored key: {fingerprint}"
msgstr "Chiave salvata: {fingerprint}"

#. Prompt dialog: the key the server offers now. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_offered"
msgid "Offered key: {fingerprint}"
msgstr "Chiave offerta: {fingerprint}"

#. Prompt dialog: the server sent its own text (name, instruction) above the answer fields.
msgctxt "ui.prompt.server_caption"
msgid "From the server (ShellDrive does not check this text):"
msgstr "Dal server (ShellDrive non verifica questo testo):"

#. Prompt dialog: appended to a password prompt after a host key was accepted in this connection.
msgctxt "ui.prompt.just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Hai appena accettato l'identità di questo server. ShellDrive non ha inviato automaticamente la password salvata."

#. Prompt dialog: the password is asked again because the connection was lost.
msgctxt "ui.prompt.reconnect"
msgid "The connection was lost. Enter your password to reconnect."
msgstr "La connessione è stata interrotta. Inserisci la password per riconnetterti."

#. Prompt dialog: label of the password field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.password"
msgid "&Password:"
msgstr "&Password:"

#. Prompt dialog: label of the key passphrase field.
msgctxt "ui.prompt.field.passphrase"
msgid "Passph&rase:"
msgstr "Passph&rase:"

#. Prompt dialog: label of the proxy password field.
msgctxt "ui.prompt.field.proxy"
msgid "Pro&xy password:"
msgstr "Password del pro&xy:"

#. Prompt dialog: label of the current password in a password change.
msgctxt "ui.prompt.field.current"
msgid "C&urrent password:"
msgstr "Password &attuale:"

#. Prompt dialog: label of the new password in a password change.
msgctxt "ui.prompt.field.new"
msgid "Ne&w password:"
msgstr "&Nuova password:"

#. Prompt dialog: label of the repeated new password in a password change.
msgctxt "ui.prompt.field.retype"
msgid "Re&type new password:"
msgstr "Ripe&ti la nuova password:"

#. Prompt dialog: check box that keeps the secret on this computer, shown only when it can be saved.
msgctxt "ui.prompt.check.save"
msgid "&Save on this computer"
msgstr "&Salva su questo computer"

#. Prompt dialog: shows the fingerprint of the key that unlocks a key file. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.key_fingerprint"
msgid "Key fingerprint: {fingerprint}"
msgstr "Impronta della chiave: {fingerprint}"

#. Prompt dialog: the server asks a password change. {user} is the account name.
msgctxt "ui.prompt.change_intro"
msgid "The server asks you to choose a new password for {user}."
msgstr "Il server ti chiede di scegliere una nuova password per {user}."

#. Prompt dialog: the new passwords differ.
msgctxt "ui.prompt.mismatch"
msgid "The new passwords do not match."
msgstr "Le nuove password non corrispondono."

#. Prompt dialog: a field is empty.
msgctxt "ui.prompt.empty"
msgid "Fill in every field."
msgstr "Compila tutti i campi."

#. Prompt dialog: the answer could not be queued for the agent; the dialog stays open.
msgctxt "ui.prompt.send_failed"
msgid "ShellDrive could not send your answer. Try again."
msgstr "ShellDrive non è riuscito a inviare la risposta. Riprova."

#. Prompt dialog: label above one keyboard-interactive answer field. {n} is this field and {total} the count.
msgctxt "ui.prompt.kbd_answer"
msgid "Answer {n} of {total}:"
msgstr "Risposta {n} di {total}:"

#. Prompt dialog: the server asks questions. {host} is the server name and {port} its port.
msgctxt "ui.prompt.kbdint_intro"
msgid "The server {host} (port {port}) asks you to answer these questions."
msgstr "Il server {host} (porta {port}) ti chiede di rispondere a queste domande."

#. Prompt dialog: a proxy needs a password. {proxy_host} and {proxy_port} are the proxy, {host} the server.
msgctxt "ui.prompt.proxy_intro"
msgid "The proxy {proxy_host}:{proxy_port} needs a password to reach {host}."
msgstr "Il proxy {proxy_host}:{proxy_port} richiede una password per raggiungere {host}."

#. Prompt dialog: the proxy user name. {user} is the user name.
msgctxt "ui.prompt.proxy_user"
msgid "Proxy user: {user}"
msgstr "Utente del proxy: {user}"

#. Prompt dialog: outdated algorithms. {host} is the server, {algorithms} a list such as hmac-sha1, 3des-cbc.
msgctxt "ui.prompt.legacy_intro"
msgid "{host} uses outdated security algorithms: {algorithms}."
msgstr "{host} usa algoritmi di sicurezza obsoleti: {algorithms}."

#. Prompt dialog: explains the outdated algorithms warning.
msgctxt "ui.prompt.legacy_text"
msgid "The connection works, but these algorithms are easier to attack. Continue only if you trust this server."
msgstr "La connessione funziona, ma questi algoritmi sono più facili da attaccare. Continua solo se ti fidi di questo server."

#. Prompt dialog: remaining time, shown as text only. {count} is the number of minutes, at least 1.
#, plural-arg=count
msgctxt "ui.prompt.deadline"
msgid "Time left to answer: about {count} minute."
msgid_plural "Time left to answer: about {count} minutes."
msgstr[0] "Tempo per rispondere: circa {count} minuto."
msgstr[1] "Tempo per rispondere: circa {count} minuti."
msgstr[2] "Tempo per rispondere: circa {count} minuti."

#. Tray balloon when a prompt expired without an answer. {profile} is the profile name.
msgctxt "ui.prompt.timeout"
msgid "A sign-in for {profile} timed out. Open ShellDrive to try again."
msgstr "Il tempo per accedere a {profile} è scaduto. Apri ShellDrive per riprovare."

#. Property sheet tab: general connection settings.
msgctxt "ui.tab.general"
msgid "General"
msgstr "Generale"

#. Property sheet tab: how to sign in.
msgctxt "ui.tab.auth"
msgid "Authentication"
msgstr "Autenticazione"

#. Property sheet tab: jump hosts, proxy and connection count.
msgctxt "ui.tab.conn"
msgid "Connection"
msgstr "Connessione"

#. Property sheet tab: the drive that is shown.
msgctxt "ui.tab.mount"
msgid "Mount"
msgstr "Montaggio"

#. Property sheet tab: algorithms and host keys.
msgctxt "ui.tab.security"
msgid "Security"
msgstr "Sicurezza"

#. Caption of the editor opened by New.
msgctxt "ui.editor.caption_new"
msgid "New connection"
msgstr "Nuova connessione"

#. Caption of the editor opened by Edit.
msgctxt "ui.editor.caption_edit"
msgid "Edit connection"
msgstr "Modifica connessione"

#. Caption of the quick mount dialog (no saved profile).
msgctxt "ui.editor.caption_adhoc"
msgid "Quick mount"
msgstr "Montaggio rapido"

#. General page: one line of help above the fields.
msgctxt "ui.general.intro"
msgid "Where the server is and which folder to show. Leave the user name empty to use your Windows user name."
msgstr "Indica dove si trova il server e la cartella da mostrare. Lascia vuoto il nome utente per usare quello di Windows."

#. General page: the name of the saved connection.
msgctxt "ui.general.name"
msgid "Name"
msgstr "Nome"

#. General page: server name or address.
msgctxt "ui.general.host"
msgid "Server address"
msgstr "Indirizzo del server"

#. General page: SSH port number.
msgctxt "ui.general.port"
msgid "Port"
msgstr "Porta"

#. General page: user name on the server.
msgctxt "ui.general.user"
msgid "User name"
msgstr "Nome utente"

#. General page: folder on the server that the drive shows.
msgctxt "ui.general.remote_path"
msgid "Remote folder (empty = the login folder)"
msgstr "Cartella remota (vuota = cartella di accesso)"

#. Authentication page: key file sign-in check box.
msgctxt "ui.auth.method_publickey"
msgid "Use a &key file"
msgstr "Usa un &file di chiave"

#. Authentication page: keyboard-interactive check box.
msgctxt "ui.auth.method_kbdint"
msgid "Use &questions from the server (keyboard-interactive)"
msgstr "Usa le &domande del server (keyboard-interactive)"

#. Authentication page: password sign-in check box.
msgctxt "ui.auth.method_password"
msgid "Use a &password"
msgstr "Usa una &password"

#. Authentication page: label of the key file path.
msgctxt "ui.auth.identity"
msgid "Key file"
msgstr "File di chiave"

#. Authentication page: button that opens a file picker for the key file.
msgctxt "ui.auth.browse"
msgid "&Browse…"
msgstr "&Sfoglia…"

#. Authentication page: label of the certificate file.
msgctxt "ui.auth.certificate"
msgid "Certificate file (optional)"
msgstr "File del certificato (facoltativo)"

#. Authentication page: label of the key agent list.
msgctxt "ui.auth.agent"
msgid "Key agent"
msgstr "Agente di chiavi"

#. Authentication page: label of the identities-only list.
msgctxt "ui.auth.identities_only"
msgid "Offer only the selected keys (recommended)"
msgstr "Proponi solo le chiavi selezionate (consigliato)"

#. Authentication page: keep the password on this computer.
msgctxt "ui.auth.save_password"
msgid "&Save the password on this computer"
msgstr "Sal&va la password su questo computer"

#. Authentication page: remember the password for reconnects.
msgctxt "ui.auth.cache_secrets"
msgid "Re&member the password for reconnects"
msgstr "Ricorda la password per le ria&ttivazioni"

#. Connection page: one line of help above the fields.
msgctxt "ui.conn.intro"
msgid "How to reach the server: a jump host, a proxy and the number of connections."
msgstr "Come raggiungere il server: un host di salto, un proxy e il numero di connessioni."

#. Connection page: jump host list (profile names or host names).
msgctxt "ui.conn.jump"
msgid "Jump hosts (profile names or host names, separated by commas)"
msgstr "Host di salto (nomi di profilo o di host, separati da virgole)"

#. Connection page: proxy type list.
msgctxt "ui.conn.proxy_kind"
msgid "Proxy"
msgstr "Proxy"

#. Connection page: proxy server name or address.
msgctxt "ui.conn.proxy_host"
msgid "Proxy server"
msgstr "Server proxy"

#. Connection page: proxy port number.
msgctxt "ui.conn.proxy_port"
msgid "Proxy port"
msgstr "Porta del proxy"

#. Connection page: proxy user name; its password is asked when needed.
msgctxt "ui.conn.proxy_user"
msgid "Proxy user name (the password is asked when needed)"
msgstr "Nome utente del proxy (la password viene richiesta se serve)"

#. Connection page: proxy authentication list.
msgctxt "ui.conn.proxy_auth"
msgid "Proxy authentication"
msgstr "Autenticazione del proxy"

#. Connection page: number of parallel connections list.
msgctxt "ui.conn.connections"
msgid "Parallel connections (1 to 4; use 1 with two-step sign-in)"
msgstr "Connessioni parallele (da 1 a 4; usa 1 con l'accesso in due passaggi)"

#. Connection page: keepalive interval in milliseconds.
msgctxt "ui.conn.keepalive"
msgid "Keepalive interval in milliseconds (0 = default)"
msgstr "Intervallo di keepalive in millisecondi (0 = predefinito)"

#. Connection page: connect timeout in milliseconds.
msgctxt "ui.conn.connect_timeout"
msgid "Connect timeout in milliseconds (0 = default)"
msgstr "Timeout di connessione in millisecondi (0 = predefinito)"

#. Mount page: drive letter list; auto lets Windows choose.
msgctxt "ui.mount.target"
msgid "Drive letter"
msgstr "Lettera dell'unità"

#. Mount page: storage backend list.
msgctxt "ui.mount.backend"
msgid "Backend"
msgstr "Backend"

#. Mount page: read-only check box (mount group letters must be unique).
msgctxt "ui.mount.read_only"
msgid "&Read only"
msgstr "Solo &lettura"

#. Mount page: write mode list.
msgctxt "ui.mount.write_mode"
msgid "Writes"
msgstr "Scritture"

#. Mount page: symbolic link handling list.
msgctxt "ui.mount.symlinks"
msgid "Symbolic links"
msgstr "Collegamenti simbolici"

#. Mount page: label of the drive in Explorer.
msgctxt "ui.mount.label"
msgid "Drive label"
msgstr "Etichetta dell'unità"

#. Mount page: how long to wait for the server when offline, in milliseconds.
msgctxt "ui.mount.offline_wait"
msgid "Wait for the server when offline, in milliseconds (0 = default)"
msgstr "Attesa del server quando non raggiungibile, in millisecondi (0 = predefinito)"

#. Mount page: adds a Network locations entry in This PC (mount group letters must be unique).
msgctxt "ui.mount.network_location"
msgid "&Show in This PC under Network locations"
msgstr "&Mostra in Questo PC, in Posizioni di rete"

#. Mount page: size of the disk cache in megabytes.
msgctxt "ui.mount.disk_cache"
msgid "Disk cache size in MB (0 = off)"
msgstr "Dimensione della cache su disco in MB (0 = disattivata)"

#. Drive letter list: first entry, Windows chooses the letter.
msgctxt "ui.target.auto"
msgid "Choose automatically"
msgstr "Scegli automaticamente"

#. Backend list: Windows chooses the backend.
msgctxt "ui.backend.auto"
msgid "Automatic"
msgstr "Automatico"

#. Backend list: the Dokany driver (a product name).
msgctxt "ui.backend.dokany"
msgid "Dokany"
msgstr "Dokany"

#. Backend list: WebDAV (a protocol name).
msgctxt "ui.backend.webdav"
msgid "WebDAV"
msgstr "WebDAV"

#. Writes list: wait for the server on every write (default).
msgctxt "ui.write.through"
msgid "Wait for the server to confirm each write (safer)"
msgstr "Attendi la conferma del server per ogni scrittura (più sicuro)"

#. Writes list: acknowledge writes before the server confirms them.
msgctxt "ui.write.behind"
msgid "Write in the background (faster; recent changes can be lost if the connection drops)"
msgstr "Scrivi in background (più veloce; se la connessione cade, le modifiche recenti possono andare perse)"

#. Symbolic links list: links must stay inside the remote folder (default).
msgctxt "ui.symlinks.inside"
msgid "Stay inside the remote folder"
msgstr "Restare nella cartella remota"

#. Symbolic links list: follow links.
msgctxt "ui.symlinks.follow"
msgid "Follow"
msgstr "Segui"

#. Symbolic links list: hide links.
msgctxt "ui.symlinks.hide"
msgid "Hide"
msgstr "Nascondi"

#. Security page: explains the outdated algorithms setting (03 7.6 warning).
msgctxt "ui.security.legacy_text"
msgid "Some servers still offer old encryption methods. They work, but they are easier to attack."
msgstr "Alcuni server offrono ancora metodi di cifratura obsoleti. Funzionano, ma sono più facili da attaccare."

#. Security page: outdated algorithms list.
msgctxt "ui.security.legacy"
msgid "Outdated algorithms"
msgstr "Algoritmi obsoleti"

#. Security page: optional host key name.
msgctxt "ui.security.host_key_alias"
msgid "Host key name (optional)"
msgstr "Nome della chiave dell'host (facoltativo)"

#. Security page: what to do when the server offers new host keys.
msgctxt "ui.security.update_host_keys"
msgid "When the server offers new host keys"
msgstr "Quando il server propone nuove chiavi dell'host"

#. Security page: refuse servers open to the Terrapin attack (group ui.security).
msgctxt "ui.security.refuse_terrapin"
msgid "&Refuse servers that are open to the Terrapin attack"
msgstr "&Rifiuta i server esposti all'attacco Terrapin"

#. Outdated algorithms list: allow silently.
msgctxt "ui.legacy.allow"
msgid "Allow"
msgstr "Consenti"

#. Outdated algorithms list: warn once per server (default).
msgctxt "ui.legacy.warn"
msgid "Warn (default)"
msgstr "Avvisa (predefinito)"

#. Outdated algorithms list: ask before the connection starts.
msgctxt "ui.legacy.ask"
msgid "Ask first"
msgstr "Chiedi prima"

#. Outdated algorithms list: refuse outdated algorithms.
msgctxt "ui.legacy.refuse"
msgid "Refuse"
msgstr "Rifiuta"

#. Host key update list: ask the user.
msgctxt "ui.hku.ask"
msgid "Ask me"
msgstr "Chiedimi"

#. Host key update list: save new keys automatically.
msgctxt "ui.hku.save"
msgid "Save them automatically"
msgstr "Salvale automaticamente"

#. Host key update list: ignore the new keys.
msgctxt "ui.hku.ignore"
msgid "Ignore"
msgstr "Ignorale"

#. Key agent list: Automatic.
msgctxt "ui.agent.auto"
msgid "Automatic"
msgstr "Automatico"

#. Key agent list: the Pageant key agent (a product name).
msgctxt "ui.agent.pageant"
msgid "Pageant"
msgstr "Pageant"

#. Key agent list: the OpenSSH agent of Windows.
msgctxt "ui.agent.openssh"
msgid "OpenSSH agent"
msgstr "Agente OpenSSH"

#. Key agent list: no agent.
msgctxt "ui.agent.none"
msgid "None"
msgstr "Nessuno"

#. Identities-only list: the default when no setting is saved.
msgctxt "ui.idonly.unset"
msgid "Automatic (on when a key file is set)"
msgstr "Automatico (attivo quando è impostato un file di chiave)"

#. Identities-only list: yes.
msgctxt "ui.idonly.yes"
msgid "Yes"
msgstr "Sì"

#. Identities-only list: no.
msgctxt "ui.idonly.no"
msgid "No"
msgstr "No"

#. Proxy list: no proxy.
msgctxt "ui.proxy.none"
msgid "No proxy"
msgstr "Nessun proxy"

#. Proxy list: HTTP proxy (a protocol name).
msgctxt "ui.proxy.http"
msgid "HTTP proxy"
msgstr "Proxy HTTP"

#. Proxy list: SOCKS5 proxy (a protocol name).
msgctxt "ui.proxy.socks5"
msgid "SOCKS5 proxy"
msgstr "Proxy SOCKS5"

#. Proxy list: the proxy of the Windows settings.
msgctxt "ui.proxy.system"
msgid "Use the system proxy settings"
msgstr "Usa le impostazioni proxy del sistema"

#. Proxy authentication list: automatic.
msgctxt "ui.pauth.auto"
msgid "Automatic"
msgstr "Automatico"

#. Proxy authentication list: basic authentication.
msgctxt "ui.pauth.basic"
msgid "Basic"
msgstr "Base"

#. Proxy authentication list: Negotiate, the Windows sign-in.
msgctxt "ui.pauth.negotiate"
msgid "Negotiate (Windows sign-in)"
msgstr "Negotiate (accesso di Windows)"

#. Proxy authentication list: no authentication.
msgctxt "ui.pauth.none"
msgid "None"
msgstr "Nessuna"

#. Main window button: new connection.
msgctxt "ui.main.new"
msgid "New"
msgstr "Nuova"

#. Main window button: edit the selected connection.
msgctxt "ui.main.edit"
msgid "Edit"
msgstr "Modifica"

#. Main window button: copy the selected connection.
msgctxt "ui.main.duplicate"
msgid "Duplicate"
msgstr "Duplica"

#. Main window button: delete the selected connection.
msgctxt "ui.main.delete"
msgid "Delete"
msgstr "Elimina"

#. Main window button: mount a connection that is not saved. The ellipsis marks a dialog.
msgctxt "ui.main.quick_mount"
msgid "Quick mount…"
msgstr "Montaggio rapido…"

#. Main window button: show the selected mounted drive in Explorer.
msgctxt "ui.main.open"
msgid "Open"
msgstr "Apri"

#. Main window state column: the connection is saved but not mounted.
msgctxt "ui.main.not_mounted"
msgid "Not mounted"
msgstr "Non montata"

#. Shown when a connection cannot be written to the profile store.
msgctxt "ui.error.save"
msgid "The connection could not be saved. Check that you can write to your ShellDrive folder."
msgstr "Impossibile salvare la connessione. Verifica di poter scrivere nella cartella di ShellDrive."

#. Shown when a connection cannot be deleted.
msgctxt "ui.error.delete"
msgid "The connection could not be deleted."
msgstr "Impossibile eliminare la connessione."

#. Shown when a mount request does not start in the agent.
msgctxt "ui.error.mount"
msgid "ShellDrive could not start this connection. Check the settings, then try again."
msgstr "ShellDrive non è riuscito ad avviare questa connessione. Controlla le impostazioni e riprova."

#. Editor error: the name is empty.
msgctxt "ui.error.name"
msgid "Enter a name for this connection."
msgstr "Inserisci un nome per questa connessione."

#. Editor error: the server address is empty.
msgctxt "ui.error.host"
msgid "Enter the server address."
msgstr "Inserisci l'indirizzo del server."

#. Editor error: the port is not 1 to 65535.
msgctxt "ui.error.port"
msgid "Enter a port number from 1 to 65535."
msgstr "Inserisci un numero di porta da 1 a 65535."

#. Editor error: a number field holds text.
msgctxt "ui.error.number"
msgid "Enter a whole number in this field."
msgstr "Inserisci un numero intero in questo campo."

#. Editor error: the parallel connections are not 1 to 4.
msgctxt "ui.error.connections"
msgid "Choose 1 to 4 parallel connections."
msgstr "Scegli da 1 a 4 connessioni parallele."

#. Editor error: no sign-in method is selected.
msgctxt "ui.error.methods"
msgid "Choose at least one way to sign in."
msgstr "Scegli almeno un metodo di accesso."

#. Editor error: a proxy is selected without a server.
msgctxt "ui.error.proxy_host"
msgid "Enter the proxy server address."
msgstr "Inserisci l'indirizzo del server proxy."

#. Editor error: the proxy port is not 1 to 65535.
msgctxt "ui.error.proxy_port"
msgid "Enter a proxy port number from 1 to 65535."
msgstr "Inserisci una porta proxy da 1 a 65535."

#. Editor error: sd_config rejects a value that has no field of its own.
msgctxt "ui.error.other"
msgid "This setting is not valid. Check the value."
msgstr "Questa impostazione non è valida. Controlla il valore."

#. File picker filter: all files.
msgctxt "ui.file.any"
msgid "All files"
msgstr "Tutti i file"

#. Title of the delete confirmation.
msgctxt "ui.delete.title"
msgid "Delete connection"
msgstr "Elimina connessione"

#. Delete confirmation text. {name} is the connection name.
msgctxt "ui.delete.text"
msgid "Delete the connection {name}? Its saved settings are removed. Drives that are mounted stay mounted."
msgstr "Eliminare la connessione {name}? Le impostazioni salvate vengono rimosse. Le unità montate restano montate."

#. Delete confirmation: the destructive button.
msgctxt "ui.delete.yes"
msgid "Delete"
msgstr "Elimina"

#. Delete confirmation: keeps the connection.
msgctxt "ui.delete.no"
msgid "Cancel"
msgstr "Annulla"

#. Title of the .sdmount confirmation (the product name).
msgctxt "ui.mount_file.title"
msgid "ShellDrive"
msgstr "ShellDrive"

#. Shown for an .sdmount file that is invalid or names no profile of the user (03 8.1).
msgctxt "ui.mount_file.invalid"
msgid "This file does not refer to one of your ShellDrive connections."
msgstr "Questo file non fa riferimento a nessuna delle tue connessioni di ShellDrive."

#. Question for a .sdmount file that came from another computer. {name} is the connection.
msgctxt "ui.mount_file.mark"
msgid "This file came from another computer. Connect to {name}?"
msgstr "Questo file proviene da un altro computer. Connettersi a {name}?"

#. Button of the .sdmount question: connect.
msgctxt "ui.mount_file.connect"
msgid "Connect"
msgstr "Connetti"

#. Button of the .sdmount question: do nothing.
msgctxt "ui.mount_file.cancel"
msgid "Cancel"
msgstr "Annulla"

#. Main window button: import connections from PuTTY or OpenSSH. The ellipsis marks a dialog.
msgctxt "ui.main.import"
msgid "Import…"
msgstr "Importa…"

#. Title of the import dialog.
msgctxt "ui.import.title"
msgid "Import connections"
msgstr "Importa connessioni"

#. Import dialog: how the preview works.
msgctxt "ui.import.intro"
msgid "Read connections from PuTTY or from your OpenSSH config file. Check the ones to add. Connections that already exist are not checked."
msgstr "Leggi le connessioni da PuTTY o dal file di configurazione di OpenSSH. Seleziona quelle da aggiungere; quelle già presenti non sono selezionate."

#. Import dialog: read the PuTTY saved sessions.
msgctxt "ui.import.putty"
msgid "PuTTY sessions"
msgstr "Sessioni di PuTTY"

#. Import dialog: read the OpenSSH client configuration file.
msgctxt "ui.import.openssh"
msgid "OpenSSH config"
msgstr "Configurazione di OpenSSH"

#. Import dialog: writes the checked connections.
msgctxt "ui.import.run"
msgid "Import"
msgstr "Importa"

#. Import dialog: closes without writing.
msgctxt "ui.import.close"
msgid "Close"
msgstr "Chiudi"

#. Import list column: connection name.
msgctxt "ui.import.col_name"
msgid "Name"
msgstr "Nome"

#. Import list column: server name or address.
msgctxt "ui.import.col_server"
msgid "Server"
msgstr "Server"

#. Import list column: user name.
msgctxt "ui.import.col_user"
msgid "User"
msgstr "Utente"

#. Import list column: why a row is unchecked or skipped.
msgctxt "ui.import.col_note"
msgid "Note"
msgstr "Nota"

#. Import list note: a connection with the same host, port and user exists.
msgctxt "ui.import.note_duplicate"
msgid "Already saved"
msgstr "Già salvata"

#. Import list note: an imported key file is the only key offered (D37).
msgctxt "ui.import.note_only_key"
msgid "Only this key is offered"
msgstr "Viene proposta solo questa chiave"

#. Import list note: an entry the importer does not support. {item} is the setting.
msgctxt "ui.import.note_skipped"
msgid "Not imported: {item}"
msgstr "Non importato: {item}"

#. Shown when the PuTTY sessions cannot be read.
msgctxt "ui.import.error_putty"
msgid "No PuTTY sessions could be read."
msgstr "Impossibile leggere le sessioni di PuTTY."

#. Shown when the OpenSSH config file cannot be read.
msgctxt "ui.import.error_openssh"
msgid "The OpenSSH config file could not be read."
msgstr "Impossibile leggere il file di configurazione di OpenSSH."
