msgctxt "svc.debug_started"
msgid "ShellDrive service running in console mode. Press Ctrl+C to stop."
msgstr "Le service ShellDrive fonctionne en mode console. Appuyez sur Ctrl+C pour l'arrêter."

msgctxt "svc.debug_stopped"
msgid "ShellDrive service stopped."
msgstr "Le service ShellDrive s'est arrêté."

msgctxt "svc.not_scm"
msgid "This program is the ShellDrive service and needs the Service Control Manager. To run it in a console, use: shelldrive-host.exe service-debug"
msgstr "Ce programme est le service ShellDrive et nécessite le gestionnaire de contrôle des services. Pour l'exécuter dans une console, utilisez : shelldrive-host.exe service-debug"
