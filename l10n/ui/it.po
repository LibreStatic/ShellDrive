# ShellDrive UI strings, it (03 §9.1). msgctxt is the stable symbolic id; msgid is the English source.
msgid ""
msgstr ""
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n == 1 ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

#. Tray icon tooltip when no drive is mounted.
#. sdl10n:maxlen=128
msgctxt "ui.tray.tip_none"
msgid "ShellDrive: no drives mounted"
msgstr "ShellDrive: nessuna unità montata"

#. Tray icon tooltip with the number of mounted drives.
#. sdl10n:maxlen=128
#, plural-arg=count
msgctxt "ui.tray.tip_count"
msgid "ShellDrive: {count} drive mounted."
msgid_plural "ShellDrive: {count} drives mounted."
msgstr[0] "ShellDrive: {count} unità montata."
msgstr[1] "ShellDrive: {count} di unità montate."
msgstr[2] "ShellDrive: {count} unità montate."

#. Tray menu: opens the main window.
msgctxt "ui.tray.open"
msgid "Open ShellDrive"
msgstr "Apri ShellDrive"

#. Tray menu: quits the tray application. Mounts and the agent keep running.
msgctxt "ui.tray.exit"
msgid "Exit"
msgstr "Esci"

#. Tray menu: disabled item shown when no drive is mounted.
msgctxt "ui.tray.no_drives"
msgid "No drives mounted"
msgstr "Nessuna unità montata"

#. Tray menu item for one mounted drive. {drive} is a letter such as E:, {profile} is the profile name.
msgctxt "ui.tray.unmount"
msgid "Unmount {drive} ({profile})"
msgstr "Smonta {drive} ({profile})"

#. Main window list column: profile name.
msgctxt "ui.main.col_name"
msgid "Name"
msgstr "Nome"

#. Main window list column: drive letter.
msgctxt "ui.main.col_drive"
msgid "Drive"
msgstr "Unità"

#. Main window list column: connection state.
msgctxt "ui.main.col_state"
msgid "State"
msgstr "Stato"

#. Main window list column: storage backend (product names Dokany or WebDAV).
msgctxt "ui.main.col_backend"
msgid "Backend"
msgstr "Backend"

#. Main window list column: server host name.
msgctxt "ui.main.col_server"
msgid "Server"
msgstr "Server"

#. Main window button that starts a new mount. The ellipsis marks a dialog.
msgctxt "ui.main.mount"
msgid "Mount…"
msgstr "Monta…"

#. Main window button that unmounts the selected drive.
msgctxt "ui.main.unmount"
msgid "Unmount"
msgstr "Smonta"

#. Main window button that asks the agent for the mount list again.
msgctxt "ui.main.refresh"
msgid "Refresh"
msgstr "Aggiorna"

#. Status bar summary of the mounts.
#, plural-arg=count
msgctxt "ui.status.count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} unità montata."
msgstr[1] "{count} di unità montate."
msgstr[2] "{count} unità montate."

#. Status bar when the agent is not running.
msgctxt "ui.status.agent_down"
msgid "ShellDrive is not running."
msgstr "ShellDrive non è in esecuzione."

#. Mount state in the list: the agent is opening the connection.
msgctxt "ui.state.connecting"
msgid "Connecting"
msgstr "Connessione"

#. Mount state in the list: signing in to the server.
msgctxt "ui.state.authenticating"
msgid "Signing in"
msgstr "Autenticazione"

#. Mount state in the list: the drive is mounted and usable.
msgctxt "ui.state.mounted"
msgid "Connected"
msgstr "Connesso"

#. Mount state in the list: the connection is lost and ShellDrive retries.
msgctxt "ui.state.offline"
msgid "Offline"
msgstr "Offline"

#. Mount state in the list: the user has to sign in again.
msgctxt "ui.state.auth_required"
msgid "Sign-in required"
msgstr "Accesso richiesto"

#. Mount state in the list: the mount failed.
msgctxt "ui.state.failed"
msgid "Failed"
msgstr "Non riuscito"

#. Mount state in the list: the drive is being unmounted.
msgctxt "ui.state.unmounting"
msgid "Disconnecting"
msgstr "Smontaggio"

#. Mount state in the list: the drive is no longer mounted.
msgctxt "ui.state.unmounted"
msgid "Not mounted"
msgstr "Smontato"

#. Balloon title for warnings from the agent.
#. sdl10n:maxlen=64
msgctxt "ui.warn.title"
msgid "ShellDrive warning"
msgstr "Avviso di ShellDrive"

#. Balloon text: the connection uses outdated algorithms. {drive} is a drive letter such as E:.
#. sdl10n:maxlen=256
msgctxt "ui.warn.legacy"
msgid "Drive {drive} uses outdated security. Open ShellDrive for details."
msgstr "L'unità {drive} usa una sicurezza obsoleta. Apri ShellDrive per i dettagli."

#. Balloon text: the connection is open to a known attack until the server is updated.
#. sdl10n:maxlen=256
msgctxt "ui.warn.terrapin"
msgid "Drive {drive} is open to a known attack until the server is updated."
msgstr "L'unità {drive} è esposta a un attacco noto finché il server non viene aggiornato."

#. Balloon text: changes could not be written to the server.
#. sdl10n:maxlen=256
msgctxt "ui.warn.write_failed"
msgid "Changes to drive {drive} could not be saved."
msgstr "Impossibile salvare le modifiche all'unità {drive}."

#. Balloon text for any other warning.
#. sdl10n:maxlen=256
msgctxt "ui.warn.generic"
msgid "Drive {drive} needs your attention. Open ShellDrive for details."
msgstr "L'unità {drive} richiede attenzione. Apri ShellDrive per i dettagli."

#. Message box when the agent refuses to unmount a drive.
msgctxt "ui.error.unmount"
msgid "Could not unmount drive {drive}."
msgstr "Impossibile smontare l'unità {drive}."

#. Prompt dialog title for a server whose host key is not known yet (first connection).
msgctxt "ui.prompt.title_hostkey"
msgid "Unknown server"
msgstr "Server sconosciuto"

#. Prompt dialog title when a known server presents a different host key. ShellDrive never offers to accept it.
msgctxt "ui.prompt.title_changed"
msgid "Server identity changed"
msgstr "L'identità del server è cambiata"

#. Prompt dialog title for a password. {host} is the server name.
msgctxt "ui.prompt.title_password"
msgid "Sign in to {host}"
msgstr "Accedi a {host}"

#. Prompt dialog title for a key passphrase. {profile} is the profile name.
msgctxt "ui.prompt.title_passphrase"
msgid "Passphrase for {profile}"
msgstr "Passphrase di {profile}"

#. Prompt dialog title for keyboard-interactive questions. {host} is the server name.
msgctxt "ui.prompt.title_kbdint"
msgid "Verification from {host}"
msgstr "Verifica da {host}"

#. Prompt dialog title when the server requires a password change. {host} is the server name.
msgctxt "ui.prompt.title_change"
msgid "Change your password on {host}"
msgstr "Cambia la password su {host}"

#. Prompt dialog title for outdated security algorithms. {host} is the server name.
msgctxt "ui.prompt.title_legacy"
msgid "Outdated security on {host}"
msgstr "Sicurezza obsoleta su {host}"

#. Prompt dialog title for a proxy password. {profile} is the profile name.
msgctxt "ui.prompt.title_proxy"
msgid "Proxy password for {profile}"
msgstr "Password del proxy di {profile}"

#. Prompt dialog: first line for a host key or keyboard prompt. {host} and {port} are the server and its port.
msgctxt "ui.prompt.hostkey_intro"
msgid "The authenticity of host {host} (port {port}) can't be established."
msgstr "Impossibile verificare l'autenticità dell'host {host} (porta {port})."

#. Prompt dialog: a jump host chain. {hop} is this hop (from 1) and {hops} the total number of hops.
msgctxt "ui.prompt.hop_info"
msgid "Jump host {hop} of {hops}."
msgstr "Host di salto {hop} di {hops}."

#. Prompt dialog: names the jump host the connection went through. {via} is that host name.
msgctxt "ui.prompt.reach_via"
msgid "Reached through jump host {via}."
msgstr "Raggiunto tramite l'host di salto {via}."

#. Prompt dialog: the profile line, outside the server text. {profile} is the profile name.
msgctxt "ui.prompt.profile_line"
msgid "Profile: {profile}"
msgstr "Profilo: {profile}"

#. Prompt dialog: the server and user line of a sign-in prompt. {host} and {user} are the server and the account.
msgctxt "ui.prompt.target_line"
msgid "Server: {host}, user: {user}"
msgstr "Server: {host}, utente: {user}"

#. Prompt dialog: key type of a new host key. {type} is the algorithm name, such as ED25519.
msgctxt "ui.prompt.key_type"
msgid "Key type: {type}"
msgstr "Tipo di chiave: {type}"

#. Prompt dialog: label of the read-only fingerprint field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.fingerprint"
msgid "&Fingerprint (SHA-256):"
msgstr "&Impronta (SHA-256):"

#. Prompt dialog: asks the user to check a new host key with the administrator.
msgctxt "ui.prompt.hostkey_check"
msgid "Ask the server's administrator to confirm this fingerprint before you trust it."
msgstr "Chiedi all'amministratore del server di confermare questa impronta prima di fidarti."

#. Prompt dialog: explains the two trust buttons. Use the same words as the button captions.
msgctxt "ui.prompt.hostkey_choice"
msgid "Trust and connect saves this server's key for next time. Connect once uses it only for this connection."
msgstr "Fidati e connetti salva la chiave di questo server per le prossime volte. Connetti una volta la usa solo per questa connessione."

#. Prompt dialog: screen reader hint, because no button is the default for a trust decision.
msgctxt "ui.prompt.choose_button"
msgid "Choose a button to continue."
msgstr "Scegli un pulsante per continuare."

#. Prompt dialog button: trusts the new host key, saves it and connects.
msgctxt "ui.prompt.btn.trust"
msgid "&Trust and connect"
msgstr "&Fidati e connetti"

#. Prompt dialog button: connects once with a new host key, without saving it.
msgctxt "ui.prompt.btn.once"
msgid "Connect &once"
msgstr "Connetti &una volta"

#. Prompt dialog button: closes the dialog without answering the request (rejects it).
msgctxt "ui.prompt.btn.cancel"
msgid "&Cancel"
msgstr "&Annulla"

#. Prompt dialog button for the host key change notice: closes it.
msgctxt "ui.prompt.btn.close"
msgid "Clos&e"
msgstr "Ch&iudi"

#. Prompt dialog button: sends the password or passphrase and connects.
msgctxt "ui.prompt.btn.connect"
msgid "Co&nnect"
msgstr "Con&netti"

#. Prompt dialog button: sends the keyboard-interactive answers.
msgctxt "ui.prompt.btn.verify"
msgid "&Verify"
msgstr "&Verifica"

#. Prompt dialog button: sends the old and new passwords.
msgctxt "ui.prompt.btn.change"
msgid "Chan&ge password"
msgstr "Cambia &password"

#. Prompt dialog button: continues with the outdated algorithms, once.
msgctxt "ui.prompt.btn.anyway"
msgid "Continue &anyway"
msgstr "Continua &comunque"

#. Prompt dialog: a host key change notice. {host} is the server name.
msgctxt "ui.prompt.changed_intro"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "L'identità di {host} è cambiata. ShellDrive ha interrotto la connessione."

#. Prompt dialog: warning under the host key change notice.
msgctxt "ui.prompt.changed_warning"
msgid "This can mean someone is intercepting the connection. Ask the server's administrator before you change anything."
msgstr "Potrebbe significare che qualcuno sta intercettando la connessione. Chiedi all'amministratore del server prima di cambiare qualcosa."

#. Prompt dialog: the key ShellDrive has stored. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_stored"
msgid "Stored key: {fingerprint}"
msgstr "Chiave salvata: {fingerprint}"

#. Prompt dialog: the key the server offers now. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.changed_offered"
msgid "Offered key: {fingerprint}"
msgstr "Chiave offerta: {fingerprint}"

#. Prompt dialog: the server sent its own text (name, instruction) above the answer fields.
msgctxt "ui.prompt.server_caption"
msgid "From the server (ShellDrive does not check this text):"
msgstr "Dal server (ShellDrive non verifica questo testo):"

#. Prompt dialog: appended to a password prompt after a host key was accepted in this connection.
msgctxt "ui.prompt.just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Hai appena accettato l'identità di questo server. ShellDrive non ha inviato automaticamente la password salvata."

#. Prompt dialog: the password is asked again because the connection was lost.
msgctxt "ui.prompt.reconnect"
msgid "The connection was lost. Enter your password to reconnect."
msgstr "La connessione è stata interrotta. Inserisci la password per riconnetterti."

#. Prompt dialog: label of the password field. The mnemonic letter moves focus to the field.
msgctxt "ui.prompt.field.password"
msgid "&Password:"
msgstr "&Password:"

#. Prompt dialog: label of the key passphrase field.
msgctxt "ui.prompt.field.passphrase"
msgid "Passph&rase:"
msgstr "Passph&rase:"

#. Prompt dialog: label of the proxy password field.
msgctxt "ui.prompt.field.proxy"
msgid "Pro&xy password:"
msgstr "Password del pro&xy:"

#. Prompt dialog: label of the current password in a password change.
msgctxt "ui.prompt.field.current"
msgid "C&urrent password:"
msgstr "Password &attuale:"

#. Prompt dialog: label of the new password in a password change.
msgctxt "ui.prompt.field.new"
msgid "Ne&w password:"
msgstr "&Nuova password:"

#. Prompt dialog: label of the repeated new password in a password change.
msgctxt "ui.prompt.field.retype"
msgid "Re&type new password:"
msgstr "Ripe&ti la nuova password:"

#. Prompt dialog: check box that keeps the secret on this computer, shown only when it can be saved.
msgctxt "ui.prompt.check.save"
msgid "&Save on this computer"
msgstr "&Salva su questo computer"

#. Prompt dialog: shows the fingerprint of the key that unlocks a key file. {fingerprint} is a SHA256 fingerprint.
msgctxt "ui.prompt.key_fingerprint"
msgid "Key fingerprint: {fingerprint}"
msgstr "Impronta della chiave: {fingerprint}"

#. Prompt dialog: the server asks a password change. {user} is the account name.
msgctxt "ui.prompt.change_intro"
msgid "The server asks you to choose a new password for {user}."
msgstr "Il server ti chiede di scegliere una nuova password per {user}."

#. Prompt dialog: the new passwords differ.
msgctxt "ui.prompt.mismatch"
msgid "The new passwords do not match."
msgstr "Le nuove password non corrispondono."

#. Prompt dialog: a field is empty.
msgctxt "ui.prompt.empty"
msgid "Fill in every field."
msgstr "Compila tutti i campi."

#. Prompt dialog: the answer could not be queued for the agent; the dialog stays open.
msgctxt "ui.prompt.send_failed"
msgid "ShellDrive could not send your answer. Try again."
msgstr "ShellDrive non è riuscito a inviare la risposta. Riprova."

#. Prompt dialog: label above one keyboard-interactive answer field. {n} is this field and {total} the count.
msgctxt "ui.prompt.kbd_answer"
msgid "Answer {n} of {total}:"
msgstr "Risposta {n} di {total}:"

#. Prompt dialog: the server asks questions. {host} is the server name and {port} its port.
msgctxt "ui.prompt.kbdint_intro"
msgid "The server {host} (port {port}) asks you to answer these questions."
msgstr "Il server {host} (porta {port}) ti chiede di rispondere a queste domande."

#. Prompt dialog: a proxy needs a password. {proxy_host} and {proxy_port} are the proxy, {host} the server.
msgctxt "ui.prompt.proxy_intro"
msgid "The proxy {proxy_host}:{proxy_port} needs a password to reach {host}."
msgstr "Il proxy {proxy_host}:{proxy_port} richiede una password per raggiungere {host}."

#. Prompt dialog: the proxy user name. {user} is the user name.
msgctxt "ui.prompt.proxy_user"
msgid "Proxy user: {user}"
msgstr "Utente del proxy: {user}"

#. Prompt dialog: outdated algorithms. {host} is the server, {algorithms} a list such as hmac-sha1, 3des-cbc.
msgctxt "ui.prompt.legacy_intro"
msgid "{host} uses outdated security algorithms: {algorithms}."
msgstr "{host} usa algoritmi di sicurezza obsoleti: {algorithms}."

#. Prompt dialog: explains the outdated algorithms warning.
msgctxt "ui.prompt.legacy_text"
msgid "The connection works, but these algorithms are easier to attack. Continue only if you trust this server."
msgstr "La connessione funziona, ma questi algoritmi sono più facili da attaccare. Continua solo se ti fidi di questo server."

#. Prompt dialog: remaining time, shown as text only. {count} is the number of minutes, at least 1.
#, plural-arg=count
msgctxt "ui.prompt.deadline"
msgid "Time left to answer: about {count} minute."
msgid_plural "Time left to answer: about {count} minutes."
msgstr[0] "Tempo per rispondere: circa {count} minuto."
msgstr[1] "Tempo per rispondere: circa {count} minuti."
msgstr[2] "Tempo per rispondere: circa {count} minuti."

#. Tray balloon when a prompt expired without an answer. {profile} is the profile name.
msgctxt "ui.prompt.timeout"
msgid "A sign-in for {profile} timed out. Open ShellDrive to try again."
msgstr "Il tempo per accedere a {profile} è scaduto. Apri ShellDrive per riprovare."

#. Host key manager window title.
msgctxt "ui.hostkeys.title"
msgid "Host keys"
msgstr "Chiavi host"

#. Host key manager tab: keys stored in the known hosts files.
msgctxt "ui.hostkeys.tab_known"
msgid "Known keys"
msgstr "Chiavi conosciute"

#. Host key manager tab: keys the server offered to add or remove (UpdateHostKeys).
msgctxt "ui.hostkeys.tab_announced"
msgid "Announced keys"
msgstr "Chiavi annunciate"

#. Host key list column: host name.
msgctxt "ui.hostkeys.col_host"
msgid "Host"
msgstr "Host"

#. Host key list column: TCP port.
msgctxt "ui.hostkeys.col_port"
msgid "Port"
msgstr "Porta"

#. Host key list column: SSH key type.
msgctxt "ui.hostkeys.col_type"
msgid "Key type"
msgstr "Tipo di chiave"

#. Host key list column: SHA256 fingerprint of the key.
msgctxt "ui.hostkeys.col_fp"
msgid "SHA256 fingerprint"
msgstr "Impronta SHA256"

#. Host key list column: the store the key comes from.
msgctxt "ui.hostkeys.col_source"
msgid "Source"
msgstr "Origine"

#. Announced keys column: whether the key is added or removed.
msgctxt "ui.hostkeys.col_change"
msgid "Change"
msgstr "Modifica"

#. Host key list: the host name of a hashed known_hosts entry (it cannot be read).
msgctxt "ui.hostkeys.hashed"
msgid "(hashed)"
msgstr "(con hash)"

#. Host key list: source of a key in the machine store (read-only here).
msgctxt "ui.hostkeys.src_machine"
msgid "Machine (read-only)"
msgstr "Macchina (sola lettura)"

#. Host key list: source of a key in the user store.
msgctxt "ui.hostkeys.src_user"
msgid "ShellDrive (user)"
msgstr "ShellDrive (utente)"

#. Announced keys: the key is added to the store.
msgctxt "ui.hostkeys.action_add"
msgid "Add"
msgstr "Aggiunta"

#. Announced keys: the key is removed from the store.
msgctxt "ui.hostkeys.action_remove"
msgid "Remove"
msgstr "Rimozione"

#. Host key manager button: removes the selected key from the user store.
msgctxt "ui.hostkeys.btn_remove"
msgid "Remove"
msgstr "Rimuovi"

#. Host key manager button: copies the PuTTY host keys into the user store.
msgctxt "ui.hostkeys.btn_import_putty"
msgid "Import from PuTTY"
msgstr "Importa da PuTTY"

#. Host key manager button: opens a known_hosts file and copies its keys.
msgctxt "ui.hostkeys.btn_import_openssh"
msgid "Import from OpenSSH…"
msgstr "Importa da OpenSSH…"

#. Announced keys button: adds the proven keys of the announcement.
msgctxt "ui.hostkeys.btn_add"
msgid "Add keys"
msgstr "Aggiungi chiavi"

#. Announced keys button: adds the keys and removes the ones the server no longer uses.
msgctxt "ui.hostkeys.btn_add_all"
msgid "Add and remove"
msgstr "Aggiungi e rimuovi"

#. Confirmation before a key is removed. {host} is the host name, {type} the key type.
msgctxt "ui.hostkeys.confirm_remove"
msgid "Remove the {type} key of {host} from your known hosts? ShellDrive asks again the next time it connects to {host}."
msgstr "Rimuovere la chiave {type} di {host} dagli host conosciuti? ShellDrive chiederà di nuovo alla prossima connessione a {host}."

#. Confirmation before an announcement that also removes keys is applied.
msgctxt "ui.hostkeys.confirm_accept_removals"
msgid "Also remove the keys the server no longer uses? They are deleted from your known hosts."
msgstr "Rimuovere anche le chiavi che il server non usa più? Verranno cancellate dagli host conosciuti."

#. File filter name in the OpenSSH known_hosts file picker.
msgctxt "ui.hostkeys.file_all"
msgid "All files"
msgstr "Tutti i file"

#. Title of the OpenSSH known_hosts file picker.
msgctxt "ui.hostkeys.pick_title"
msgid "Choose an OpenSSH known_hosts file"
msgstr "Scegli un file known_hosts di OpenSSH"

#. Host key manager: the known hosts files could not be opened.
msgctxt "ui.hostkeys.store_failed"
msgid "The known hosts could not be opened."
msgstr "Impossibile aprire gli host conosciuti."

#. Host key manager: a key was removed.
msgctxt "ui.hostkeys.removed"
msgid "The host key was removed."
msgstr "La chiave dell'host è stata rimossa."

#. Host key manager: a key could not be removed. {code} is the error name.
msgctxt "ui.hostkeys.remove_failed"
msgid "The host key could not be removed ({code})."
msgstr "Impossibile rimuovere la chiave dell'host ({code})."

#. Host key manager: the import failed. {code} is the error name.
msgctxt "ui.hostkeys.import_failed"
msgid "The host keys could not be imported ({code})."
msgstr "Impossibile importare le chiavi ({code})."

#. Host key manager: the import source had no keys.
msgctxt "ui.hostkeys.import_none"
msgid "No host keys were found in that source."
msgstr "Nessuna chiave trovata in quell'origine."

#. Host key manager: number of keys imported.
#, plural-arg=count
msgctxt "ui.hostkeys.imported"
msgid "{count} host key imported."
msgid_plural "{count} host keys imported."
msgstr[0] "{count} chiave importata."
msgstr[1] "{count} chiavi importate."
msgstr[2] "{count} chiavi importate."

#. Host key manager: the agent is not running, so announcements cannot be read.
msgctxt "ui.hostkeys.agent_down"
msgid "The agent is not running."
msgstr "L'agente non è in esecuzione."

#. Host key manager: the announcements could not be read.
msgctxt "ui.hostkeys.announced_failed"
msgid "The announced keys could not be read."
msgstr "Impossibile leggere le chiavi annunciate."

#. Host key manager: applying an announcement failed. {code} is the error name.
msgctxt "ui.hostkeys.accept_failed"
msgid "The host keys could not be applied ({code})."
msgstr "Impossibile applicare le chiavi ({code})."

#. Host key manager: the request could not be queued for the agent.
msgctxt "ui.hostkeys.accept_failed_queue"
msgid "The request could not be sent to the agent. Try again."
msgstr "Impossibile inviare la richiesta all'agente. Riprova."

#. Host key manager: an announcement was applied. {host} is the host name.
msgctxt "ui.hostkeys.accepted"
msgid "Host keys for {host} were updated."
msgstr "Le chiavi di {host} sono state aggiornate."

#. Host key manager status line: number of keys listed.
#, plural-arg=count
msgctxt "ui.hostkeys.status_known"
msgid "{count} host key."
msgid_plural "{count} host keys."
msgstr[0] "{count} chiave."
msgstr[1] "{count} chiavi."
msgstr[2] "{count} chiavi."

#. Host key manager status line: number of announced keys.
#, plural-arg=count
msgctxt "ui.hostkeys.status_announced"
msgid "{count} announced key."
msgid_plural "{count} announced keys."
msgstr[0] "{count} chiave annunciata."
msgstr[1] "{count} chiavi annunciate."
msgstr[2] "{count} chiavi annunciate."

#. Logs viewer window title.
msgctxt "ui.logs.title"
msgid "Logs"
msgstr "Registri"

#. Logs viewer: label of the level filter.
msgctxt "ui.logs.level_label"
msgid "Show"
msgstr "Mostra"

#. Logs viewer: label of the search box.
msgctxt "ui.logs.search_label"
msgid "Search"
msgstr "Cerca"

#. Logs viewer level filter: errors only.
msgctxt "ui.logs.level_error"
msgid "Errors only"
msgstr "Solo errori"

#. Logs viewer level filter: warnings and errors.
msgctxt "ui.logs.level_warn"
msgid "Warnings and errors"
msgstr "Avvisi ed errori"

#. Logs viewer level filter: information and more severe records.
msgctxt "ui.logs.level_info"
msgid "Information and above"
msgstr "Informazioni e superiori"

#. Logs viewer level filter: debug and more severe records.
msgctxt "ui.logs.level_debug"
msgid "Debug and above"
msgstr "Debug e superiori"

#. Logs viewer level filter: every record.
msgctxt "ui.logs.level_trace"
msgid "All records"
msgstr "Tutti i record"

#. Logs viewer button: copies the selected lines (all lines when nothing is selected).
msgctxt "ui.logs.btn_copy"
msgid "Copy selection"
msgstr "Copia selezione"

#. Logs viewer button: opens the folder with the log files.
msgctxt "ui.logs.btn_folder"
msgid "Open log folder"
msgstr "Apri cartella dei registri"

#. Logs viewer status line: number of records shown.
#, plural-arg=count
msgctxt "ui.logs.status_count"
msgid "{count} record shown."
msgid_plural "{count} records shown."
msgstr[0] "{count} record mostrato."
msgstr[1] "{count} record mostrati."
msgstr[2] "{count} record mostrati."

#. Logs viewer status line: records the agent dropped before the ones shown.
#, plural-arg=count
msgctxt "ui.logs.dropped"
msgid "{count} older record was dropped."
msgid_plural "{count} older records were dropped."
msgstr[0] "È andato perso {count} record precedente."
msgstr[1] "Sono andati persi {count} record precedenti."
msgstr[2] "Sono andati persi {count} record precedenti."

#. Logs viewer: the agent is not running; the records already shown stay.
msgctxt "ui.logs.agent_down"
msgid "The agent is not running. Records already shown are kept."
msgstr "L'agente non è in esecuzione. I record già mostrati restano visibili."

#. Logs viewer: the running agent has no log.tail method.
msgctxt "ui.logs.old_agent"
msgid "The running agent is too old to show its log."
msgstr "L'agente in esecuzione è troppo vecchio per mostrare il suo registro."

#. Logs viewer: reading the log failed. {code} is the error name.
msgctxt "ui.logs.read_failed"
msgid "The log could not be read ({code})."
msgstr "Impossibile leggere il registro ({code})."

#. Logs viewer: the agent sent a malformed log.tail reply.
msgctxt "ui.logs.bad_reply"
msgid "The agent sent a log that could not be read."
msgstr "L'agente ha inviato un registro illeggibile."

#. Logs viewer: the log folder could not be opened.
msgctxt "ui.logs.open_failed"
msgid "The log folder could not be opened."
msgstr "Impossibile aprire la cartella dei registri."

#. Logs viewer: first poll in progress.
msgctxt "ui.logs.loading"
msgid "Loading the log…"
msgstr "Caricamento del registro…"

#. Settings window title.
msgctxt "ui.settings.title"
msgid "Settings"
msgstr "Impostazioni"

#. Settings: label of the language list.
msgctxt "ui.settings.language"
msgid "Language"
msgstr "Lingua"

#. Settings: the first language entry, the Windows language.
msgctxt "ui.settings.lang_system"
msgid "System default"
msgstr "Predefinita di sistema"

#. Settings: checkbox for balloon notifications.
msgctxt "ui.settings.notify"
msgid "Show notifications"
msgstr "Mostra notifiche"

#. Settings: checkbox that starts the tray icon at sign-in (Run key, this user only).
msgctxt "ui.settings.logon"
msgid "Start the tray icon at sign-in"
msgstr "Avvia l'icona nell'area di notifica all'accesso"

#. Settings: label of the default backend list.
msgctxt "ui.settings.backend"
msgid "Default backend"
msgstr "Backend predefinito"

#. Settings: default backend choice, chosen by Windows.
msgctxt "ui.settings.backend_auto"
msgid "Automatic"
msgstr "Automatico"

#. Settings: default backend choice, the Dokany product name.
msgctxt "ui.settings.backend_dokany"
msgid "Dokany"
msgstr "Dokany"

#. Settings: default backend choice, the WebDAV protocol name.
msgctxt "ui.settings.backend_webdav"
msgid "WebDAV"
msgstr "WebDAV"

#. Settings: label of the memory cache budget field.
msgctxt "ui.settings.cache"
msgid "Memory cache (MB)"
msgstr "Cache in memoria (MB)"

#. Settings: explains the values of the memory cache budget field.
msgctxt "ui.settings.cache_hint"
msgid "0 uses the default. Otherwise 16 to 65536."
msgstr "0 usa il valore predefinito. Altrimenti da 16 a 65536."

#. Settings: heading of the update group.
msgctxt "ui.settings.group_updates"
msgid "Updates"
msgstr "Aggiornamenti"

#. Settings: checkbox for automatic update checks (disabled until the agent offers it).
msgctxt "ui.settings.check_updates"
msgid "Check for updates automatically"
msgstr "Cerca aggiornamenti automaticamente"

#. Settings: shown when the agent cannot check for updates.
msgctxt "ui.settings.updates_unavailable"
msgid "Updates are not available in this version of the agent."
msgstr "Gli aggiornamenti non sono disponibili in questa versione dell'agente."

#. Settings: which changes take effect without a restart.
msgctxt "ui.settings.live_note"
msgid "Notifications, the backend and the cache apply to new mounts and connections after the agent reloads the file."
msgstr "Notifiche, backend e cache valgono per i nuovi montaggi e le nuove connessioni dopo che l'agente ricarica il file."

#. Settings: shown after a language change, which is read at start-up.
msgctxt "ui.settings.restart_note"
msgid "The language changes when you restart ShellDrive."
msgstr "La lingua cambia al riavvio di ShellDrive."

#. Settings button: saves the file and applies it.
msgctxt "ui.settings.btn_save"
msgid "Save"
msgstr "Salva"

#. Settings button: closes without saving.
msgctxt "ui.settings.btn_cancel"
msgid "Cancel"
msgstr "Annulla"

#. Settings: the memory cache field holds a value outside 0 and 16 to 65536.
msgctxt "ui.settings.cache_invalid"
msgid "Enter 0, or a size from 16 to 65536 MB."
msgstr "Inserisci 0 oppure una dimensione da 16 a 65536 MB."

#. Settings: saving settings.ini failed. {code} is the error name.
msgctxt "ui.settings.save_failed"
msgid "The settings could not be saved ({code})."
msgstr "Impossibile salvare le impostazioni ({code})."

#. Settings: the Run key for start at sign-in could not be written.
msgctxt "ui.settings.run_failed"
msgid "Start at sign-in could not be changed."
msgstr "Impossibile modificare l'avvio all'accesso."

#. About window title.
msgctxt "ui.about.title"
msgid "About ShellDrive"
msgstr "Informazioni su ShellDrive"

#. About window: the version line. {version} is the product version.
msgctxt "ui.about.version"
msgid "Version {version}"
msgstr "Versione {version}"

#. About window: the license line.
msgctxt "ui.about.license"
msgid "Licensed under the MIT License."
msgstr "Licenza MIT."

#. About window: the copyright line.
msgctxt "ui.about.copyright"
msgid "Copyright (C) LibreStatic"
msgstr "Copyright (C) LibreStatic"

#. About window button: opens the project web page in the browser.
msgctxt "ui.about.btn_project"
msgid "Project page"
msgstr "Pagina del progetto"

#. About window button: closes the window.
msgctxt "ui.about.btn_close"
msgid "Close"
msgstr "Chiudi"

#. About window: the browser could not be started.
msgctxt "ui.about.open_failed"
msgid "The project page could not be opened in the browser."
msgstr "Impossibile aprire la pagina del progetto nel browser."

#. Menu item: opens the host key manager.
msgctxt "ui.menu.hostkeys"
msgid "Host keys…"
msgstr "Chiavi host…"

#. Menu item: opens the Logs viewer.
msgctxt "ui.menu.logs"
msgid "Logs…"
msgstr "Registri…"

#. Menu item: opens Settings.
msgctxt "ui.menu.settings"
msgid "Settings…"
msgstr "Impostazioni…"

#. Menu item: opens the About window.
msgctxt "ui.menu.about"
msgid "About ShellDrive"
msgstr "Informazioni su ShellDrive"

#. Menu bar: the Tools menu.
msgctxt "ui.menu.tools"
msgid "Tools"
msgstr "Strumenti"

#. Menu bar: the Help menu.
msgctxt "ui.menu.help"
msgid "Help"
msgstr "Aiuto"
