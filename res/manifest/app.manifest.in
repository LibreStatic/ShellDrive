<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest template (04 §3.3), instantiated per binary by sd_add_app and sd_add_dll.
     trustInfo uses the asm.v2 namespace because the XP SP2 loader rejects the v3 form.
     @SD_MANIFEST_ARCH@ follows the flavour (x86 for the x86 flavours, amd64 for x64, arm64 for ARM64, arm for ARM32).
     @SD_MANIFEST_DEPENDENCY@ (comctl32 v6) and @SD_MANIFEST_DPI@ (DPI awareness) are empty for console
     binaries and filled in for GUI applications only (sd_add_app WINDOWS, 03 §7.1 and §7.3).
     longPathAware (2016 namespace) is left out on the XP flavours, whose SDK 7.1A does not know that
     namespace; the placeholder is set by sd_manifest_configure (cmake/SdModule.cmake). Never put a
     placeholder inside this comment: its text is XML and would break the comment. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="com.librestatic.shelldrive.@SD_MANIFEST_NAME@" version="@SD_VERSION_MAJOR@.@SD_VERSION_MINOR@.@SD_VERSION_PATCH@.@SD_BUILD_NUMBER@" processorArchitecture="@SD_MANIFEST_ARCH@"/>
@SD_MANIFEST_DEPENDENCY@
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Vista, 7, 8, 8.1, 10/11 -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
@SD_MANIFEST_DPI@
@SD_MANIFEST_LONGPATH@
    </windowsSettings>
  </application>
</assembly>
