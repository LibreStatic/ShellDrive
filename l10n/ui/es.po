#. Main window button: new connection.
msgctxt "ui.main.new"
msgid "New"
msgstr "Nueva"

#. Main window button: edit the selected connection.
msgctxt "ui.main.edit"
msgid "Edit"
msgstr "Editar"

#. Main window button: copy the selected connection.
msgctxt "ui.main.duplicate"
msgid "Duplicate"
msgstr "Duplicar"

#. Main window button: delete the selected connection.
msgctxt "ui.main.delete"
msgid "Delete"
msgstr "Eliminar"

#. Main window button: mount a connection that is not saved. The ellipsis marks a dialog.
msgctxt "ui.main.quick_mount"
msgid "Quick mount…"
msgstr "Montaje rápido…"

#. Main window button: show the selected mounted drive in Explorer.
msgctxt "ui.main.open"
msgid "Open"
msgstr "Abrir"

#. Main window state column: the connection is saved but not mounted.
msgctxt "ui.main.not_mounted"
msgid "Not mounted"
msgstr "No montada"

#. Shown when a connection cannot be written to the profile store.
msgctxt "ui.error.save"
msgid "The connection could not be saved. Check that you can write to your ShellDrive folder."
msgstr "No se pudo guardar la conexión. Revisá que puedas escribir en la carpeta de ShellDrive."

#. Shown when a connection cannot be deleted.
msgctxt "ui.error.delete"
msgid "The connection could not be deleted."
msgstr "No se pudo eliminar la conexión."

#. Shown when a mount request does not start in the agent.
msgctxt "ui.error.mount"
msgid "ShellDrive could not start this connection. Check the settings, then try again."
msgstr "ShellDrive no pudo iniciar esta conexión. Revisá la configuración y volvé a intentarlo."

#. Editor error: the name is empty.
msgctxt "ui.error.name"
msgid "Enter a name for this connection."
msgstr "Escribí un nombre para esta conexión."

#. Editor error: the server address is empty.
msgctxt "ui.error.host"
msgid "Enter the server address."
msgstr "Escribí la dirección del servidor."

#. Editor error: the port is not 1 to 65535.
msgctxt "ui.error.port"
msgid "Enter a port number from 1 to 65535."
msgstr "Escribí un puerto del 1 al 65535."

#. Editor error: a number field holds text.
msgctxt "ui.error.number"
msgid "Enter a whole number in this field."
msgstr "Escribí un número entero en este campo."

#. Editor error: the parallel connections are not 1 to 4.
msgctxt "ui.error.connections"
msgid "Choose 1 to 4 parallel connections."
msgstr "Elegí de 1 a 4 conexiones en paralelo."

#. Editor error: no sign-in method is selected.
msgctxt "ui.error.methods"
msgid "Choose at least one way to sign in."
msgstr "Elegí al menos una forma de ingreso."

#. Editor error: a proxy is selected without a server.
msgctxt "ui.error.proxy_host"
msgid "Enter the proxy server address."
msgstr "Escribí la dirección del servidor proxy."

#. Editor error: the proxy port is not 1 to 65535.
msgctxt "ui.error.proxy_port"
msgid "Enter a proxy port number from 1 to 65535."
msgstr "Escribí un puerto de proxy del 1 al 65535."

#. Editor error: sd_config rejects a value that has no field of its own.
msgctxt "ui.error.other"
msgid "This setting is not valid. Check the value."
msgstr "Este ajuste no es válido. Revisá el valor."

#. File picker filter: all files.
msgctxt "ui.file.any"
msgid "All files"
msgstr "Todos los archivos"

#. Title of the delete confirmation.
msgctxt "ui.delete.title"
msgid "Delete connection"
msgstr "Eliminar conexión"

#. Delete confirmation text. {name} is the connection name.
msgctxt "ui.delete.text"
msgid "Delete the connection {name}? Its saved settings are removed. Drives that are mounted stay mounted."
msgstr "¿Eliminar la conexión {name}? Se quitan sus ajustes guardados. Las unidades montadas siguen montadas."

#. Delete confirmation: the destructive button.
msgctxt "ui.delete.yes"
msgid "Delete"
msgstr "Eliminar"

#. Delete confirmation: keeps the connection.
msgctxt "ui.delete.no"
msgid "Cancel"
msgstr "Cancelar"

#. Title of the .sdmount confirmation (the product name).
msgctxt "ui.mount_file.title"
msgid "ShellDrive"
msgstr "ShellDrive"

#. Shown for an .sdmount file that is invalid or names no profile of the user (03 8.1).
msgctxt "ui.mount_file.invalid"
msgid "This file does not refer to one of your ShellDrive connections."
msgstr "Este archivo no corresponde a ninguna conexión de ShellDrive."

#. Question for a .sdmount file that came from another computer. {name} is the connection.
msgctxt "ui.mount_file.mark"
msgid "This file came from another computer. Connect to {name}?"
msgstr "Este archivo vino de otra computadora. ¿Conectar con {name}?"

#. Button of the .sdmount question: connect.
msgctxt "ui.mount_file.connect"
msgid "Connect"
msgstr "Conectar"

#. Button of the .sdmount question: do nothing.
msgctxt "ui.mount_file.cancel"
msgid "Cancel"
msgstr "Cancelar"

#. Main window button: import connections from PuTTY or OpenSSH. The ellipsis marks a dialog.
msgctxt "ui.main.import"
msgid "Import…"
msgstr "Importar…"

#. Title of the import dialog.
msgctxt "ui.import.title"
msgid "Import connections"
msgstr "Importar conexiones"

#. Import dialog: how the preview works.
msgctxt "ui.import.intro"
msgid "Read connections from PuTTY or from your OpenSSH config file. Check the ones to add. Connections that already exist are not checked."
msgstr "Leé las conexiones de PuTTY o del archivo de configuración de OpenSSH. Marcá las que querés agregar; las que ya existen no vienen marcadas."

#. Import dialog: read the PuTTY saved sessions.
msgctxt "ui.import.putty"
msgid "PuTTY sessions"
msgstr "Sesiones de PuTTY"

#. Import dialog: read the OpenSSH client configuration file.
msgctxt "ui.import.openssh"
msgid "OpenSSH config"
msgstr "Configuración de OpenSSH"

#. Import dialog: writes the checked connections.
msgctxt "ui.import.run"
msgid "Import"
msgstr "Importar"

#. Import dialog: closes without writing.
msgctxt "ui.import.close"
msgid "Close"
msgstr "Cerrar"

#. Import list column: connection name.
msgctxt "ui.import.col_name"
msgid "Name"
msgstr "Nombre"

#. Import list column: server name or address.
msgctxt "ui.import.col_server"
msgid "Server"
msgstr "Servidor"

#. Import list column: user name.
msgctxt "ui.import.col_user"
msgid "User"
msgstr "Usuario"

#. Import list column: why a row is unchecked or skipped.
msgctxt "ui.import.col_note"
msgid "Note"
msgstr "Nota"

#. Import list note: a connection with the same host, port and user exists.
msgctxt "ui.import.note_duplicate"
msgid "Already saved"
msgstr "Ya guardada"

#. Import list note: an imported key file is the only key offered (D37).
msgctxt "ui.import.note_only_key"
msgid "Only this key is offered"
msgstr "Solo se ofrece esta clave"

#. Import list note: an entry the importer does not support. {item} is the setting.
msgctxt "ui.import.note_skipped"
msgid "Not imported: {item}"
msgstr "No importada: {item}"

#. Shown when the PuTTY sessions cannot be read.
msgctxt "ui.import.error_putty"
msgid "No PuTTY sessions could be read."
msgstr "No se pudieron leer las sesiones de PuTTY."

#. Shown when the OpenSSH config file cannot be read.
msgctxt "ui.import.error_openssh"
msgid "The OpenSSH config file could not be read."
msgstr "No se pudo leer el archivo de configuración de OpenSSH."

#. Host key manager window title.
msgctxt "ui.hostkeys.title"
msgid "Host keys"
msgstr "Claves de host"

#. Host key manager tab: keys stored in the known hosts files.
msgctxt "ui.hostkeys.tab_known"
msgid "Known keys"
msgstr "Claves conocidas"

#. Host key manager tab: keys the server offered to add or remove (UpdateHostKeys).
msgctxt "ui.hostkeys.tab_announced"
msgid "Announced keys"
msgstr "Claves anunciadas"

#. Host key list column: host name.
msgctxt "ui.hostkeys.col_host"
msgid "Host"
msgstr "Host"

#. Host key list column: TCP port.
msgctxt "ui.hostkeys.col_port"
msgid "Port"
msgstr "Puerto"

#. Host key list column: SSH key type.
msgctxt "ui.hostkeys.col_type"
msgid "Key type"
msgstr "Tipo de clave"

#. Host key list column: SHA256 fingerprint of the key.
msgctxt "ui.hostkeys.col_fp"
msgid "SHA256 fingerprint"
msgstr "Huella SHA256"

#. Host key list column: the store the key comes from.
msgctxt "ui.hostkeys.col_source"
msgid "Source"
msgstr "Origen"

#. Announced keys column: whether the key is added or removed.
msgctxt "ui.hostkeys.col_change"
msgid "Change"
msgstr "Cambio"

#. Host key list: the host name of a hashed known_hosts entry (it cannot be read).
msgctxt "ui.hostkeys.hashed"
msgid "(hashed)"
msgstr "(cifrado)"

#. Host key list: source of a key in the machine store (read-only here).
msgctxt "ui.hostkeys.src_machine"
msgid "Machine (read-only)"
msgstr "Equipo (solo lectura)"

#. Host key list: source of a key in the user store.
msgctxt "ui.hostkeys.src_user"
msgid "ShellDrive (user)"
msgstr "ShellDrive (usuario)"

#. Announced keys: the key is added to the store.
msgctxt "ui.hostkeys.action_add"
msgid "Add"
msgstr "Agregar"

#. Announced keys: the key is removed from the store.
msgctxt "ui.hostkeys.action_remove"
msgid "Remove"
msgstr "Quitar"

#. Host key manager button: removes the selected key from the user store.
msgctxt "ui.hostkeys.btn_remove"
msgid "Remove"
msgstr "Quitar"

#. Host key manager button: copies the PuTTY host keys into the user store.
msgctxt "ui.hostkeys.btn_import_putty"
msgid "Import from PuTTY"
msgstr "Importar desde PuTTY"

#. Host key manager button: opens a known_hosts file and copies its keys.
msgctxt "ui.hostkeys.btn_import_openssh"
msgid "Import from OpenSSH…"
msgstr "Importar desde OpenSSH…"

#. Announced keys button: adds the proven keys of the announcement.
msgctxt "ui.hostkeys.btn_add"
msgid "Add keys"
msgstr "Agregar claves"

#. Announced keys button: adds the keys and removes the ones the server no longer uses.
msgctxt "ui.hostkeys.btn_add_all"
msgid "Add and remove"
msgstr "Agregar y quitar"

#. Confirmation before a key is removed. {host} is the host name, {type} the key type.
msgctxt "ui.hostkeys.confirm_remove"
msgid "Remove the {type} key of {host} from your known hosts? ShellDrive asks again the next time it connects to {host}. If you did not expect the key to change, someone may be intercepting your connection."
msgstr "¿Quitar la clave {type} de {host} de tus hosts conocidos? ShellDrive volverá a preguntar la próxima vez que se conecte a {host}. Si no esperabas que la clave cambie, puede que alguien esté interceptando tu conexión."

#. Confirmation before an announcement that also removes keys is applied.
msgctxt "ui.hostkeys.confirm_accept_removals"
msgid "Also remove the keys the server no longer uses? They are deleted from your known hosts."
msgstr "¿Quitar también las claves que el servidor ya no usa? Se borran de tus hosts conocidos."

#. File filter name in the OpenSSH known_hosts file picker.
msgctxt "ui.hostkeys.file_all"
msgid "All files"
msgstr "Todos los archivos"

#. Title of the OpenSSH known_hosts file picker.
msgctxt "ui.hostkeys.pick_title"
msgid "Choose an OpenSSH known_hosts file"
msgstr "Elegí un archivo known_hosts de OpenSSH"

#. Host key manager: the known hosts files could not be opened.
msgctxt "ui.hostkeys.store_failed"
msgid "The known hosts could not be opened."
msgstr "No se pudieron abrir los hosts conocidos."

#. Host key manager: a key was removed.
msgctxt "ui.hostkeys.removed"
msgid "The host key was removed."
msgstr "Se quitó la clave del host."

#. Host key manager: a key could not be removed. {code} is the error name.
msgctxt "ui.hostkeys.remove_failed"
msgid "The host key could not be removed ({code})."
msgstr "No se pudo quitar la clave del host ({code})."

#. Host key manager: the import failed. {code} is the error name.
msgctxt "ui.hostkeys.import_failed"
msgid "The host keys could not be imported ({code})."
msgstr "No se pudieron importar las claves ({code})."

#. Host key manager: the import source had no keys.
msgctxt "ui.hostkeys.import_none"
msgid "No host keys were found in that source."
msgstr "No se encontraron claves en ese origen."

#. Host key manager: number of keys imported.
#, plural-arg=count
msgctxt "ui.hostkeys.imported"
msgid "{count} host key imported."
msgid_plural "{count} host keys imported."
msgstr[0] "{count} clave importada."
msgstr[1] "{count} claves importadas."
msgstr[2] "{count} claves importadas."

#. Host key manager: the agent is not running, so announcements cannot be read.
msgctxt "ui.hostkeys.agent_down"
msgid "The agent is not running."
msgstr "El agente no está en ejecución."

#. Host key manager: the announcements could not be read.
msgctxt "ui.hostkeys.announced_failed"
msgid "The announced keys could not be read."
msgstr "No se pudieron leer las claves anunciadas."

#. Host key manager: applying an announcement failed. {code} is the error name.
msgctxt "ui.hostkeys.accept_failed"
msgid "The host keys could not be applied ({code})."
msgstr "No se pudieron aplicar las claves ({code})."

#. Host key manager: the request could not be queued for the agent.
msgctxt "ui.hostkeys.accept_failed_queue"
msgid "The request could not be sent to the agent. Try again."
msgstr "No se pudo enviar el pedido al agente. Volvé a intentarlo."

#. Host key manager: an announcement was applied. {host} is the host name.
msgctxt "ui.hostkeys.accepted"
msgid "Host keys for {host} were updated."
msgstr "Se actualizaron las claves de {host}."

#. Host key manager status line: number of keys listed.
#, plural-arg=count
msgctxt "ui.hostkeys.status_known"
msgid "{count} host key."
msgid_plural "{count} host keys."
msgstr[0] "{count} clave."
msgstr[1] "{count} claves."
msgstr[2] "{count} claves."

#. Host key manager status line: number of announced keys.
#, plural-arg=count
msgctxt "ui.hostkeys.status_announced"
msgid "{count} announced key."
msgid_plural "{count} announced keys."
msgstr[0] "{count} clave anunciada."
msgstr[1] "{count} claves anunciadas."
msgstr[2] "{count} claves anunciadas."

#. Host key manager button (Known keys tab): asks a server for its host keys and adds the ones the user confirms.
msgctxt "ui.hostkeys.btn_add_server"
msgid "Add key from server…"
msgstr "Agregar clave desde el servidor…"

#. Title of the dialog that asks for the server to get host keys from.
msgctxt "ui.hostkeys.add.title"
msgid "Add a host key from a server"
msgstr "Agregar una clave de host desde un servidor"

#. Intro of the dialog that asks for the server. The user types a host name, optionally followed by :port.
msgctxt "ui.hostkeys.add.intro"
msgid "ShellDrive connects to the server and asks for the host keys it has. Nothing is saved until you have checked the fingerprints. Type the server name, or name:port."
msgstr "ShellDrive se conecta al servidor y le pide las claves de host que tiene. No se guarda nada hasta que revises las huellas digitales. Escribí el nombre del servidor, o nombre:puerto."

#. Label of the server field. The mnemonic letter moves focus to the field.
msgctxt "ui.hostkeys.add.host_label"
msgid "&Server:"
msgstr "&Servidor:"

#. Button of the server dialog: connects and asks the server for its host keys.
msgctxt "ui.hostkeys.add.btn_ok"
msgid "&Look up"
msgstr "&Buscar"

#. Button of the server dialog: closes it without doing anything.
msgctxt "ui.hostkeys.add.btn_cancel"
msgid "&Cancel"
msgstr "&Cancelar"

#. Server dialog: the field does not hold a usable server name.
msgctxt "ui.hostkeys.add.invalid_host"
msgid "Type a server name such as example.org or example.org:2222. Use letters, digits, dots and hyphens only."
msgstr "Escribí un nombre de servidor como example.org o example.org:2222. Usá solo letras, dígitos, puntos y guiones."

#. Host key manager status line while the agent connects to the server. {host} is the server name.
msgctxt "ui.hostkeys.add.working"
msgid "Asking {host} for its host keys…"
msgstr "Pidiéndole a {host} sus claves de host…"

#. Host key manager status line: the server offered no key that is not stored yet. {host} is the server name.
msgctxt "ui.hostkeys.add.none"
msgid "{host} has no other host keys to add."
msgstr "{host} no tiene otras claves de host para agregar."

#. Title of the dialog that shows the host keys a server offered.
msgctxt "ui.hostkeys.add.review_title"
msgid "Add host keys"
msgstr "Agregar claves de host"

#. Review dialog for a server whose key ShellDrive already stores: it offers {count} more. {host} is the server name.
#, plural-arg=count
msgctxt "ui.hostkeys.add.review_verified"
msgid "{host} also has {count} other host key. Add it?"
msgid_plural "{host} also has {count} other host keys. Add them?"
msgstr[0] "{host} también tiene {count} otra clave de host. ¿La agregás?"
msgstr[1] "{host} también tiene {count} de otras claves de host. ¿Las agregás?"
msgstr[2] "{host} también tiene {count} otras claves de host. ¿Las agregás?"

#. Review dialog for a server ShellDrive has no stored key for (first contact, 03 5.2). {host} is the server name.
msgctxt "ui.hostkeys.add.review_first"
msgid "ShellDrive has no key stored for {host}, so it cannot tell whether this is the server you mean. Compare the fingerprint with the one the server's administrator gave you."
msgstr "ShellDrive no tiene ninguna clave guardada de {host}, así que no puede saber si es el servidor que querés. Compará la huella digital con la que te dio el administrador del servidor."

#. Label of the read-only list of keys the server offered (type and SHA-256 fingerprint). The mnemonic letter moves focus to the list.
msgctxt "ui.hostkeys.add.review_list_label"
msgid "&Keys offered by the server:"
msgstr "Cla&ves que ofrece el servidor:"

#. Review dialog button: stores the keys in the user's known hosts.
msgctxt "ui.hostkeys.add.review_btn_add"
msgid "&Add"
msgstr "&Agregar"

#. Review dialog button: closes the dialog without adding anything. It is the default button.
msgctxt "ui.hostkeys.add.review_btn_skip"
msgid "&Don't add"
msgstr "&No agregar"

#. Host key manager status line: the user did not add the offered keys.
msgctxt "ui.hostkeys.add.declined"
msgid "No key was added. The offer stays on the Announced keys tab."
msgstr "No se agregó ninguna clave. La oferta queda en la pestaña de claves anunciadas."

#. Host key manager: this build of the agent cannot connect to a server to collect its host keys yet.
msgctxt "ui.hostkeys.add.err_unsupported"
msgid "ShellDrive cannot collect host keys from a server in this version yet."
msgstr "Esta versión de ShellDrive todavía no puede obtener claves de host de un servidor."

#. Host key manager: the server presented a key that does not match the stored one. {host} is the server name.
msgctxt "ui.hostkeys.add.err_mismatch"
msgid "The host key {host} presented does not match the one stored for it. Nothing was added."
msgstr "La clave de host que presentó {host} no coincide con la guardada. No se agregó nada."

#. Host key manager: the host keys of a server could not be collected. {host} is the server name, {code} the error name.
msgctxt "ui.hostkeys.add.err_connect"
msgid "ShellDrive could not get the host keys of {host} ({code})."
msgstr "ShellDrive no pudo obtener las claves de host de {host} ({code})."

