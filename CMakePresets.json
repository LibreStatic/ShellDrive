{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "x64-modern",
      "displayName": "x64 modern (v143, Windows 10+, CFG + CET)",
      "inherits": "base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-modern",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "x64-xp",
      "displayName": "x64 XP (v141_xp, SDK 7.1A, subsystem 5.02)",
      "inherits": "base",
      "toolset": {
        "value": "v141_xp",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-xp"
      }
    },
    {
      "name": "x86-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "v141_xp",
        "strategy": "set"
      }
    },
    {
      "name": "x86-ia32",
      "displayName": "x86 IA32 (v141_xp, SDK 7.1A, /arch:IA32, no SSE; XP SP3)",
      "inherits": "x86-base",
      "cacheVariables": {
        "SD_FLAVOUR": "x86-ia32",
        "SD_X86_ARCH": "IA32"
      }
    },
    {
      "name": "x86-sse2",
      "displayName": "x86 SSE2 (v141_xp, SDK 7.1A, /arch:SSE2; XP SP3)",
      "inherits": "x86-base",
      "cacheVariables": {
        "SD_FLAVOUR": "x86-sse2",
        "SD_X86_ARCH": "SSE2"
      }
    },
    {
      "name": "x64-analysis",
      "displayName": "x64 analysis (v143, /analyze; -DSD_ENABLE_ASAN=ON for ASan)",
      "inherits": "base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x64-analysis",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0",
        "SD_ENABLE_ANALYZE": "ON",
        "SD_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "x86-fuzz",
      "displayName": "x86 fuzz (v143 Win32, libFuzzer + ASan, DLL CRT; tests/fuzz, never shipped)",
      "inherits": "x86-base",
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "x86-ia32",
        "SD_X86_ARCH": "IA32",
        "SD_FUZZ": "ON",
        "SD_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "arm64",
      "displayName": "ARM64 (v143, SDK 10.0.26100; cross-compiled, build only, no tests)",
      "inherits": "base",
      "architecture": {
        "value": "ARM64",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "arm64",
        "CMAKE_SYSTEM_VERSION": "10.0.26100.0"
      }
    },
    {
      "name": "arm32",
      "displayName": "ARM32 (v143, SDK 10.0.22621; cross-compiled, build only, best effort D5, no tests)",
      "inherits": "base",
      "architecture": {
        "value": "ARM",
        "strategy": "set"
      },
      "toolset": {
        "value": "v143",
        "strategy": "set"
      },
      "cacheVariables": {
        "SD_FLAVOUR": "arm32",
        "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
        "CMAKE_C_COMPILER_WORKS": "1",
        "CMAKE_C_ABI_COMPILED": "ON",
        "CMAKE_C_STANDARD_LIBRARIES": "kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-modern",
      "configurePreset": "x64-modern",
      "configuration": "Release"
    },
    {
      "name": "x64-modern-debug",
      "configurePreset": "x64-modern",
      "configuration": "Debug"
    },
    {
      "name": "x64-xp",
      "configurePreset": "x64-xp",
      "configuration": "Release"
    },
    {
      "name": "x64-xp-debug",
      "configurePreset": "x64-xp",
      "configuration": "Debug"
    },
    {
      "name": "x86-ia32",
      "configurePreset": "x86-ia32",
      "configuration": "Release"
    },
    {
      "name": "x86-ia32-debug",
      "configurePreset": "x86-ia32",
      "configuration": "Debug"
    },
    {
      "name": "x86-sse2",
      "configurePreset": "x86-sse2",
      "configuration": "Release"
    },
    {
      "name": "x86-sse2-debug",
      "configurePreset": "x86-sse2",
      "configuration": "Debug"
    },
    {
      "name": "x86-fuzz",
      "configurePreset": "x86-fuzz",
      "configuration": "Debug"
    },
    {
      "name": "x64-analysis",
      "configurePreset": "x64-analysis",
      "configuration": "Debug"
    },
    {
      "name": "arm64",
      "configurePreset": "arm64",
      "configuration": "Release"
    },
    {
      "name": "arm64-debug",
      "configurePreset": "arm64",
      "configuration": "Debug"
    },
    {
      "name": "arm32",
      "configurePreset": "arm32",
      "configuration": "Release"
    },
    {
      "name": "arm32-debug",
      "configurePreset": "arm32",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "x86-fuzz",
      "inherits": "base",
      "configurePreset": "x86-fuzz",
      "configuration": "Debug",
      "environment": {
        "PATH": "C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Tools\\MSVC\\14.44.35207\\bin\\Hostx64\\x86;$penv{PATH}"
      }
    },
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "x64-modern",
      "inherits": "base",
      "configurePreset": "x64-modern",
      "configuration": "Release"
    },
    {
      "name": "x64-modern-debug",
      "inherits": "base",
      "configurePreset": "x64-modern",
      "configuration": "Debug"
    },
    {
      "name": "x64-xp",
      "inherits": "base",
      "configurePreset": "x64-xp",
      "configuration": "Release"
    },
    {
      "name": "x64-xp-debug",
      "inherits": "base",
      "configurePreset": "x64-xp",
      "configuration": "Debug"
    },
    {
      "name": "x86-ia32",
      "inherits": "base",
      "configurePreset": "x86-ia32",
      "configuration": "Release"
    },
    {
      "name": "x86-ia32-debug",
      "inherits": "base",
      "configurePreset": "x86-ia32",
      "configuration": "Debug"
    },
    {
      "name": "x86-sse2",
      "inherits": "base",
      "configurePreset": "x86-sse2",
      "configuration": "Release"
    },
    {
      "name": "x86-sse2-debug",
      "inherits": "base",
      "configurePreset": "x86-sse2",
      "configuration": "Debug"
    },
    {
      "name": "x64-analysis",
      "inherits": "base",
      "configurePreset": "x64-analysis",
      "configuration": "Debug"
    },
    {
      "name": "arm64",
      "description": "ARM64 test binaries cannot run on x64 hosts (04 section 11.4). This preset selects only the msi.* checks, which run the x64 sd-test-msi of the nested host-tools build on the package (-DSD_BUILD_MSI=ON); without the MSI it selects nothing and ctest exits 0.",
      "configurePreset": "arm64",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^msi[.]"
        }
      },
      "execution": {
        "noTestsAction": "ignore"
      }
    },
    {
      "name": "arm32",
      "description": "ARM32 test binaries cannot run on x64 hosts (04 section 11.4). This preset selects only the msi.* checks, which run the x64 sd-test-msi of the nested host-tools build on the package (-DSD_BUILD_MSI=ON); without the MSI it selects nothing and ctest exits 0.",
      "configurePreset": "arm32",
      "configuration": "Release",
      "filter": {
        "include": {
          "name": "^msi[.]"
        }
      },
      "execution": {
        "noTestsAction": "ignore"
      }
    }
  ]
}
