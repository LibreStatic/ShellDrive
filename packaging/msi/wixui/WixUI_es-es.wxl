    <String Id="VerifyReadyDlgUpdate" Overridable="yes">&amp;Actualizar</String>
    <String Id="VerifyReadyDlgUpdateText" Overridable="yes">Hacé clic en Actualizar para actualizar [ProductName] desde el equipo. Hacé clic en Atrás para revisar o cambiar alguna de las opciones de instalación. Hacé clic en Cancelar para salir del asistente.</String>
