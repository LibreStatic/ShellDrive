# ShellDrive CLI strings, Spanish (Rioplatense voseo).
msgid ""
msgstr ""
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n == 1 ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

msgctxt "cli.version"
msgid "ShellDrive {version}"
msgstr "ShellDrive {version}"

msgctxt "cli.usage"
msgid "Usage: shelldrive <command> [options]"
msgstr "Uso: shelldrive <comando> [opciones]"

msgctxt "cli.unknown_command"
msgid "Unknown command: {command}. Run \"shelldrive --help\" for help."
msgstr "Comando desconocido: {command}. Ejecutá \"shelldrive --help\" para ver la ayuda."

msgctxt "cli.mounted_count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} unidad montada."
msgstr[1] "{count} de unidades montadas."
msgstr[2] "{count} unidades montadas."
