    <String Id="VerifyReadyDlgBannerBitmap" Overridable="yes">WixUI_Bmp_Banner</String>
    <String Id="VerifyReadyDlgChange" Overridable="yes">&amp;Ändern</String>
    <String Id="VerifyReadyDlgChangeText" Overridable="yes">Klicke auf "Ändern", um die Installation zu starten. Klicke auf "Zurück", um die Installationseinstellungen zu prüfen oder zu ändern. Klicke auf "Abbrechen", um den Assistenten zu beenden.</String>
    <String Id="VerifyReadyDlgChangeTitle" Overridable="yes">{\WixUI_Font_Title}Bereit zur Änderung von [ProductName]</String>
    <String Id="VerifyReadyDlgInstall" Overridable="yes">&amp;Installieren</String>
    <String Id="VerifyReadyDlgInstallText" Overridable="yes">Klicke auf "Installieren", um die Installation zu starten. Klicke auf "Zurück", um die Installationseinstellungen zu prüfen oder zu ändern. Klicke auf "Abbrechen", um den Assistenten zu beenden.</String>
    <String Id="VerifyReadyDlgInstallTitle" Overridable="yes">{\WixUI_Font_Title}Bereit zur Installation von [ProductName]</String>
    <String Id="VerifyReadyDlgRemove" Overridable="yes">&amp;Entfernen</String>
    <String Id="VerifyReadyDlgRemoveText" Overridable="yes">Klicke auf "Entfernen", um [ProductName] vom Computer zu entfernen. Klicke auf "Zurück", um die Installationseinstellungen zu prüfen oder zu ändern. Klicke auf "Abbrechen", um den Assistenten zu beenden.</String>
    <String Id="VerifyReadyDlgRemoveTitle" Overridable="yes">{\WixUI_Font_Title}Bereit zum Entfernen von [ProductName]</String>
    <String Id="VerifyReadyDlgRepair" Overridable="yes">Re&amp;parieren</String>
    <String Id="VerifyReadyDlgRepairText" Overridable="yes">Klicke auf "Reparieren", um die Installation von [ProductName] zu reparieren. Klicke auf "Zurück", um die Installationseinstellungen zu prüfen oder zu ändern. Klicke auf "Abbrechen", um den Assistenten zu beenden.</String>
    <String Id="VerifyReadyDlgRepairTitle" Overridable="yes">{\WixUI_Font_Title}Bereit zur Reparatur von [ProductName]</String>
    <String Id="VerifyReadyDlgUpdate" Overridable="yes">&amp;Aktualisieren</String>
    <String Id="VerifyReadyDlgUpdateText" Overridable="yes">Klicke auf "Aktualisieren", um [ProductName] auf deinem Computer zu aktualisieren. Klicke auf "Zurück", um die Installationseinstellungen zu prüfen oder zu ändern. Klicke auf "Abbrechen", um den Assistenten zu beenden.</String>
    <String Id="VerifyReadyDlgUpdateTitle" Overridable="yes">{\WixUI_Font_Title}Bereit zum Aktualisieren von [ProductName]</String>
    <String Id="VerifyReadyDlg_Title" Overridable="yes">[ProductName]-Setup</String>
