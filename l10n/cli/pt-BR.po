# ShellDrive CLI strings, Brazilian Portuguese.
msgid ""
msgstr ""
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=((n == 0 || n == 1) ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

msgctxt "cli.version"
msgid "ShellDrive {version}"
msgstr "ShellDrive {version}"

msgctxt "cli.usage"
msgid "Usage: shelldrive <command> [options]"
msgstr "Uso: shelldrive <comando> [opções]"

msgctxt "cli.unknown_command"
msgid "Unknown command: {command}. Run \"shelldrive --help\" for help."
msgstr "Comando desconhecido: {command}. Execute \"shelldrive --help\" para ver a ajuda."

msgctxt "cli.mounted_count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} unidade montada."
msgstr[1] "{count} de unidades montadas."
msgstr[2] "{count} unidades montadas."

msgctxt "cli.help.commands"
msgid "Commands:"
msgstr "Comandos:"

msgctxt "cli.help.options"
msgid "Options:"
msgstr "Opções:"

msgctxt "cli.help.global_options"
msgid "Global options:"
msgstr "Opções globais:"

msgctxt "cli.help.mount"
msgid "Mount a profile or a server as a drive."
msgstr "Monta um perfil ou um servidor como unidade."

msgctxt "cli.help.unmount"
msgid "Unmount a drive, or every drive with --all."
msgstr "Desmonta uma unidade, ou todas com --all."

msgctxt "cli.help.list"
msgid "List the drives mounted in this session."
msgstr "Mostra as unidades montadas nesta sessão."

msgctxt "cli.help.agent_stop"
msgid "Stop the ShellDrive agent of this session and unmount its drives."
msgstr "Para o agente do ShellDrive desta sessão e desmonta as unidades dele."

msgctxt "cli.help.version"
msgid "Show the version."
msgstr "Mostra a versão."

msgctxt "cli.help.help"
msgid "Show help for a command."
msgstr "Mostra a ajuda de um comando."

msgctxt "cli.help.more"
msgid "Run \"shelldrive help <command>\" to see the options of a command."
msgstr "Execute \"shelldrive help <comando>\" para ver as opções de um comando."

msgctxt "cli.help.opt_host"
msgid "Server to connect to, with an optional user name and port."
msgstr "Servidor ao qual se conectar, com nome de usuário e porta opcionais."

msgctxt "cli.help.opt_letter"
msgid "Drive letter to use, for example Z:. By default the first free letter from Z: down."
msgstr "Letra de unidade a usar, por exemplo Z:. Por padrão, a primeira letra livre de Z: para baixo."

msgctxt "cli.help.opt_identity"
msgid "Private key file to sign in with."
msgstr "Arquivo de chave privada usado para entrar."

msgctxt "cli.help.opt_remote_path"
msgid "Folder on the server to show in the drive. By default your home folder."
msgstr "Pasta do servidor a mostrar na unidade. Por padrão, sua pasta pessoal."

msgctxt "cli.help.opt_read_only"
msgid "Mount the drive read-only."
msgstr "Monta a unidade somente leitura."

msgctxt "cli.help.opt_prompt"
msgid "How to ask for passwords and confirmations: auto, console or none."
msgstr "Como pedir senhas e confirmações: auto, console ou none."

msgctxt "cli.help.opt_stdin"
msgid "Read the answers to questions from standard input, one per line."
msgstr "Lê as respostas às perguntas da entrada padrão, uma por linha."

msgctxt "cli.help.opt_no_wait"
msgid "Return as soon as the mount has started."
msgstr "Retorna assim que a montagem começar."

msgctxt "cli.help.opt_all"
msgid "Unmount every drive of this session."
msgstr "Desmonta todas as unidades desta sessão."

msgctxt "cli.help.opt_json"
msgid "Print the result as JSON."
msgstr "Mostra o resultado como JSON."

msgctxt "cli.help.opt_quiet"
msgid "Print only errors."
msgstr "Mostra apenas os erros."

msgctxt "cli.help.opt_lang"
msgid "Language of the messages: en, es, fr, pt, it or de."
msgstr "Idioma das mensagens: en, es, fr, pt, it ou de."

msgctxt "cli.err.unknown_option"
msgid "Unknown option: {option}."
msgstr "Opção desconhecida: {option}."

msgctxt "cli.err.missing_value"
msgid "The option {option} needs a value."
msgstr "A opção {option} precisa de um valor."

msgctxt "cli.err.missing_argument"
msgid "The command \"{command}\" needs more arguments."
msgstr "Faltam argumentos para o comando \"{command}\"."

msgctxt "cli.err.extra_argument"
msgid "Unexpected argument: {argument}."
msgstr "Argumento inesperado: {argument}."

msgctxt "cli.err.bad_value"
msgid "Invalid value for {option}: {value}."
msgstr "Valor inválido para {option}: {value}."

msgctxt "cli.err.conflict"
msgid "{option} cannot be used together with {other}."
msgstr "{option} não pode ser usado junto com {other}."

msgctxt "cli.err.host_spec"
msgid "Invalid server: {value}. Use [user@]host[:port]."
msgstr "Servidor inválido: {value}. Use [usuário@]host[:porta]."

msgctxt "cli.err.see_help"
msgid "Run \"shelldrive help {command}\" for help."
msgstr "Execute \"shelldrive help {command}\" para ver a ajuda."

msgctxt "cli.mount.connecting"
msgid "Connecting to {host}..."
msgstr "Conectando a {host}..."

msgctxt "cli.mount.done"
msgid "Mounted {name} on {target}."
msgstr "{name} foi montado em {target}."

msgctxt "cli.mount.started"
msgid "Mounting {name} on {target}."
msgstr "Montando {name} em {target}."

msgctxt "cli.unmount.done"
msgid "Unmounted {target}."
msgstr "{target} foi desmontado."

msgctxt "cli.list.empty"
msgid "No drives are mounted."
msgstr "Nenhuma unidade está montada."

msgctxt "cli.list.col_drive"
msgid "Drive"
msgstr "Unidade"

msgctxt "cli.list.col_state"
msgid "State"
msgstr "Estado"

msgctxt "cli.list.col_server"
msgid "Server"
msgstr "Servidor"

msgctxt "cli.list.col_profile"
msgid "Profile"
msgstr "Perfil"

msgctxt "cli.state.connecting"
msgid "connecting"
msgstr "conectando"

msgctxt "cli.state.authenticating"
msgid "signing in"
msgstr "entrando"

msgctxt "cli.state.mounted"
msgid "mounted"
msgstr "montada"

msgctxt "cli.state.offline"
msgid "offline"
msgstr "offline"

msgctxt "cli.state.auth_required"
msgid "sign-in required"
msgstr "login necessário"

msgctxt "cli.state.failed"
msgid "failed"
msgstr "falhou"

msgctxt "cli.state.unmounting"
msgid "unmounting"
msgstr "desmontando"

msgctxt "cli.state.unmounted"
msgid "unmounted"
msgstr "desmontada"

msgctxt "cli.agent.stopped"
msgid "The ShellDrive agent stopped."
msgstr "O agente do ShellDrive parou."

msgctxt "cli.agent.not_running"
msgid "The ShellDrive agent is not running."
msgstr "O agente do ShellDrive não está em execução."

msgctxt "cli.hk.unknown"
msgid "The authenticity of host '{host}' (port {port}) can't be established."
msgstr "Não é possível confirmar a autenticidade do host '{host}' (porta {port})."

msgctxt "cli.hk.fingerprint"
msgid "{type} key fingerprint: {fingerprint}"
msgstr "Impressão digital da chave {type}: {fingerprint}"

msgctxt "cli.hk.check_hint"
msgid "Compare the fingerprint with the one the server's administrator gave you."
msgstr "Compare a impressão digital com a que o administrador do servidor passou para você."

msgctxt "cli.hostkey_default_no"
msgid "Trust this key? [y]es, [o]nce, [N]o: "
msgstr "Confiar nesta chave? [s]im, [u]ma vez, [N]ão: "

msgctxt "cli.hk.letter_yes"
msgid "y"
msgstr "s"

msgctxt "cli.hk.letter_once"
msgid "o"
msgstr "u"

msgctxt "cli.hk.word_yes"
msgid "yes"
msgstr "sim"

msgctxt "cli.hk.word_once"
msgid "once"
msgstr "uma vez"

msgctxt "prompt.hostkey_just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Você acabou de aceitar a identidade deste servidor. O ShellDrive não enviou automaticamente sua senha salva."

msgctxt "cli.prompt.password"
msgid "Password for {user}@{host}: "
msgstr "Senha de {user}@{host}: "

msgctxt "cli.prompt.passphrase"
msgid "Passphrase for the key {key}: "
msgstr "Frase secreta da chave {key}: "

msgctxt "cli.prompt.retry"
msgid "The server did not accept the answer. Try again."
msgstr "O servidor não aceitou a resposta. Tente de novo."

msgctxt "cli.prompt.server_says"
msgid "The server {host} asks:"
msgstr "O servidor {host} pergunta:"

msgctxt "cli.hk.mismatch_stored"
msgid "Stored key: {type} {fingerprint} ({file}, line {line})"
msgstr "Chave salva: {type} {fingerprint} ({file}, linha {line})"

msgctxt "cli.hk.mismatch_offered"
msgid "Key offered now: {type} {fingerprint}"
msgstr "Chave oferecida agora: {type} {fingerprint}"

msgctxt "cli.hk.mismatch_hint"
msgid "If the server's key really changed, remove the old key from that file and connect again."
msgstr "Se a chave do servidor mudou de verdade, remova a chave antiga desse arquivo e conecte-se novamente."

msgctxt "cli.error.auth_failed"
msgid "Signing in to {host} failed. Check the user name, the password or the key."
msgstr "Não foi possível entrar em {host}. Verifique o nome de usuário, a senha ou a chave."

msgctxt "cli.error.prompt_required"
msgid "{host} needs a password or another answer, but ShellDrive was not allowed to ask. Run the command in a console or use --stdin."
msgstr "{host} precisa de uma senha ou de outra resposta, mas o ShellDrive não tinha permissão para perguntar. Execute o comando em um console ou use --stdin."

msgctxt "cli.error.host_key_unknown"
msgid "The identity of {host} is not known yet, and ShellDrive was not allowed to ask you to confirm it. Run the command in a console to check the key."
msgstr "A identidade de {host} ainda não é conhecida, e o ShellDrive não tinha permissão para pedir que você a confirmasse. Execute o comando em um console para verificar a chave."

msgctxt "cli.error.host_key_rejected"
msgid "You did not trust the key of {host}. ShellDrive did not connect."
msgstr "Você não confiou na chave de {host}. O ShellDrive não se conectou."

msgctxt "cli.error.host_key_mismatch"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "A identidade de {host} mudou. O ShellDrive interrompeu a conexão."

msgctxt "cli.error.host_key_type_unavailable"
msgid "{host} did not offer the type of key ShellDrive knows for it. ShellDrive stopped the connection."
msgstr "{host} não ofereceu o tipo de chave que o ShellDrive conhece para ele. O ShellDrive interrompeu a conexão."

msgctxt "cli.error.host_key_revoked"
msgid "The key of {host} has been revoked. ShellDrive stopped the connection."
msgstr "A chave de {host} foi revogada. O ShellDrive interrompeu a conexão."

msgctxt "cli.error.dns_failed"
msgid "The server name {host} could not be found."
msgstr "O nome de servidor {host} não foi encontrado."

msgctxt "cli.error.conn_refused"
msgid "{host} refused the connection."
msgstr "{host} recusou a conexão."

msgctxt "cli.error.net_unreachable"
msgid "{host} cannot be reached from this network."
msgstr "{host} não pode ser alcançado a partir desta rede."

msgctxt "cli.error.connect_failed"
msgid "The connection to {host} failed."
msgstr "A conexão com {host} falhou."

msgctxt "cli.error.kex_failed"
msgid "ShellDrive and {host} could not agree on a secure connection."
msgstr "O ShellDrive e {host} não conseguiram estabelecer uma conexão segura."

msgctxt "cli.error.legacy_refused"
msgid "{host} only offers outdated encryption, which is turned off."
msgstr "{host} só oferece criptografia obsoleta, que está desativada."

msgctxt "cli.error.bad_passphrase"
msgid "The passphrase of the key is wrong."
msgstr "A frase secreta da chave está incorreta."

msgctxt "cli.error.key_format"
msgid "The key file could not be read."
msgstr "Não foi possível ler o arquivo de chave."

msgctxt "cli.error.timeout"
msgid "The operation took too long and was stopped."
msgstr "A operação demorou demais e foi interrompida."

msgctxt "cli.error.cancelled"
msgid "Cancelled."
msgstr "Cancelado."

msgctxt "cli.error.agent_unavailable"
msgid "The ShellDrive agent is not running and could not be started."
msgstr "O agente do ShellDrive não está em execução e não pôde ser iniciado."

msgctxt "cli.error.agent_untrusted"
msgid "Another program is using the name of the ShellDrive agent. ShellDrive did not connect to it."
msgstr "Outro programa está usando o nome do agente do ShellDrive. O ShellDrive não se conectou a ele."

msgctxt "cli.error.access_denied"
msgid "Access denied."
msgstr "Acesso negado."

msgctxt "cli.error.proto_unsupported"
msgid "This shelldrive version does not match the running ShellDrive agent. Run \"shelldrive agent stop\" and try again."
msgstr "Esta versão do shelldrive não corresponde ao agente do ShellDrive em execução. Execute \"shelldrive agent stop\" e tente de novo."

msgctxt "cli.error.profile_not_found"
msgid "There is no profile named {name}."
msgstr "Não há nenhum perfil chamado {name}."

msgctxt "cli.error.mount_not_found"
msgid "No ShellDrive drive matches {name}."
msgstr "Nenhuma unidade do ShellDrive corresponde a {name}."

msgctxt "cli.error.target_in_use"
msgid "The drive letter {target} is already in use."
msgstr "A letra de unidade {target} já está em uso."

msgctxt "cli.error.invalid_target"
msgid "Invalid drive letter: {value}. Use a letter from D: to Z:."
msgstr "Letra de unidade inválida: {value}. Use uma letra de D: a Z:."

msgctxt "cli.error.already_mounted"
msgid "This profile is already mounted."
msgstr "Este perfil já está montado."

msgctxt "cli.error.backend_unavailable"
msgid "Dokany is not installed, so ShellDrive cannot create the drive. Install Dokany 2.1 or later."
msgstr "O Dokany não está instalado, por isso o ShellDrive não pode criar a unidade. Instale o Dokany 2.1 ou posterior."

msgctxt "cli.error.generic"
msgid "The operation failed ({code})."
msgstr "A operação falhou ({code})."

msgctxt "cli.help.opt_backend"
msgid "Drive backend: auto (Dokany when it is installed, otherwise WebDAV), dokany or webdav."
msgstr "Back-end da unidade: auto (Dokany se estiver instalado; caso contrário, WebDAV), dokany ou webdav."

msgctxt "cli.error.webclient_disabled"
msgid "The WebClient service is disabled, so ShellDrive cannot create a WebDAV drive. An administrator can enable it with: sc config WebClient start= demand"
msgstr "O serviço WebClient está desativado, então o ShellDrive não pode criar uma unidade WebDAV. Um administrador pode ativá-lo com: sc config WebClient start= demand"

msgctxt "cli.error.webdav_unavailable"
msgid "The Windows WebDAV client (WebClient service) is not installed or could not be started. An administrator can start it with: sc start WebClient. On Windows Server, add the WebDAV Redirector feature first."
msgstr "O cliente WebDAV do Windows (serviço WebClient) não está instalado ou não pôde ser iniciado. Um administrador pode iniciá-lo com: sc start WebClient. No Windows Server, adicione primeiro o recurso WebDAV Redirector."

msgctxt "cli.state.reconnecting"
msgid "reconnecting"
msgstr "reconectando"

msgctxt "cli.list.write_failed"
msgid "On {target}, {count} file could not be saved on the server (last: {path})."
msgid_plural "On {target}, {count} files could not be saved on the server (last: {path})."
msgstr[0] "Em {target}, não foi possível salvar {count} arquivo no servidor (último: {path})."
msgstr[1] "Em {target}, não foi possível salvar {count} de arquivos no servidor (último: {path})."
msgstr[2] "Em {target}, não foi possível salvar {count} arquivos no servidor (último: {path})."

#. ---- M2: status, profile import, hostkey commands, mount options and the new prompts ----

#. Summary of the status command.
msgctxt "cli.help.status"
msgid "Show the detailed state of the mounted drives."
msgstr "Mostra o estado detalhado das unidades montadas."

#. Summary of "profile import".
msgctxt "cli.help.profile_import"
msgid "Import profiles from PuTTY sessions or an OpenSSH ssh_config file."
msgstr "Importa perfis de sessões do PuTTY ou de um arquivo ssh_config do OpenSSH."

#. Summary of the hostkey command.
msgctxt "cli.help.hostkey"
msgid "Show, import or remove stored host keys, and apply announced key updates."
msgstr "Mostra, importa ou remove as chaves de host salvas e aplica as atualizações de chaves anunciadas."

#. Help for --jump HOST. The value syntax is literal.
msgctxt "cli.help.opt_jump"
msgid "A server to connect through before the target, as [user@]host[:port]. Repeat the option for several hops."
msgstr "Um servidor pelo qual conectar antes do destino, no formato [usuário@]host[:porta]. Repita a opção para vários saltos."

#. Help for --proxy SPEC. The value syntax and the scheme names are literal.
msgctxt "cli.help.opt_proxy"
msgid "Proxy for the first leg: http://[user@]host[:port] or socks5://[user@]host[:port]."
msgstr "Proxy para o primeiro trecho: http://[usuário@]host[:porta] ou socks5://[usuário@]host[:porta]."

#. Help for --connections N. States the pool rule (D18): extra connections only with non-interactive auth.
msgctxt "cli.help.opt_connections"
msgid "How many connections to the server to use at once, from 1 to 4. More than one is only reached when signing in needs no typed answer."
msgstr "Quantas conexões com o servidor usar ao mesmo tempo, de 1 a 4. Mais de uma só é usada quando entrar não exige uma resposta digitada."

#. Help for hostkey remove --type T.
msgctxt "cli.help.opt_type"
msgid "Remove only the stored key of this type, for example ssh-ed25519."
msgstr "Remove somente a chave salva desse tipo, por exemplo ssh-ed25519."

#. Help for hostkey import --from. putty and openssh are literal values.
msgctxt "cli.help.opt_from"
msgid "Where to copy host keys from: putty (the registry) or openssh (a known_hosts file)."
msgstr "De onde copiar as chaves de host: putty (o Registro) ou openssh (um arquivo known_hosts)."

#. Help for hostkey accept-announced --add-only.
msgctxt "cli.help.opt_add_only"
msgid "Add the new keys, but keep the keys the server no longer offers."
msgstr "Adiciona as chaves novas, mas mantém as chaves que o servidor não oferece mais."

#. Help for hostkey list --announced.
msgctxt "cli.help.opt_announced"
msgid "Show the host key updates that servers announced and that wait for review."
msgstr "Mostra as atualizações de chaves de host que os servidores anunciaram e que aguardam revisão."

#. Help for --dry-run.
msgctxt "cli.help.opt_dry_run"
msgid "Show what would be imported without writing anything."
msgstr "Mostra o que seria importado sem gravar nada."

#. Detail line of shelldrive status; {state} is a connection state word such as ready.
msgctxt "cli.status.conn"
msgid "Connection: {state}"
msgstr "Conexão: {state}"

#. Detail line of shelldrive status.
msgctxt "cli.status.pool"
msgid "Connections in use: {count} of {wanted}."
msgstr "Conexões em uso: {count} de {wanted}."

#. Detail line of shelldrive status: automatic reconnects after losses.
msgctxt "cli.status.reconnects"
msgid "Reconnected {count} times."
msgstr "Reconexões: {count}."

#. Detail line of shelldrive status; {reason} is an English error identifier.
msgctxt "cli.status.reason"
msgid "The connection was lost ({reason})."
msgstr "A conexão foi perdida ({reason})."

#. profile import summary with --dry-run.
#, plural-arg=count
msgctxt "cli.pi.found"
msgid "{count} profile found. Nothing was written (--dry-run)."
msgid_plural "{count} profiles found. Nothing was written (--dry-run)."
msgstr[0] "{count} perfil encontrado. Nada foi gravado (--dry-run)."
msgstr[1] "{count} de perfis encontrados. Nada foi gravado (--dry-run)."
msgstr[2] "{count} perfis encontrados. Nada foi gravado (--dry-run)."

#. profile import summary.
#, plural-arg=count
msgctxt "cli.pi.imported"
msgid "{count} profile imported."
msgid_plural "{count} profiles imported."
msgstr[0] "{count} perfil importado."
msgstr[1] "{count} de perfis importados."
msgstr[2] "{count} perfis importados."

#. profile import of a source with no usable entries.
msgctxt "cli.pi.empty"
msgid "Nothing to import."
msgstr "Nada para importar."

#. Note column of the profile import table.
msgctxt "cli.pi.note_duplicate"
msgid "a profile for this server already exists"
msgstr "já existe um perfil para este servidor"

#. Note column of the profile import table (D37).
msgctxt "cli.pi.note_only_this_key"
msgid "the imported key would be the only one offered"
msgstr "a chave importada seria a única oferecida"

#. Note column of the profile import table.
msgctxt "cli.pi.note_proxy_skipped"
msgid "its proxy type is not supported"
msgstr "o tipo de proxy não é compatível"

#. Note column of the profile import table.
msgctxt "cli.pi.note_name_changed"
msgid "renamed because the name was taken"
msgstr "renomeado porque o nome já estava em uso"

#. profile import: an ssh_config keyword that has no ShellDrive equivalent (3.7). {item} is the keyword.
msgctxt "cli.pi.skip_keyword"
msgid "{source}: the {item} lines are not imported."
msgstr "{source}: as linhas {item} não são importadas."

#. profile import: same, for global lines (no Host section).
msgctxt "cli.pi.skip_keyword_global"
msgid "The {item} lines are not imported."
msgstr "As linhas {item} não são importadas."

#. profile import: a PuTTY session of another protocol. {item} is the protocol.
msgctxt "cli.pi.skip_not_ssh"
msgid "{source}: the session is not SSH ({item})."
msgstr "{source}: a sessão não é SSH ({item})."

#. profile import: a PuTTY proxy type without an equivalent (D20). {item} is the method.
msgctxt "cli.pi.skip_proxy"
msgid "{source}: the proxy type ({item}) is not supported."
msgstr "{source}: o tipo de proxy ({item}) não é compatível."

#. profile import: an unusable entry.
msgctxt "cli.pi.skip_invalid"
msgid "{source}: unusable entry ({item})."
msgstr "{source}: entrada inutilizável ({item})."

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_store"
msgid "Store"
msgstr "Repositório"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_type"
msgid "Type"
msgstr "Tipo"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_fp"
msgid "Fingerprint"
msgstr "Impressão digital"

#. hostkey list of a host with no stored key.
msgctxt "cli.hk.list_empty"
msgid "No host key is stored for {host}."
msgstr "Não há nenhuma chave de host salva para {host}."

#. hostkey list stopped early because there are very many keys.
msgctxt "cli.hk.list_truncated"
msgid "The list was cut short; refine the host name to see the rest."
msgstr "A lista foi encurtada; refine o nome do host para ver o restante."

#. hostkey remove.
msgctxt "cli.hk.removed"
msgid "Removed the stored keys of {host}."
msgstr "As chaves salvas de {host} foram removidas."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.imported"
msgid "{count} host key imported."
msgid_plural "{count} host keys imported."
msgstr[0] "{count} chave de host importada."
msgstr[1] "{count} de chaves de host importadas."
msgstr[2] "{count} chaves de host importadas."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_kept"
msgid "{count} key was already stored."
msgid_plural "{count} keys were already stored."
msgstr[0] "{count} chave já estava salva."
msgstr[1] "{count} de chaves já estavam salvas."
msgstr[2] "{count} chaves já estavam salvas."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_conflicts"
msgid "{count} key conflicts with a stored key and was not imported."
msgid_plural "{count} keys conflict with stored keys and were not imported."
msgstr[0] "{count} chave está em conflito com uma chave salva e não foi importada."
msgstr[1] "{count} de chaves estão em conflito com chaves salvas e não foram importadas."
msgstr[2] "{count} chaves estão em conflito com chaves salvas e não foram importadas."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_invalid"
msgid "{count} line could not be read."
msgid_plural "{count} lines could not be read."
msgstr[0] "Não foi possível ler {count} linha."
msgstr[1] "Não foi possível ler {count} de linhas."
msgstr[2] "Não foi possível ler {count} linhas."

#. hostkey import of a source without keys.
msgctxt "cli.hk.import_empty"
msgid "The source has no host keys."
msgstr "A origem não tem chaves de host."

#. hostkey list --announced with nothing pending.
msgctxt "cli.hk.announced_none"
msgid "There are no host key updates to review."
msgstr "Não há atualizações de chaves de host para revisar."

#. hostkey list --announced, one pending update. {id} is the id for accept-announced.
msgctxt "cli.hk.announced_item"
msgid "{id}: {host} offered new host keys."
msgstr "{id}: {host} ofereceu chaves de host novas."

#. One key a server added to its announcement (5.6).
msgctxt "cli.hk.announced_add"
msgid "New key: {type} {fingerprint}"
msgstr "Chave nova: {type} {fingerprint}"

#. One key a server no longer offers (5.6).
msgctxt "cli.hk.announced_remove"
msgid "No longer offered: {type} {fingerprint}"
msgstr "Não é mais oferecida: {type} {fingerprint}"

#. hostkey accept-announced.
msgctxt "cli.hk.announced_applied"
msgid "Updated the host keys of {host}: {added} added, {removed} removed."
msgstr "As chaves de host de {host} foram atualizadas (adicionadas: {added}; removidas: {removed})."

#. Introduction of the password-change questions (2.5, PASSWD_CHANGEREQ).
msgctxt "cli.prompt.password_change"
msgid "The server {host} asks to change the password."
msgstr "O servidor {host} pede para alterar a senha."

#. Proxy password prompt; input is hidden.
msgctxt "cli.prompt.proxy_password"
msgid "Password for the proxy {user}@{proxy_host}:{proxy_port}: "
msgstr "Senha do proxy {user}@{proxy_host}:{proxy_port}: "

#. The legacy-algorithms question (2.5, C21); {algorithms} is a comma list of algorithm names.
msgctxt "cli.prompt.legacy_ack"
msgid "The server {host} uses outdated encryption ({algorithms})."
msgstr "O servidor {host} usa criptografia obsoleta ({algorithms})."

#. The legacy-algorithms question; the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.legacy_ack_question"
msgid "Continue anyway? [y]es, [N]o: "
msgstr "Continuar mesmo assim? [s]im, [N]ão: "

#. Shown for hop i >= 1 of a jump chain (TM-R03). {host} is the previous hop.
msgctxt "cli.prompt.via"
msgid "Reached through jump host {host}."
msgstr "Conexão feita através do host de salto {host}."

#. Shown for every prompt of a jump chain. {host} is the hop's server.
msgctxt "cli.prompt.hop"
msgid "Jump host {hop} of {hops}: {host}"
msgstr "Host de salto {hop} de {hops}: {host}"

#. Save question after a password, passphrase or proxy password (4.2); the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.save"
msgid "Save the answer for the next connection? [y]es, [N]o: "
msgstr "Salvar a resposta para a próxima conexão? [s]im, [N]ão: "

#. Credential Manager comment for a saved secret (4.2). {name} is the profile name.
msgctxt "cli.save.comment"
msgid "Saved by ShellDrive for {name}"
msgstr "Salvo pelo ShellDrive para {name}"

msgctxt "cli.error.host_key_not_found"
msgid "No host key of {host} is stored in your ShellDrive store."
msgstr "Não há nenhuma chave de {host} salva no repositório do ShellDrive."

msgctxt "cli.error.announcement_not_found"
msgid "There is no pending host key update with this id."
msgstr "Não há nenhuma atualização de chaves de host pendente com este id."

msgctxt "cli.error.session_not_found"
msgid "There is no PuTTY session named {name}."
msgstr "Não há nenhuma sessão do PuTTY chamada {name}."

msgctxt "cli.error.putty_not_found"
msgid "PuTTY is not installed, or it has no saved sessions."
msgstr "O PuTTY não está instalado ou não tem sessões salvas."

msgctxt "cli.error.file_not_found"
msgid "The file {name} could not be read."
msgstr "Não foi possível ler o arquivo {name}."

#. M3: refresh, cache clear, profile test, status --stats and the new mount option.
#. Exit code 3: the drive has no file system to refresh.
msgctxt "cli.error.not_mounted"
msgid "The drive is not mounted, so there is nothing to refresh."
msgstr "A unidade não está montada, então não há nada para atualizar."

#. Exit code 8: write-behind data is queued and the cache clear was refused.
msgctxt "cli.error.write_behind_pending"
msgid "Changes are still waiting to be written to the server, so the cache was not cleared. Run the command again with --force to clear the rest; the waiting changes are kept."
msgstr "Ainda há alterações aguardando para serem gravadas no servidor, então o cache não foi limpo. Execute o comando novamente com --force para limpar o restante; as alterações pendentes são mantidas."

#. Printed by shelldrive refresh. {path} is the drive and the folder, such as W: or W:\docs.
msgctxt "cli.refresh.done"
msgid "Refreshed the cache of {path}."
msgstr "O cache de {path} foi atualizado."

#. Printed by shelldrive cache clear. {count} is the number of drives whose cache was cleared.
#, plural-arg=count
msgctxt "cli.cache.cleared"
msgid "Cleared the cache of {count} drive."
msgid_plural "Cleared the cache of {count} drives."
msgstr[0] "Cache limpo para {count} unidade."
msgstr[1] "Cache limpo para {count} de unidades."
msgstr[2] "Cache limpo para {count} unidades."

#. Printed by status --stats for a drive without a connection.
msgctxt "cli.stats.none"
msgid "No statistics: the drive has no connection."
msgstr "Sem estatísticas: a unidade não tem conexão."

#. Heading of one drive in status --stats. {target} is the drive, {name} the profile.
msgctxt "cli.stats.header"
msgid "{target} {name}"
msgstr "{target} {name}"

#. status --stats: the session line. Round trip in milliseconds; generation counts the reconnects.
msgctxt "cli.stats.session"
msgid "Connection: round trip {srtt} ms, {inflight} requests in flight, {queued} queued, session generation {generation}."
msgstr "Conexão: ida e volta de {srtt} ms, {inflight} requisições em andamento, {queued} na fila, geração da sessão {generation}."

#. status --stats: bytes received and sent by the current connection.
msgctxt "cli.stats.transfer"
msgid "Transferred {rx} bytes in and {tx} bytes out."
msgstr "Transferidos {rx} bytes de entrada e {tx} bytes de saída."

#. status --stats: the cache counters of the drive (memory and disk tiers).
msgctxt "cli.stats.cache"
msgid "Cache: {hits} hits, {misses} misses, {failed} failed writes, {queued} bytes waiting for write-behind."
msgstr "Cache: {hits} acertos, {misses} erros, {failed} gravações com falha, {queued} bytes aguardando gravação adiada."

#. profile test: the result line. {path} is the resolved remote folder.
msgctxt "cli.test.ok"
msgid "{name} works: connected to {host} as {user}, and the remote path is {path}."
msgstr "{name} funciona: conectado a {host} como {user}, e o caminho remoto é {path}."

#. profile test: the host key that was verified.
msgctxt "cli.test.hostkey"
msgid "Host key: {fingerprint}."
msgstr "Chave do host: {fingerprint}."

#. profile test: the negotiated algorithms (key exchange, host key, cipher and MAC of the client-to-server direction).
msgctxt "cli.test.algorithms"
msgid "Algorithms: key exchange {kex}, host key {hostkey}, cipher {cipher}, MAC {mac}."
msgstr "Algoritmos: troca de chaves {kex}, chave do host {hostkey}, cifra {cipher}, MAC {mac}."

#. profile test: an outdated algorithm was negotiated on some hop.
msgctxt "cli.test.legacy"
msgid "The server negotiated an outdated algorithm. security.legacy_algorithms decides what happens next."
msgstr "O servidor negociou um algoritmo desatualizado. security.legacy_algorithms decide o que acontece depois."

#. Help of the mount option --open.
msgctxt "cli.help.opt_open"
msgid "Open the drive in Explorer once it is mounted."
msgstr "Abre a unidade no Explorador depois de montada."

#. Help of the status option --stats.
msgctxt "cli.help.opt_stats"
msgid "Also show the connection and cache counters of each drive."
msgstr "Mostra também os contadores de conexão e de cache de cada unidade."

#. Help of the cache clear option --force.
msgctxt "cli.help.opt_force"
msgid "Clear the cache even while changes are waiting to be written. The waiting changes are kept."
msgstr "Limpa o cache mesmo com alterações aguardando gravação. As alterações pendentes são mantidas."

#. Summary of the refresh command.
msgctxt "cli.help.refresh"
msgid "Drop the cached attributes and listings of a folder, or of the whole drive."
msgstr "Descarta os atributos e as listagens em cache de uma pasta ou de toda a unidade."

#. Summary of the cache command.
msgctxt "cli.help.cache"
msgid "Clear the cache of a profile, a drive or every mounted drive."
msgstr "Limpa o cache de um perfil, de uma unidade ou de todas as unidades montadas."

#. Summary of profile test.
msgctxt "cli.help.profile_test"
msgid "Connect and sign in, then resolve the remote path, without mounting anything."
msgstr "Conecta e autentica, depois resolve o caminho remoto, sem montar nada."

msgctxt "cli.help.service"
msgid "Global drives (shared by every session) and the ShellDrive service: list, mount, unmount, status, install, uninstall, start, stop and repair-data. Changing them needs an elevated console."
msgstr "Unidades globais (compartilhadas por todas as sessões) e o serviço ShellDrive: list, mount, unmount, status, install, uninstall, start, stop e repair-data. Para alterá-las, use um console elevado."

msgctxt "cli.service.need_admin"
msgid "Changing global drives needs an elevated console. Run it as administrator."
msgstr "Alterar unidades globais exige um console elevado. Execute o programa como administrador."

msgctxt "cli.service.unavailable"
msgid "The ShellDrive service is not running or not installed."
msgstr "O serviço do ShellDrive não está em execução ou não está instalado."

msgctxt "cli.service.none"
msgid "No global drives are mounted."
msgstr "Nenhuma unidade global está montada."

msgctxt "cli.service.list_item"
msgid "{target}  {label}  {state}"
msgstr "{target}  {label}  {state}"

msgctxt "cli.service.connecting"
msgid "Connecting {target}..."
msgstr "Conectando {target}..."

msgctxt "cli.service.mounted"
msgid "{target} is mounted."
msgstr "{target} está montada."

msgctxt "cli.service.unmounting"
msgid "Unmounting {name}..."
msgstr "Desmontando {name}..."

msgctxt "cli.service.state.connecting"
msgid "connecting"
msgstr "conectando"

msgctxt "cli.service.state.mounted"
msgid "mounted"
msgstr "montada"

msgctxt "cli.service.state.failed"
msgid "failed"
msgstr "falhou"

msgctxt "cli.service.state.offline"
msgid "offline"
msgstr "offline"

msgctxt "cli.service.state.unmounting"
msgid "unmounting"
msgstr "desmontando"

#. Printed by "shelldrive service install" after the service is registered (exit 0).
msgctxt "cli.service.installed"
msgid "ShellDrive service installed."
msgstr "O serviço ShellDrive foi instalado."

#. Printed by "shelldrive service uninstall" after the service and its Event Log source are removed (exit 0).
msgctxt "cli.service.uninstalled"
msgid "ShellDrive service removed."
msgstr "O serviço ShellDrive foi removido."

#. Printed by "shelldrive service start" when the service is running (exit 0).
msgctxt "cli.service.started"
msgid "ShellDrive service started."
msgstr "O serviço ShellDrive foi iniciado."

#. Printed by "shelldrive service stop" when the service has stopped (exit 0).
msgctxt "cli.service.stopped"
msgid "ShellDrive service stopped."
msgstr "O serviço ShellDrive foi parado."

#. Printed by "shelldrive service install" when the service already exists (exit 1).
msgctxt "cli.service.already_installed"
msgid "The ShellDrive service is already installed."
msgstr "O serviço ShellDrive já está instalado."

#. Printed by "shelldrive service uninstall, start or stop" when the service does not exist (exit 1).
msgctxt "cli.service.not_installed"
msgid "The ShellDrive service is not installed."
msgstr "O serviço ShellDrive não está instalado."

#. Printed by "shelldrive service start" when the service is already running (exit 1).
msgctxt "cli.service.already_running"
msgid "The ShellDrive service is already running."
msgstr "O serviço ShellDrive já está em execução."

#. Printed by "shelldrive service stop" when the service is not running (exit 1).
msgctxt "cli.service.not_running"
msgid "The ShellDrive service is not running."
msgstr "O serviço ShellDrive não está em execução."

#. Printed when the Windows Service Control Manager refuses a service verb (exit 1). {code} is the Win32 error number.
msgctxt "cli.service.scm_failed"
msgid "The Windows service manager refused the request (error {code})."
msgstr "O gerenciador de serviços do Windows recusou a solicitação (erro {code})."

#. Description of ShellDriveSvc shown in the Services console; set at install time in the language of the installing console.
msgctxt "cli.service.description"
msgid "Mounts ShellDrive drives shared by every user of this computer. Stays idle while no global drive is configured."
msgstr "Monta as unidades do ShellDrive compartilhadas por todos os usuários deste computador. Fica inativo enquanto nenhuma unidade global estiver configurada."

msgctxt "cli.service.status.not_installed"
msgid "The ShellDrive service is not installed."
msgstr "O serviço ShellDrive não está instalado."

msgctxt "cli.service.status.state_line"
msgid "Service state: {state}."
msgstr "Estado do serviço: {state}."

msgctxt "cli.service.status.start_line"
msgid "Start type: {type}."
msgstr "Tipo de inicialização: {type}."

msgctxt "cli.service.status.program_line"
msgid "Program: {path}"
msgstr "Programa: {path}"

msgctxt "cli.service.status.program_ok"
msgid "The program path is quoted and points at this install."
msgstr "O caminho do programa está entre aspas e aponta para esta instalação."

msgctxt "cli.service.status.program_unquoted"
msgid "The program path is not quoted. Remove the service and install it again."
msgstr "O caminho do programa não está entre aspas. Remova o serviço e instale-o novamente."

msgctxt "cli.service.status.program_other"
msgid "The program path points at another install. Remove the service and install it again from this one."
msgstr "O caminho do programa aponta para outra instalação. Remova o serviço e instale-o novamente a partir desta."

msgctxt "cli.service.status.program_unknown"
msgid "The program path cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "O caminho do programa não pode ser verificado: o shelldrive-host.exe não está ao lado deste programa."

msgctxt "cli.service.status.source_ok"
msgid "The Event Log source is registered for this install."
msgstr "A origem do Log de Eventos está registrada para esta instalação."

msgctxt "cli.service.status.source_missing"
msgid "The Event Log source is not registered."
msgstr "A origem do Log de Eventos não está registrada."

msgctxt "cli.service.status.source_other"
msgid "The Event Log source is registered for another program."
msgstr "A origem do Log de Eventos está registrada para outro programa."

msgctxt "cli.service.status.source_unknown"
msgid "The Event Log source cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "A origem do Log de Eventos não pode ser verificada: o shelldrive-host.exe não está ao lado deste programa."

msgctxt "cli.service.status.pipe_down"
msgid "The service is running but does not answer on its pipe."
msgstr "O serviço está em execução, mas não responde pelo seu canal."

msgctxt "cli.service.status.healthy"
msgid "The machine data folder is in order."
msgstr "A pasta de dados da máquina está em ordem."

msgctxt "cli.service.status.idle"
msgid "The machine data folder is refused, so the service stays idle. Run \"shelldrive service repair-data\" as administrator."
msgstr "A pasta de dados da máquina foi recusada, então o serviço fica inativo. Execute \"shelldrive service repair-data\" como administrador."

msgctxt "cli.service.status.prompts"
msgid "{count} administrator prompt waiting."
msgid_plural "{count} administrator prompts waiting."
msgstr[0] "{count} solicitação de administrador pendente."
msgstr[1] "{count} de solicitações de administrador pendentes."
msgstr[2] "{count} solicitações de administrador pendentes."

msgctxt "cli.service.svc_state.running"
msgid "running"
msgstr "em execução"

msgctxt "cli.service.svc_state.stopped"
msgid "stopped"
msgstr "parado"

msgctxt "cli.service.svc_state.starting"
msgid "starting"
msgstr "iniciando"

msgctxt "cli.service.svc_state.stopping"
msgid "stopping"
msgstr "parando"

msgctxt "cli.service.svc_state.paused"
msgid "paused"
msgstr "pausado"

msgctxt "cli.service.svc_state.unknown"
msgid "unknown"
msgstr "desconhecido"

msgctxt "cli.service.start_type.automatic"
msgid "automatic"
msgstr "automático"

msgctxt "cli.service.start_type.manual"
msgid "manual"
msgstr "manual"

msgctxt "cli.service.start_type.disabled"
msgid "disabled"
msgstr "desabilitado"

msgctxt "cli.service.start_type.unknown"
msgid "unknown"
msgstr "desconhecido"

msgctxt "cli.service.repair.ok"
msgid "The machine data folder is in order. Its permissions were set again."
msgstr "A pasta de dados da máquina está em ordem. Suas permissões foram aplicadas novamente."

msgctxt "cli.service.repair.moved"
msgid "An untrusted machine data folder was moved to {path}. A new one was created. Nothing from the old folder is imported, so stored secrets and keys must be entered again."
msgstr "A pasta de dados da máquina, que não é confiável, foi movida para {path}. Uma nova foi criada. Nada da pasta antiga é importado, então os segredos e as chaves guardados precisam ser informados novamente."

msgctxt "cli.service.repair.refused"
msgid "{path} is a link or a junction, so nothing was changed. Remove it yourself, then run this command again."
msgstr "{path} é um link ou uma junção, então nada foi alterado. Remova-o você mesmo e execute este comando novamente."

msgctxt "cli.service.repair.failed"
msgid "The machine data folder could not be repaired (error {code})."
msgstr "Não foi possível reparar a pasta de dados da máquina (erro {code})."

#. TM-R19 (03 7.5): asked before token-only WebDAV is used for one enable. Shown in the console.
msgctxt "cli.prompt.webdav_token_only"
msgid "Windows could not sign in to ShellDrive's local file server. Continue with a less protected connection? Other programs that learn the drive's address can then read your files."
msgstr "O Windows não conseguiu entrar no servidor local de arquivos do ShellDrive. Continuar com uma conexão menos protegida? Outros programas que descobrirem o endereço da unidade podem ler seus arquivos."

#. Question for the token-only consent; the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.webdav_token_only_question"
msgid "Continue with a less protected connection? [y]es, [N]o: "
msgstr "Continuar com uma conexão menos protegida? [s]im, [N]ão: "

#. Help for hostkey add --from-server. The value is host[:port].
msgctxt "cli.help.opt_from_server"
msgid "The server to take host keys from, as host[:port]. Its keys are checked against the stored ones first."
msgstr "O servidor de onde pegar as chaves de host, na forma host[:porta]. As chaves dele são conferidas primeiro com as já guardadas."

#. Help for hostkey add --expect. SHA256: is literal.
msgctxt "cli.help.opt_expect"
msgid "Accept the key only when its SHA-256 fingerprint is this value, for example SHA256:abc... Meant for scripts: a mismatch fails."
msgstr "Aceita a chave só se a impressão digital SHA-256 for este valor, por exemplo SHA256:abc... Feito para scripts: se não bater, falha."

#. Help for --machine on hostkey add and accept-announced.
msgctxt "cli.help.opt_machine"
msgid "Work on the machine host keys (the service's store). Needs an elevated console."
msgstr "Trabalha com as chaves de host da máquina (o armazenamento do serviço). Exige um console elevado."

#. Printed when --machine is used from a console that is not elevated (exit 9).
msgctxt "cli.hk.need_admin"
msgid "Changing the machine host keys needs an elevated console. Run it as administrator."
msgstr "Alterar as chaves de host da máquina exige um console elevado. Execute o programa como administrador."

#. Printed by hostkey add and accept-announced --machine until the service connect path exists (exit 1).
msgctxt "cli.hk.not_built"
msgid "Adding host keys from a server is not part of this build yet."
msgstr "Adicionar chaves de host de um servidor ainda não faz parte desta versão."

#. Printed by hostkey add when the server offers no host key that is not stored yet. {host} is the host as typed.
msgctxt "cli.hk.add_none"
msgid "{host} has no other host keys to add."
msgstr "{host} não tem outras chaves de host para adicionar."

#. Printed by hostkey add before the question about the keys the server offers besides the stored ones.
#, plural-arg=count
msgctxt "cli.hk.add_offer"
msgid "{host} also has {count} other host key. Add it?"
msgid_plural "{host} also has {count} other host keys. Add them?"
msgstr[0] "{host} também tem {count} outra chave de host. Quer adicioná-la?"
msgstr[1] "{host} também tem {count} de outras chaves de host. Quer adicioná-las?"
msgstr[2] "{host} também tem {count} outras chaves de host. Quer adicioná-las?"

#. Question for the key of a first contact (no stored key; 5.2). The letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.hk.add_first_question"
msgid "Add this key? [y]es, [N]o: "
msgstr "Adicionar esta chave? [s]im, [N]ão: "

#. Choices after cli.hk.add_offer. The letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.hk.add_choices"
msgid "[y]es, [N]o: "
msgstr "[s]im, [N]ão: "
