    <String Id="VerifyReadyDlgBannerBitmap" Overridable="yes">WixUI_Bmp_Banner</String>
    <String Id="VerifyReadyDlgChange" Overridable="yes">&amp;Cambia</String>
    <String Id="VerifyReadyDlgChangeText" Overridable="yes">Fai clic su Cambia per avviare l'installazione. Fai clic su Indietro per rivedere o modificare le impostazioni di installazione. Fai clic su Annulla per uscire dalla procedura guidata.</String>
    <String Id="VerifyReadyDlgChangeTitle" Overridable="yes">{\WixUI_Font_Title}Inizio modifica di [ProductName]</String>
    <String Id="VerifyReadyDlgInstall" Overridable="yes">&amp;Installa</String>
    <String Id="VerifyReadyDlgInstallText" Overridable="yes">Fai clic su Installa per avviare l'installazione. Fai clic su Indietro per rivedere o modificare le impostazioni di installazione. Fai clic su Annulla per uscire dalla procedura guidata.</String>
    <String Id="VerifyReadyDlgInstallTitle" Overridable="yes">{\WixUI_Font_Title}Inizio installazione di [ProductName]</String>
    <String Id="VerifyReadyDlgRemove" Overridable="yes">&amp;Rimuovi</String>
    <String Id="VerifyReadyDlgRemoveText" Overridable="yes">Fai clic su Rimuovi per rimuovere [ProductName] dal computer. Fai clic su Indietro per rivedere o modificare le impostazioni di installazione. Fai clic su Annulla per uscire dalla procedura guidata.</String>
    <String Id="VerifyReadyDlgRemoveTitle" Overridable="yes">{\WixUI_Font_Title}Inizio rimozione di [ProductName]</String>
    <String Id="VerifyReadyDlgRepair" Overridable="yes">Ri&amp;para</String>
    <String Id="VerifyReadyDlgRepairText" Overridable="yes">Fai clic su Ripara per riparare l'installazione di [ProductName]. Fai clic su Indietro per rivedere o modificare le impostazioni di installazione. Fai clic su Annulla per uscire dalla procedura guidata.</String>
    <String Id="VerifyReadyDlgRepairTitle" Overridable="yes">{\WixUI_Font_Title}Inizio riparazione di [ProductName]</String>
    <String Id="VerifyReadyDlgUpdate" Overridable="yes">A&amp;ggiorna</String>
    <String Id="VerifyReadyDlgUpdateText" Overridable="yes">Fai clic su Aggiorna per eseguire l'aggiornamento di [ProductName] dal computer in uso. Fai clic su Indietro per rivedere o modificare le impostazioni di installazione. Fai clic su Annulla per uscire dalla procedura guidata.</String>
    <String Id="VerifyReadyDlgUpdateTitle" Overridable="yes">{\WixUI_Font_Title}Inizio aggiornamento di [ProductName]</String>
