msgid "The agent is not running. Records already shown are kept."
msgstr "O agente não está em execução. Os registros já exibidos foram mantidos."

#. Logs viewer: the running agent has no log.tail method.
msgctxt "ui.logs.old_agent"
msgid "The running agent is too old to show its log."
msgstr "O agente em execução é antigo demais para mostrar o registro."

#. Logs viewer: reading the log failed. {code} is the error name.
msgctxt "ui.logs.read_failed"
msgid "The log could not be read ({code})."
msgstr "Não foi possível ler o registro ({code})."

#. Logs viewer: the agent sent a malformed log.tail reply.
msgctxt "ui.logs.bad_reply"
msgid "The agent sent a log that could not be read."
msgstr "O agente enviou um registro que não pôde ser lido."

#. Logs viewer: the log folder could not be opened.
msgctxt "ui.logs.open_failed"
msgid "The log folder could not be opened."
msgstr "Não foi possível abrir a pasta de registros."

#. Logs viewer: first poll in progress.
msgctxt "ui.logs.loading"
msgid "Loading the log…"
msgstr "Carregando o registro…"

#. Settings window title.
msgctxt "ui.settings.title"
msgid "Settings"
msgstr "Configurações"

#. Settings: label of the language list.
msgctxt "ui.settings.language"
msgid "Language"
msgstr "Idioma"

#. Settings: the first language entry, the Windows language.
msgctxt "ui.settings.lang_system"
msgid "System default"
msgstr "Padrão do sistema"

#. Settings: checkbox for balloon notifications.
msgctxt "ui.settings.notify"
msgid "Show notifications"
msgstr "Mostrar notificações"

#. Settings: checkbox that starts the tray icon at sign-in (Run key, this user only).
msgctxt "ui.settings.logon"
msgid "Start the tray icon at sign-in"
msgstr "Iniciar o ícone da bandeja ao entrar"

#. Settings: label of the default backend list.
msgctxt "ui.settings.backend"
msgid "Default backend"
msgstr "Backend padrão"

#. Settings: default backend choice, chosen by Windows.
msgctxt "ui.settings.backend_auto"
msgid "Automatic"
msgstr "Automático"

#. Settings: default backend choice, the Dokany product name.
msgctxt "ui.settings.backend_dokany"
msgid "Dokany"
msgstr "Dokany"

#. Settings: default backend choice, the WebDAV protocol name.
msgctxt "ui.settings.backend_webdav"
msgid "WebDAV"
msgstr "WebDAV"

#. Settings: label of the memory cache budget field.
msgctxt "ui.settings.cache"
msgid "Memory cache (MB)"
msgstr "Cache de memória (MB)"

#. Settings: explains the values of the memory cache budget field.
msgctxt "ui.settings.cache_hint"
msgid "0 uses the default. Otherwise 16 to 65536."
msgstr "0 usa o padrão. Caso contrário, de 16 a 65536."

#. Settings: heading of the update group.
msgctxt "ui.settings.group_updates"
msgid "Updates"
msgstr "Atualizações"

#. Settings: checkbox for automatic update checks (disabled until the agent offers it).
msgctxt "ui.settings.check_updates"
msgid "Check for updates automatically"
msgstr "Verificar atualizações automaticamente"

#. Settings: shown when the agent cannot check for updates.
msgctxt "ui.settings.updates_unavailable"
msgid "Updates are not available in this version of the agent."
msgstr "As atualizações não estão disponíveis nesta versão do agente."

#. Settings: which changes take effect without a restart.
msgctxt "ui.settings.live_note"
msgid "Notifications, the backend and the cache apply to new mounts and connections after the agent reloads the file."
msgstr "As notificações, o backend e o cache valem para novas montagens e conexões depois que o agente recarrega o arquivo."

#. Settings: shown after a language change, which is read at start-up.
msgctxt "ui.settings.restart_note"
msgid "The language changes when you restart ShellDrive."
msgstr "O idioma muda quando você reiniciar o ShellDrive."

#. Settings button: saves the file and applies it.
msgctxt "ui.settings.btn_save"
msgid "Save"
msgstr "Salvar"

#. Settings button: closes without saving.
msgctxt "ui.settings.btn_cancel"
msgid "Cancel"
msgstr "Cancelar"

#. Settings: the memory cache field holds a value outside 0 and 16 to 65536.
msgctxt "ui.settings.cache_invalid"
msgid "Enter 0, or a size from 16 to 65536 MB."
msgstr "Digite 0 ou um tamanho de 16 a 65536 MB."

#. Settings: saving settings.ini failed. {code} is the error name.
msgctxt "ui.settings.save_failed"
msgid "The settings could not be saved ({code})."
msgstr "Não foi possível salvar as configurações ({code})."

#. Settings: the Run key for start at sign-in could not be written.
msgctxt "ui.settings.run_failed"
msgid "Start at sign-in could not be changed."
msgstr "Não foi possível alterar a inicialização com o login."

#. About window title.
msgctxt "ui.about.title"
msgid "About ShellDrive"
msgstr "Sobre o ShellDrive"

#. About window: the version line. {version} is the product version.
msgctxt "ui.about.version"
msgid "Version {version}"
msgstr "Versão {version}"

#. About window: the license line.
msgctxt "ui.about.license"
msgid "Licensed under the MIT License."
msgstr "Licença MIT."

#. About window: the copyright line.
msgctxt "ui.about.copyright"
msgid "Copyright (C) LibreStatic"
msgstr "Direitos autorais (C) LibreStatic"

#. About window button: opens the project web page in the browser.
msgctxt "ui.about.btn_project"
msgid "Project page"
msgstr "Página do projeto"

#. About window button: closes the window.
msgctxt "ui.about.btn_close"
msgid "Close"
msgstr "Fechar"

#. About window: the browser could not be started.
msgctxt "ui.about.open_failed"
msgid "The project page could not be opened in the browser."
msgstr "Não foi possível abrir a página do projeto no navegador."

#. Menu item: opens the host key manager.
msgctxt "ui.menu.hostkeys"
msgid "Host keys…"
msgstr "Chaves de host…"

#. Menu item: opens the Logs viewer.
msgctxt "ui.menu.logs"
msgid "Logs…"
msgstr "Registros…"

#. Menu item: opens Settings.
msgctxt "ui.menu.settings"
msgid "Settings…"
msgstr "Configurações…"

#. Menu item: opens the About window.
msgctxt "ui.menu.about"
msgid "About ShellDrive"
msgstr "Sobre o ShellDrive"

#. Menu bar: the Tools menu.
msgctxt "ui.menu.tools"
msgid "Tools"
msgstr "Ferramentas"

#. Menu bar: the Help menu.
msgctxt "ui.menu.help"
msgid "Help"
msgstr "Ajuda"


#. First-run wizard: the title of the sheet.
msgctxt "ui.wizard.caption"
msgid "Set up ShellDrive"
msgstr "Configurar o ShellDrive"

#. First-run wizard, welcome page: title.
msgctxt "ui.wizard.welcome_title"
msgid "Welcome to ShellDrive"
msgstr "Bem-vindo ao ShellDrive"

#. First-run wizard, welcome page: what a profile is.
msgctxt "ui.wizard.welcome_text"
msgid "ShellDrive shows folders on SFTP servers as Windows drives. Each connection is a profile: a server, a user name and a folder on that server."
msgstr "O ShellDrive mostra pastas de servidores SFTP como unidades do Windows. Cada conexão é um perfil: um servidor, um nome de usuário e uma pasta nesse servidor."

#. First-run wizard, welcome page: what to do next.
msgctxt "ui.wizard.welcome_next"
msgid "Choose Next to set up your first connection. You can close this wizard at any time."
msgstr "Clique em Avançar para configurar sua primeira conexão. Você pode fechar este assistente a qualquer momento."

#. First-run wizard, backend page: title.
msgctxt "ui.wizard.backend_title"
msgid "How drives are shown"
msgstr "Como as unidades são exibidas"

#. First-run wizard, backend page: explains Dokany (a driver) and WebDAV (the Windows network redirector). Product names stay.
msgctxt "ui.wizard.backend_text"
msgid "ShellDrive uses one of two ways to show a drive in Windows. Dokany is a driver that is fast and is used when it is installed. WebDAV uses the Windows network redirector and needs no driver."
msgstr "O ShellDrive usa uma de duas formas para mostrar uma unidade no Windows. O Dokany é um driver rápido, usado quando está instalado. O WebDAV usa o redirecionador de rede do Windows e não precisa de driver."

#. First-run wizard, backend page: Dokany is installed on this computer.
msgctxt "ui.wizard.backend_dokany_yes"
msgid "Dokany is installed on this computer. Automatic will use it."
msgstr "O Dokany está instalado neste computador. O modo automático vai usá-lo."

#. First-run wizard, backend page: Dokany is missing, so the automatic choice is WebDAV.
msgctxt "ui.wizard.backend_dokany_no"
msgid "Dokany is not installed on this computer. Automatic will use WebDAV."
msgstr "O Dokany não está instalado neste computador. O modo automático vai usar o WebDAV."

#. First-run wizard, import page: title.
msgctxt "ui.wizard.import_title"
msgid "Import existing connections"
msgstr "Importar conexões existentes"

#. First-run wizard, import page: what the importers read.
msgctxt "ui.wizard.import_text"
msgid "ShellDrive can read the sessions of PuTTY and the hosts of your OpenSSH configuration file and offer them as profiles."
msgstr "O ShellDrive pode ler as sessões do PuTTY e os hosts do arquivo de configuração do OpenSSH e oferecê-los como perfis."

#. First-run wizard, import page: host keys are trusted from PuTTY and OpenSSH live.
msgctxt "ui.wizard.import_trust"
msgid "ShellDrive also trusts the host keys you already accepted in PuTTY and OpenSSH. You can turn this off in Settings."
msgstr "O ShellDrive também confia nas chaves de host que você já aceitou no PuTTY e no OpenSSH. Você pode desativar isso nas Configurações."

#. First-run wizard, import page: opens the import dialog. Mnemonic I.
msgctxt "ui.wizard.import_button"
msgid "&Import…"
msgstr "&Importar…"

#. First-run wizard, create page: title.
msgctxt "ui.wizard.create_title"
msgid "Create your first profile"
msgstr "Criar seu primeiro perfil"

#. First-run wizard, create page: what a profile holds.
msgctxt "ui.wizard.create_text"
msgid "A profile holds the server, your user name and the folder to show. You can create more profiles later."
msgstr "Um perfil guarda o servidor, o nome de usuário e a pasta que será exibida. Você pode criar outros perfis depois."

#. First-run wizard, create page: opens the profile editor. Mnemonic C.
msgctxt "ui.wizard.create_button"
msgid "&Create a profile…"
msgstr "&Criar um perfil…"

#. First-run wizard, create page: shown after a profile was saved. {name} is the profile name.
msgctxt "ui.wizard.create_saved"
msgid "Saved: {name}. Choose Next to continue."
msgstr "Salvo: {name}. Clique em Avançar para continuar."

#. First-run wizard, finish page: title.
msgctxt "ui.wizard.finish_title"
msgid "Setup complete"
msgstr "Configuração concluída"

#. First-run wizard, finish page: the tray icon keeps running.
msgctxt "ui.wizard.finish_text"
msgid "When you close the main window, ShellDrive keeps running in the notification area."
msgstr "Quando você fecha a janela principal, o ShellDrive continua na área de notificação."

#. First-run wizard, finish page: full-disk encryption advice (TM-R31).
msgctxt "ui.wizard.fde_note"
msgid "Saved passwords and keys are only as safe as your Windows password. Turn on BitLocker or device encryption if you keep keys in ShellDrive or use the disk cache."
msgstr "Senhas e chaves salvas são tão seguras quanto a sua senha do Windows. Ative o BitLocker ou a criptografia do dispositivo se guardar chaves no ShellDrive ou usar o cache em disco."

#. First-run wizard, finish page: mounts the profile created on the create page. Mnemonic M.
msgctxt "ui.wizard.mount_now"
msgid "&Mount the new profile now"
msgstr "&Montar o novo perfil agora"

#. Balloon title for notifications that are not warnings.
#. sdl10n:maxlen=64
msgctxt "ui.notify.title"
msgid "ShellDrive"
msgstr "ShellDrive"

#. Balloon text: the server offered new host keys (03 5.6). {host} is the host name.
#. sdl10n:maxlen=256
msgctxt "ui.notify.hostkeys"
msgid "{host} offered new host keys. Review"
msgstr "{host} ofereceu novas chaves de host. Revise-as"

#. Settings: label of the update channel list (stable or beta).
msgctxt "ui.settings.update_channel"
msgid "Channel"
msgstr "Canal"

#. Settings: the stable update channel.
msgctxt "ui.settings.channel_stable"
msgid "Stable"
msgstr "Estável"

#. Settings: the beta update channel. Beta is a product term and is not translated.
msgctxt "ui.settings.channel_beta"
msgid "Beta"
msgstr "Beta"

#. Settings: button that asks the agent for the latest manifest now.
msgctxt "ui.settings.update_check_now"
msgid "Check now"
msgstr "Verificar agora"

#. Settings: button that installs an offered update after consent.
msgctxt "ui.settings.update_install"
msgid "Install update"
msgstr "Instalar atualização"

#. Settings: button that opens the release notes of the offered version in the browser.
msgctxt "ui.settings.update_notes"
msgid "Release notes"
msgstr "Notas da versão"

#. Settings: shown next to a control that a group policy sets.
msgctxt "ui.settings.update_managed"
msgid "Managed by your organization."
msgstr "Gerenciado pela sua organização."

#. Settings: update checks are disabled by a group policy.
msgctxt "ui.settings.update_off_policy"
msgid "Update checks are turned off by your organization."
msgstr "Sua organização desativou a verificação de atualizações."

#. Settings: update checks are disabled in settings.ini.
msgctxt "ui.settings.update_off_settings"
msgid "Update checks are turned off in settings."
msgstr "A verificação de atualizações está desativada nas configurações."

#. Update status: no check has run in this session yet.
msgctxt "ui.update.status_idle"
msgid "No update check has run in this session."
msgstr "Nenhuma verificação de atualização foi feita nesta sessão."

#. Update status: a check is running.
msgctxt "ui.update.status_checking"
msgid "Checking for updates..."
msgstr "Verificando atualizações..."

#. Update status: the installed version is the newest one. {channel} is stable or beta.
msgctxt "ui.update.status_current"
msgid "ShellDrive is up to date ({channel} channel)."
msgstr "O ShellDrive está atualizado (canal {channel})."

#. Update status: a newer version is offered. {size} is in kilobytes.
msgctxt "ui.update.status_available"
msgid "Version {version} is available ({size} KB)."
msgstr "A versão {version} está disponível ({size} KB)."

#. Update status: the last successful check is old. {days} is at least 14.
msgctxt "ui.update.status_stale"
msgid "The last successful update check was {days} days ago."
msgstr "A última verificação de atualização bem-sucedida foi há {days} dias."

#. Update status: the check or the install failed. {code} is the error name.
msgctxt "ui.update.status_failed"
msgid "The update check failed ({code})."
msgstr "A verificação de atualização falhou ({code})."

#. Update status: an update is being installed. {version} is the new version.
msgctxt "ui.update.status_installing"
msgid "Installing version {version}. ShellDrive restarts when it is done."
msgstr "Instalando a versão {version}. O ShellDrive reinicia ao terminar."

#. Update progress: the new version is downloaded.
msgctxt "ui.update.stage_downloading"
msgid "Downloading the update..."
msgstr "Baixando a atualização..."

#. Update progress: the downloaded version is installed.
msgctxt "ui.update.stage_applying"
msgid "Installing the update..."
msgstr "Instalando a atualização..."

#. Update progress: the update is installed.
msgctxt "ui.update.stage_done"
msgid "The update is installed."
msgstr "A atualização foi instalada."

#. Update progress: the install failed. {code} is the error name.
msgctxt "ui.update.stage_failed"
msgid "The update could not be installed ({code})."
msgstr "Não foi possível instalar a atualização ({code})."

#. Title of the consent dialog before an update is installed.
msgctxt "ui.update.consent_title"
msgid "Install the update"
msgstr "Instalar a atualização"

#. Consent dialog: what happens. {version} is the offered version.
msgctxt "ui.update.consent_text"
msgid "ShellDrive {name} will be downloaded, its signature and checksum will be checked, and it will be installed. ShellDrive restarts when the installation ends."
msgstr "O ShellDrive {name} será baixado, a assinatura e a soma de verificação serão conferidas e ele será instalado. O ShellDrive reinicia quando a instalação terminar."

#. Consent dialog: the button that starts the install.
msgctxt "ui.update.consent_yes"
msgid "Install and restart"
msgstr "Instalar e reiniciar"

#. Consent dialog: the button that leaves the update for later.
msgctxt "ui.update.consent_no"
msgid "Not now"
msgstr "Agora não"

#. Balloon when a newer version is offered. {version} is the offered version.
msgctxt "ui.notify.update"
msgid "ShellDrive {version} is available. Open Settings to install it."
msgstr "O ShellDrive {version} está disponível. Abra as configurações para instalá-lo."

#. Tray tooltip and tray menu header: a global drive waits for an administrator (03 §2.6 rule 3).
#. sdl10n:maxlen=128
msgctxt "ui.tray.admin_tip"
msgid "A global ShellDrive drive needs attention"
msgstr "Uma unidade global do ShellDrive precisa de atenção"

#. Tray menu item: opens the administrator window. {count} is the number of prompts waiting.
#, plural-arg=count
msgctxt "ui.tray.admin_prompts"
msgid "{count} prompt waiting for an administrator"
msgid_plural "{count} prompts waiting for an administrator"
msgstr[0] "{count} solicitação aguardando um administrador"
msgstr[1] "{count} solicitações aguardando um administrador"
msgstr[2] "{count} solicitações aguardando um administrador"

#. Shown when the administrator window cannot be started (not when the UAC prompt is declined).
msgctxt "ui.admin.launch_failed"
msgid "ShellDrive could not open its administrator window. Try again from the tray menu."
msgstr "O ShellDrive não conseguiu abrir a janela de administração. Tente de novo pelo menu da bandeja."

#. Prompt dialog text for token-only WebDAV (03 7.5, TM-R19). Shown when Windows cannot sign in, every time it is enabled.
msgctxt "ui.webdav.token_only_ask"
msgid "Windows could not sign in to ShellDrive's local file server. Continue with a less protected connection? Other programs that learn the drive's address can then read your files."
msgstr "O Windows não conseguiu entrar no servidor local de arquivos do ShellDrive. Continuar com uma conexão menos protegida? Outros programas que descobrirem o endereço da unidade podem ler seus arquivos."

#. Prompt dialog title for the token-only WebDAV question (03 7.5).
msgctxt "ui.prompt.title_token_only"
msgid "Less protected connection"
msgstr "Conexão menos protegida"

#. Prompt dialog button: continue with the token-only connection for this enable (answers accept).
msgctxt "ui.prompt.btn.token_continue"
msgid "Contin&ue"
msgstr "Con&tinuar"

#. Settings: tab label of the host key and password settings.
msgctxt "ui.settings.tab_security"
msgid "Security"
msgstr "Segurança"

#. Settings: checkbox, read the host keys PuTTY has accepted (5.1).
msgctxt "ui.settings.trust_putty"
msgid "Trust host keys accepted in PuTTY"
msgstr "Confiar nas chaves de host aceitas no PuTTY"

#. Settings: checkbox, read the host keys OpenSSH has accepted (5.1).
msgctxt "ui.settings.trust_openssh"
msgid "Trust host keys accepted in OpenSSH"
msgstr "Confiar nas chaves de host aceitas no OpenSSH"

#. Settings: a host key source file is ignored because other users can change it (TM-R06).
msgctxt "ui.settings.src_insecure"
msgid "Ignored: other users can change this file."
msgstr "Ignorado: outros usuários podem alterar este arquivo."

#. Settings: checkbox, store saved passwords so they roam with the Windows profile (3.4).
msgctxt "ui.settings.roam"
msgid "Roam saved passwords with my profile"
msgstr "Itinerar as senhas salvas com o meu perfil"

#. Settings: warning under the roaming checkbox.
msgctxt "ui.settings.roam_hint"
msgid "Saved SSH passwords then exist on every computer your roaming profile is used on."
msgstr "As senhas SSH salvas passam a existir em todos os computadores em que o seu perfil móvel for usado."

#. Settings: tab label of the general settings.
msgctxt "ui.settings.tab_general"
msgid "General"
msgstr "Geral"

#. Settings: label of the WebClient service state (read-only).
msgctxt "ui.settings.webclient"
msgid "WebClient service:"
msgstr "Serviço WebClient:"

#. Settings: the WebClient service is running.
msgctxt "ui.settings.webclient_running"
msgid "Running"
msgstr "Em execução"

#. Settings: the WebClient service is stopped; ShellDrive starts it when a WebDAV drive needs it.
msgctxt "ui.settings.webclient_stopped"
msgid "Stopped (ShellDrive starts it when a drive needs it)"
msgstr "Parado (o ShellDrive o inicia quando uma unidade precisa dele)"

#. Settings: the WebClient service is disabled and only an administrator can enable it.
msgctxt "ui.settings.webclient_disabled"
msgid "Disabled (an administrator must enable it to use the WebDAV backend)"
msgstr "Desabilitado (um administrador precisa habilitá-lo para usar o mecanismo WebDAV)"

#. Settings: the WebClient service is not installed.
msgctxt "ui.settings.webclient_missing"
msgid "Not installed (the WebDAV backend is not available)"
msgstr "Não instalado (o mecanismo WebDAV não está disponível)"

#. Settings: the WebClient service state could not be read.
msgctxt "ui.settings.webclient_unknown"
msgid "Unknown"
msgstr "Desconhecido"

#. Menu item: opens the Service page (status of the ShellDrive service and the machine data folder repair).
msgctxt "ui.menu.service"
msgid "Service…"
msgstr "Serviço…"

#. Service page window title.
msgctxt "ui.service.title"
msgid "ShellDrive service"
msgstr "Serviço do ShellDrive"

#. Service page: the service is not installed.
msgctxt "ui.service.not_installed"
msgid "The ShellDrive service is not installed."
msgstr "O serviço ShellDrive não está instalado."

#. Service page. {state} is one of the state words below.
msgctxt "ui.service.state_line"
msgid "Service state: {state}."
msgstr "Estado do serviço: {state}."

#. Service page: service state word, shown after "Service state:".
msgctxt "ui.service.state.running"
msgid "running"
msgstr "em execução"

msgctxt "ui.service.state.stopped"
msgid "stopped"
msgstr "parado"

msgctxt "ui.service.state.starting"
msgid "starting"
msgstr "iniciando"

msgctxt "ui.service.state.stopping"
msgid "stopping"
msgstr "parando"

msgctxt "ui.service.state.paused"
msgid "paused"
msgstr "pausado"

msgctxt "ui.service.state.unknown"
msgid "unknown"
msgstr "desconhecido"

#. Service page. {type} is one of the start type words below.
msgctxt "ui.service.start_line"
msgid "Start type: {type}."
msgstr "Tipo de inicialização: {type}."

#. Service page: start type word, shown after "Start type:".
msgctxt "ui.service.start_type.automatic"
msgid "automatic"
msgstr "automático"

msgctxt "ui.service.start_type.manual"
msgid "manual"
msgstr "manual"

msgctxt "ui.service.start_type.disabled"
msgid "disabled"
msgstr "desabilitado"

msgctxt "ui.service.start_type.unknown"
msgid "unknown"
msgstr "desconhecido"

#. Service page. {path} is the program path registered with the Service Control Manager.
msgctxt "ui.service.program_line"
msgid "Program: {path}"
msgstr "Programa: {path}"

#. Service page: check of the registered program path (quoted, this install).
msgctxt "ui.service.program.ok"
msgid "The program path is quoted and points at this install."
msgstr "O caminho do programa está entre aspas e aponta para esta instalação."

#. Service page: the program path is not quoted.
msgctxt "ui.service.program.unquoted"
msgid "The program path is not quoted. Remove the service and install it again."
msgstr "O caminho do programa não está entre aspas. Remova o serviço e instale-o novamente."

#. Service page: the program path is quoted but names another program or install.
msgctxt "ui.service.program.other"
msgid "The program path points at another install. Remove the service and install it again from this one."
msgstr "O caminho do programa aponta para outra instalação. Remova o serviço e instale-o novamente a partir desta."

#. Service page: the program path cannot be checked.
msgctxt "ui.service.program.unknown"
msgid "The program path cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "O caminho do programa não pode ser verificado: o shelldrive-host.exe não está ao lado deste programa."

#. Service page: Event Log source check, registered for this install.
msgctxt "ui.service.source.ok"
msgid "The Event Log source is registered for this install."
msgstr "A origem do Log de Eventos está registrada para esta instalação."

#. Service page: no Event Log source is registered.
msgctxt "ui.service.source.missing"
msgid "The Event Log source is not registered."
msgstr "A origem do Log de Eventos não está registrada."

#. Service page: the Event Log source names another program.
msgctxt "ui.service.source.other"
msgid "The Event Log source is registered for another program."
msgstr "A origem do Log de Eventos está registrada para outro programa."

#. Service page: the Event Log source cannot be checked.
msgctxt "ui.service.source.unknown"
msgid "The Event Log source cannot be checked: shelldrive-host.exe is not next to this program."
msgstr "A origem do Log de Eventos não pode ser verificada: o shelldrive-host.exe não está ao lado deste programa."

#. Service page: the service runs but does not answer on its pipe.
msgctxt "ui.service.pipe_down"
msgid "The service is running but does not answer on its pipe."
msgstr "O serviço está em execução, mas não responde pelo seu canal."

#. Service page: the service answers but is too old to report its machine data folder.
msgctxt "ui.service.old_service"
msgid "The running service is an older version and does not report its machine data folder."
msgstr "O serviço em execução é uma versão mais antiga e não informa o estado da sua pasta de dados da máquina."

#. Service page: the machine data folder is trusted.
msgctxt "ui.service.machine_ok"
msgid "The machine data folder is in order."
msgstr "A pasta de dados da máquina está em ordem."

#. Service page: the machine data folder is refused because of its owner (the service stays idle).
msgctxt "ui.service.machine_owner"
msgid "The machine data folder belongs to an account that is not trusted, so the service stays idle."
msgstr "A pasta de dados da máquina pertence a uma conta que não é confiável, então o serviço fica inativo."

#. Service page: the machine data folder is refused because of a link or junction.
msgctxt "ui.service.machine_link"
msgid "The machine data folder is or holds a link or junction, so the service stays idle."
msgstr "A pasta de dados da máquina é ou contém um link ou uma junção, então o serviço fica inativo."

#. Service page: the machine data folder is refused because other accounts can change it.
msgctxt "ui.service.machine_acl"
msgid "Other accounts can change the machine data folder, so the service stays idle."
msgstr "Outras contas podem alterar a pasta de dados da máquina, então o serviço fica inativo."

#. Service page: the machine data folder is refused for another reason.
msgctxt "ui.service.machine_other"
msgid "The machine data folder is refused, so the service stays idle."
msgstr "A pasta de dados da máquina foi recusada, então o serviço fica inativo."

#. Service page, administrators only. {path} is the folder the service refused.
msgctxt "ui.service.machine_path"
msgid "Refused folder: {path}"
msgstr "Pasta recusada: {path}"

#. Service page: global drives of the service. {count} is the number of mounts.
#, plural-arg=count
msgctxt "ui.service.drives"
msgid "{count} global drive mounted."
msgid_plural "{count} global drives mounted."
msgstr[0] "{count} unidade global montada."
msgstr[1] "{count} unidades globais montadas."
msgstr[2] "{count} unidades globais montadas."

#. Service page: open administrator prompts of the service. {count} is their number.
#, plural-arg=count
msgctxt "ui.service.prompts"
msgid "{count} administrator prompt waiting."
msgid_plural "{count} administrator prompts waiting."
msgstr[0] "{count} solicitação de administrador pendente."
msgstr[1] "{count} de solicitações de administrador pendentes."
msgstr[2] "{count} solicitações de administrador pendentes."

#. Service page: machine profiles the service loaded. {count} is their number.
#, plural-arg=count
msgctxt "ui.service.profiles"
msgid "{count} machine profile loaded."
msgid_plural "{count} machine profiles loaded."
msgstr[0] "{count} perfil da máquina carregado."
msgstr[1] "{count} perfis da máquina carregados."
msgstr[2] "{count} perfis da máquina carregados."

#. Service page: shown while the first status is being read.
msgctxt "ui.service.loading"
msgid "Reading the service status…"
msgstr "Lendo o estado do serviço…"

#. Service page: the Service Control Manager query failed. {code} is the Windows error number.
msgctxt "ui.service.read_failed"
msgid "The service status could not be read (error {code})."
msgstr "Não foi possível ler o estado do serviço (erro {code})."

#. Service page button: reads the status again.
msgctxt "ui.service.btn_refresh"
msgid "Refresh"
msgstr "Atualizar"

#. Service page button: repairs the machine data folder (carries the UAC shield for an administrator that is not elevated).
msgctxt "ui.service.btn_repair"
msgid "Repair data…"
msgstr "Reparar dados…"

#. Service page button: closes the page.
msgctxt "ui.service.btn_close"
msgid "Close"
msgstr "Fechar"

#. Service page note under the status: the repair button is off because the user is not an administrator.
msgctxt "ui.service.note_admin_only"
msgid "Repairing the machine data folder is for administrators."
msgstr "Reparar a pasta de dados da máquina é só para administradores."

#. Service page note under the status: the repair button asks for administrator rights.
msgctxt "ui.service.note_elevate"
msgid "Repair data asks for administrator rights."
msgstr "Reparar dados pede direitos de administrador."

#. Service page note under the status: a repair is running.
msgctxt "ui.service.note_repairing"
msgid "Repairing the machine data folder…"
msgstr "Reparando a pasta de dados da máquina…"

#. Repair confirmation dialog title.
msgctxt "ui.service.repair_title"
msgid "Repair the machine data folder"
msgstr "Reparar a pasta de dados da máquina"

#. Repair confirmation dialog: what the repair does.
msgctxt "ui.service.repair_text"
msgid "ShellDrive checks the machine data folder and sets its permissions again. A folder that belongs to an account that is not trusted, or that holds a link, is moved aside and replaced by an empty one. Nothing from the moved folder is imported, so stored service passwords and keys must be entered again."
msgstr "O ShellDrive confere a pasta de dados da máquina e aplica suas permissões novamente. Uma pasta que pertence a uma conta que não é confiável, ou que contém um link, é movida para o lado e substituída por uma vazia. Nada da pasta movida é importado, então as senhas e chaves do serviço guardadas precisam ser informadas novamente."

#. Repair confirmation dialog: the button that starts the repair.
msgctxt "ui.service.repair_yes"
msgid "Repair data"
msgstr "Reparar dados"

#. Repair confirmation dialog: the button that leaves the folder alone. It is the default button.
msgctxt "ui.service.repair_no"
msgid "Cancel"
msgstr "Cancelar"

#. Dialog title: the repair needs administrator rights.
msgctxt "ui.service.elevate_title"
msgid "Administrator rights needed"
msgstr "Direitos de administrador necessários"

#. Dialog text: the repair needs administrator rights; the Service page can be opened again elevated (UAC).
msgctxt "ui.service.elevate_text"
msgid "Repairing the machine data folder needs administrator rights. ShellDrive can open this page again as an administrator."
msgstr "Reparar a pasta de dados da máquina exige direitos de administrador. O ShellDrive pode abrir esta página de novo como administrador."

#. Dialog button: reopens the Service page as an administrator.
msgctxt "ui.service.elevate_yes"
msgid "Open as administrator"
msgstr "Abrir como administrador"

#. Dialog button: does nothing.
msgctxt "ui.service.elevate_no"
msgid "Cancel"
msgstr "Cancelar"

#. Repair result: the folder was in order and its permissions were set again.
msgctxt "ui.service.repair_done"
msgid "The machine data folder is in order. Its permissions were set again."
msgstr "A pasta de dados da máquina está em ordem. Suas permissões foram aplicadas novamente."

#. Repair result: an untrusted folder was moved aside and replaced.
msgctxt "ui.service.repair_moved"
msgid "An untrusted machine data folder was moved aside and a new one was created. Nothing from the old folder is imported, so stored service passwords and keys must be entered again."
msgstr "Uma pasta de dados da máquina que não era confiável foi movida para o lado e uma nova foi criada. Nada da pasta antiga é importado, então as senhas e chaves do serviço guardadas precisam ser informadas novamente."

#. Repair result: the repair worked but the service still refuses the folder.
msgctxt "ui.service.repair_still_refused"
msgid "The machine data folder was repaired, but the service still refuses it. The status shows the reason."
msgstr "A pasta de dados da máquina foi reparada, mas o serviço ainda a recusa. O estado mostra o motivo."

#. Repair result: refused because global drives are mounted.
msgctxt "ui.service.repair_busy"
msgid "Unmount the global drives first, then try again."
msgstr "Desmonte primeiro as unidades globais e tente de novo."

#. Repair result: refused because the caller is not an elevated administrator.
msgctxt "ui.service.repair_denied"
msgid "Only an administrator with elevated rights can repair the machine data folder."
msgstr "Somente um administrador com direitos elevados pode reparar a pasta de dados da máquina."

#. Repair result: a link or junction blocked the repair; nothing was changed.
msgctxt "ui.service.repair_link"
msgid "A link or junction is in the machine data folder, so nothing was changed. Remove it yourself, then try again."
msgstr "Há um link ou uma junção na pasta de dados da máquina, então nada foi alterado. Remova-o você mesmo e tente de novo."

#. Repair result: the running service does not know the repair method.
msgctxt "ui.service.repair_unsupported"
msgid "The running service is an older version and cannot do this repair. Update ShellDrive, then try again."
msgstr "O serviço em execução é uma versão mais antiga e não consegue fazer este reparo. Atualize o ShellDrive e tente de novo."

#. Repair result: the repair failed. {code} is the error.
msgctxt "ui.service.repair_failed"
msgid "The machine data folder could not be repaired (error {code})."
msgstr "Não foi possível reparar a pasta de dados da máquina (erro {code})."

#. Menu bar: the Connection menu of the main window.
msgctxt "ui.menu.connection"
msgid "Connection"
msgstr "Conexão"

#. Connection menu item: opens the legacy and Terrapin details of the selected drive. The ellipsis marks a dialog.
msgctxt "ui.menu.security"
msgid "Security details…"
msgstr "Detalhes de segurança…"

#. Main window list column: security warnings of the connection (legacy encryption, Terrapin).
msgctxt "ui.main.col_security"
msgid "Security"
msgstr "Segurança"

#. Main window list group: the user's own connections.
msgctxt "ui.main.group_mine"
msgid "My connections"
msgstr "Minhas conexões"

#. Main window list group: connections that an administrator provides for all users.
msgctxt "ui.main.group_org"
msgid "Provided by your organization"
msgstr "Fornecidas pela sua organização"

#. Main window list group: drives that the service mounts for all users.
msgctxt "ui.main.group_global"
msgid "Global drives"
msgstr "Unidades globais"

#. Main window status cell while the connection retries. {attempt} is the number of the attempt.
msgctxt "ui.main.status_reconnecting"
msgid "Reconnecting ({attempt})"
msgstr "Reconectando ({attempt})"

#. Main window security cell: the connection uses outdated encryption algorithms.
msgctxt "ui.main.sec_legacy"
msgid "Legacy encryption"
msgstr "Criptografia obsoleta"

#. Main window security cell: the connection is open to the Terrapin attack.
msgctxt "ui.main.sec_terrapin"
msgid "Open to the Terrapin attack"
msgstr "Exposta ao ataque Terrapin"

#. Main window security cell: outdated encryption and open to the Terrapin attack.
msgctxt "ui.main.sec_both"
msgid "Legacy encryption, Terrapin"
msgstr "Criptografia obsoleta, Terrapin"

#. Balloon: the host key of a server changed and ShellDrive stopped the connection. {host} is the server. A click opens the details.
#. sdl10n:maxlen=256
msgctxt "ui.hki.notify_changed"
msgid "The identity of {host} has changed. ShellDrive stopped the connection. Click for details."
msgstr "A identidade de {host} mudou. O ShellDrive interrompeu a conexão. Clique para ver os detalhes."

#. Balloon: the server offered none of the host key types ShellDrive has stored for it. {host} is the server. A click opens the host key manager.
#. sdl10n:maxlen=256
msgctxt "ui.hki.notify_type"
msgid "{host} did not offer the type of key ShellDrive knows for it. ShellDrive stopped the connection. Click to manage host keys."
msgstr "{host} não ofereceu o tipo de chave que o ShellDrive conhece para ele. O ShellDrive interrompeu a conexão. Clique para gerenciar as chaves de host."

#. Balloon: like the previous one, with the key type ShellDrive has stored. {host} is the server, {stored} the stored key type.
#. sdl10n:maxlen=256
msgctxt "ui.hki.notify_type_stored"
msgid "{host} did not offer the type of key ShellDrive knows for it (stored: {stored}). ShellDrive stopped the connection. Click to manage host keys."
msgstr "{host} não ofereceu o tipo de chave que o ShellDrive conhece para ele (salva: {stored}). O ShellDrive interrompeu a conexão. Clique para gerenciar as chaves de host."

#. Title of the dialog that explains a changed host key.
msgctxt "ui.hki.title"
msgid "Host key changed"
msgstr "A chave de host mudou"

#. Changed host key dialog: what happened. {host} is the server. There is no connect-anyway option.
msgctxt "ui.hki.intro"
msgid "ShellDrive stopped the connection to {host} because the server presented a different host key than the one stored for it. The server may have been reinstalled, or someone may be intercepting your connection. ShellDrive does not offer to connect anyway."
msgstr "O ShellDrive interrompeu a conexão com {host} porque o servidor apresentou uma chave de host diferente da que está salva. O servidor pode ter sido reinstalado, ou alguém pode estar interceptando sua conexão. O ShellDrive não oferece a opção de conectar mesmo assim."

#. Label of the read-only field with the stored and the offered key. The mnemonic letter moves focus to the field.
msgctxt "ui.hki.keys_label"
msgid "&Fingerprints:"
msgstr "&Impressões digitais:"

#. Changed host key dialog: the stored key. {type} is the key type, {fp} the SHA-256 fingerprint.
msgctxt "ui.hki.line_stored"
msgid "Stored key: {type}  {fp}"
msgstr "Chave salva: {type}  {fp}"

#. Changed host key dialog: the key the server presented now. {type} is the key type, {fp} the SHA-256 fingerprint.
msgctxt "ui.hki.line_offered"
msgid "Offered now: {type}  {fp}"
msgstr "Oferecida agora: {type}  {fp}"

#. Changed host key dialog: the old key is in the user's own list. {line} is the line number.
msgctxt "ui.hki.where_user"
msgid "The stored key is in your ShellDrive list, line {line}."
msgstr "A chave salva está na sua lista do ShellDrive, linha {line}."

#. Changed host key dialog: the old key is in the list for all users of the computer. {line} is the line number.
msgctxt "ui.hki.where_machine"
msgid "The stored key is in the ShellDrive list for all users of this computer, line {line}."
msgstr "A chave salva está na lista do ShellDrive para todos os usuários deste computador, linha {line}."

#. Changed host key dialog: the old key is in a file another program owns. {path} is the file, {line} the line number.
msgctxt "ui.hki.where_file"
msgid "The stored key is in {path}, line {line}."
msgstr "A chave salva está em {path}, linha {line}."

#. Changed host key dialog: the old key is in the host keys PuTTY saved in the Windows registry.
msgctxt "ui.hki.where_putty"
msgid "The stored key is in the host keys PuTTY saved (Windows registry)."
msgstr "A chave salva está nas chaves de host salvas pelo PuTTY (registro do Windows)."

#. Changed host key dialog: what to do when the old key is in the user's own list.
msgctxt "ui.hki.todo_user"
msgid "If you expected this change, remove the old key in the host key manager, connect again and check the new fingerprint with the server's administrator before you trust it. If you did not expect it, do not connect."
msgstr "Se você esperava essa mudança, remova a chave antiga no gerenciador de chaves de host, conecte novamente e confira a nova impressão digital com o administrador do servidor antes de confiar nela. Se não esperava, não conecte."

#. Changed host key dialog: what to do when the old key is in the list for all users of the computer.
msgctxt "ui.hki.todo_machine"
msgid "This list is shared by all users of this computer, so only an administrator can change it. Ask your administrator to check the key."
msgstr "Esta lista é compartilhada por todos os usuários deste computador, então só um administrador pode alterá-la. Peça ao seu administrador para verificar a chave."

#. Changed host key dialog: what to do when the old key is in a source ShellDrive only reads (OpenSSH file, PuTTY registry).
msgctxt "ui.hki.todo_source"
msgid "ShellDrive only reads this source and cannot remove the key. Correct the entry in the program that owns it, or stop using keys from this source. A mismatch in any source blocks the connection."
msgstr "O ShellDrive apenas lê esta origem e não pode remover a chave. Corrija a entrada no programa responsável por ela ou pare de usar as chaves desta origem. Uma divergência em qualquer origem bloqueia a conexão."

#. Changed host key dialog button: opens the host key manager. The ellipsis marks a window.
msgctxt "ui.hki.btn_manage"
msgid "&Manage host keys…"
msgstr "&Gerenciar chaves de host…"

#. Changed host key dialog button: shows the file with the old key in Explorer.
msgctxt "ui.hki.btn_open"
msgid "&Open file location"
msgstr "A&brir local do arquivo"

#. Changed host key dialog button: turns off reading host keys from the source (OpenSSH or PuTTY) of the old key.
msgctxt "ui.hki.btn_stop"
msgid "&Stop using keys from this source"
msgstr "&Parar de usar chaves desta origem"

#. Changed host key dialog button: closes the dialog. It is the default button.
msgctxt "ui.hki.btn_close"
msgid "&Close"
msgstr "&Fechar"

#. Question before host keys of a source are no longer read. {source} is PuTTY or OpenSSH.
msgctxt "ui.hki.stop_confirm"
msgid "ShellDrive will no longer read the host keys saved by {source}. Servers known only there will ask you to confirm their key again. Stop using this source?"
msgstr "O ShellDrive deixará de ler as chaves de host salvas pelo {source}. Os servidores conhecidos apenas ali pedirão que você confirme a chave novamente. Parar de usar esta origem?"

#. Message after host keys of a source are no longer read. {source} is PuTTY or OpenSSH.
msgctxt "ui.hki.stop_done"
msgid "ShellDrive stopped using the host keys saved by {source}. Connect again to continue."
msgstr "O ShellDrive parou de usar as chaves de host salvas pelo {source}. Conecte novamente para continuar."

#. Title of the dialog with the legacy algorithm and Terrapin details of a connection.
msgctxt "ui.secdlg.title"
msgid "Security details"
msgstr "Detalhes de segurança"

#. Security details: the connection uses outdated algorithms. {host} is the server.
msgctxt "ui.secdlg.legacy"
msgid "{host} uses outdated security algorithms. The connection works, but it is easier to attack."
msgstr "{host} usa algoritmos de segurança obsoletos. A conexão funciona, mas é mais fácil de atacar."

#. Security details: the server is open to the Terrapin attack. {host} is the server.
msgctxt "ui.secdlg.terrapin"
msgid "The connection to {host} is open to a known attack (Terrapin) because the server is out of date. Ask the server's administrator to update OpenSSH."
msgstr "A conexão com {host} está exposta a um ataque conhecido (Terrapin) porque o servidor está desatualizado. Peça ao administrador do servidor para atualizar o OpenSSH."

#. Security details: label of the read-only list of outdated algorithms. The mnemonic letter moves focus to the list.
msgctxt "ui.secdlg.list_label"
msgid "&Algorithms:"
msgstr "&Algoritmos:"

#. Security details: the algorithm names were not reported for this connection.
msgctxt "ui.secdlg.list_unknown"
msgid "The names of the outdated algorithms are not available for this connection. Unmount the drive and mount it again to see them."
msgstr "Os nomes dos algoritmos obsoletos não estão disponíveis para esta conexão. Desmonte a unidade e monte-a novamente para vê-los."

#. Security details: one outdated algorithm. {category} is its kind, {algorithm} its name, {reason} a short reason.
msgctxt "ui.secdlg.algo_line"
msgid "{category}: {algorithm} ({reason})"
msgstr "{category}: {algorithm} ({reason})"

#. Security details: kind of algorithm, key exchange.
msgctxt "ui.secdlg.cat_kex"
msgid "Key exchange"
msgstr "Troca de chaves"

#. Security details: kind of algorithm, host key.
msgctxt "ui.secdlg.cat_hostkey"
msgid "Host key"
msgstr "Chave de host"

#. Security details: kind of algorithm, encryption cipher.
msgctxt "ui.secdlg.cat_cipher"
msgid "Cipher"
msgstr "Cifra"

#. Security details: kind of algorithm, message authentication code.
msgctxt "ui.secdlg.cat_mac"
msgid "Message check (MAC)"
msgstr "Verificação de mensagens (MAC)"

#. Security details: kind of algorithm, not recognized.
msgctxt "ui.secdlg.cat_other"
msgid "Algorithm"
msgstr "Algoritmo"

#. Security details: reason, shown in parentheses after a key exchange name.
msgctxt "ui.secdlg.why_kex"
msgid "built on SHA-1 or a small fixed group"
msgstr "baseado em SHA-1 ou em um grupo fixo pequeno"

#. Security details: reason, shown in parentheses after a CBC cipher name.
msgctxt "ui.secdlg.why_cbc"
msgid "CBC mode is open to padding attacks"
msgstr "o modo CBC é vulnerável a ataques de preenchimento"

#. Security details: reason, shown in parentheses after a message check name.
msgctxt "ui.secdlg.why_mac"
msgid "built on SHA-1"
msgstr "baseada em SHA-1"

#. Security details: reason, shown in parentheses after a host key name.
msgctxt "ui.secdlg.why_hostkey"
msgid "its signatures use SHA-1"
msgstr "suas assinaturas usam SHA-1"

#. Security details: reason, shown in parentheses after an algorithm of an unknown kind.
msgctxt "ui.secdlg.why_other"
msgid "considered outdated"
msgstr "considerado obsoleto"

#. Security details button: stops warning about this set of algorithms for this server.
msgctxt "ui.secdlg.btn_keep"
msgid "&Don't warn again for this server"
msgstr "&Não avisar mais sobre este servidor"

#. Security details button: refuses outdated algorithms for this server from now on.
msgctxt "ui.secdlg.btn_refuse"
msgid "&Refuse outdated algorithms for this server"
msgstr "&Recusar algoritmos obsoletos neste servidor"

#. Security details button: closes the dialog. It is the default button.
msgctxt "ui.secdlg.btn_close"
msgid "&Close"
msgstr "&Fechar"

#. Security details: confirmation after Don't warn again.
msgctxt "ui.secdlg.keep_done"
msgid "ShellDrive will not warn about these algorithms for this server again. A different set of outdated algorithms warns again."
msgstr "O ShellDrive não avisará mais sobre estes algoritmos neste servidor. Outro conjunto de algoritmos obsoletos avisará novamente."

#. Security details: question after the setting was saved. {drive} is the drive letter.
msgctxt "ui.secdlg.refuse_ask"
msgid "Outdated algorithms are refused for this server from now on. Reconnect {drive} now?"
msgstr "A partir de agora, os algoritmos obsoletos são recusados neste servidor. Reconectar {drive} agora?"

#. Host key manager button: copies the SHA256 fingerprint of the selected key.
msgctxt "ui.hostkeys.btn_copy_fp"
msgid "Copy fingerprint"
msgstr "Copiar impressão digital"

#. Host key manager status line: the fingerprint is on the clipboard.
msgctxt "ui.hostkeys.fp_copied"
msgid "Fingerprint copied."
msgstr "A impressão digital foi copiada."

#. Announced keys button: drops the selected offer without changing any stored key.
msgctxt "ui.hostkeys.btn_reject"
msgid "Dismiss offer"
msgstr "Descartar oferta"

#. Host key manager status line after an offer was dismissed. {host} is the server.
msgctxt "ui.hostkeys.rejected"
msgid "The offer from {host} was dismissed. No key was changed."
msgstr "A oferta de {host} foi descartada. Nenhuma chave foi alterada."

#. Host key manager status line: the agent did not drop the offer. {code} is the error name.
msgctxt "ui.hostkeys.reject_failed"
msgid "The offer could not be dismissed ({code})."
msgstr "Não foi possível descartar a oferta ({code})."

#. Host key manager details pane when no key is selected.
msgctxt "ui.hostkeys.det_none"
msgid "Select a key to see its details."
msgstr "Selecione uma chave para ver os detalhes."

#. Host key details line. {value} is the host name.
msgctxt "ui.hostkeys.det_host"
msgid "Host: {value}"
msgstr "Host: {value}"

#. Host key details line. {value} is the TCP port.
msgctxt "ui.hostkeys.det_port"
msgid "Port: {value}"
msgstr "Porta: {value}"

#. Host key details line. {value} is the key type, such as ssh-ed25519.
msgctxt "ui.hostkeys.det_type"
msgid "Key type: {value}"
msgstr "Tipo de chave: {value}"

#. Host key details line. {value} is the SHA256 fingerprint.
msgctxt "ui.hostkeys.det_fp"
msgid "SHA256 fingerprint: {value}"
msgstr "Impressão digital SHA256: {value}"

#. Host key details line. {value} says which store holds the key.
msgctxt "ui.hostkeys.det_store"
msgid "Stored in: {value}"
msgstr "Armazenada em: {value}"

#. Host key details line. {value} is the line number of the key in its known_hosts file.
msgctxt "ui.hostkeys.det_line"
msgid "Line in the file: {value}"
msgstr "Linha no arquivo: {value}"

#. Host key details: note for a key of the machine store.
msgctxt "ui.hostkeys.det_readonly"
msgid "Machine keys can only be changed by an administrator."
msgstr "Somente um administrador pode alterar as chaves da máquina."

#. Tools menu and tray menu: opens the list of recent events.
msgctxt "ui.menu.events"
msgid "Events…"
msgstr "Eventos…"

#. Title of the event list window.
msgctxt "ui.events.title"
msgid "ShellDrive events"
msgstr "Eventos do ShellDrive"

#. Event list column: when the event happened.
msgctxt "ui.events.col_time"
msgid "Time"
msgstr "Hora"

#. Event list column: the drive letter or server the event is about.
msgctxt "ui.events.col_subject"
msgid "Drive or server"
msgstr "Unidade ou servidor"

#. Event list column: the kind of event.
msgctxt "ui.events.col_kind"
msgid "Kind"
msgstr "Tipo"

#. Event list column: what happened.
msgctxt "ui.events.col_text"
msgid "Event"
msgstr "Evento"

#. Event kind: a drive changed state.
msgctxt "ui.events.kind_drive"
msgid "Drive"
msgstr "Unidade"

#. Event kind: a host key problem or offer.
msgctxt "ui.events.kind_hostkey"
msgid "Host key"
msgstr "Chave do host"

#. Event kind: a warning.
msgctxt "ui.events.kind_warning"
msgid "Warning"
msgstr "Aviso"

#. Event kind: something failed.
msgctxt "ui.events.kind_error"
msgid "Error"
msgstr "Erro"

#. Event kind: information, such as an update.
msgctxt "ui.events.kind_info"
msgid "Information"
msgstr "Informação"

#. Event list button: copies the listed events to the clipboard.
msgctxt "ui.events.btn_copy"
msgid "Copy list"
msgstr "Copiar lista"

#. Event list button: forgets the recorded events.
msgctxt "ui.events.btn_clear"
msgid "Clear list"
msgstr "Limpar lista"

#. Event text: a mount failed. {code} is the error name.
msgctxt "ui.events.text_failed"
msgid "Failed ({code})."
msgstr "Falhou ({code})."

#. Event list status line: number of events shown.
#, plural-arg=count
msgctxt "ui.events.status_count"
msgid "{count} event."
msgid_plural "{count} events."
msgstr[0] "{count} evento."
msgstr[1] "{count} de eventos."
msgstr[2] "{count} eventos."

#. Settings: title of the Notifications tab.
msgctxt "ui.settings.tab_notifications"
msgid "Notifications"
msgstr "Notificações"

#. Settings: label of the list that sets the default write mode of connections that do not choose one (3.4).
msgctxt "ui.settings.write_default"
msgid "Default for writes"
msgstr "Gravações por padrão"

#. Settings: default write mode list, wait for the server on every write.
msgctxt "ui.settings.write_through"
msgid "Wait for the server (safer)"
msgstr "Aguardar o servidor (mais seguro)"

#. Settings: default write mode list, acknowledge writes before the server confirms them.
msgctxt "ui.settings.write_behind"
msgid "Write in the background (faster)"
msgstr "Gravar em segundo plano (mais rápido)"

#. Settings: checkbox that starts the ShellDrive agent at sign-in (Run key, this user only).
msgctxt "ui.settings.agent_logon"
msgid "Start the ShellDrive agent at sign-in"
msgstr "Iniciar o agente do ShellDrive ao entrar"

#. Settings: checkbox, strict log privacy (10.1).
msgctxt "ui.settings.log_privacy"
msgid "Keep host names and file paths out of log files"
msgstr "Não incluir nomes de servidor nem caminhos de arquivo nos logs"

#. Settings: text above the list of notification switches.
msgctxt "ui.settings.notify_hint"
msgid "Choose which notifications appear. Important problems, such as a changed host key or a write that failed, are always shown."
msgstr "Escolha quais notificações aparecem. Problemas importantes, como uma chave de host alterada ou uma gravação que falhou, sempre são exibidos."

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_connection_lost"
msgid "Connection lost"
msgstr "Conexão perdida"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_reconnected"
msgid "Connection restored"
msgstr "Conexão restabelecida"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_mount_failed"
msgid "A drive could not be connected"
msgstr "Não foi possível conectar uma unidade"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_mounted"
msgid "A drive was connected"
msgstr "Uma unidade foi conectada"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_legacy_algorithms"
msgid "A connection uses outdated encryption"
msgstr "Uma conexão usa criptografia obsoleta"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_hostkeys_offered"
msgid "A server offers new host keys"
msgstr "Um servidor oferece novas chaves de host"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_hostkeys_saved"
msgid "New host keys were saved automatically"
msgstr "Novas chaves de host foram salvas automaticamente"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_proxy_password"
msgid "A proxy sends the password unencrypted"
msgstr "Um proxy envia a senha sem criptografia"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_pool_limited"
msgid "Extra connections not used because signing in needs typing"
msgstr "Conexões extras não usadas porque entrar exige digitação"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_service_attention"
msgid "The ShellDrive service needs attention"
msgstr "O serviço do ShellDrive precisa de atenção"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_update_available"
msgid "An update is available"
msgstr "Há uma atualização disponível"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_update_stale"
msgid "Update information is out of date"
msgstr "As informações de atualização estão desatualizadas"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_terrapin"
msgid "A connection is open to the Terrapin attack"
msgstr "Uma conexão está exposta ao ataque Terrapin"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_hostkeys_source"
msgid "A host key file was ignored because other users can change it"
msgstr "Um arquivo de chaves de host foi ignorado porque outros usuários podem alterá-lo"

#. Settings: notification switch (7.7).
msgctxt "ui.settings.nk_disk_cache"
msgid "Disk cache refused on a volume without permissions"
msgstr "Cache em disco recusado em um volume sem permissões"

#. Status bar while ShellDrive is being started after a click on the not-running text.
msgctxt "ui.status.agent_starting"
msgid "Starting ShellDrive…"
msgstr "Iniciando o ShellDrive…"

#. Message when the click on the status bar could not start ShellDrive. {code} is the error name.
msgctxt "ui.status.agent_start_failed"
msgid "ShellDrive could not be started ({code}). Try again in a moment."
msgstr "Não foi possível iniciar o ShellDrive ({code}). Tente novamente em instantes."

#. Balloon: a mounted drive lost its connection (03 7.7). {name} is the drive letter or the connection name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.lost"
msgid "{name}: the connection was lost. ShellDrive is trying to reconnect."
msgstr "{name}: a conexão foi perdida. O ShellDrive está tentando reconectar."

#. Balloon: a drive is connected again after it lost its connection (03 7.7). {name} is the drive letter or the connection name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.reconnected"
msgid "{name}: connected again."
msgstr "{name}: conectado novamente."

#. Balloon: a drive could not be connected (03 7.7). {name} is the drive letter or the connection name, {code} the error name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.mount_failed"
msgid "ShellDrive could not connect {name} ({code}). Open ShellDrive for details."
msgstr "O ShellDrive não conseguiu conectar {name} ({code}). Abra o ShellDrive para ver os detalhes."

#. Balloon: a drive is connected (03 7.7, off by default). {name} is the drive letter or the connection name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.mounted"
msgid "{name}: connected."
msgstr "{name}: conectado."

#. Balloon: the proxy of a connection receives the proxy password unencrypted (03 3.8, 7.7). {name} is the connection, {proxy} the proxy as host:port.
#. sdl10n:maxlen=256
msgctxt "ui.notice.proxy_password"
msgid "{name}: the proxy {proxy} receives your proxy password unencrypted."
msgstr "{name}: o proxy {proxy} recebe sua senha de proxy sem criptografia."

#. Balloon: extra connections of a drive are not used because signing in needs typing (03 7.7, off by default). {name} is the drive letter or the connection name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.pool_limited"
msgid "{name}: extra connections are not used because signing in needs you to type."
msgstr "{name}: as conexões extras não são usadas porque o login exige que você digite algo."

#. Balloon: ShellDrive saved new host keys of a server by itself (03 5.6, 7.7). {host} is the server.
#. sdl10n:maxlen=256
msgctxt "ui.notice.hostkeys_saved"
msgid "ShellDrive saved new host keys for {host}."
msgstr "O ShellDrive salvou novas chaves de host de {host}."

#. Balloon: the disk cache was not used because its folder is on a volume without file permissions (03 1.9, 7.7). {name} is the drive letter or the connection name.
#. sdl10n:maxlen=256
msgctxt "ui.notice.disk_cache"
msgid "{name}: ShellDrive did not use the disk cache because its folder is on a volume without file permissions."
msgstr "{name}: o ShellDrive não usou o cache em disco porque a pasta dele está em um volume sem permissões de arquivo."

#. Title of the dialog that explains a wrong host key type (03 5.2).
msgctxt "ui.hki.type_title"
msgid "Host key type not offered"
msgstr "Tipo de chave de host não oferecido"

#. Wrong host key type dialog: what happened. {host} is the server. Nothing is trusted automatically.
msgctxt "ui.hki.type_intro"
msgid "ShellDrive stopped the connection to {host} because the server did not offer any of the host key types ShellDrive has stored for it. The server may have been reinstalled or upgraded, or someone may be intercepting your connection. ShellDrive does not trust a key of another type by itself."
msgstr "O ShellDrive interrompeu a conexão com {host} porque o servidor não ofereceu nenhum dos tipos de chave de host que o ShellDrive guardou para ele. O servidor pode ter sido reinstalado ou atualizado, ou alguém pode estar interceptando sua conexão. O ShellDrive não confia por conta própria em uma chave de outro tipo."

#. Wrong host key type dialog: the key types stored for the server. {types} is a comma separated list.
msgctxt "ui.hki.line_stored_types"
msgid "Stored key types: {types}"
msgstr "Tipos de chave guardados: {types}"

#. Wrong host key type dialog: the host key types the server offers. {types} is a comma separated list.
msgctxt "ui.hki.line_offered_types"
msgid "Types the server offers: {types}"
msgstr "Tipos oferecidos pelo servidor: {types}"

#. Wrong host key type dialog: shown in place of the list of key types when there is none.
msgctxt "ui.hki.types_none"
msgid "none"
msgstr "nenhum"

#. Wrong host key type dialog: what to do. It names the button Add key from server.
msgctxt "ui.hki.type_todo"
msgid "If you expected this change, check the new fingerprint with the server's administrator, then add the key with the Add key from server button. If you did not expect it, do not connect."
msgstr "Se você esperava essa mudança, confira a nova impressão digital com o administrador do servidor e depois adicione a chave com o botão Adicionar chave do servidor. Se não esperava, não se conecte."

#. Wrong host key type dialog button: opens the host key manager and the review of the server's keys. The ellipsis marks a window.
msgctxt "ui.hki.btn_add"
msgid "&Add key from server…"
msgstr "&Adicionar chave do servidor…"
