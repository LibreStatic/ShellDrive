    <String Id="VerifyReadyDlgRemove" Overridable="yes">&amp;Quitar</String>
    <String Id="VerifyReadyDlgRemoveText" Overridable="yes">Hacé clic en Quitar para quitar [ProductName] de tu equipo. Hacé clic en Atrás para revisar o cambiar la configuración de la instalación. Hacé clic en Cancelar para salir del asistente.</String>
