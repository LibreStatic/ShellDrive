msgctxt "svc.debug_started"
msgid "ShellDrive service running in console mode. Press Ctrl+C to stop."
msgstr "O serviço ShellDrive está em execução no modo console. Pressione Ctrl+C para parar."

msgctxt "svc.debug_stopped"
msgid "ShellDrive service stopped."
msgstr "O serviço ShellDrive foi parado."

msgctxt "svc.not_scm"
msgid "This program is the ShellDrive service and needs the Service Control Manager. To run it in a console, use: shelldrive-host.exe service-debug"
msgstr "Este programa é o serviço ShellDrive e precisa do Gerenciador de Controle de Serviços. Para executá-lo em um console, use: shelldrive-host.exe service-debug"
