# ShellDrive CLI strings, German (informal imperative).
msgid ""
msgstr ""
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "cli.version"
msgid "ShellDrive {version}"
msgstr "ShellDrive {version}"

msgctxt "cli.usage"
msgid "Usage: shelldrive <command> [options]"
msgstr "Verwendung: shelldrive <Befehl> [Optionen]"

msgctxt "cli.unknown_command"
msgid "Unknown command: {command}. Run \"shelldrive --help\" for help."
msgstr "Unbekannter Befehl: {command}. Führe \"shelldrive --help\" aus, um die Hilfe anzuzeigen."

msgctxt "cli.mounted_count"
msgid "{count} drive mounted."
msgid_plural "{count} drives mounted."
msgstr[0] "{count} Laufwerk eingebunden."
msgstr[1] "{count} Laufwerke eingebunden."

msgctxt "cli.help.commands"
msgid "Commands:"
msgstr "Befehle:"

msgctxt "cli.help.options"
msgid "Options:"
msgstr "Optionen:"

msgctxt "cli.help.global_options"
msgid "Global options:"
msgstr "Globale Optionen:"

msgctxt "cli.help.mount"
msgid "Mount a profile or a server as a drive."
msgstr "Bindet ein Profil oder einen Server als Laufwerk ein."

msgctxt "cli.help.unmount"
msgid "Unmount a drive, or every drive with --all."
msgstr "Trennt ein Laufwerk oder mit --all alle Laufwerke."

msgctxt "cli.help.list"
msgid "List the drives mounted in this session."
msgstr "Zeigt die in dieser Sitzung eingebundenen Laufwerke an."

msgctxt "cli.help.agent_stop"
msgid "Stop the ShellDrive agent of this session and unmount its drives."
msgstr "Beendet den ShellDrive-Agenten dieser Sitzung und trennt seine Laufwerke."

msgctxt "cli.help.version"
msgid "Show the version."
msgstr "Zeigt die Version an."

msgctxt "cli.help.help"
msgid "Show help for a command."
msgstr "Zeigt die Hilfe zu einem Befehl an."

msgctxt "cli.help.more"
msgid "Run \"shelldrive help <command>\" to see the options of a command."
msgstr "Führe \"shelldrive help <Befehl>\" aus, um die Optionen eines Befehls zu sehen."

msgctxt "cli.help.opt_host"
msgid "Server to connect to, with an optional user name and port."
msgstr "Server, mit dem die Verbindung hergestellt wird, mit optionalem Benutzernamen und Port."

msgctxt "cli.help.opt_letter"
msgid "Drive letter to use, for example Z:. By default the first free letter from Z: down."
msgstr "Zu verwendender Laufwerksbuchstabe, zum Beispiel Z:. Standard: der erste freie Buchstabe ab Z: abwärts."

msgctxt "cli.help.opt_identity"
msgid "Private key file to sign in with."
msgstr "Private Schlüsseldatei für die Anmeldung."

msgctxt "cli.help.opt_remote_path"
msgid "Folder on the server to show in the drive. By default your home folder."
msgstr "Ordner auf dem Server, der im Laufwerk angezeigt wird. Standard: dein Basisordner."

msgctxt "cli.help.opt_read_only"
msgid "Mount the drive read-only."
msgstr "Bindet das Laufwerk schreibgeschützt ein."

msgctxt "cli.help.opt_prompt"
msgid "How to ask for passwords and confirmations: auto, console or none."
msgstr "Wie nach Passwörtern und Bestätigungen gefragt wird: auto, console oder none."

msgctxt "cli.help.opt_stdin"
msgid "Read the answers to questions from standard input, one per line."
msgstr "Liest die Antworten auf Fragen von der Standardeingabe, eine pro Zeile."

msgctxt "cli.help.opt_no_wait"
msgid "Return as soon as the mount has started."
msgstr "Kehrt zurück, sobald das Einbinden begonnen hat."

msgctxt "cli.help.opt_all"
msgid "Unmount every drive of this session."
msgstr "Trennt alle Laufwerke dieser Sitzung."

msgctxt "cli.help.opt_json"
msgid "Print the result as JSON."
msgstr "Gibt das Ergebnis als JSON aus."

msgctxt "cli.help.opt_quiet"
msgid "Print only errors."
msgstr "Gibt nur Fehler aus."

msgctxt "cli.help.opt_lang"
msgid "Language of the messages: en, es, fr, pt, it or de."
msgstr "Sprache der Meldungen: en, es, fr, pt, it oder de."

msgctxt "cli.err.unknown_option"
msgid "Unknown option: {option}."
msgstr "Unbekannte Option: {option}."

msgctxt "cli.err.missing_value"
msgid "The option {option} needs a value."
msgstr "Die Option {option} braucht einen Wert."

msgctxt "cli.err.missing_argument"
msgid "The command \"{command}\" needs more arguments."
msgstr "Für den Befehl \"{command}\" fehlen Argumente."

msgctxt "cli.err.extra_argument"
msgid "Unexpected argument: {argument}."
msgstr "Unerwartetes Argument: {argument}."

msgctxt "cli.err.bad_value"
msgid "Invalid value for {option}: {value}."
msgstr "Ungültiger Wert für {option}: {value}."

msgctxt "cli.err.conflict"
msgid "{option} cannot be used together with {other}."
msgstr "{option} kann nicht zusammen mit {other} verwendet werden."

msgctxt "cli.err.host_spec"
msgid "Invalid server: {value}. Use [user@]host[:port]."
msgstr "Ungültiger Server: {value}. Verwende [benutzer@]host[:port]."

msgctxt "cli.err.see_help"
msgid "Run \"shelldrive help {command}\" for help."
msgstr "Führe \"shelldrive help {command}\" aus, um die Hilfe anzuzeigen."

msgctxt "cli.mount.connecting"
msgid "Connecting to {host}..."
msgstr "Verbindung mit {host} wird hergestellt..."

msgctxt "cli.mount.done"
msgid "Mounted {name} on {target}."
msgstr "{name} ist als {target} eingebunden."

msgctxt "cli.mount.started"
msgid "Mounting {name} on {target}."
msgstr "{name} wird als {target} eingebunden."

msgctxt "cli.unmount.done"
msgid "Unmounted {target}."
msgstr "{target} wurde getrennt."

msgctxt "cli.list.empty"
msgid "No drives are mounted."
msgstr "Es sind keine Laufwerke eingebunden."

msgctxt "cli.list.col_drive"
msgid "Drive"
msgstr "Laufwerk"

msgctxt "cli.list.col_state"
msgid "State"
msgstr "Status"

msgctxt "cli.list.col_server"
msgid "Server"
msgstr "Server"

msgctxt "cli.list.col_profile"
msgid "Profile"
msgstr "Profil"

msgctxt "cli.state.connecting"
msgid "connecting"
msgstr "verbinden"

msgctxt "cli.state.authenticating"
msgid "signing in"
msgstr "anmelden"

msgctxt "cli.state.mounted"
msgid "mounted"
msgstr "eingebunden"

msgctxt "cli.state.offline"
msgid "offline"
msgstr "offline"

msgctxt "cli.state.auth_required"
msgid "sign-in required"
msgstr "Anmeldung nötig"

msgctxt "cli.state.failed"
msgid "failed"
msgstr "fehlgeschlagen"

msgctxt "cli.state.unmounting"
msgid "unmounting"
msgstr "wird getrennt"

msgctxt "cli.state.unmounted"
msgid "unmounted"
msgstr "getrennt"

msgctxt "cli.agent.stopped"
msgid "The ShellDrive agent stopped."
msgstr "Der ShellDrive-Agent wurde beendet."

msgctxt "cli.agent.not_running"
msgid "The ShellDrive agent is not running."
msgstr "Der ShellDrive-Agent läuft nicht."

msgctxt "cli.hk.unknown"
msgid "The authenticity of host '{host}' (port {port}) can't be established."
msgstr "Die Echtheit des Hosts '{host}' (Port {port}) kann nicht festgestellt werden."

msgctxt "cli.hk.fingerprint"
msgid "{type} key fingerprint: {fingerprint}"
msgstr "Fingerabdruck des {type}-Schlüssels: {fingerprint}"

msgctxt "cli.hk.check_hint"
msgid "Compare the fingerprint with the one the server's administrator gave you."
msgstr "Vergleiche den Fingerabdruck mit dem, den du vom Administrator des Servers bekommen hast."

msgctxt "cli.hostkey_default_no"
msgid "Trust this key? [y]es, [o]nce, [N]o: "
msgstr "Diesem Schlüssel vertrauen? [j]a, [e]inmal, [N]ein: "

msgctxt "cli.hk.letter_yes"
msgid "y"
msgstr "j"

msgctxt "cli.hk.letter_once"
msgid "o"
msgstr "e"

msgctxt "cli.hk.word_yes"
msgid "yes"
msgstr "ja"

msgctxt "cli.hk.word_once"
msgid "once"
msgstr "einmal"

msgctxt "prompt.hostkey_just_accepted"
msgid "You just accepted this server's identity. ShellDrive did not send your saved password automatically."
msgstr "Du hast gerade die Identität dieses Servers akzeptiert. ShellDrive hat dein gespeichertes Passwort nicht automatisch gesendet."

msgctxt "cli.prompt.password"
msgid "Password for {user}@{host}: "
msgstr "Passwort für {user}@{host}: "

msgctxt "cli.prompt.passphrase"
msgid "Passphrase for the key {key}: "
msgstr "Passphrase für den Schlüssel {key}: "

msgctxt "cli.prompt.retry"
msgid "The server did not accept the answer. Try again."
msgstr "Der Server hat die Antwort nicht akzeptiert. Versuche es noch einmal."

msgctxt "cli.prompt.server_says"
msgid "The server {host} asks:"
msgstr "Der Server {host} fragt:"

msgctxt "cli.hk.mismatch_stored"
msgid "Stored key: {type} {fingerprint} ({file}, line {line})"
msgstr "Gespeicherter Schlüssel: {type} {fingerprint} ({file}, Zeile {line})"

msgctxt "cli.hk.mismatch_offered"
msgid "Key offered now: {type} {fingerprint}"
msgstr "Jetzt angebotener Schlüssel: {type} {fingerprint}"

msgctxt "cli.hk.mismatch_hint"
msgid "If the server's key really changed, remove the old key from that file and connect again."
msgstr "Wenn sich der Schlüssel des Servers wirklich geändert hat, entferne den alten Schlüssel aus dieser Datei und verbinde dich erneut."

msgctxt "cli.error.auth_failed"
msgid "Signing in to {host} failed. Check the user name, the password or the key."
msgstr "Die Anmeldung bei {host} ist fehlgeschlagen. Prüfe den Benutzernamen, das Passwort oder den Schlüssel."

msgctxt "cli.error.prompt_required"
msgid "{host} needs a password or another answer, but ShellDrive was not allowed to ask. Run the command in a console or use --stdin."
msgstr "{host} braucht ein Passwort oder eine andere Antwort, aber ShellDrive durfte nicht nachfragen. Führe den Befehl in einer Konsole aus oder verwende --stdin."

msgctxt "cli.error.host_key_unknown"
msgid "The identity of {host} is not known yet, and ShellDrive was not allowed to ask you to confirm it. Run the command in a console to check the key."
msgstr "Die Identität von {host} ist noch nicht bekannt, und ShellDrive durfte dich nicht bitten, sie zu bestätigen. Führe den Befehl in einer Konsole aus, um den Schlüssel zu prüfen."

msgctxt "cli.error.host_key_rejected"
msgid "You did not trust the key of {host}. ShellDrive did not connect."
msgstr "Du hast dem Schlüssel von {host} nicht vertraut. ShellDrive hat keine Verbindung hergestellt."

msgctxt "cli.error.host_key_mismatch"
msgid "The identity of {host} has changed. ShellDrive stopped the connection."
msgstr "Die Identität von {host} hat sich geändert. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.host_key_type_unavailable"
msgid "{host} did not offer the type of key ShellDrive knows for it. ShellDrive stopped the connection."
msgstr "{host} hat nicht den Schlüsseltyp angeboten, den ShellDrive für diesen Server kennt. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.host_key_revoked"
msgid "The key of {host} has been revoked. ShellDrive stopped the connection."
msgstr "Der Schlüssel von {host} wurde widerrufen. ShellDrive hat die Verbindung abgebrochen."

msgctxt "cli.error.dns_failed"
msgid "The server name {host} could not be found."
msgstr "Der Servername {host} wurde nicht gefunden."

msgctxt "cli.error.conn_refused"
msgid "{host} refused the connection."
msgstr "{host} hat die Verbindung abgelehnt."

msgctxt "cli.error.net_unreachable"
msgid "{host} cannot be reached from this network."
msgstr "{host} ist aus diesem Netzwerk nicht erreichbar."

msgctxt "cli.error.connect_failed"
msgid "The connection to {host} failed."
msgstr "Die Verbindung mit {host} ist fehlgeschlagen."

msgctxt "cli.error.kex_failed"
msgid "ShellDrive and {host} could not agree on a secure connection."
msgstr "ShellDrive und {host} konnten sich nicht auf eine sichere Verbindung einigen."

msgctxt "cli.error.legacy_refused"
msgid "{host} only offers outdated encryption, which is turned off."
msgstr "{host} bietet nur veraltete Verschlüsselung an, die ausgeschaltet ist."

msgctxt "cli.error.bad_passphrase"
msgid "The passphrase of the key is wrong."
msgstr "Die Passphrase des Schlüssels ist falsch."

msgctxt "cli.error.key_format"
msgid "The key file could not be read."
msgstr "Die Schlüsseldatei konnte nicht gelesen werden."

msgctxt "cli.error.timeout"
msgid "The operation took too long and was stopped."
msgstr "Der Vorgang hat zu lange gedauert und wurde abgebrochen."

msgctxt "cli.error.cancelled"
msgid "Cancelled."
msgstr "Abgebrochen."

msgctxt "cli.error.agent_unavailable"
msgid "The ShellDrive agent is not running and could not be started."
msgstr "Der ShellDrive-Agent läuft nicht und konnte nicht gestartet werden."

msgctxt "cli.error.agent_untrusted"
msgid "Another program is using the name of the ShellDrive agent. ShellDrive did not connect to it."
msgstr "Ein anderes Programm verwendet den Namen des ShellDrive-Agenten. ShellDrive hat sich nicht damit verbunden."

msgctxt "cli.error.access_denied"
msgid "Access denied."
msgstr "Zugriff verweigert."

msgctxt "cli.error.proto_unsupported"
msgid "This shelldrive version does not match the running ShellDrive agent. Run \"shelldrive agent stop\" and try again."
msgstr "Diese shelldrive-Version passt nicht zum laufenden ShellDrive-Agenten. Führe \"shelldrive agent stop\" aus und versuche es erneut."

msgctxt "cli.error.profile_not_found"
msgid "There is no profile named {name}."
msgstr "Es gibt kein Profil mit dem Namen {name}."

msgctxt "cli.error.mount_not_found"
msgid "No ShellDrive drive matches {name}."
msgstr "Kein ShellDrive-Laufwerk passt zu {name}."

msgctxt "cli.error.target_in_use"
msgid "The drive letter {target} is already in use."
msgstr "Der Laufwerksbuchstabe {target} wird bereits verwendet."

msgctxt "cli.error.invalid_target"
msgid "Invalid drive letter: {value}. Use a letter from D: to Z:."
msgstr "Ungültiger Laufwerksbuchstabe: {value}. Verwende einen Buchstaben von D: bis Z:."

msgctxt "cli.error.already_mounted"
msgid "This profile is already mounted."
msgstr "Dieses Profil ist bereits eingebunden."

msgctxt "cli.error.backend_unavailable"
msgid "Dokany is not installed, so ShellDrive cannot create the drive. Install Dokany 2.1 or later."
msgstr "Dokany ist nicht installiert, daher kann ShellDrive das Laufwerk nicht erstellen. Installiere Dokany 2.1 oder neuer."

msgctxt "cli.error.generic"
msgid "The operation failed ({code})."
msgstr "Der Vorgang ist fehlgeschlagen ({code})."

msgctxt "cli.help.opt_backend"
msgid "Drive backend: auto (Dokany when it is installed, otherwise WebDAV), dokany or webdav."
msgstr "Laufwerks-Backend: auto (Dokany, wenn installiert, sonst WebDAV), dokany oder webdav."

msgctxt "cli.error.webclient_disabled"
msgid "The WebClient service is disabled, so ShellDrive cannot create a WebDAV drive. An administrator can enable it with: sc config WebClient start= demand"
msgstr "Der Dienst WebClient ist deaktiviert, daher kann ShellDrive kein WebDAV-Laufwerk erstellen. Ein Administrator kann ihn so aktivieren: sc config WebClient start= demand"

msgctxt "cli.error.webdav_unavailable"
msgid "The Windows WebDAV client (WebClient service) is not installed or could not be started. An administrator can start it with: sc start WebClient. On Windows Server, add the WebDAV Redirector feature first."
msgstr "Der Windows-WebDAV-Client (Dienst WebClient) ist nicht installiert oder konnte nicht gestartet werden. Ein Administrator kann ihn so starten: sc start WebClient. Unter Windows Server füge zuerst das Feature WebDAV Redirector hinzu."

msgctxt "cli.state.reconnecting"
msgid "reconnecting"
msgstr "verbindet neu"

msgctxt "cli.list.write_failed"
msgid "On {target}, {count} file could not be saved on the server (last: {path})."
msgid_plural "On {target}, {count} files could not be saved on the server (last: {path})."
msgstr[0] "Auf {target} konnte {count} Datei nicht auf dem Server gespeichert werden (zuletzt: {path})."
msgstr[1] "Auf {target} konnten {count} Dateien nicht auf dem Server gespeichert werden (zuletzt: {path})."

#. ---- M2: status, profile import, hostkey commands, mount options and the new prompts ----

#. Summary of the status command.
msgctxt "cli.help.status"
msgid "Show the detailed state of the mounted drives."
msgstr "Zeigt den detaillierten Zustand der eingebundenen Laufwerke an."

#. Summary of "profile import".
msgctxt "cli.help.profile_import"
msgid "Import profiles from PuTTY sessions or an OpenSSH ssh_config file."
msgstr "Importiert Profile aus PuTTY-Sitzungen oder einer OpenSSH-ssh_config-Datei."

#. Summary of the hostkey command.
msgctxt "cli.help.hostkey"
msgid "Show, import or remove stored host keys, and apply announced key updates."
msgstr "Zeigt gespeicherte Host-Schlüssel an, importiert oder entfernt sie und wendet angekündigte Schlüsselaktualisierungen an."

#. Help for --jump HOST. The value syntax is literal.
msgctxt "cli.help.opt_jump"
msgid "A server to connect through before the target, as [user@]host[:port]. Repeat the option for several hops."
msgstr "Ein Server, über den vor dem Ziel verbunden wird, als [benutzer@]host[:port]. Wiederhole die Option für mehrere Sprünge."

#. Help for --proxy SPEC. The value syntax and the scheme names are literal.
msgctxt "cli.help.opt_proxy"
msgid "Proxy for the first leg: http://[user@]host[:port] or socks5://[user@]host[:port]."
msgstr "Proxy für den ersten Abschnitt: http://[benutzer@]host[:port] oder socks5://[benutzer@]host[:port]."

#. Help for --connections N. States the pool rule (D18): extra connections only with non-interactive auth.
msgctxt "cli.help.opt_connections"
msgid "How many connections to the server to use at once, from 1 to 4. More than one is only reached when signing in needs no typed answer."
msgstr "Wie viele Verbindungen zum Server gleichzeitig verwendet werden, von 1 bis 4. Mehr als eine wird nur erreicht, wenn die Anmeldung keine getippte Antwort braucht."

#. Help for hostkey remove --type T.
msgctxt "cli.help.opt_type"
msgid "Remove only the stored key of this type, for example ssh-ed25519."
msgstr "Entfernt nur den gespeicherten Schlüssel dieses Typs, zum Beispiel ssh-ed25519."

#. Help for hostkey import --from. putty and openssh are literal values.
msgctxt "cli.help.opt_from"
msgid "Where to copy host keys from: putty (the registry) or openssh (a known_hosts file)."
msgstr "Woher die Host-Schlüssel kopiert werden: putty (die Registrierung) oder openssh (eine known_hosts-Datei)."

#. Help for hostkey accept-announced --add-only.
msgctxt "cli.help.opt_add_only"
msgid "Add the new keys, but keep the keys the server no longer offers."
msgstr "Fügt die neuen Schlüssel hinzu, behält aber die Schlüssel, die der Server nicht mehr anbietet."

#. Help for hostkey list --announced.
msgctxt "cli.help.opt_announced"
msgid "Show the host key updates that servers announced and that wait for review."
msgstr "Zeigt die Host-Schlüssel-Aktualisierungen an, die Server angekündigt haben und die auf eine Prüfung warten."

#. Help for --dry-run.
msgctxt "cli.help.opt_dry_run"
msgid "Show what would be imported without writing anything."
msgstr "Zeigt an, was importiert würde, ohne etwas zu schreiben."

#. Detail line of shelldrive status; {state} is a connection state word such as ready.
msgctxt "cli.status.conn"
msgid "Connection: {state}"
msgstr "Verbindung: {state}"

#. Detail line of shelldrive status.
msgctxt "cli.status.pool"
msgid "Connections in use: {count} of {wanted}."
msgstr "Verbindungen in Gebrauch: {count} von {wanted}."

#. Detail line of shelldrive status: automatic reconnects after losses.
msgctxt "cli.status.reconnects"
msgid "Reconnected {count} times."
msgstr "Erneut verbunden: {count} mal."

#. Detail line of shelldrive status; {reason} is an English error identifier.
msgctxt "cli.status.reason"
msgid "The connection was lost ({reason})."
msgstr "Die Verbindung ging verloren ({reason})."

#. profile import summary with --dry-run.
#, plural-arg=count
msgctxt "cli.pi.found"
msgid "{count} profile found. Nothing was written (--dry-run)."
msgid_plural "{count} profiles found. Nothing was written (--dry-run)."
msgstr[0] "{count} Profil gefunden. Es wurde nichts geschrieben (--dry-run)."
msgstr[1] "{count} Profile gefunden. Es wurde nichts geschrieben (--dry-run)."

#. profile import summary.
#, plural-arg=count
msgctxt "cli.pi.imported"
msgid "{count} profile imported."
msgid_plural "{count} profiles imported."
msgstr[0] "{count} Profil importiert."
msgstr[1] "{count} Profile importiert."

#. profile import of a source with no usable entries.
msgctxt "cli.pi.empty"
msgid "Nothing to import."
msgstr "Nichts zu importieren."

#. Note column of the profile import table.
msgctxt "cli.pi.note_duplicate"
msgid "a profile for this server already exists"
msgstr "für diesen Server existiert bereits ein Profil"

#. Note column of the profile import table (D37).
msgctxt "cli.pi.note_only_this_key"
msgid "the imported key would be the only one offered"
msgstr "der importierte Schlüssel wäre der einzige angebotene"

#. Note column of the profile import table.
msgctxt "cli.pi.note_proxy_skipped"
msgid "its proxy type is not supported"
msgstr "der Proxy-Typ wird nicht unterstützt"

#. Note column of the profile import table.
msgctxt "cli.pi.note_name_changed"
msgid "renamed because the name was taken"
msgstr "umbenannt, weil der Name bereits vergeben war"

#. profile import: an ssh_config keyword that has no ShellDrive equivalent (3.7). {item} is the keyword.
msgctxt "cli.pi.skip_keyword"
msgid "{source}: the {item} lines are not imported."
msgstr "{source}: die {item}-Zeilen werden nicht importiert."

#. profile import: same, for global lines (no Host section).
msgctxt "cli.pi.skip_keyword_global"
msgid "The {item} lines are not imported."
msgstr "Die {item}-Zeilen werden nicht importiert."

#. profile import: a PuTTY session of another protocol. {item} is the protocol.
msgctxt "cli.pi.skip_not_ssh"
msgid "{source}: the session is not SSH ({item})."
msgstr "{source}: die Sitzung ist kein SSH ({item})."

#. profile import: a PuTTY proxy type without an equivalent (D20). {item} is the method.
msgctxt "cli.pi.skip_proxy"
msgid "{source}: the proxy type ({item}) is not supported."
msgstr "{source}: der Proxy-Typ ({item}) wird nicht unterstützt."

#. profile import: an unusable entry.
msgctxt "cli.pi.skip_invalid"
msgid "{source}: unusable entry ({item})."
msgstr "{source}: unbrauchbarer Eintrag ({item})."

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_store"
msgid "Store"
msgstr "Speicher"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_type"
msgid "Type"
msgstr "Typ"

#. Column heading of hostkey list (keep it short).
msgctxt "cli.hk.col_fp"
msgid "Fingerprint"
msgstr "Fingerabdruck"

#. hostkey list of a host with no stored key.
msgctxt "cli.hk.list_empty"
msgid "No host key is stored for {host}."
msgstr "Für {host} ist kein Host-Schlüssel gespeichert."

#. hostkey list stopped early because there are very many keys.
msgctxt "cli.hk.list_truncated"
msgid "The list was cut short; refine the host name to see the rest."
msgstr "Die Liste wurde gekürzt; grenze den Hostnamen weiter ein, um den Rest zu sehen."

#. hostkey remove.
msgctxt "cli.hk.removed"
msgid "Removed the stored keys of {host}."
msgstr "Die gespeicherten Schlüssel von {host} wurden entfernt."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.imported"
msgid "{count} host key imported."
msgid_plural "{count} host keys imported."
msgstr[0] "{count} Host-Schlüssel importiert."
msgstr[1] "{count} Host-Schlüssel importiert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_kept"
msgid "{count} key was already stored."
msgid_plural "{count} keys were already stored."
msgstr[0] "{count} Schlüssel war bereits gespeichert."
msgstr[1] "{count} Schlüssel waren bereits gespeichert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_conflicts"
msgid "{count} key conflicts with a stored key and was not imported."
msgid_plural "{count} keys conflict with stored keys and were not imported."
msgstr[0] "{count} Schlüssel steht im Konflikt mit einem gespeicherten Schlüssel und wurde nicht importiert."
msgstr[1] "{count} Schlüssel stehen im Konflikt mit gespeicherten Schlüsseln und wurden nicht importiert."

#. hostkey import summary.
#, plural-arg=count
msgctxt "cli.hk.import_invalid"
msgid "{count} line could not be read."
msgid_plural "{count} lines could not be read."
msgstr[0] "{count} Zeile konnte nicht gelesen werden."
msgstr[1] "{count} Zeilen konnten nicht gelesen werden."

#. hostkey import of a source without keys.
msgctxt "cli.hk.import_empty"
msgid "The source has no host keys."
msgstr "Die Quelle enthält keine Host-Schlüssel."

#. hostkey list --announced with nothing pending.
msgctxt "cli.hk.announced_none"
msgid "There are no host key updates to review."
msgstr "Es gibt keine Host-Schlüssel-Aktualisierungen zu prüfen."

#. hostkey list --announced, one pending update. {id} is the id for accept-announced.
msgctxt "cli.hk.announced_item"
msgid "{id}: {host} offered new host keys."
msgstr "{id}: {host} hat neue Host-Schlüssel angeboten."

#. One key a server added to its announcement (5.6).
msgctxt "cli.hk.announced_add"
msgid "New key: {type} {fingerprint}"
msgstr "Neuer Schlüssel: {type} {fingerprint}"

#. One key a server no longer offers (5.6).
msgctxt "cli.hk.announced_remove"
msgid "No longer offered: {type} {fingerprint}"
msgstr "Nicht mehr angeboten: {type} {fingerprint}"

#. hostkey accept-announced.
msgctxt "cli.hk.announced_applied"
msgid "Updated the host keys of {host}: {added} added, {removed} removed."
msgstr "Die Host-Schlüssel von {host} wurden aktualisiert (hinzugefügt: {added}; entfernt: {removed})."

#. Introduction of the password-change questions (2.5, PASSWD_CHANGEREQ).
msgctxt "cli.prompt.password_change"
msgid "The server {host} asks to change the password."
msgstr "Der Server {host} bittet darum, das Passwort zu ändern."

#. Proxy password prompt; input is hidden.
msgctxt "cli.prompt.proxy_password"
msgid "Password for the proxy {user}@{proxy_host}:{proxy_port}: "
msgstr "Passwort für den Proxy {user}@{proxy_host}:{proxy_port}: "

#. The legacy-algorithms question (2.5, C21); {algorithms} is a comma list of algorithm names.
msgctxt "cli.prompt.legacy_ack"
msgid "The server {host} uses outdated encryption ({algorithms})."
msgstr "Der Server {host} verwendet veraltete Verschlüsselung ({algorithms})."

#. The legacy-algorithms question; the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.legacy_ack_question"
msgid "Continue anyway? [y]es, [N]o: "
msgstr "Trotzdem fortfahren? [j]a, [N]ein: "

#. Shown for hop i >= 1 of a jump chain (TM-R03). {host} is the previous hop.
msgctxt "cli.prompt.via"
msgid "Reached through jump host {host}."
msgstr "Verbindung über den Jump-Host {host} hergestellt."

#. Shown for every prompt of a jump chain. {host} is the hop's server.
msgctxt "cli.prompt.hop"
msgid "Jump host {hop} of {hops}: {host}"
msgstr "Jump-Host {hop} von {hops}: {host}"

#. Save question after a password, passphrase or proxy password (4.2); the letters in brackets must match cli.hk.letter_yes; the default (capital) is no.
msgctxt "cli.prompt.save"
msgid "Save the answer for the next connection? [y]es, [N]o: "
msgstr "Antwort für die nächste Verbindung speichern? [j]a, [N]ein: "

#. Credential Manager comment for a saved secret (4.2). {name} is the profile name.
msgctxt "cli.save.comment"
msgid "Saved by ShellDrive for {name}"
msgstr "Von ShellDrive für {name} gespeichert"

msgctxt "cli.error.host_key_not_found"
msgid "No host key of {host} is stored in your ShellDrive store."
msgstr "Es ist kein Schlüssel von {host} in deinem ShellDrive-Speicher gespeichert."

msgctxt "cli.error.announcement_not_found"
msgid "There is no pending host key update with this id."
msgstr "Es gibt keine ausstehende Host-Schlüssel-Aktualisierung mit dieser Kennung."

msgctxt "cli.error.session_not_found"
msgid "There is no PuTTY session named {name}."
msgstr "Es gibt keine PuTTY-Sitzung mit dem Namen {name}."

msgctxt "cli.error.putty_not_found"
msgid "PuTTY is not installed, or it has no saved sessions."
msgstr "PuTTY ist nicht installiert oder hat keine gespeicherten Sitzungen."

msgctxt "cli.error.file_not_found"
msgid "The file {name} could not be read."
msgstr "Die Datei {name} konnte nicht gelesen werden."

#. M3: refresh, cache clear, profile test, status --stats and the new mount option.
#. Exit code 3: the drive has no file system to refresh.
msgctxt "cli.error.not_mounted"
msgid "The drive is not mounted, so there is nothing to refresh."
msgstr "Das Laufwerk ist nicht verbunden, es gibt also nichts zu aktualisieren."

#. Exit code 8: write-behind data is queued and the cache clear was refused.
msgctxt "cli.error.write_behind_pending"
msgid "Changes are still waiting to be written to the server, so the cache was not cleared. Run the command again with --force to clear the rest; the waiting changes are kept."
msgstr "Es warten noch Änderungen darauf, auf den Server geschrieben zu werden, daher wurde der Cache nicht geleert. Führe den Befehl mit --force erneut aus, um den Rest zu leeren; die wartenden Änderungen bleiben erhalten."

#. Printed by shelldrive refresh. {path} is the drive and the folder, such as W: or W:\docs.
msgctxt "cli.refresh.done"
msgid "Refreshed the cache of {path}."
msgstr "Der Cache von {path} wurde aktualisiert."

#. Printed by shelldrive cache clear. {count} is the number of drives whose cache was cleared.
#, plural-arg=count
msgctxt "cli.cache.cleared"
msgid "Cleared the cache of {count} drive."
msgid_plural "Cleared the cache of {count} drives."
msgstr[0] "Der Cache von {count} Laufwerk wurde geleert."
msgstr[1] "Der Cache von {count} Laufwerken wurde geleert."

#. Printed by status --stats for a drive without a connection.
msgctxt "cli.stats.none"
msgid "No statistics: the drive has no connection."
msgstr "Keine Statistik: Das Laufwerk hat keine Verbindung."

#. Heading of one drive in status --stats. {target} is the drive, {name} the profile.
msgctxt "cli.stats.header"
msgid "{target} {name}"
msgstr "{target} {name}"

#. status --stats: the session line. Round trip in milliseconds; generation counts the reconnects.
msgctxt "cli.stats.session"
msgid "Connection: round trip {srtt} ms, {inflight} requests in flight, {queued} queued, session generation {generation}."
msgstr "Verbindung: Umlaufzeit {srtt} ms, {inflight} Anfragen in Bearbeitung, {queued} in der Warteschlange, Sitzungsgeneration {generation}."

#. status --stats: bytes received and sent by the current connection.
msgctxt "cli.stats.transfer"
msgid "Transferred {rx} bytes in and {tx} bytes out."
msgstr "Übertragen: {rx} Byte empfangen und {tx} Byte gesendet."

#. status --stats: the cache counters of the drive (memory and disk tiers).
msgctxt "cli.stats.cache"
msgid "Cache: {hits} hits, {misses} misses, {failed} failed writes, {queued} bytes waiting for write-behind."
msgstr "Cache: {hits} Treffer, {misses} Fehlzugriffe, {failed} fehlgeschlagene Schreibvorgänge, {queued} Byte warten auf verzögertes Schreiben."

#. profile test: the result line. {path} is the resolved remote folder.
msgctxt "cli.test.ok"
msgid "{name} works: connected to {host} as {user}, and the remote path is {path}."
msgstr "{name} funktioniert: Verbindung zu {host} als {user} hergestellt, der Remote-Pfad ist {path}."

#. profile test: the host key that was verified.
msgctxt "cli.test.hostkey"
msgid "Host key: {fingerprint}."
msgstr "Host-Schlüssel: {fingerprint}."

#. profile test: the negotiated algorithms (key exchange, host key, cipher and MAC of the client-to-server direction).
msgctxt "cli.test.algorithms"
msgid "Algorithms: key exchange {kex}, host key {hostkey}, cipher {cipher}, MAC {mac}."
msgstr "Algorithmen: Schlüsselaustausch {kex}, Host-Schlüssel {hostkey}, Verschlüsselung {cipher}, MAC {mac}."

#. profile test: an outdated algorithm was negotiated on some hop.
msgctxt "cli.test.legacy"
msgid "The server negotiated an outdated algorithm. security.legacy_algorithms decides what happens next."
msgstr "Der Server hat einen veralteten Algorithmus ausgehandelt. security.legacy_algorithms legt fest, was danach geschieht."

#. Help of the mount option --open.
msgctxt "cli.help.opt_open"
msgid "Open the drive in Explorer once it is mounted."
msgstr "Öffne das Laufwerk im Explorer, sobald es verbunden ist."

#. Help of the status option --stats.
msgctxt "cli.help.opt_stats"
msgid "Also show the connection and cache counters of each drive."
msgstr "Zeige zusätzlich die Zähler für Verbindung und Cache jedes Laufwerks."

#. Help of the cache clear option --force.
msgctxt "cli.help.opt_force"
msgid "Clear the cache even while changes are waiting to be written. The waiting changes are kept."
msgstr "Leere den Cache auch, während Änderungen auf das Schreiben warten. Die wartenden Änderungen bleiben erhalten."

#. Summary of the refresh command.
msgctxt "cli.help.refresh"
msgid "Drop the cached attributes and listings of a folder, or of the whole drive."
msgstr "Verwirf die zwischengespeicherten Attribute und Listen eines Ordners oder des ganzen Laufwerks."

#. Summary of the cache command.
msgctxt "cli.help.cache"
msgid "Clear the cache of a profile, a drive or every mounted drive."
msgstr "Leere den Cache eines Profils, eines Laufwerks oder aller verbundenen Laufwerke."

#. Summary of profile test.
msgctxt "cli.help.profile_test"
msgid "Connect and sign in, then resolve the remote path, without mounting anything."
msgstr "Verbinde dich und melde dich an, löse dann den Remote-Pfad auf, ohne etwas einzubinden."
