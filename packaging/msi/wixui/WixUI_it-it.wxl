<?xml version="1.0" encoding="utf-8"?>
<!-- Italian overrides of the WixUI_Minimal strings: informal imperative (AGENTS.md). Replaces the WiX stock it-it, which uses the formal infinitive and Lei forms. -->
<!-- Every id of packaging/msi/wixui/dialog-set.txt. Values that WiX's stock file already has in the project register are copied from it. -->
