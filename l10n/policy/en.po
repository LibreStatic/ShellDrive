msgctxt "policy.supported.xp"
msgid "At least Windows XP Service Pack 3"
msgstr ""

msgctxt "policy.supported.win11"
msgid "At least Windows 11"
msgstr ""

msgctxt "policy.legacyalgorithms.title"
msgid "Legacy SSH algorithms"
msgstr ""

msgctxt "policy.legacyalgorithms.explain"
msgid "Controls the use of legacy SSH algorithms. 0 allows them, 1 allows them with a warning, 2 refuses them."
msgstr ""

msgctxt "policy.legacyalgorithms.label"
msgid "Legacy algorithms:"
msgstr ""

msgctxt "policy.legacyalgorithms.opt.0"
msgid "Allow"
msgstr ""

msgctxt "policy.legacyalgorithms.opt.1"
msgid "Warn"
msgstr ""

msgctxt "policy.legacyalgorithms.opt.2"
msgid "Refuse"
msgstr ""

msgctxt "policy.allowuserprofiles.title"
msgid "Allow user profiles"
msgstr ""

msgctxt "policy.allowuserprofiles.explain"
msgid "Allows users to keep their own connection profiles. When disabled, only the machine profiles are used."
msgstr ""

msgctxt "policy.allowadhocmounts.title"
msgid "Allow ad hoc mounts"
msgstr ""

msgctxt "policy.allowadhocmounts.explain"
msgid "Allows mounting a connection that is not saved as a profile. When disabled, only saved profiles can be mounted."
msgstr ""

msgctxt "policy.allowedbackends.title"
msgid "Allowed mount backends"
msgstr ""

msgctxt "policy.allowedbackends.explain"
msgid "Lists the mount backends that may be used, separated by commas (webdav,dokany)."
msgstr ""

msgctxt "policy.allowedbackends.label"
msgid "Backends (comma-separated):"
msgstr ""

msgctxt "policy.disablecredentialsaving.title"
msgid "Disable saving credentials"
msgstr ""

msgctxt "policy.disablecredentialsaving.explain"
msgid "Prevents ShellDrive from saving passwords and keys in Windows Credential Manager."
msgstr ""

msgctxt "policy.stricthostkeychecking.title"
msgid "Strict host key checking"
msgstr ""

msgctxt "policy.stricthostkeychecking.explain"
msgid "When enabled, ShellDrive accepts only host keys that are already in the machine known_hosts store. New keys are never accepted on first use."
msgstr ""

msgctxt "policy.disableknownhostssources.title"
msgid "Disable other known_hosts sources"
msgstr ""

msgctxt "policy.disableknownhostssources.explain"
msgid "Prevents ShellDrive from reading the user's OpenSSH known_hosts file and the PuTTY host keys."
msgstr ""

msgctxt "policy.updatehostkeys.title"
msgid "Host key updates"
msgstr ""

msgctxt "policy.updatehostkeys.explain"
msgid "Controls whether ShellDrive updates known host keys. 0 never updates, 1 asks the user, 2 accepts keys proven by the server. For the service, 2 is the only way to update the machine store."
msgstr ""

msgctxt "policy.updatehostkeys.label"
msgid "Host key updates:"
msgstr ""

msgctxt "policy.updatehostkeys.opt.0"
msgid "Never"
msgstr ""

msgctxt "policy.updatehostkeys.opt.1"
msgid "Ask"
msgstr ""

msgctxt "policy.updatehostkeys.opt.2"
msgid "Accept proven keys"
msgstr ""

msgctxt "policy.forcewritethrough.title"
msgid "Force write-through"
msgstr ""

msgctxt "policy.forcewritethrough.explain"
msgid "When enabled, profiles that use write-behind caching are refused. Writes reach the server before the call returns."
msgstr ""

msgctxt "policy.proxyserver.title"
msgid "Proxy server"
msgstr ""

msgctxt "policy.proxyserver.explain"
msgid "Forces this proxy as the first hop for every profile, in the form scheme://host:port. When not set, each profile's own proxy setting applies."
msgstr ""

msgctxt "policy.proxyserver.label"
msgid "Proxy (scheme://host:port):"
msgstr ""

msgctxt "policy.allowsystemproxy.title"
msgid "Allow the system proxy"
msgstr ""

msgctxt "policy.allowsystemproxy.explain"
msgid "Allows profiles that use the Windows system proxy, WPAD or PAC. When disabled, those profiles are refused."
msgstr ""

msgctxt "policy.allowsystemproxysspi.title"
msgid "Allow SSPI to the system proxy"
msgstr ""

msgctxt "policy.allowsystemproxysspi.explain"
msgid "Allows Windows integrated authentication (SSPI) to be answered for a proxy that comes from the system settings, WPAD or PAC. Disabled by default."
msgstr ""

msgctxt "policy.allowwebdavtokenonly.title"
msgid "Allow WebDAV token-only fallback"
msgstr ""

msgctxt "policy.allowwebdavtokenonly.explain"
msgid "Allows the WebDAV fallback that uses only a token. When disabled, that fallback is forbidden and the connection fails."
msgstr ""

msgctxt "policy.uilanguage.title"
msgid "Interface language"
msgstr ""

msgctxt "policy.uilanguage.explain"
msgid "Sets the language of the ShellDrive interface and messages. When not set, the user's Windows language is used."
msgstr ""

msgctxt "policy.uilanguage.label"
msgid "Language:"
msgstr ""

msgctxt "policy.uilanguage.opt.en"
msgid "English"
msgstr ""

msgctxt "policy.uilanguage.opt.es"
msgid "Español"
msgstr ""

msgctxt "policy.uilanguage.opt.fr"
msgid "Français"
msgstr ""

msgctxt "policy.uilanguage.opt.pt-br"
msgid "Português (Brasil)"
msgstr ""

msgctxt "policy.uilanguage.opt.it"
msgid "Italiano"
msgstr ""

msgctxt "policy.uilanguage.opt.de"
msgid "Deutsch"
msgstr ""

msgctxt "policy.disableupdatecheck.title"
msgid "Disable update checks"
msgstr ""

msgctxt "policy.disableupdatecheck.explain"
msgid "Prevents ShellDrive from checking for updates. When enabled, no check is made and the update settings are ignored."
msgstr ""

msgctxt "policy.updatechannel.title"
msgid "Update channel"
msgstr ""

msgctxt "policy.updatechannel.explain"
msgid "Sets the update channel: stable for released versions only, or beta to include pre-releases."
msgstr ""

msgctxt "policy.updatechannel.label"
msgid "Channel:"
msgstr ""

msgctxt "policy.updatechannel.opt.stable"
msgid "Stable"
msgstr ""

msgctxt "policy.updatechannel.opt.beta"
msgid "Beta"
msgstr ""

msgctxt "policy.updateurl.title"
msgid "Update manifest URL"
msgstr ""

msgctxt "policy.updateurl.explain"
msgid "Sets the address of the update manifest, for example an internal mirror. When not set, the default address is used."
msgstr ""

msgctxt "policy.updateurl.label"
msgid "Manifest URL:"
msgstr ""

msgctxt "policy.hidetrayicon.title"
msgid "Hide the tray icon"
msgstr ""

msgctxt "policy.hidetrayicon.explain"
msgid "Hides the ShellDrive icon in the notification area."
msgstr ""

msgctxt "policy.disablenetworklocations.title"
msgid "Disable network locations"
msgstr ""

msgctxt "policy.disablenetworklocations.explain"
msgid "Prevents ShellDrive mounts from being added to Network Locations (NetHood) in Explorer."
msgstr ""

msgctxt "policy.disablemoderncontextmenu.title"
msgid "Disable the modern context menu"
msgstr ""

msgctxt "policy.disablemoderncontextmenu.explain"
msgid "Prevents ShellDrive entries from appearing in the modern Windows 11 context menu. The classic menu entries remain."
msgstr ""

msgctxt "policy.logprivacy.title"
msgid "Log privacy"
msgstr ""

msgctxt "policy.logprivacy.explain"
msgid "Sets how much personal data is written to the logs. 0 uses standard logging, 1 uses strict logging, which removes more personal data from the entries."
msgstr ""

msgctxt "policy.logprivacy.label"
msgid "Log detail:"
msgstr ""

msgctxt "policy.logprivacy.opt.0"
msgid "Standard"
msgstr ""

msgctxt "policy.logprivacy.opt.1"
msgid "Strict"
msgstr ""
