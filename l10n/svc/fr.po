# ShellDrive service strings, French (vous).
msgid ""
msgstr ""
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=((n == 0 || n == 1) ? 0 : n != 0 && n % 1000000 == 0 ? 1 : 2);\n"

msgctxt "svc.debug_started"
msgid "ShellDrive service running in console mode. Press Ctrl+C to stop."
msgstr "Le service ShellDrive fonctionne en mode console. Appuyez sur Ctrl+C pour l'arrêter."

msgctxt "svc.debug_stopped"
msgid "ShellDrive service stopped."
msgstr "Le service ShellDrive s'est arrêté."

msgctxt "svc.not_scm"
msgid "This program is the ShellDrive service and needs the Service Control Manager. To run it in a console, use: shelldrive-host.exe service-debug"
msgstr "Ce programme est le service ShellDrive et nécessite le gestionnaire de contrôle des services. Pour l'exécuter dans une console, utilisez : shelldrive-host.exe service-debug"

# Event Log messages (03 §10.3): the same ids, placeholders and placeholder order as en.po.
msgctxt "evt.started"
msgid "ShellDrive service started (version %1)."
msgstr "Le service ShellDrive a démarré (version %1)."

msgctxt "evt.stopped"
msgid "ShellDrive service stopped."
msgstr "Le service ShellDrive s'est arrêté."

msgctxt "evt.mounted"
msgid "Global drive for profile %1 is mounted at %2."
msgstr "Le lecteur global du profil %1 est monté sur %2."

msgctxt "evt.unmounted"
msgid "Global drive for profile %1 at %2 was unmounted."
msgstr "Le lecteur global du profil %1 sur %2 a été démonté."

msgctxt "evt.mount_failed"
msgid "Global drive for profile %1 failed to mount (%2): %3"
msgstr "Le lecteur global du profil %1 n'a pas pu être monté (%2) : %3"

msgctxt "evt.start_failed"
msgid "ShellDrive service could not start (%1)."
msgstr "Le service ShellDrive n'a pas pu démarrer (%1)."

msgctxt "evt.client_refused"
msgid "ShellDrive refused a service pipe client of user %1 (%2: token, per_sid, reserved or rate). At most one such event is written per user every 10 minutes."
msgstr "ShellDrive a refusé un client du canal de service de l'utilisateur %1 (%2 : token, per_sid, reserved ou rate). Au plus un événement de ce type est écrit par utilisateur toutes les 10 minutes."

msgctxt "evt.untrusted_folder"
msgid "ShellDrive refused the untrusted machine folder or service file %1 (%2). A refused folder keeps the service idle until an elevated shelldrive service repair-data renames it aside; a refused file fails the mount that uses it."
msgstr "ShellDrive a refusé le dossier machine ou le fichier de service non approuvé %1 (%2). Un dossier refusé maintient le service inactif jusqu'à ce qu'un shelldrive service repair-data élevé le renomme ; un fichier refusé fait échouer le montage qui l'utilise."

msgctxt "evt.audit"
msgid "Change through the global drive for profile %1 by %3 (SID %2): %4 %5."
msgstr "Modification via le lecteur global du profil %1 par %3 (SID %2) : %4 %5."

msgctxt "evt.hostkeys_announced"
msgid "A server announced host keys for %1 (new: %2; no longer offered: %3). The machine host keys are not changed until an administrator accepts them with shelldrive hostkey list --announced --machine."
msgstr "Un serveur a annoncé des clés d'hôte pour %1 (nouvelles : %2 ; ne sont plus proposées : %3). Les clés d'hôte de la machine ne changent pas tant qu'un administrateur ne les a pas acceptées avec shelldrive hostkey list --announced --machine."
